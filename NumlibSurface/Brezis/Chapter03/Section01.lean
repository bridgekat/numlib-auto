import Mathlib.Topology.Bases
import Mathlib.Topology.Order

/-!
# Brezis, Section 3.1: The coarsest topology for which a collection of maps becomes continuous

This module formalizes Section 3.1 of [brezis2011functional]. Let $X$ be a set, and let
$(\varphi_i)_{i \in I}$ be a family of maps $\varphi_i : X \to Y_i$ into topological spaces $Y_i$.
Problem 1 of the source asks for the coarsest topology on $X$ that makes every $\varphi_i$
continuous. Problem 2 constructs it as the topology generated by the sets $\varphi_i^{-1}(\omega)$
with $\omega$ open in $Y_i$, and Lemma 3.1 shows that the finite intersections of such sets form a
basis. A sequence converges in this topology if and only if its images under every $\varphi_i$
converge (Proposition 3.1). A map $\psi$ from a topological space into $X$ is continuous if and only
if every $\varphi_i \circ \psi$ is continuous (Proposition 3.2). Sections 3.2 and 3.4 define the
weak topologies $\sigma(E, E^\star)$ and $\sigma(E^\star, E)$ in this way.

The results restate Mathlib: `TopologicalSpace.generateFrom_iUnion_isOpen` (Problem 2),
`TopologicalSpace.isTopologicalBasis_of_subbasis` (Lemma 3.1), `nhds_iInf` with `nhds_induced`
(Proposition 3.1), and `continuous_iInf_rng` with `continuous_induced_rng` (Proposition 3.2).

## Main definitions

* Problem 1, `Brezis.Chapter03.weakestTopology`: the coarsest topology on $X$ that makes every
  $\varphi_i$ continuous.

## Main results

* Problem 1, `Brezis.Chapter03.continuous_weakestTopology`: every $\varphi_i$ is continuous for this
  topology.
* Problem 1, `Brezis.Chapter03.weakestTopology_le`: every topology that makes all $\varphi_i$
  continuous is finer.
* Problem 2, `Brezis.Chapter03.weakestTopology_eq_generateFrom`: the topology is generated by the
  sets $\varphi_i^{-1}(\omega)$.
* Lemma 3.1, `Brezis.Chapter03.lemma_3_1`: the finite intersections of the sets of a subbasis form a
  basis of the topology that it generates.
* Proposition 3.1, `Brezis.Chapter03.proposition_3_1`: $x_n \to x$ if and only if
  $\varphi_i(x_n) \to \varphi_i(x)$ for every $i$.
* Proposition 3.2, `Brezis.Chapter03.proposition_3_2`: $\psi$ is continuous if and only if
  $\varphi_i \circ \psi$ is continuous for every $i$.

## Implementation notes

* The topology is `⨅ i, TopologicalSpace.induced (φ i) inferInstance`. In Mathlib's order on
  `TopologicalSpace X`, `t ≤ s` means that `t` is finer than `s`. Thus "the coarsest topology that
  makes the $\varphi_i$ continuous" is the greatest such topology.

## Not formalized

* **Remark 1.** It is a discussion.
-/

open Filter Topology TopologicalSpace

namespace Brezis.Chapter03

variable {X : Type*} {ι : Type*} {Y : ι → Type*} [∀ i, TopologicalSpace (Y i)]

/-- **Problem 1** of Section 3.1 of [brezis2011functional]. Let $X$ be a set and let
$\varphi_i : X \to Y_i$, $i \in I$, be maps into topological spaces $Y_i$. The **coarsest
topology** on $X$ for which every $\varphi_i$ is continuous (also called the weakest or initial
topology) is the infimum, in Mathlib's order, of the topologies on $X$ induced by the
$\varphi_i$.

The definition is `⨅ i, TopologicalSpace.induced (φ i) inferInstance`. -/
@[instance_reducible]
def weakestTopology (φ : ∀ i, X → Y i) : TopologicalSpace X :=
  ⨅ i, TopologicalSpace.induced (φ i) inferInstance

/-- **Problem 1** of Section 3.1 of [brezis2011functional]. Every map $\varphi_i$ is continuous for
the topology `Brezis.Chapter03.weakestTopology φ`. -/
theorem continuous_weakestTopology (φ : ∀ i, X → Y i) (i : ι) :
    Continuous[weakestTopology φ, _] (φ i) :=
  continuous_iInf_dom continuous_induced_dom

/-- **Problem 1** of Section 3.1 of [brezis2011functional], minimality. Let $t$ be a topology on $X$
for which every $\varphi_i$ is continuous. Then $t$ has at least as many open sets as
`Brezis.Chapter03.weakestTopology φ`.

In Mathlib's order this is `t ≤ weakestTopology φ`. -/
theorem weakestTopology_le (φ : ∀ i, X → Y i) {t : TopologicalSpace X}
    (h : ∀ i, Continuous[t, _] (φ i)) : t ≤ weakestTopology φ :=
  le_iInf fun i => continuous_iff_le_induced.1 (h i)

/-- **Problem 2** of Section 3.1 of [brezis2011functional]. The topology
`Brezis.Chapter03.weakestTopology φ` is the topology generated by the sets
$\varphi_i^{-1}(\omega)$, where $i \in I$ and $\omega$ is open in $Y_i$. That is, it is the
coarsest topology in which all these sets are open. -/
theorem weakestTopology_eq_generateFrom (φ : ∀ i, X → Y i) :
    weakestTopology φ =
      generateFrom {U | ∃ (i : ι) (ω : Set (Y i)), IsOpen ω ∧ U = φ i ⁻¹' ω} := by
  rw [weakestTopology, ← generateFrom_iUnion_isOpen]
  congr 1
  ext U
  simp only [Set.mem_iUnion, Set.mem_ofPred_eq, isOpen_induced_iff]
  constructor
  · rintro ⟨i, ω, hω, rfl⟩
    exact ⟨i, ω, hω, rfl⟩
  · rintro ⟨i, ω, hω, rfl⟩
    exact ⟨i, ω, hω, rfl⟩

/-- **Lemma 3.1** of [brezis2011functional]. Let $s$ be a family of subsets of $X$. The finite
intersections of sets of $s$ form a basis of the topology generated by $s$.

The source states that the family of arbitrary unions of finite intersections of sets of $s$ is
stable under finite intersections; this is equivalent. The empty intersection is $X$. -/
theorem lemma_3_1 (s : Set (Set X)) :
    @IsTopologicalBasis X (generateFrom s)
      ((fun f => ⋂₀ f) '' {f : Set (Set X) | f.Finite ∧ f ⊆ s}) :=
  @isTopologicalBasis_of_subbasis X (generateFrom s) s rfl

/-- **Proposition 3.1** of [brezis2011functional]. Let $(x_n)$ be a sequence in $X$ and $x \in X$.
Then $x_n \to x$ in the topology `Brezis.Chapter03.weakestTopology φ` if and only if
$\varphi_i(x_n) \to \varphi_i(x)$ for every $i \in I$. -/
theorem proposition_3_1 (φ : ∀ i, X → Y i) (x : ℕ → X) (a : X) :
    Tendsto x atTop (@nhds X (weakestTopology φ) a) ↔
      ∀ i, Tendsto (fun n => φ i (x n)) atTop (𝓝 (φ i a)) := by
  unfold weakestTopology
  rw [nhds_iInf, tendsto_iInf]
  refine forall_congr' fun i => ?_
  rw [nhds_induced, tendsto_comap_iff]
  rfl

/-- **Proposition 3.2** of [brezis2011functional]. Let $Z$ be a topological space and let
$\psi : Z \to X$. Then $\psi$ is continuous for the topology
`Brezis.Chapter03.weakestTopology φ` on $X$ if and only if $\varphi_i \circ \psi$ is continuous
from $Z$ into $Y_i$ for every $i \in I$. -/
theorem proposition_3_2 (φ : ∀ i, X → Y i) {Z : Type*} [TopologicalSpace Z] (ψ : Z → X) :
    Continuous[_, weakestTopology φ] ψ ↔ ∀ i, Continuous (φ i ∘ ψ) := by
  unfold weakestTopology
  rw [continuous_iInf_rng]
  exact forall_congr' fun i => continuous_induced_rng

end Brezis.Chapter03
