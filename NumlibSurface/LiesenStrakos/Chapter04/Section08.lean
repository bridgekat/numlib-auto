import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.Order.Lattice.Nat
import Numlib.Krylov.Subspace

/-!
# Liesen and Strakoš, Section 4.8: Other types of recurrences

Section 4.8 of [liesen2013krylov] gives coupled recurrences for unitary operators,
replaces polynomial interpolation of conjugation by rational interpolation, and
describes a Lanczos recurrence using both an operator and its adjoint.

## Main definitions

* Algorithm 4.8.1, `LiesenStrakos.IsIsometricArnoldi`: the coupled isometric Arnoldi recurrences.
* Section 4.8.2, `LiesenStrakos.mcmillanDegree`: the least rational degree interpolating complex
  conjugation on the eigenvalues of an operator.
* Section 4.8.3, `LiesenStrakos.generalizedKrylovSubspace`: the subspaces generated by iterating
  the operator and its adjoint.
* Algorithm 4.8.2, `LiesenStrakos.IsGeneralizedLanczos`: the layered generalized Lanczos process.

## Main results

* Theorem 4.8.1 (1), `LiesenStrakos.theorem_4_8_1_one`: collinear or concyclic spectra
  with at least four distinct eigenvalues have McMillan degree one.

## Deviations from the source

* **Algorithms 4.8.1 and 4.8.2** (reading). The predicates state the recurrences, with empty
  layers after generalized Lanczos termination.
* **Theorem 4.8.1 (1)** (generalization). Rational interpolation on the eigenvalues
  gives the conclusion for any finite-dimensional operator with the stated spectrum.

## Not formalized

* **Theorem 4.8.1 (2).** The bound for zeros of harmonic rational functions is still needed.
-/

open Polynomial

namespace LiesenStrakos

section Isometric

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [FiniteDimensional ℂ E]

/-- For a unitary operator $U$ and nonzero initial vector $b$, isometric Arnoldi starts with
$v_0=\widetilde v_0=b/\|b\|$. For $j+1<d(U,b)$ it sets
$\gamma_j=-\langle\widetilde v_j,Uv_j\rangle$, $\sigma_j=(1-|\gamma_j|^2)^{1/2}>0$, and updates
$v_{j+1}=(Uv_j+\gamma_j\widetilde v_j)/\sigma_j$ and
$\widetilde v_{j+1}=\sigma_j\widetilde v_j+\overline{\gamma_j}v_{j+1}$.
This is Algorithm 4.8.1 of [liesen2013krylov].

**Reading.** The predicate describes initialization and recurrence through the grade. Its
conclusion as a Krylov basis is separate. -/
def IsIsometricArnoldi (U : E ≃ₗᵢ[ℂ] E) (b : E) (v w : ℕ → E) : Prop :=
  b ≠ 0 ∧ v 0 = ((‖b‖ : ℂ)⁻¹) • b ∧ w 0 = v 0 ∧
    ∀ j, j + 1 < Krylov.grade U.toLinearEquiv.toLinearMap b →
      let γ := -inner ℂ (w j) (U (v j))
      let σ := Real.sqrt (1 - ‖γ‖ ^ 2)
      0 < σ ∧ v (j + 1) = ((σ : ℂ)⁻¹) • (U (v j) + γ • w j) ∧
        w (j + 1) = (σ : ℂ) • w j + star γ • v (j + 1)

end Isometric

section Rational

open Module.End

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The McMillan degree of the conjugation interpolation problem on the eigenvalues of $A$
is the least $\max(\deg p,\deg q)$ for coprime numerator and denominator polynomials
$p,q$ with $q\ne0$ and $q(\lambda)\ne0$ at every eigenvalue, with
$p(\lambda)=\overline\lambda q(\lambda)$ at each eigenvalue.
Degrees use natural numbers with the convention $\deg 0=0$ for the numerator, which
leaves the maximum unchanged. This is the definition in Section 4.8.2 of [liesen2013krylov].

**Generalization.** Rational interpolation on the spectrum is defined also for
nondiagonalizable operators. -/
noncomputable def mcmillanDegree [FiniteDimensional ℂ V] (A : Module.End ℂ V) : ℕ :=
  sInf {d : ℕ | ∃ p q : ℂ[X], q ≠ 0 ∧ IsCoprime p q ∧ max p.natDegree q.natDegree = d ∧
    ∀ z : ℂ, A.HasEigenvalue z →
      q.eval z ≠ 0 ∧ p.eval z = star z * q.eval z}

/-- If the eigenvalues of an operator are collinear or concyclic and there are at least
four distinct eigenvalues, then its McMillan degree is one.
This is Theorem 4.8.1 (1) of [liesen2013krylov].

The book states the result for diagonalizable matrices. The degree here depends only
on the set of eigenvalues, so the proof applies to every finite-dimensional operator
with the stated spectrum.

**Reading.** No diagonalizability assumption for the spectral interpolation criterion.
-/
theorem theorem_4_8_1_one [FiniteDimensional ℂ V] (A : Module.End ℂ V)
    (hcard : 4 ≤ (finite_hasEigenvalue A).toFinset.card)
    (hshape :
      (∃ c w : ℂ, w ≠ 0 ∧ ∀ z, A.HasEigenvalue z → ∃ t : ℝ, z = c + (t : ℂ) * w) ∨
      (∃ c : ℂ, ∃ r : ℝ, 0 < r ∧ ∀ z, A.HasEigenvalue z → ‖z - c‖ = r)) :
    mcmillanDegree A = 1 := by
  let S := {d : ℕ | ∃ p q : ℂ[X], q ≠ 0 ∧ IsCoprime p q ∧ max p.natDegree q.natDegree = d ∧
    ∀ z : ℂ, A.HasEigenvalue z → q.eval z ≠ 0 ∧ p.eval z = star z * q.eval z}
  change sInf S = 1
  have hOne : 1 ∈ S := by
    rcases hshape with ⟨c, w, hw, hline⟩ | ⟨c, r, hr, hsphere⟩
    · let β := star w / w
      have hβ : β ≠ 0 := div_ne_zero (star_ne_zero.mpr hw) hw
      have hβw : β * w = star w := div_mul_cancel₀ _ hw
      let p : ℂ[X] := C β * X + C (star c - β * c)
      refine ⟨p, 1, one_ne_zero, isCoprime_one_right, ?_, ?_⟩
      · have hdeg : p.natDegree = 1 := natDegree_linear hβ
        rw [hdeg, natDegree_one]
        decide
      · intro z hz
        obtain ⟨t, ht⟩ := hline z hz
        have htstar : star (t : ℂ) = t := Complex.conj_ofReal t
        refine ⟨by simp, ?_⟩
        simp only [p, eval_add, eval_mul, eval_X, eval_C, eval_one, mul_one, ht, star_add,
          star_mul, htstar]
        calc
          _ = (β * w) * (t : ℂ) + star c := by ring
          _ = _ := by rw [hβw]; ring
    · let R : ℂ := (r : ℂ) ^ 2
      let q : ℂ[X] := X - C c
      let p : ℂ[X] := C (star c) * q + C R
      have hR : R ≠ 0 := pow_ne_zero _ (Complex.ofReal_ne_zero.mpr hr.ne')
      have hCop : IsCoprime (C R) q := ⟨C R⁻¹, 0, by
        rw [zero_mul, add_zero, ← map_mul, inv_mul_cancel₀ hR, map_one]⟩
      have hP : p.natDegree ≤ 1 := by
        have hform : p = C (star c) * X + C (R - star c * c) := by
          simp only [p, q, mul_sub, ← map_mul, map_sub]
          abel
        rw [hform]
        exact natDegree_linear_le
      refine ⟨p, q, X_sub_C_ne_zero c, hCop.mul_add_right_left (C (star c)), ?_, ?_⟩
      · rw [show q.natDegree = 1 from natDegree_X_sub_C c, max_eq_right hP]
      · intro z hz
        have hnorm := hsphere z hz
        have hq : z - c ≠ 0 := by
          intro hzero
          rw [hzero, norm_zero] at hnorm
          exact hr.ne' hnorm.symm
        have hprod : star (z - c) * (z - c) = R := by
          change (starRingEnd ℂ) (z - c) * (z - c) = _
          rw [Complex.conj_mul', hnorm]
        refine ⟨by simpa [q] using hq, ?_⟩
        simp only [p, q, eval_add, eval_mul, eval_C, eval_sub, eval_X]
        rw [← hprod, star_sub]
        ring
  have hZero : 0 ∉ S := by
    rintro ⟨p, q, -, -, hpq, heval⟩
    obtain ⟨a, ha, b, hb, hne⟩ := Finset.one_lt_card.1
      (show 1 < (finite_hasEigenvalue A).toFinset.card by omega)
    have hmem (z : ℂ) : z ∈ (finite_hasEigenvalue A).toFinset ↔ A.HasEigenvalue z :=
      (finite_hasEigenvalue A).mem_toFinset
    have hpa : p = C (p.coeff 0) := eq_C_of_natDegree_eq_zero (by
      exact Nat.eq_zero_of_le_zero ((le_max_left _ _).trans_eq hpq))
    have hqa : q = C (q.coeff 0) := eq_C_of_natDegree_eq_zero (by
      exact Nat.eq_zero_of_le_zero ((le_max_right _ _).trans_eq hpq))
    obtain ⟨hq0, hEvalA⟩ := heval a ((hmem a).1 ha)
    have hEvalB := (heval b ((hmem b).1 hb)).2
    rw [hpa, hqa, eval_C, eval_C] at hEvalA hEvalB
    rw [hqa, eval_C] at hq0
    exact hne (star_injective (mul_right_cancel₀ hq0 (hEvalA.symm.trans hEvalB)))
  have hinf : sInf S ∈ S := Nat.sInf_mem ⟨1, hOne⟩
  have hbound := Nat.sInf_le hOne
  by_contra hne
  exact hZero (show 0 ∈ S from (show sInf S = 0 by omega) ▸ hinf)

end Rational

section Generalized

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [FiniteDimensional 𝕜 E]

/-- The generalized Krylov space at layer one is the span of the start $b$. Each subsequent
space includes the images of the preceding space under $A$ and $A^*$. Layer zero is zero.
This is the sequence of subspaces in Section 4.8.3 of [liesen2013krylov]. -/
noncomputable def generalizedKrylovSubspace (A : Module.End 𝕜 E) (b : E) : ℕ → Submodule 𝕜 E
  | 0 => ⊥
  | 1 => 𝕜 ∙ b
  | n + 2 =>
    let L := generalizedKrylovSubspace A b (n + 1)
    L ⊔ L.map A ⊔ L.map A.adjoint

/-- To build the next generalized Lanczos layer, process each vector $y$ in the current layer.
Apply $A$ and then $A^*$ to $y$. For each result subtract its orthogonal projection
onto the span of the previous and current layers together with the vectors already
accepted in the next layer. Append each nonzero residual in order.
An empty current layer produces an empty next layer. -/
noncomputable def generalizedLanczosLayer (A : Module.End 𝕜 E) (previous current : List E) :
    List E := by
  classical
  exact current.foldl (fun layer y => [A y, A.adjoint y].foldl (fun accumulated w =>
    let L := Submodule.span 𝕜 {z : E | z ∈ previous ++ current ++ accumulated}
    let r := w - L.starProjection w
    if r = 0 then accumulated else accumulated ++ [r]) layer) []

/-- The generalized Lanczos process starts with the single nonzero vector $b$ and builds each
next layer by orthogonalizing $Ay$ and $A^*y$ for vectors $y$ in the current layer.
Layer zero is empty and an empty new layer ends the process. This is Algorithm 4.8.2
of [liesen2013krylov].

**Reading.** The layer predicate records the recurrence and extends the sequence by empty
layers upon termination. -/
def IsGeneralizedLanczos (A : Module.End 𝕜 E) (b : E) (layer : ℕ → List E) : Prop :=
  b ≠ 0 ∧ layer 0 = [] ∧ layer 1 = [b] ∧
    ∀ n : ℕ, layer (n + 2) = generalizedLanczosLayer A (layer n) (layer (n + 1))

end Generalized
end LiesenStrakos
