import Numlib.Optimization.InexactNewton
import NumlibSurface.CartisGouldToint.Chapter03.Section01

/-!
# The class of second-order methods

Class M is a property of deterministic rules acting on finite second-order oracle transcripts.
Execution includes finite internal trial queries and is recursive, so membership cannot be
obtained by choosing an unrelated sequence.
The preliminary estimates concern individual genuine shifted inexact Newton steps.
-/
noncomputable section
namespace CartisGouldToint.Chapter03.Section05
open InnerProductSpace Optimization Optimization.InexactNewton
open Chapter02.Section01 Chapter03.Section01
variable {n : ℕ}

/-- Conditions (3.5.1)–(3.5.4) with fixed constants, along the actual recursive execution.
Only prefixes before the first successful gradient test are constrained. Every active
internal execution must halt against the actual objective; no divergent fallback is accepted. -/
def secondOrderRunConditions (A : Method (EuclideanSpace ℝ (Fin n)))
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (epsilon : ℝ)
    (x0 : EuclideanSpace ℝ (Fin n)) (rg rs kl : ℝ) : Prop :=
  ∀ k : ℕ, (∀ j ≤ k, epsilon < ‖gradient f (state A f epsilon x0 j).1‖) →
    let x := (state A f epsilon x0 k).1
    let d := decisionAt A f epsilon x0 k
    Halts A f epsilon ((state A f epsilon x0 k).2 ++ [oracle f x]) ∧
    d.step ≠ 0 ∧
    IsStep (TrustRegionSecondOrder.hessianOperator f x) (gradient f x)
      d.step d.residual d.shift rg rs ∧
    (∀ u, 0 ≤ inner ℝ (TrustRegionSecondOrder.hessianOperator f x u) u +
      d.shift * ‖u‖ ^ 2) ∧
    TrustRegionSecondOrder.curvature f x + d.shift ≤
      kl * max |TrustRegionSecondOrder.curvature f x| (Real.sqrt ‖gradient f x‖)

/-- The literal class-M conditions for a method applied to a fixed objective from a given
initial point. The residual and multiplier constants are independent of the iteration index.
The iterates are generated by the deterministic rule, rather than supplied as a certificate. -/
def secondOrderMethodClass (A : Method (EuclideanSpace ℝ (Fin n)))
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (epsilon : ℝ)
    (x0 : EuclideanSpace ℝ (Fin n)) : Prop :=
  ∃ rg rs kl : ℝ, 0 ≤ rg ∧ rg < 1 ∧ 0 < rs ∧ 1 < kl ∧
    secondOrderRunConditions A f epsilon x0 rg rs kl

/-- An additional uniform version of class-M membership. For each fixed pair of smoothness
bounds, the same constants work for every eligible objective, starting point and tolerance.
This uniformity strengthens the literal source definition and must be stated separately
when required by a complexity lower bound over a family of objectives. -/
def uniformSecondOrderMethodClass (A : Method (EuclideanSpace ℝ (Fin n))) : Prop :=
  ∀ Lg LH : ℝ, 1 ≤ Lg → 1 ≤ LH →
    ∃ rg rs kl : ℝ, 0 ≤ rg ∧ rg < 1 ∧ 0 < rs ∧ 1 < kl ∧
    ∀ (f : EuclideanSpace ℝ (Fin n) → ℝ),
      assumption_f_Bb f → assumption_f_gL f Lg → hessianLipschitz f LH →
      ∀ (epsilon : ℝ), 0 < epsilon → ∀ (x0 : EuclideanSpace ℝ (Fin n)),
        secondOrderRunConditions A f epsilon x0 rg rs kl

/-- Uniform membership specializes to the literal class-M conditions for every eligible
objective and positive stopping tolerance. -/
theorem uniformSecondOrderMethodClass.membership
    {A : Method (EuclideanSpace ℝ (Fin n))} (h : uniformSecondOrderMethodClass A)
    {f : EuclideanSpace ℝ (Fin n) → ℝ} {Lg LH epsilon : ℝ}
    (hBb : assumption_f_Bb f) (hg : assumption_f_gL f Lg)
    (hf : hessianLipschitz f LH) (hepsilon : 0 < epsilon)
    (x0 : EuclideanSpace ℝ (Fin n)) : secondOrderMethodClass A f epsilon x0 := by
  obtain ⟨rg, rs, kl, hrg0, hrg1, hrs, hkl, hsteps⟩ := h Lg LH hg.2.1 hf.one_le
  exact ⟨rg, rs, kl, hrg0, hrg1, hrs, hkl, hsteps f hBb hg hf epsilon hepsilon x0⟩

/-- Corrected explicit constant in Lemma 3.5.1: the quantity under the square root is the
step-proportional upper bound `b`, rather than the self-referential printed `κλ`.
Appendix B.3.5 uses `b * (1 + rg)` in its defining quadratic. -/
theorem lemma_3_5_1_corrected
    {f : EuclideanSpace ℝ (Fin n) → ℝ} {x s r : EuclideanSpace ℝ (Fin n)}
    {lambda rg rs b : ℝ}
    (h : IsStep (TrustRegionSecondOrder.hessianOperator f x) (gradient f x)
      s r lambda rg rs) (hrg : 0 ≤ rg) (_hrg1 : rg < 1) (_hrs : 0 < rs) (hb : 1 < b) (hs : s ≠ 0)
    (hpsd : ∀ u, 0 ≤ inner ℝ (TrustRegionSecondOrder.hessianOperator f x u) u +
      lambda * ‖u‖ ^ 2) (hl : lambda ≤ b * ‖s‖) :
    TrustRegionSecondOrder.curvature f x + lambda ≤
      (2 * Real.sqrt (b * (1 + rg))) *
        max |TrustRegionSecondOrder.curvature f x| (Real.sqrt ‖gradient f x‖) := by
  let : Nontrivial (EuclideanSpace ℝ (Fin n)) := ⟨⟨s, 0, hs⟩⟩
  let B := fderiv ℝ (fderiv ℝ f) x
  let mu := leastCurvature B
  have hmu : ∀ u, mu * ‖u‖ ^ 2 ≤
      inner ℝ (TrustRegionSecondOrder.hessianOperator f x u) u := by
    intro u
    rw [TrustRegionSecondOrder.hessianOperator, continuousLinearMapOfBilin_apply]
    exact (le_leastCurvature_iff B mu).mp le_rfl u
  have hneg : -lambda ≤ leastCurvature B := by
    apply (le_leastCurvature_iff B (-lambda)).mpr
    intro u
    have hh := hpsd u
    rw [TrustRegionSecondOrder.hessianOperator, continuousLinearMapOfBilin_apply] at hh
    linarith
  have hquad := h.shift_quadratic_le hs hmu (by dsimp [mu]; linarith) (by linarith) hl
  apply shift_bound_of_quadratic (by nlinarith : 1 ≤ b * (1 + rg)) (norm_nonneg _)
  exact hquad

/-- Lemma 3.5.2 with the printed inverse coefficient. This follows from the stronger inverse
square-root bound because (3.5.6) requires `b > 1`, so the coefficient's denominator exceeds
one. No correction of the numbered statement is needed. -/
theorem lemma_3_5_2
    {f : EuclideanSpace ℝ (Fin n) → ℝ} {Lg L lambda rg rs b : ℝ}
    {x s r : EuclideanSpace ℝ (Fin n)}
    (_hBb : assumption_f_Bb f) (_hg : assumption_f_gL f Lg)
    (hf : hessianLipschitz f L)
    (h : IsStep (TrustRegionSecondOrder.hessianOperator f x) (gradient f x)
      s r lambda rg rs) (_hrg0 : 0 ≤ rg) (_hrg1 : rg < 1)
    (hrs : 0 < rs) (hb : 1 < b) (hl : lambda ≤ b * ‖s‖) :
    (L / 2 + rs + b)⁻¹ * Real.sqrt ‖gradient f (x + s)‖ ≤ ‖s‖ := by
  let C := L / 2 + rs + b
  have hC : 1 ≤ C := by dsimp [C]; linarith [hf.nonneg]
  have hquad := h.next_gradient_le hf.toHessianLipschitz hl
  have hstrong := sqrt_gradient_le_step (by linarith : 0 < C)
    (norm_nonneg s) hquad
  have hsqrt : Real.sqrt C ≤ C := by
    nlinarith [Real.sq_sqrt (show 0 ≤ C by linarith), Real.sqrt_nonneg C]
  have hi : C⁻¹ ≤ (Real.sqrt C)⁻¹ :=
    (inv_le_inv₀ (show 0 < C by linarith)
      (Real.sqrt_pos.mpr (show 0 < C by linarith))).mpr hsqrt
  exact (mul_le_mul_of_nonneg_right hi (Real.sqrt_nonneg _)).trans hstrong

/-- Lemma 3.5.3. The nonnegative multipliers inherited from (3.5.3) are explicit; an upper
bound on unrestricted signed multipliers would not bound the shifted Hessian norm.
The lower-bound constant is uniform over the sequence. -/
theorem lemma_3_5_3
    {f : EuclideanSpace ℝ (Fin n) → ℝ} {Lg L rg rs b c : ℝ}
    {x s r : ℕ → EuclideanSpace ℝ (Fin n)} {lambda : ℕ → ℝ}
    (_hBb : assumption_f_Bb f) (hg : assumption_f_gL f Lg)
    (_hf : hessianLipschitz f L) (_hrg0 : 0 ≤ rg) (hrg : rg < 1)
    (_hrs : 0 < rs) (hb : 0 < b) (hc : 0 < c)
    (h : ∀ k, IsStep (TrustRegionSecondOrder.hessianOperator f (x k))
      (gradient f (x k)) (s k) (r k) (lambda k) rg rs)
    (hl : ∀ k, lambda k ≤ b)
    (_hiter : ∀ k, x (k + 1) = x k + s k)
    (hconv : ∀ k, ‖gradient f (x (k + 1))‖ ≤ c * ‖gradient f (x k)‖ ^ 2) :
    ∃ C : ℝ, 0 < C ∧ ∀ k, C * Real.sqrt ‖gradient f (x (k + 1))‖ ≤ ‖s k‖ := by
  let D := (Lg + b) / (1 - rg)
  have hD : 0 < D := div_pos (by linarith [hg.2.1]) (sub_pos.mpr hrg)
  have hC : 0 < c * D ^ 2 := mul_pos hc (sq_pos_of_pos hD)
  refine ⟨(Real.sqrt (c * D ^ 2))⁻¹, inv_pos.mpr (Real.sqrt_pos.mpr hC), ?_⟩
  intro k
  have hgrad := (h k).gradient_le hrg
    (norm_hessianOperator_le (by linarith [hg.2.1]) hg.2.2 (x k)) (hl k)
  have hsq : ‖gradient f (x k)‖ ^ 2 ≤ (D * ‖s k‖) ^ 2 := by
    have hp : 0 ≤ D * ‖s k‖ := mul_nonneg hD.le (norm_nonneg _)
    nlinarith [norm_nonneg (gradient f (x k))]
  have hnext : ‖gradient f (x (k + 1))‖ ≤ (c * D ^ 2) * ‖s k‖ ^ 2 := by
    have hh := mul_le_mul_of_nonneg_left hsq hc.le
    nlinarith [hconv k]
  exact sqrt_gradient_le_step hC (norm_nonneg _) hnext

end CartisGouldToint.Chapter03.Section05
