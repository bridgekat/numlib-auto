import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Logic.Equiv.Fin.Basic
import Mathlib.Order.Interval.Finset.Fin

/-!
# Splitting `Fin` at an index

Identify `Fin n` with the index set $\{0, 1, \dots, n - 1\}$. This module gives several ways to cut
such an index set into a head and a tail, each in the form that some matrix argument needs. An index
$i < s + m$ comes from the left summand of $\{0, \dots, s - 1\} \sqcup \{0, \dots, m - 1\}$ when
$i < s$, and from the right summand, shifted by $s$, otherwise; this is the case split behind every
computation with `Matrix.fromBlocks` reindexed along `finSumFinEquiv`. Two bijections $\{0, \dots,
n\} \to \{0, \dots, n - 1\} \sqcup \{*\}$ split off the first or the last index; the second one
gives the column order of an augmented matrix $[A \mid b]$.

For a function $g$ on $\{0, \dots, k - 1\}$, the remaining results split a sum $\sum_{i < k} g_i$ at
an index $j$ into $\sum_{i \le j} g_i + \sum_{j < i < k} g_i$, compare a sum over $k \le a$ indices
with a sum over $a$ indices of the terms below $k$, and drop the terms of a function that vanishes
from some index on. They give the reindexing between `Fin (min m n)` and the indices of a
rectangular diagonal, and the padding of a coefficient vector with zeros.

## Main definitions

* `finSuccEquivSumUnit`: the bijection $\{0, \dots, n\} \to \{0, \dots, n - 1\} \sqcup \{*\}$ that
  sends $0$ to $*$ and $i + 1$ to $i$.
* `finSuccEquivLastSumUnit`: the bijection $\{0, \dots, n\} \to \{0, \dots, n - 1\} \sqcup \{*\}$
  that sends $n$ to $*$ and each $i < n$ to $i$.

## Main results

* `finSumFinEquiv_symm_cases`: an index $i < s + m$ is the index $i$ of the left summand if $i < s$,
  and the index $i - s$ of the right summand if $s \le i$.
* `Fin.sum_eq_sum_castLE_add_sum_Ioi`: for $j < k$, $\sum_{i < k} g_i = \sum_{i \le j} g_i + \sum_{j
  < i < k} g_i$.
* `Fin.sum_castLE_eq_sum_ite`: for $k \le a$, the sum of $g$ over $i < k$ is the sum over $i < a$ of
  the terms $g_i$ with $i < k$.
* `Fin.sum_eq_sum_castLE_of_forall_le`: if $m \le k$ and $g_i = 0$ for $i \ge m$, then
  $\sum_{i < k} g_i = \sum_{i < m} g_i$.
* `Fin.sum_dite_lt`: for $k \le a$, the sum over $i < a$ of a function on $\{0, \dots, k - 1\}$
  extended by zero is its sum over $i < k$.

## Implementation notes

* `finSuccEquivSumUnit` and `finSuccEquivLastSumUnit` are the `Sum` forms of Mathlib's
  `finSuccEquiv` and `finSuccEquivLast`. The point $*$ is the summand `Unit` of `Fin n ⊕ Unit`.
* A sum over the leading indices is stated through `Fin.castLE`, which embeds `Fin k` in `Fin a` for
  $k \le a$.
* The four sum lemmas are the additive forms, generated by `to_additive`, of
  `Fin.prod_eq_prod_castLE_mul_prod_Ioi`, `Fin.prod_castLE_eq_prod_ite`,
  `Fin.prod_eq_prod_castLE_of_forall_le` and `Fin.prod_dite_lt`.
-/

open Finset

/-- Let $s, m \in \mathbb{N}$ and $i \in \{0, \dots, s + m - 1\}$. The inverse of `finSumFinEquiv`
sends $i$ to an element of $\{0, \dots, s - 1\} \sqcup \{0, \dots, m - 1\}$, and one of two
cases holds: either $i < s$ and $i$ goes to the index $i$ of the left summand, or $s \le i$ and
$i$ goes to the index $i - s$ of the right summand. -/
theorem finSumFinEquiv_symm_cases {s m : ℕ} (i : Fin (s + m)) :
    (∃ hi : (i : ℕ) < s, finSumFinEquiv.symm i = Sum.inl ⟨i, hi⟩) ∨
      ∃ hi : s ≤ (i : ℕ), finSumFinEquiv.symm i = Sum.inr ⟨i - s, by omega⟩ := by
  by_cases hi : (i : ℕ) < s
  · refine Or.inl ⟨hi, finSumFinEquiv.symm_apply_eq.2 ?_⟩
    rw [finSumFinEquiv_apply_left]
    exact Fin.ext rfl
  · refine Or.inr ⟨not_lt.1 hi, finSumFinEquiv.symm_apply_eq.2 ?_⟩
    rw [finSumFinEquiv_apply_right]
    exact Fin.ext (by simp; omega)

/-- The bijection $\{0, \dots, n\} \to \{0, \dots, n - 1\} \sqcup \{*\}$ that sends $0$ to $*$ and
$i + 1$ to $i$. It is the `Sum` form of Mathlib's `finSuccEquiv`, with the point $*$ the summand
`Unit`. Composed with it, the function `Sum.elim v (fun _ ↦ f)` is `Fin.cons f v`, the vector
$(f, v_0, \dots, v_{n-1})$. -/
def finSuccEquivSumUnit (n : ℕ) : Fin (n + 1) ≃ Fin n ⊕ Unit where
  toFun := Fin.cases (Sum.inr ()) Sum.inl
  invFun := Sum.elim Fin.succ fun _ ↦ 0
  left_inv i := by induction i using Fin.cases <;> simp
  right_inv x := by rcases x with i | ⟨⟩ <;> simp

/-- The bijection `finSuccEquivSumUnit` sends $0$ to the point $*$ of the summand `Unit`. -/
@[simp]
theorem finSuccEquivSumUnit_zero (n : ℕ) : finSuccEquivSumUnit n 0 = Sum.inr () := rfl

/-- The bijection `finSuccEquivSumUnit` sends $i + 1$ to the index $i$ of the left summand. -/
@[simp]
theorem finSuccEquivSumUnit_succ {n : ℕ} (i : Fin n) :
    finSuccEquivSumUnit n i.succ = Sum.inl i := by
  simp [finSuccEquivSumUnit]

/-- The inverse of `finSuccEquivSumUnit` sends the index $i$ of the left summand to $i + 1$. -/
@[simp]
theorem finSuccEquivSumUnit_symm_inl {n : ℕ} (i : Fin n) :
    (finSuccEquivSumUnit n).symm (Sum.inl i) = i.succ := rfl

/-- The inverse of `finSuccEquivSumUnit` sends the point $*$ of the summand `Unit` to $0$. -/
@[simp]
theorem finSuccEquivSumUnit_symm_inr (n : ℕ) (u : Unit) :
    (finSuccEquivSumUnit n).symm (Sum.inr u) = 0 := rfl

/-- The bijection $\{0, \dots, n\} \to \{0, \dots, n - 1\} \sqcup \{*\}$ that sends the last index
$n$ to $*$ and each $i < n$ to $i$. It is the `Sum` form of Mathlib's `finSuccEquivLast`, with
the point $*$ the summand `Unit`. It gives the column order of an augmented matrix $[A \mid b]$:
the columns of $A$ first, then $b$. -/
def finSuccEquivLastSumUnit (n : ℕ) : Fin (n + 1) ≃ Fin n ⊕ Unit where
  toFun i := Fin.lastCases (Sum.inr ()) Sum.inl i
  invFun := Sum.elim Fin.castSucc fun _ => Fin.last n
  left_inv i := by
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
  right_inv x := by
    rcases x with j | u <;> simp

/-- The bijection `finSuccEquivLastSumUnit` sends the last index $n$ to the point $*$ of the summand
`Unit`. -/
@[simp]
theorem finSuccEquivLastSumUnit_last (n : ℕ) :
    finSuccEquivLastSumUnit n (Fin.last n) = Sum.inr () := by
  simp [finSuccEquivLastSumUnit]

/-- The bijection `finSuccEquivLastSumUnit` sends each $i < n$ to the index $i$ of the left summand.
-/
@[simp]
theorem finSuccEquivLastSumUnit_castSucc {n : ℕ} (i : Fin n) :
    finSuccEquivLastSumUnit n i.castSucc = Sum.inl i := by
  simp [finSuccEquivLastSumUnit]

/-- The inverse of `finSuccEquivLastSumUnit` sends the index $i$ of the left summand to $i$. -/
@[simp]
theorem finSuccEquivLastSumUnit_symm_inl {n : ℕ} (i : Fin n) :
    (finSuccEquivLastSumUnit n).symm (Sum.inl i) = i.castSucc := rfl

/-- The inverse of `finSuccEquivLastSumUnit` sends the point $*$ of the summand `Unit` to the last
index $n$. -/
@[simp]
theorem finSuccEquivLastSumUnit_symm_inr (n : ℕ) (u : Unit) :
    (finSuccEquivLastSumUnit n).symm (Sum.inr u) = Fin.last n := rfl

/-- Let $M$ be a commutative monoid, let $j < k$, and let $g \colon \{0, \dots, k - 1\} \to M$. Then
$$\prod_{i < k} g_i = \Bigl(\prod_{i \le j} g_i\Bigr) \cdot \prod_{j < i < k} g_i.$$ The product
over $i \le j$ is the product over `Fin (j + 1)`, read through `Fin.castLE`. -/
@[to_additive /-- Let $M$ be a commutative additive monoid, let $j < k$, and let
$g \colon \{0, \dots, k - 1\} \to M$. Then
$$\sum_{i < k} g_i = \sum_{i \le j} g_i + \sum_{j < i < k} g_i.$$
The sum over $i \le j$ is the sum over `Fin (j + 1)`, read through `Fin.castLE`. -/]
theorem Fin.prod_eq_prod_castLE_mul_prod_Ioi {M : Type*} [CommMonoid M] {k : ℕ}
    (j : Fin k) (g : Fin k → M) :
    ∏ i, g i = (∏ a : Fin (j + 1), g (Fin.castLE j.isLt a)) * ∏ i ∈ Ioi j, g i := by
  rw [← prod_filter_mul_prod_filter_not univ (· ≤ j)]
  congr 1
  · refine (prod_bij (fun a _ => Fin.castLE j.isLt a) (fun a _ => ?_)
      (fun a _ b _ hab => Fin.castLE_injective _ hab) (fun i hi => ?_) (fun _ _ => rfl)).symm
    · simp only [mem_filter, mem_univ, true_and, Fin.le_def, Fin.val_castLE]
      have := a.isLt
      omega
    · simp only [mem_filter, mem_univ, true_and, Fin.le_def] at hi
      exact ⟨⟨i, by omega⟩, mem_univ _, Fin.ext (by simp)⟩
  · refine prod_congr ?_ fun _ _ => rfl
    ext i
    simp

/-- Let $M$ be a commutative monoid, let $k \le a$, and let $g \colon \{0, \dots, a - 1\} \to M$.
Then the product of $g$ over the first $k$ indices is the product over all $a$ indices with the
factors from $k$ on replaced by $1$:
$$\prod_{i < k} g_i = \prod_{i < a} h_i, \qquad
  h_i = \begin{cases} g_i & \text{if } i < k, \\ 1 & \text{if } i \ge k. \end{cases}$$
The product over $i < k$ is the product over `Fin k`, read through `Fin.castLE`. -/
@[to_additive /-- Let $M$ be a commutative additive monoid, let $k \le a$, and let
$g \colon \{0, \dots, a - 1\} \to M$. Then the sum of $g$ over the first $k$ indices is the sum
over all $a$ indices with the terms from $k$ on replaced by $0$:
$$\sum_{i < k} g_i = \sum_{i < a} h_i, \qquad
  h_i = \begin{cases} g_i & \text{if } i < k, \\ 0 & \text{if } i \ge k. \end{cases}$$
The sum over $i < k$ is the sum over `Fin k`, read through `Fin.castLE`. This is the reindexing
between `Fin (min m n)` and the indices of a rectangular diagonal. -/]
theorem Fin.prod_castLE_eq_prod_ite {M : Type*} [CommMonoid M] {k a : ℕ} (hk : k ≤ a)
    (g : Fin a → M) :
    ∏ i : Fin k, g (Fin.castLE hk i) = ∏ i : Fin a, if (i : ℕ) < k then g i else 1 := by
  classical
  set g' : ℕ → M := fun j => if h : j < a then g ⟨j, h⟩ else 1 with hg'
  have h1 : ∀ i : Fin k, g (Fin.castLE hk i) = g' i := fun i => by
    simp [hg', Fin.castLE, lt_of_lt_of_le i.isLt hk]
  have h2 : ∀ i : Fin a, (if (i : ℕ) < k then g i else 1) = if (i : ℕ) < k then g' i else 1 :=
    fun i => by simp [hg', i.isLt]
  simp_rw [h1, h2]
  rw [Fin.prod_univ_eq_prod_range (fun i => g' i) k,
    Fin.prod_univ_eq_prod_range (fun i => if i < k then g' i else 1) a, ← Finset.prod_filter]
  congr 1
  ext j
  simp only [Finset.mem_range, Finset.mem_filter]
  omega

/-- Let $M$ be a commutative monoid, let $m \le k$, and let $g \colon \{0, \dots, k - 1\} \to M$
satisfy $g_i = 1$ for every $i \ge m$. Then $$\prod_{i < k} g_i = \prod_{j < m} g_j.$$ The
product over $j < m$ is the product over `Fin m`, read through `Fin.castLE`. -/
@[to_additive /-- Let $M$ be a commutative additive monoid, let $m \le k$, and let
$g \colon \{0, \dots, k - 1\} \to M$ satisfy $g_i = 0$ for every $i \ge m$. Then
$$\sum_{i < k} g_i = \sum_{j < m} g_j.$$
The sum over $j < m$ is the sum over `Fin m`, read through `Fin.castLE`. -/]
theorem Fin.prod_eq_prod_castLE_of_forall_le {M : Type*} [CommMonoid M] {m k : ℕ} (h : m ≤ k)
    (g : Fin k → M) (hg : ∀ i : Fin k, m ≤ (i : ℕ) → g i = 1) :
    ∏ i, g i = ∏ j : Fin m, g (Fin.castLE h j) := by
  rw [Fin.prod_castLE_eq_prod_ite h]
  refine prod_congr rfl fun i _ => ?_
  split_ifs with hi
  · rfl
  · exact hg i (not_lt.1 hi)

/-- Let $M$ be a commutative monoid, let $k \le a$, and let $g \colon \{0, \dots, k - 1\} \to M$.
Extend $g$ to $\{0, \dots, a - 1\}$ by $1$. Then the product of the extension over $i < a$ is
$\prod_{j < k} g_j$. -/
@[to_additive /-- Let $M$ be a commutative additive monoid, let $k \le a$, and let
$g \colon \{0, \dots, k - 1\} \to M$. Extend $g$ to $\{0, \dots, a - 1\}$ by $0$. Then the sum of
the extension over $i < a$ is $\sum_{j < k} g_j$. This is the padding of a coefficient vector with
zeros. -/]
theorem Fin.prod_dite_lt {M : Type*} [CommMonoid M] {k a : ℕ} (hk : k ≤ a) (g : Fin k → M) :
    ∏ i : Fin a, (if h : (i : ℕ) < k then g ⟨i, h⟩ else 1) = ∏ j, g j := by
  rw [Fin.prod_univ_eq_prod_range (fun n => if h : n < k then g ⟨n, h⟩ else 1) a,
    Finset.prod_fin_eq_prod_range g]
  refine (Finset.prod_subset (Finset.range_mono hk) fun n _ hn => ?_).symm
  rw [Finset.mem_range] at hn
  simp [hn]
