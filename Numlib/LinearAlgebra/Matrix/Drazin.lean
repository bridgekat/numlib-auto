import Numlib.Algebra.Group.Drazin
import Numlib.Algebra.Polynomial.Commute
import Numlib.LinearAlgebra.Matrix.RankStabilization
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Polynomial Drazin inverses of matrices

At a rank-stabilizing exponent $k$, the equation $A^{k+1}Y=A^k$ has a solution in
the algebra generated by $A$. Consequently $A^k Y^{k+1}$ is a Drazin inverse and a polynomial
in $A$.
-/

namespace Matrix

open Module Polynomial

variable {n K : Type*} [Field K] [Fintype n] [DecidableEq n]

omit [DecidableEq n] in
private theorem mul_eq_zero_iff_cols_mem_ker (A B : Matrix n n K) :
    A * B = 0 ↔ ∀ j, B.col j ∈ LinearMap.ker A.mulVecLin := by
  simp only [LinearMap.mem_ker, mulVecLin_apply, ← col_mul_eq_mulVec_col]
  constructor
  · intro h j
    rw [h]
    rfl
  · intro h
    ext i j
    exact congrFun (h j) i

/-- When successive powers have equal ranks, $A^{k+1}p(A)=A^k$ for some polynomial $p$. -/
theorem exists_aeval_mul_pow_eq (A : Matrix n n K) {k : ℕ}
    (h : (A ^ k).rank = (A ^ (k + 1)).rank) :
    ∃ p : K[X], A ^ (k + 1) * aeval A p = A ^ k := by
  let S := Algebra.adjoin K ({A} : Set (Matrix n n K))
  let a : S := ⟨A, Algebra.subset_adjoin (Set.mem_singleton A)⟩
  let f := LinearMap.mulLeft K (a ^ k)
  let g := LinearMap.mulLeft K (a ^ (k + 1))
  have hker := (A.rank_pow_eq_iff_ker_eq (Nat.le_succ k)).mp h
  have hzero (j : ℕ) (Y : S) :
      a ^ j * Y = 0 ↔ A ^ j * (Y : Matrix n n K) = 0 := by
    constructor
    · intro hY
      exact congrArg (fun z : S => (z : Matrix n n K)) hY
    · intro hY
      exact Subtype.ext hY
  have hfg : LinearMap.ker f = LinearMap.ker g := by
    ext Y
    simp only [LinearMap.mem_ker, f, g, LinearMap.mulLeft_apply, hzero,
      mul_eq_zero_iff_cols_mem_ker, hker]
  have hle : LinearMap.range g ≤ LinearMap.range f := by
    rintro _ ⟨Y, rfl⟩
    refine ⟨a * Y, ?_⟩
    change a ^ k * (a * Y) = a ^ (k + 1) * Y
    rw [pow_succ, mul_assoc]
  have hdim : finrank K (LinearMap.range g) = finrank K (LinearMap.range f) := by
    have hf := LinearMap.finrank_range_add_finrank_ker f
    have hg := LinearMap.finrank_range_add_finrank_ker g
    rw [hfg] at hf
    omega
  have hRange := Submodule.eq_of_le_of_finrank_eq hle hdim
  obtain ⟨Y, hY⟩ : f 1 ∈ LinearMap.range g := by
    rw [hRange]
    exact LinearMap.mem_range_self f 1
  have hmem : (Y : Matrix n n K) ∈ Algebra.adjoin K ({A} : Set (Matrix n n K)) := Y.property
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hmem
  obtain ⟨p, hp⟩ := hmem
  have hpow : a ^ (k + 1) * Y = a ^ k := by
    change a ^ (k + 1) * Y = a ^ k * 1 at hY
    rwa [mul_one] at hY
  exact ⟨p, hp ▸ congrArg (fun z : S => (z : Matrix n n K)) hpow⟩

/-- A square matrix at a rank-stabilizing exponent has a unique Drazin inverse, which
is expressible as a polynomial in the matrix. -/
theorem existsUnique_isDrazinInverseAt (A : Matrix n n K) {k : ℕ}
    (h : (A ^ k).rank = (A ^ (k + 1)).rank) :
    ∃! X, IsDrazinInverseAt k A X ∧ ∃ p : K[X], X = aeval A p := by
  obtain ⟨p, hp⟩ := A.exists_aeval_mul_pow_eq h
  have hx := IsDrazinInverseAt.of_commute_pow ((Commute.refl A).aeval_right p) hp
  refine ⟨A ^ k * aeval A p ^ (k + 1), ⟨hx, ?_⟩, fun _ hy => hy.1.unique hx⟩
  refine ⟨X ^ k * p ^ (k + 1), ?_⟩
  simp only [map_mul, map_pow, aeval_X]

end Matrix
