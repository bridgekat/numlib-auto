import Numlib.LinearAlgebra.Matrix.Hessenberg
import Numlib.Krylov.ToEuclideanLin
import Numlib.Krylov.Convergence.Functional
import Mathlib.Data.Nat.Dist

/-!
# Exponential decay of inverses of positive-definite tridiagonal matrices

Matrix powers have their exact finite propagation range, hence early Krylov
vectors have zero sufficiently distant coordinates. The Chebyshev bound on an
actual minimal-residual approximation then bounds the distant inverse entry.
The scalar-spectrum case is included without a positive decay-factor premise.
-/

open scoped BigOperators
namespace Matrix
variable {N : ℕ}
section Powers
variable {R : Type*} [Semiring R]

/-- The kth power of a tridiagonal matrix has lower and upper bandwidth at most k, including the
  identity power. -/
theorem tridiagonal_pow_bandwidth {A : Matrix (Fin N) (Fin N) R}
    (hA : A.IsTridiagonal) (k : ℕ) :
    (A ^ k).HasLowerBandwidth k ∧ (A ^ k).HasUpperBandwidth k := by
  induction k with
  | zero =>
    constructor
    · apply hasLowerBandwidth_iff_fin.mpr
      intro i j hij
      simp only [pow_zero]
      exact one_apply_ne (by intro hh; subst j; omega)
    · apply hasUpperBandwidth_iff_fin.mpr
      intro i j hij
      simp only [pow_zero]
      exact one_apply_ne (by intro hh; subst j; omega)
  | succ k hk =>
    obtain ⟨hL, hU⟩ := isTridiagonal_iff_hasBandwidth_one.mp hA
    rw [pow_succ]
    exact ⟨hk.1.mul hL, hk.2.mul hU⟩

/-- A tridiagonal matrix power has zero entries whenever the natural index distance exceeds the
  power. -/
theorem tridiagonal_pow_entry_zero {A : Matrix (Fin N) (Fin N) R}
    (hA : A.IsTridiagonal) (k : ℕ) (i j : Fin N) (hk : k < Nat.dist i.val j.val) :
    (A ^ k) i j = 0 := by
  obtain ⟨hL, hU⟩ := tridiagonal_pow_bandwidth hA k
  by_cases hij : i.val ≤ j.val
  · apply hasUpperBandwidth_iff_fin.mp hU i j
    rw [Nat.dist_eq_sub_of_le hij] at hk
    omega
  · apply hasLowerBandwidth_iff_fin.mp hL i j
    rw [Nat.dist_comm, Nat.dist_eq_sub_of_le (by omega)] at hk
    omega

end Powers

variable {𝕜 : Type*} [RCLike 𝕜]

/-- Every vector in the first m Krylov directions generated by a coordinate unit vector has zero
  coordinate i when m is at most the natural distance from i to the starting index. -/
theorem tridiagonal_krylov_coordinate_zero {A : Matrix (Fin N) (Fin N) 𝕜}
    (hA : A.IsTridiagonal) (i j : Fin N) (m : ℕ) (hm : m ≤ Nat.dist i.val j.val)
    {x : EuclideanSpace 𝕜 (Fin N)}
    (hx : x ∈ Krylov.subspace (toEuclideanLin A) (PiLp.single 2 j (1 : 𝕜)) m) : x i = 0 := by
  rw [krylov_subspace_toEuclideanLin] at hx
  let K : Submodule 𝕜 (EuclideanSpace 𝕜 (Fin N)) :=
    LinearMap.ker ((EuclideanSpace.proj i).toLinearMap)
  have hspan : Submodule.span 𝕜
      (Set.range fun k : Fin m => toEuclideanLin (A ^ (k : ℕ)) (PiLp.single 2 j (1 : 𝕜))) ≤ K
        := by
    apply Submodule.span_le.mpr
    rintro y ⟨k, rfl⟩
    change (toEuclideanLin (A ^ (k : ℕ)) (PiLp.single 2 j (1 : 𝕜))) i = 0
    change ((A ^ (k : ℕ)) *ᵥ Pi.single j (1 : 𝕜)) i = 0
    simpa [mulVec_single] using
      tridiagonal_pow_entry_zero hA k i j (lt_of_lt_of_le k.isLt hm)
  exact hspan hx

end Matrix

namespace Matrix
variable {𝕜 : Type*} [RCLike 𝕜] {N : ℕ}

/-- The ordinary inverse of a tridiagonal matrix has the sharp Chebyshev
entry-decay bound from its enclosing positive spectral interval. The estimate
uses an actual minimal-residual approximation and includes equal endpoints. -/
theorem inverse_entry_decay {A : Matrix (Fin N) (Fin N) 𝕜}
    (htri : A.IsTridiagonal) (hunit : IsUnit A) {lo hi : ℝ}
    (hlo : 0 < lo) (hle : lo ≤ hi)
    (hA : (toEuclideanLin A).IsSymmetricBoundedBy lo hi) (i j : Fin N) :
    ‖A⁻¹ i j‖ ≤ 2 / lo * ((Real.sqrt (hi / lo) - 1) / (Real.sqrt (hi / lo) + 1)) ^
      (Nat.dist i.val j.val) := by
  let b : EuclideanSpace 𝕜 (Fin N) := PiLp.single 2 j (1 : 𝕜)
  let z : EuclideanSpace 𝕜 (Fin N) := toEuclideanLin A⁻¹ b
  let φ : EuclideanSpace 𝕜 (Fin N) →ₗ[𝕜] 𝕜 := (EuclideanSpace.proj i).toLinearMap
  have hstar : toEuclideanLin A z = b := toEuclideanLin_mul_nonsing_inv_apply hunit b
  have hb : ‖b‖ = 1 := by simp [b]
  have hz : φ z = A⁻¹ i j := by
    change (A⁻¹ *ᵥ Pi.single j (1 : 𝕜)) i = _
    simp [mulVec_single]
  have hφ : ∀ v, ‖φ v‖ ≤ (1 : ℝ) * ‖v‖ := fun v => by
    change ‖v i‖ ≤ (1 : ℝ) * ‖v‖
    simpa only [one_mul] using PiLp.norm_apply_le v i
  have hvan : ∀ v ∈ Krylov.subspace (toEuclideanLin A) b (Nat.dist i.val j.val), φ v = 0 :=
    fun v hv => tridiagonal_krylov_coordinate_zero htri i j _ le_rfl hv
  have hh := Krylov.functional_solution_decay hlo hle zero_le_one hA φ hφ b z hstar _ hvan
  simpa only [hz, hb, one_mul, mul_one] using hh

end Matrix
