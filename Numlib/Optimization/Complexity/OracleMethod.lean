import Mathlib.Analysis.Calculus.ContDiff.FTaylorSeries
import Mathlib.Data.Fin.Tuple.Basic

/-!
# Oracle methods

An oracle method is a deterministic method that accesses the objective only through an oracle: the
next iterate is a function of the oracle answers at all previous iterates. This is the setting of
Section 1.2.4 of [cartis2022evaluation], of the class $\mathcal{M}$ of its Section 3.5, and of the
classes $\mathcal{M}(p)$ and $\mathcal{M}_{\mathrm{ZR}}(p)$ of its Section 4.2. Oracle methods are
used to state lower bounds of the form "for every method in a class there is a hard function". The
key fact is the resisting-oracle principle: two oracles that give the same answers at the iterates
generated by the first one generate the same iterates.

For a function $f$ on a real normed space and an order $p$, the $p$-th order oracle answers with the
derivatives $(f(x), \nabla f(x), \dots, \nabla^p f(x))$.

## Main definitions

* `Optimization.OracleMethod`: an initial point $x_0$ and, for each $k$, a map from the answers
  $(O(x_0), \dots, O(x_k))$ to the next iterate $x_{k+1}$.
* `Optimization.OracleMethod.iterate`: the $k$-th iterate $x_k$ generated with the oracle $O$.
* `Optimization.jetOracle`: the $p$-th order oracle $x \mapsto (f(x), \nabla f(x), \dots, \nabla^p
  f(x))$.
* `Optimization.jetSeries` and `Optimization.jetValue`: the Taylor data and the function value read
  off an answer of the $p$-th order oracle.

## Main results

* `Optimization.OracleMethod.iterate_succ`: $x_{k+1} = \mathrm{next}_k(O(x_0), \dots, O(x_k))$.
* `Optimization.OracleMethod.iterate_congr`: the resisting-oracle principle.

## Implementation notes

* A method that also depends on its previous iterates needs no separate treatment: the previous
  iterates are themselves functions of the previous answers.
-/

namespace Optimization

/-- A **deterministic oracle method** on $E$ with oracle answers in $I$ consists of an initial point
$x_0 \in E$ and, for each iteration $k$, a map $\mathrm{next}_k \colon I^{k+1} \to E$ from the
oracle answers at the iterates $x_0, \dots, x_k$ to the next iterate $x_{k+1}$. -/
structure OracleMethod (E I : Type*) where
  /-- The initial point $x_0$. -/
  x₀ : E
  /-- The map from the answers $(O(x_0), \dots, O(x_k))$ to the next iterate $x_{k+1}$. -/
  next : (k : ℕ) → (Fin (k + 1) → I) → E

namespace OracleMethod

variable {E I : Type*} (M : OracleMethod E I) (O O' : E → I)

/-- The trajectory $(x_0, \dots, x_k)$ generated by the method $M$ with the oracle
$O \colon E \to I$: $x_0$ is the initial point, and $x_{k+1} = \mathrm{next}_k(O(x_0), \dots,
O(x_k))$. -/
def trajectory (M : OracleMethod E I) (O : E → I) : (k : ℕ) → Fin (k + 1) → E
  | 0 => fun _ => M.x₀
  | k + 1 => Fin.snoc (trajectory M O k) (M.next k fun i => O (trajectory M O k i))

/-- The $k$-th iterate $x_k$ generated by the method $M$ with the oracle $O$, the last entry of the
trajectory $(x_0, \dots, x_k)$. -/
def iterate (k : ℕ) : E := M.trajectory O k (Fin.last k)

/-- The iterate $x_0$ is the initial point of the method. -/
@[simp]
theorem iterate_zero : M.iterate O 0 = M.x₀ := rfl

/-- Entry $i$ of the trajectory $(x_0, \dots, x_k)$ is the iterate $x_i$. -/
theorem trajectory_apply (k : ℕ) (i : Fin (k + 1)) : M.trajectory O k i = M.iterate O i := by
  induction k with
  | zero => rw [Fin.fin_one_eq_zero i]; rfl
  | succ k ih =>
    induction i using Fin.lastCases with
    | last => rfl
    | cast i =>
      simp only [trajectory, Fin.snoc_castSucc, ih, Fin.val_castSucc]

/-- The trajectory $(x_0, \dots, x_k)$ is the map $i \mapsto x_i$ on $\{0, \dots, k\}$. -/
theorem trajectory_eq (k : ℕ) : M.trajectory O k = fun i : Fin (k + 1) => M.iterate O i :=
  funext (M.trajectory_apply O k)

/-- Let $M$ be an oracle method and $O \colon E \to I$ an oracle. For every $k$, the iterates
generated with $O$ satisfy
$$x_{k+1} = \mathrm{next}_k(O(x_0), \dots, O(x_k)).$$
-/
theorem iterate_succ (k : ℕ) :
    M.iterate O (k + 1) = M.next k fun i => O (M.iterate O i) := by
  rw [iterate, trajectory, Fin.snoc_last]
  simp_rw [trajectory_apply]

/-- **Resisting-oracle principle.** Let $M$ be an oracle method, let $O, O' \colon E \to I$ be
oracles, let $x_i$ be the iterates of $M$ generated with $O$ and let $k \in \mathbb{N}$. If
$O'(x_i) = O(x_i)$ for every $i \le k$, then the iterates generated with $O'$ agree with $x_i$
for every $i \le k + 1$. -/
theorem iterate_congr {k : ℕ} (h : ∀ i ≤ k, O' (M.iterate O i) = O (M.iterate O i)) :
    ∀ i ≤ k + 1, M.iterate O' i = M.iterate O i := by
  induction k with
  | zero =>
    intro i hi
    rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hi with rfl | rfl
    · rfl
    · simp only [iterate_succ, Nat.reduceAdd]
      congr 1
      funext j
      rw [Fin.fin_one_eq_zero j]
      exact h 0 le_rfl
  | succ k ih =>
    have ih' := ih fun i hi => h i (hi.trans k.le_succ)
    intro i hi
    rcases Nat.lt_or_eq_of_le hi with hi | rfl
    · exact ih' i (Nat.lt_succ_iff.1 hi)
    · rw [iterate_succ, iterate_succ]
      congr 1
      funext j
      rw [ih' j (Nat.lt_succ_iff.1 j.2)]
      exact h j (Nat.lt_succ_iff.1 j.2)

/-- If two oracles agree at every iterate generated by the first one, then they generate the same
iterates. -/
theorem iterate_eq_of_forall (h : ∀ i, O' (M.iterate O i) = O (M.iterate O i)) (k : ℕ) :
    M.iterate O' k = M.iterate O k :=
  M.iterate_congr O O' (k := k) (fun i _ => h i) k k.le_succ

end OracleMethod

section jetOracle

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The **$p$-th order oracle** of $f \colon E \to \mathbb{R}$ at $x$ answers with the derivatives
$\nabla^j f(x)$ for $j = 0, \dots, p$, as continuous $j$-linear forms. The form $\nabla^0 f(x)$
is the constant map with value $f(x)$. -/
noncomputable def jetOracle (f : E → ℝ) (p : ℕ) (x : E) :
    (j : Fin (p + 1)) → ContinuousMultilinearMap ℝ (fun _ : Fin j => E) ℝ :=
  fun j => iteratedFDeriv ℝ j f x

/-- Entry $j$ of the answer of the $p$-th order oracle of $f$ at $x$ is the $j$-th derivative
$\nabla^j f(x)$, as `iteratedFDeriv`. -/
@[simp]
theorem jetOracle_apply (f : E → ℝ) (p : ℕ) (x : E) (j : Fin (p + 1)) :
    jetOracle f p x j = iteratedFDeriv ℝ j f x := rfl

/-- The answers of the $p$-th order oracles of $f$ at $x$ and of $g$ at $y$ agree if and only if
$\nabla^j f(x) = \nabla^j g(y)$ for every $j \le p$. -/
theorem jetOracle_eq_jetOracle_iff {f g : E → ℝ} {p : ℕ} {x y : E} :
    jetOracle f p x = jetOracle g p y ↔
      ∀ j ≤ p, iteratedFDeriv ℝ j f x = iteratedFDeriv ℝ j g y := by
  constructor
  · intro h j hj
    exact congrFun h ⟨j, Nat.lt_succ_iff.2 hj⟩
  · intro h
    funext j
    exact h j (Nat.lt_succ_iff.1 j.2)

/-- If the answers of the $p$-th order oracles of $f$ at $x$ and of $g$ at $y$ agree, then
$f(x) = g(y)$: the function value is part of the answer. -/
theorem eq_of_jetOracle_eq {f g : E → ℝ} {p : ℕ} {x y : E}
    (h : jetOracle f p x = jetOracle g p y) : f x = g y := by
  have := (jetOracle_eq_jetOracle_iff.1 h) 0 (Nat.zero_le _)
  simpa using congrArg (fun A => A 0) this

/-- The **Taylor data** of an answer $(J_0, \dots, J_p)$ of the $p$-th order oracle is the formal
multilinear series with $J_j$ in degree $j \le p$ and $0$ in every degree above $p$. For the
exact answer it agrees with `ftaylorSeries` up to degree $p$
(`Optimization.jetSeries_jetOracle`). -/
noncomputable def jetSeries {p : ℕ}
    (J : (j : Fin (p + 1)) → ContinuousMultilinearMap ℝ (fun _ : Fin j => E) ℝ) :
    FormalMultilinearSeries ℝ E ℝ :=
  fun j => if h : j < p + 1 then J ⟨j, h⟩ else 0

/-- For $j \le p$, the Taylor data of the $p$-th order oracle of $f$ at $x$ in degree $j$ is the
term of degree $j$ of the Taylor series `ftaylorSeries` of $f$ at $x$. -/
theorem jetSeries_jetOracle (f : E → ℝ) {p : ℕ} (x : E) {j : ℕ} (hj : j ≤ p) :
    jetSeries (jetOracle f p x) j = ftaylorSeries ℝ f x j := by
  simp [jetSeries, Nat.lt_succ_of_le hj, ftaylorSeries]

/-- The **function value** contained in an answer $(J_0, \dots, J_p)$ of the $p$-th order oracle:
the value of the $0$-linear form $J_0$. -/
noncomputable def jetValue {p : ℕ}
    (J : (j : Fin (p + 1)) → ContinuousMultilinearMap ℝ (fun _ : Fin j => E) ℝ) : ℝ :=
  jetSeries J 0 (fun _ => 0)

/-- The function value contained in the answer of the $p$-th order oracle of $f$ at $x$ is $f(x)$.
-/
@[simp]
theorem jetValue_jetOracle (f : E → ℝ) (p : ℕ) (x : E) : jetValue (jetOracle f p x) = f x := by
  rw [jetValue, jetSeries_jetOracle f x (Nat.zero_le _)]
  rfl

end jetOracle

end Optimization
