import Mathlib.Analysis.Calculus.ContDiff.FTaylorSeries
import Mathlib.Data.Fin.Tuple.Basic

/-!
# Oracle methods

Deterministic methods that access the objective only through an oracle
([cartis2022evaluation], Section 1.2.4, the classes `𝓜` of Section 3.5 and `𝓜(p)`, `𝓜_ZR(p)` of
Section 4.2): the next iterate is a function of the oracle answers at all previous iterates. Such
methods are used to state lower bounds of the form "for every method in a class there is a hard
function".

* `Optimization.OracleMethod E I`: an initial point `x₀ : E` and, for each `k`, a map from the
  answers `(O x_0, …, O x_k) : Fin (k + 1) → I` to the next iterate `x_{k+1}`.
* `Optimization.OracleMethod.iterate M O k`: the `k`-th iterate generated with the oracle
  `O : E → I`, with `iterate_zero` and `iterate_succ` (`x_{k+1} = next k (O x_0, …, O x_k)`).
* `Optimization.OracleMethod.iterate_congr`: the "resisting oracle" principle. Two oracles that give
  the same answers at the iterates generated by the first generate the same iterates.
* `Optimization.jetOracle f p x`: the `p`-th order oracle `(f(x), ∇f(x), …, ∇^p f(x))`.

Iterates of methods depending also on their previous iterates need no separate treatment: the
previous iterates are themselves functions of the previous answers.
-/

namespace Optimization

/-- A deterministic oracle method on `E` with oracle answers in `I`: an initial point `x₀` and,
for each iteration `k`, the map `next k` from the oracle answers at the iterates `x_0, …, x_k` to
the next iterate `x_{k+1}`. -/
structure OracleMethod (E I : Type*) where
  /-- The initial point. -/
  x₀ : E
  /-- The next iterate `x_{k+1}` as a function of the answers `(O x_0, …, O x_k)`. -/
  next : (k : ℕ) → (Fin (k + 1) → I) → E

namespace OracleMethod

variable {E I : Type*} (M : OracleMethod E I) (O O' : E → I)

/-- The trajectory `(x_0, …, x_k)` generated by the method `M` with the oracle `O`. -/
def trajectory (M : OracleMethod E I) (O : E → I) : (k : ℕ) → Fin (k + 1) → E
  | 0 => fun _ => M.x₀
  | k + 1 => Fin.snoc (trajectory M O k) (M.next k fun i => O (trajectory M O k i))

/-- The `k`-th iterate `x_k` generated by the method `M` with the oracle `O`. -/
def iterate (k : ℕ) : E := M.trajectory O k (Fin.last k)

@[simp]
theorem iterate_zero : M.iterate O 0 = M.x₀ := rfl

theorem trajectory_apply (k : ℕ) (i : Fin (k + 1)) : M.trajectory O k i = M.iterate O i := by
  induction k with
  | zero => rw [Fin.fin_one_eq_zero i]; rfl
  | succ k ih =>
    induction i using Fin.lastCases with
    | last => rfl
    | cast i =>
      simp only [trajectory, Fin.snoc_castSucc, ih, Fin.val_castSucc]

theorem trajectory_eq (k : ℕ) : M.trajectory O k = fun i : Fin (k + 1) => M.iterate O i :=
  funext (M.trajectory_apply O k)

/-- `x_{k+1} = next k (O x_0, …, O x_k)`. -/
theorem iterate_succ (k : ℕ) :
    M.iterate O (k + 1) = M.next k fun i => O (M.iterate O i) := by
  rw [iterate, trajectory, Fin.snoc_last]
  simp_rw [trajectory_apply]

/-- **Resisting oracle principle.** If the oracle `O'` gives the same answers as `O` at the
iterates `x_0, …, x_k` generated with `O`, then both oracles generate the same iterates
`x_0, …, x_{k+1}`. -/
theorem iterate_congr {k : ℕ} (h : ∀ i ≤ k, O' (M.iterate O i) = O (M.iterate O i)) :
    ∀ i ≤ k + 1, M.iterate O' i = M.iterate O i := by
  induction k with
  | zero =>
    intro i hi
    rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hi with rfl | rfl
    · rfl
    · simp only [iterate_succ, Nat.reduceAdd]
      congr 1
      funext j
      rw [Fin.fin_one_eq_zero j]
      exact h 0 le_rfl
  | succ k ih =>
    have ih' := ih fun i hi => h i (hi.trans k.le_succ)
    intro i hi
    rcases Nat.lt_or_eq_of_le hi with hi | rfl
    · exact ih' i (Nat.lt_succ_iff.1 hi)
    · rw [iterate_succ, iterate_succ]
      congr 1
      funext j
      rw [ih' j (Nat.lt_succ_iff.1 j.2)]
      exact h j (Nat.lt_succ_iff.1 j.2)

/-- Oracles that agree everywhere along the trajectory generated by `O` generate the same
trajectory. -/
theorem iterate_eq_of_forall (h : ∀ i, O' (M.iterate O i) = O (M.iterate O i)) (k : ℕ) :
    M.iterate O' k = M.iterate O k :=
  M.iterate_congr O O' (k := k) (fun i _ => h i) k k.le_succ

end OracleMethod

section jetOracle

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The `p`-th order oracle at `x`: the derivatives `∇^j f(x)`, `j = 0, …, p`, as continuous
multilinear maps (`∇^0 f(x)` is the constant map with value `f(x)`). -/
noncomputable def jetOracle (f : E → ℝ) (p : ℕ) (x : E) :
    (j : Fin (p + 1)) → ContinuousMultilinearMap ℝ (fun _ : Fin j => E) ℝ :=
  fun j => iteratedFDeriv ℝ j f x

@[simp]
theorem jetOracle_apply (f : E → ℝ) (p : ℕ) (x : E) (j : Fin (p + 1)) :
    jetOracle f p x j = iteratedFDeriv ℝ j f x := rfl

/-- Two `p`-th order oracles agree iff all derivatives of order `≤ p` agree. -/
theorem jetOracle_eq_jetOracle_iff {f g : E → ℝ} {p : ℕ} {x y : E} :
    jetOracle f p x = jetOracle g p y ↔
      ∀ j ≤ p, iteratedFDeriv ℝ j f x = iteratedFDeriv ℝ j g y := by
  constructor
  · intro h j hj
    exact congrFun h ⟨j, Nat.lt_succ_iff.2 hj⟩
  · intro h
    funext j
    exact h j (Nat.lt_succ_iff.1 j.2)

/-- The value of `f` is part of the answer of the jet oracle. -/
theorem eq_of_jetOracle_eq {f g : E → ℝ} {p : ℕ} {x y : E}
    (h : jetOracle f p x = jetOracle g p y) : f x = g y := by
  have := (jetOracle_eq_jetOracle_iff.1 h) 0 (Nat.zero_le _)
  simpa using congrArg (fun A => A 0) this

end jetOracle

end Optimization
