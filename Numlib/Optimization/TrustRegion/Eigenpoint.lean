import Numlib.Optimization.HighOrder.CriticalityApproximate
import Mathlib.Topology.Order.Compact

/-!
# Decrease along a negative-curvature eigenvector

The model is the actual quadratic Taylor polynomial. An eigenpoint minimizes
that polynomial on a feasible ray generated by a unit Hessian eigenvector.
The comparison with the boundary step proves decrease and ratio positivity.
-/

namespace TaylorModel

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E]

/-- An actual quadratic Taylor minimizer on a unit-direction trust-region ray. -/
def IsEigenPoint (f : E → ℝ) (x u : E) (Δ : ℝ) (s : E) : Prop :=
  ∃ t : ℝ, t ∈ Set.Icc 0 Δ ∧ s = t • u ∧
    IsMinOn (fun r : ℝ => eval f 2 x (r • u)) (Set.Icc 0 Δ) t

omit [CompleteSpace E] in
/-- The ray minimizer exists for every nonnegative radius. -/
theorem exists_eigenPoint (f : E → ℝ) (x u : E) {Δ : ℝ} (hΔ : 0 ≤ Δ) :
    ∃ s, IsEigenPoint f x u Δ s := by
  have hc : Continuous (fun r : ℝ => eval f 2 x (r • u)) :=
    (continuous_eval f 2 x).comp (continuous_id.smul continuous_const)
  obtain ⟨t, ht, hm⟩ := isCompact_Icc.exists_isMinOn (Set.nonempty_Icc.mpr hΔ)
    hc.continuousOn
  exact ⟨t • u, t, ht, rfl, hm⟩

/-- Unit genuine Hessian eigenvectors have the corresponding tensor curvature. -/
theorem tensor_curvature_of_eigenvector (f : E → ℝ) (x u : E) {μ : ℝ}
    (hu : ‖u‖ = 1) (he : hessianOperator f x u = μ • u) :
    iteratedFDeriv ℝ 2 f x (fun _ => u) = μ := by
  have hh := inner_hessianOperator f x u u
  rw [he, real_inner_smul_left, real_inner_self_eq_norm_sq, hu] at hh
  have hv : (![u, u] : Fin 2 → E) = (fun _ => u) := by ext i; fin_cases i <;> rfl
  rw [hv] at hh
  simpa using hh.symm

/-- A ray minimizer along a nonascending negative eigenvector obtains the
standard eigenpoint decrease. Any negative Hessian eigenvalue suffices. -/
theorem eigenpoint_decrease (f : E → ℝ) (x u : E) {μ Δ : ℝ} {sE : E}
    (hΔ : 0 ≤ Δ) (hμ : μ < 0) (hu : ‖u‖ = 1)
    (he : hessianOperator f x u = μ • u)
    (hg : inner ℝ (gradient f x) u ≤ 0) (hp : IsEigenPoint f x u Δ sE) :
    eval f 2 x sE ≤ eval f 2 x 0 - (1 / 2 : ℝ) * |μ| * Δ ^ 2 := by
  rcases hp with ⟨t, ht, rfl, hm⟩
  have hmΔ := hm (show Δ ∈ Set.Icc 0 Δ from ⟨hΔ, le_rfl⟩)
  have hd := decrement_two_smul f x u Δ
  rw [tensor_curvature_of_eigenvector f x u hu he, decrement] at hd
  rw [abs_of_neg hμ]
  change eval f 2 x (t • u) ≤ eval f 2 x (Δ • u) at hmΔ
  have hsign := mul_nonpos_of_nonneg_of_nonpos hΔ hg
  linarith

/-- Negative curvature with positive radius gives a strictly positive
predicted decrease for every trial improving on the eigenpoint. -/
theorem eigenpoint_predicted_decrease_pos (f : E → ℝ) (x u : E)
    {μ Δ : ℝ} {sE s : E} (hΔ : 0 < Δ) (hμ : μ < 0) (hu : ‖u‖ = 1)
    (he : hessianOperator f x u = μ • u)
    (hg : inner ℝ (gradient f x) u ≤ 0) (hp : IsEigenPoint f x u Δ sE)
    (hs : eval f 2 x s ≤ eval f 2 x sE) :
    0 < eval f 2 x 0 - eval f 2 x s := by
  have hd := eigenpoint_decrease f x u hΔ.le hμ hu he hg hp
  have hpos : 0 < (1 / 2 : ℝ) * |μ| * Δ ^ 2 := by
    have hμpos : 0 < |μ| := abs_pos.mpr hμ.ne
    positivity
  linarith

end TaylorModel
