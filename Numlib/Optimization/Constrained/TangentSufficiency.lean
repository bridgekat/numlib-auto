import Numlib.Optimization.Constrained.Inequality

/-!
# Strict optimality on the closed radial tangent cone

The closure of nonnegative multiples of actual feasible displacements contains
every limiting normalized feasible direction. Positivity of the actual Hessian
on its nonzero critical directions repairs sufficiency conditions that tested
only individual feasible displacements.
-/

open Set Filter Topology
namespace Constrained
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The closed cone generated by actual feasible displacements from x.
For convex feasible sets this is the closed tangent cone. -/
def closedRadialCone (C : Set E) (x : E) : Set E :=
  closure {d | ∃ t : ℝ, 0 ≤ t ∧ ∃ y ∈ C, d = t • (y - x)}

/-- Nonnegative multiples of actual feasible displacements belong to their
closed radial cone. -/
theorem smul_sub_mem_closedRadialCone {C : Set E} {x y : E} (hy : y ∈ C)
    {t : ℝ} (ht : 0 ≤ t) : t • (y - x) ∈ closedRadialCone C x :=
  subset_closure ⟨t, ht, y, hy, rfl⟩

/-- Continuity extends first-order nonnegativity from actual feasible
 displacements to the entire closed radial cone. -/
theorem nonneg_on_closedRadialCone {C : Set E} {x : E} (l : E →L[ℝ] ℝ)
    (h : ∀ y ∈ C, 0 ≤ l (y - x)) {v : E} (hv : v ∈ closedRadialCone C x) :
    0 ≤ l v := by
  have hsub : closedRadialCone C x ⊆ {v | 0 ≤ l v} := by
    apply closure_minimal _ (isClosed_le continuous_const l.continuous)
    rintro v ⟨t, ht, y, hy, rfl⟩
    change 0 ≤ l (t • (y - x))
    simpa only [map_smul, smul_eq_mul] using mul_nonneg ht (h y hy)
  exact hsub hv

variable [FiniteDimensional ℝ E]

/-- A finite-smoothness objective is strictly locally minimal on its feasible
set when its actual Hessian is positive on every nonzero critical direction
of the closed radial cone. The set itself need not be convex or closed. -/
theorem strict_local_min_of_pos_hessian_on_closedRadialCone
    {f : E → ℝ} {C S : Set E} {x : E} (hS : IsOpen S) (hxS : x ∈ S)
    (hf : ContDiffOn ℝ 2 f S) (_hx : x ∈ C)
    (hfirst : ∀ y ∈ C, 0 ≤ fderiv ℝ f x (y - x))
    (hpos : ∀ v ∈ closedRadialCone C x, v ≠ 0 → fderiv ℝ f x v = 0 →
      0 < fderiv ℝ (fderiv ℝ f) x v v) :
    ∃ δ > 0, ∀ y ∈ C, dist y x < δ → y ≠ x → f x < f y := by
  have hfat := hf.contDiffAt (hS.mem_nhds hxS)
  have hfnear : ∀ᶠ y in 𝓝 x, HasFDerivAt f (fderiv ℝ f y) y := by
    filter_upwards [hS.mem_nhds hxS] with y hy
    exact ((hf.contDiffAt (hS.mem_nhds hy)).differentiableAt (by norm_num)).hasFDerivAt
  have hH : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) x) x :=
    ((hfat.fderiv_right (by norm_num : (1 : WithTop ℕ∞) + 1 ≤ 2)).differentiableAt
      (by norm_num)).hasFDerivAt
  by_contra hn
  push Not at hn
  have hseq : ∀ n : ℕ, ∃ y, y ∈ C ∧ dist y x < 1 / ((n : ℝ) + 1) ∧
      y ≠ x ∧ f y ≤ f x := by
    intro n
    exact hn (1 / ((n : ℝ) + 1)) (by positivity)
  choose y hyC hyd hyne hyf using hseq
  have hylim : Tendsto y atTop (𝓝 x) := by
    rw [tendsto_iff_dist_tendsto_zero]
    exact squeeze_zero (fun _ => dist_nonneg) (fun n => (hyd n).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  have hwne : ∀ n, y n - x ≠ 0 := fun n => sub_ne_zero.mpr (hyne n)
  let u : ℕ → E := fun n => ‖y n - x‖⁻¹ • (y n - x)
  have hunorm : ∀ n, ‖u n‖ = 1 := by
    intro n
    change ‖‖y n - x‖⁻¹ • (y n - x)‖ = 1
    rw [norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hwne n))]
  obtain ⟨z, hz, φ, hφ, hulim⟩ := (isCompact_sphere (0 : E) 1).tendsto_subseq
    (fun n => mem_sphere_zero_iff_norm.mpr (hunorm n))
  have hz0 : z ≠ 0 := by
    intro h0
    rw [mem_sphere_zero_iff_norm, h0, norm_zero] at hz
    exact zero_ne_one hz
  have hzcone : z ∈ closedRadialCone C x := by
    apply isClosed_closure.mem_of_tendsto hulim
    exact Eventually.of_forall (fun n =>
      smul_sub_mem_closedRadialCone (hyC (φ n)) (inv_nonneg.mpr (norm_nonneg _)))
  have hyφ : Tendsto (y ∘ φ) atTop (𝓝 x) := hylim.comp hφ.tendsto_atTop
  let V : Set E := {y | y ∈ C ∧ f y ≤ f x}
  have hzdesc : z ∈ posTangentConeAt V x := by
    have hd0 : Tendsto (fun n => y (φ n) - x) atTop (𝓝 0) := by
      simpa using hyφ.sub_const x
    apply mem_tangentConeAt_of_seq atTop
      (fun n => Real.toNNReal (‖y (φ n) - x‖⁻¹)) (fun n => y (φ n) - x) hd0
    · exact Eventually.of_forall (fun n => by
        simpa [V] using And.intro (hyC (φ n)) (hyf (φ n)))
    · convert hulim using 1
      ext n
      simp [u, NNReal.smul_def, Real.coe_toNNReal _ (inv_nonneg.mpr (norm_nonneg _))]
  have hnonpos : fderiv ℝ f x z ≤ 0 := by
    have hmax : IsMaxOn f V x := fun w hw => hw.2
    exact hmax.isLocalMaxOn.hasFDerivWithinAt_nonpos
      (hfnear.self_of_nhds.hasFDerivWithinAt) hzdesc
  have hcrit : fderiv ℝ f x z = 0 := le_antisymm hnonpos
    (nonneg_on_closedRadialCone (fderiv ℝ f x) hfirst hzcone)
  let H := fderiv ℝ (fderiv ℝ f) x
  have hpeano := isLittleO_taylor_two hfnear hH
  have hr := hpeano.tendsto_div_nhds_zero.comp hyφ
  have hkey : ∀ n, H (u (φ n)) (u (φ n)) / 2 ≤
      -((f (y (φ n)) - f x - fderiv ℝ f x (y (φ n) - x) -
        H (y (φ n) - x) (y (φ n) - x) / 2) / ‖y (φ n) - x‖ ^ 2) := by
    intro n
    have hnz : ‖y (φ n) - x‖ ≠ 0 := norm_ne_zero_iff.mpr (hwne _)
    have hnp : 0 < ‖y (φ n) - x‖ ^ 2 := pow_pos (norm_pos_iff.mpr (hwne _)) 2
    have hHu : H (u (φ n)) (u (φ n)) =
        H (y (φ n) - x) (y (φ n) - x) / ‖y (φ n) - x‖ ^ 2 := by
      simp only [u, map_smul, smul_apply, smul_eq_mul]
      field_simp
    rw [hHu]
    have hd : (f (y (φ n)) - f x - fderiv ℝ f x (y (φ n) - x)) /
        ‖y (φ n) - x‖ ^ 2 ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg
        (by linarith [hyf (φ n), hfirst _ (hyC (φ n))]) hnp.le
    have he : -((f (y (φ n)) - f x - fderiv ℝ f x (y (φ n) - x) -
          H (y (φ n) - x) (y (φ n) - x) / 2) / ‖y (φ n) - x‖ ^ 2) =
        H (y (φ n) - x) (y (φ n) - x) / ‖y (φ n) - x‖ ^ 2 / 2 -
          (f (y (φ n)) - f x - fderiv ℝ f x (y (φ n) - x)) /
            ‖y (φ n) - x‖ ^ 2 := by field_simp; ring
    rw [he]
    linarith
  have hlimL : Tendsto (fun n => H (u (φ n)) (u (φ n)) / 2) atTop (𝓝 (H z z / 2)) := by
    have hcont : Continuous (fun v : E => H v v) :=
      H.continuous₂.comp (continuous_id.prodMk continuous_id)
    exact ((hcont.tendsto z).comp hulim).div_const 2
  have hlimR : Tendsto (fun n => -((f (y (φ n)) - f x -
      fderiv ℝ f x (y (φ n) - x) - H (y (φ n) - x) (y (φ n) - x) / 2) /
        ‖y (φ n) - x‖ ^ 2)) atTop (𝓝 (-0)) := by
    apply Tendsto.neg
    exact hr.congr (fun _ => by simp only [Function.comp_apply, H])
  rw [neg_zero] at hlimR
  have hle := le_of_tendsto_of_tendsto' hlimL hlimR hkey
  have hpositive := hpos z hzcone hz0 hcrit
  linarith

end Constrained
