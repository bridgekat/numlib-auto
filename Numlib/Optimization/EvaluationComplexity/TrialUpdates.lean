import Numlib.Optimization.EvaluationComplexity.TrialCounting

/-!
# Parameter traces with accuracy-only iterations

These records specify only initialization and the permitted update intervals. Trial iterations
use the three acceptance-ratio branches; accuracy-only iterations leave the parameter unchanged.
Positivity and logarithmic bounds are derived from these operational rules.
-/

namespace EvaluationComplexity

/-- Trust-region radius updates with an explicit set of trial iterations. -/
structure TrialTrustRegionUpdates (T : Set ℕ) (δ ρ : ℕ → ℝ)
    (η₁ η₂ γ₁ γ₂ γ₃ δmax : ℝ) (N : ℕ) : Prop where
  initial_pos : 0 < δ 0
  initial_le_max : δ 0 ≤ δmax
  eta1_pos : 0 < η₁
  eta1_le_eta2 : η₁ ≤ η₂
  eta2_lt_one : η₂ < 1
  gamma1_pos : 0 < γ₁
  gamma1_le_gamma2 : γ₁ ≤ γ₂
  gamma2_lt_one : γ₂ < 1
  one_le_gamma3 : 1 ≤ γ₃
  update : ∀ i < N, i ∈ T →
    if η₂ ≤ ρ i then δ (i + 1) ∈ Set.Icc (δ i) (min δmax (γ₃ * δ i))
    else if η₁ ≤ ρ i then δ (i + 1) ∈ Set.Icc (γ₂ * δ i) (δ i)
    else δ (i + 1) ∈ Set.Icc (γ₁ * δ i) (γ₂ * δ i)
  inactive : ∀ i < N, i ∉ T → δ (i + 1) = δ i

namespace TrialTrustRegionUpdates

variable {T : Set ℕ} {δ ρ : ℕ → ℝ} {η₁ η₂ γ₁ γ₂ γ₃ δmax : ℝ} {N : ℕ}

/-- Accuracy-only steps leave the radius unchanged. -/
theorem inactive_eq (h : TrialTrustRegionUpdates T δ ρ η₁ η₂ γ₁ γ₂ γ₃ δmax N)
    {i : ℕ} (hi : i < N) (hT : i ∉ T) : δ (i + 1) = δ i := by
  exact h.inactive i hi hT

/-- Each radius generated by these updates is positive. -/
theorem pos (h : TrialTrustRegionUpdates T δ ρ η₁ η₂ γ₁ γ₂ γ₃ δmax N)
    {i : ℕ} (hi : i ≤ N) : 0 < δ i := by
  classical
  induction i with
  | zero => exact h.initial_pos
  | succ i ih =>
    have hp := ih (by omega)
    by_cases hT : i ∈ T
    · have hu := h.update i (by omega) hT
      split_ifs at hu with h₂ h₁
      · exact hp.trans_le hu.1
      · exact (mul_pos (h.gamma1_pos.trans_le h.gamma1_le_gamma2) hp).trans_le hu.1
      · exact (mul_pos h.gamma1_pos hp).trans_le hu.1
    · rw [h.inactive_eq (by omega) hT]
      exact hp

/-- Successful trials enlarge the radius by at most the permitted growth factor. -/
theorem successful_le (h : TrialTrustRegionUpdates T δ ρ η₁ η₂ γ₁ γ₂ γ₃ δmax N)
    {i : ℕ} (hi : i < N) (hT : i ∈ T) (hs : η₁ ≤ ρ i) :
    δ (i + 1) ≤ γ₃ * δ i := by
  have hu := h.update i hi hT
  split_ifs at hu with h₂
  · exact hu.2.trans (min_le_right _ _)
  · exact hu.2.trans (le_mul_of_one_le_left (h.pos (by omega)).le h.one_le_gamma3)

/-- Unsuccessful trials contract the radius by at least the unsuccessful factor. -/
theorem unsuccessful_le (h : TrialTrustRegionUpdates T δ ρ η₁ η₂ γ₁ γ₂ γ₃ δmax N)
    {i : ℕ} (hi : i < N) (hT : i ∈ T) (hs : ¬η₁ ≤ ρ i) :
    δ (i + 1) ≤ γ₂ * δ i := by
  have h₂ : ¬η₂ ≤ ρ i := fun hh => hs (h.eta1_le_eta2.trans hh)
  have hu : δ (i + 1) ∈ Set.Icc (γ₁ * δ i) (γ₂ * δ i) := by
    simpa [hs, h₂] using h.update i hi hT
  exact hu.2

end TrialTrustRegionUpdates

/-- Adaptive-regularization parameter updates with accuracy-only iterations. -/
structure TrialRegularizationUpdates (T : Set ℕ) (σ ρ : ℕ → ℝ)
    (η₁ η₂ γ₁ γ₂ γ₃ σmin : ℝ) (N : ℕ) : Prop where
  min_pos : 0 < σmin
  min_le_initial : σmin ≤ σ 0
  eta1_pos : 0 < η₁
  eta1_le_eta2 : η₁ ≤ η₂
  eta2_lt_one : η₂ < 1
  gamma1_pos : 0 < γ₁
  gamma1_lt_one : γ₁ < 1
  one_lt_gamma2 : 1 < γ₂
  gamma2_lt_gamma3 : γ₂ < γ₃
  update : ∀ i < N, i ∈ T →
    if η₂ ≤ ρ i then σ (i + 1) ∈ Set.Icc (max σmin (γ₁ * σ i)) (σ i)
    else if η₁ ≤ ρ i then σ (i + 1) ∈ Set.Icc (σ i) (γ₂ * σ i)
    else σ (i + 1) ∈ Set.Icc (γ₂ * σ i) (γ₃ * σ i)
  inactive : ∀ i < N, i ∉ T → σ (i + 1) = σ i

namespace TrialRegularizationUpdates

variable {T : Set ℕ} {σ ρ : ℕ → ℝ} {η₁ η₂ γ₁ γ₂ γ₃ σmin : ℝ} {N : ℕ}

/-- Accuracy-only steps leave the regularization parameter unchanged. -/
theorem inactive_eq (h : TrialRegularizationUpdates T σ ρ η₁ η₂ γ₁ γ₂ γ₃ σmin N)
    {i : ℕ} (hi : i < N) (hT : i ∉ T) : σ (i + 1) = σ i := by
  exact h.inactive i hi hT

/-- All generated regularization parameters remain above their positive floor. -/
theorem min_le (h : TrialRegularizationUpdates T σ ρ η₁ η₂ γ₁ γ₂ γ₃ σmin N)
    {i : ℕ} (hi : i ≤ N) : σmin ≤ σ i := by
  classical
  induction i with
  | zero => exact h.min_le_initial
  | succ i ih =>
    have hp := ih (by omega)
    by_cases hT : i ∈ T
    · have hu := h.update i (by omega) hT
      split_ifs at hu with h₂ h₁
      · exact (le_max_left _ _).trans hu.1
      · exact hp.trans hu.1
      · exact hp.trans ((le_mul_of_one_le_left (h.min_pos.le.trans hp)
          h.one_lt_gamma2.le).trans hu.1)
    · rw [h.inactive_eq (by omega) hT]
      exact hp

/-- Each parameter generated by these updates is positive. -/
theorem pos (h : TrialRegularizationUpdates T σ ρ η₁ η₂ γ₁ γ₂ γ₃ σmin N)
    {i : ℕ} (hi : i ≤ N) : 0 < σ i := h.min_pos.trans_le (h.min_le hi)

/-- Successful trials decrease the parameter by at most the permitted factor. -/
theorem successful_ge (h : TrialRegularizationUpdates T σ ρ η₁ η₂ γ₁ γ₂ γ₃ σmin N)
    {i : ℕ} (hi : i < N) (hT : i ∈ T) (hs : η₁ ≤ ρ i) :
    γ₁ * σ i ≤ σ (i + 1) := by
  have hu := h.update i hi hT
  split_ifs at hu with h₂
  · exact (le_max_right _ _).trans hu.1
  · exact (mul_le_of_le_one_left (h.pos (by omega)).le h.gamma1_lt_one.le).trans hu.1

/-- Unsuccessful trials enlarge the parameter by at least the prescribed factor. -/
theorem unsuccessful_ge (h : TrialRegularizationUpdates T σ ρ η₁ η₂ γ₁ γ₂ γ₃ σmin N)
    {i : ℕ} (hi : i < N) (hT : i ∈ T) (hs : ¬η₁ ≤ ρ i) :
    γ₂ * σ i ≤ σ (i + 1) := by
  have h₂ : ¬η₂ ≤ ρ i := fun hh => hs (h.eta1_le_eta2.trans hh)
  have hu : σ (i + 1) ∈ Set.Icc (γ₂ * σ i) (γ₃ * σ i) := by
    simpa [hs, h₂] using h.update i hi hT
  exact hu.1

end TrialRegularizationUpdates

end EvaluationComplexity
