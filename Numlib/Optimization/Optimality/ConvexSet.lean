import Numlib.Optimization.Optimality.Unconstrained
import Numlib.Optimization.Descent
import Mathlib.Analysis.Convex.Mul
import Mathlib.Analysis.Calculus.FDeriv.Pow

/-!
# Optimality conditions on a convex set

Let $E$ be a real normed space, let $C \subseteq E$ be convex, and let $f : E \to \mathbb{R}$. This
file proves the necessary optimality conditions of Theorem 1.1.2 of [cartis2022evaluation] for a
local minimizer $x$ of $f$ on $C$, in terms of the feasible displacements
$\mathcal{C}(x) = \{d \mid x + d \in C\}$ of (1.1.7). The first-order condition (1.1.6) is
$\nabla f(x)[d] \ge 0$ for all $d \in \mathcal{C}(x)$. The second-order condition (1.1.8) is
$\nabla^2 f(x)[d]^2 \ge 0$ for the $d \in \mathcal{C}(x)$ with $\nabla f(x)[d] = 0$, and the
third-order condition (1.1.9) is $\nabla^3 f(x)[d]^3 \ge 0$ for the $d$ at which the first two
derivatives also vanish.

The converse statement, that (1.1.6) together with $\nabla^2 f(x)[d]^2 > 0$ for every nonzero
$d \in \mathcal{C}(x)$ with $\nabla f(x)[d] = 0$ implies local minimality, is false. For
$C = \{(u, v) \mid u^2 \le v\}$, $f(u, v) = v - 2u^2$ and $x = 0$, the condition (1.1.6) holds and
no nonzero $d \in \mathcal{C}(0)$ has $\nabla f(0)[d] = 0$, but $f(u, u^2) = -u^2 < 0$. Radial
directions do not see the curvature of the boundary. A correct second-order sufficient condition
quantifies over the tangent cone of $C$ at $x$ instead; it needs neither the convexity of $C$ nor
$x \in C$.

## Main results

* `Optimization.IsLocalMinOn.fderiv_apply_nonneg_of_convex`: the first-order condition (1.1.6),
  $\nabla f(x)[d] \ge 0$ for $d \in \mathcal{C}(x)$.
* `Optimization.IsLocalMinOn.iteratedFDeriv_two_nonneg_of_convex`: the second-order condition
  (1.1.8).
* `Optimization.IsLocalMinOn.iteratedFDeriv_three_nonneg_of_convex`: the third-order condition
  (1.1.9).
* `Optimization.isStrictLocalMinOn_of_posTangentCone`,
  `Optimization.isStrictLocalMinOn_of_tangentCone`: the second-order sufficient condition over the
  directions of a tangent cone.
* `Optimization.not_isLocalMinOn_parabola_counterexample`: the same condition over the feasible
  directions $d \in \mathcal{C}(x)$ only is not sufficient.

## Proof outline

The necessary conditions follow from the ray lemma `Optimization.iteratedFDeriv_apply_nonneg_of_ray`
along the segment $t \mapsto x + t d$, $t \in [0, 1]$, which stays in $C$ by convexity. For the
sufficient condition, a sequence $y_k \to x$ in $C$ with $f(y_k) \le f(x)$ has unit directions
$(y_k - x)/\|y_k - x\|$ with a limit point $d$ in the tangent cone. First-order expansions give
$\nabla f(x)[d] = 0$, and the second-order expansion gives $\nabla^2 f(x)[d]^2 \le 0$.

## Implementation notes

* The positive tangent cone `posTangentConeAt C x` is the set of limits of $c_n d_n$ with
  $c_n \ge 0$, $d_n \to 0$ and $x + d_n \in C$. For a convex set $C$ and $x \in C$ it is the closure
  of the cone generated by $\mathcal{C}(x)$.
* The tangent cone `tangentConeAt ℝ C x` allows real scalars $c_n$ of either sign, so it contains
  the positive tangent cone. The sufficient condition over it is therefore a consequence of the
  condition over the positive tangent cone.
-/

open Filter Set Topology

namespace Optimization

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Let $C$ be convex, $x \in C$, and let $x$ be a local minimizer of $f$ on $C$. If $x + d \in C$,
then $f(x) \le f(x + t d)$ for all sufficiently small $t > 0$. -/
theorem IsLocalMinOn.eventually_le_add_smul_of_convex {f : E → ℝ} {C : Set E} {x d : E}
    (hC : Convex ℝ C) (hx : x ∈ C) (hmin : IsLocalMinOn f C x) (hd : x + d ∈ C) :
    ∀ᶠ t in 𝓝[>] (0 : ℝ), f x ≤ f (x + t • d) := by
  have ht : Tendsto (fun t : ℝ => x + t • d) (𝓝[>] 0) (𝓝[C] x) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have : Tendsto (fun t : ℝ => x + t • d) (𝓝 0) (𝓝 (x + (0 : ℝ) • d)) :=
        (continuous_const.add (continuous_id.smul continuous_const)).tendsto 0
      rw [zero_smul, add_zero] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with t ht
      exact hC.add_smul_mem hx hd ⟨ht.1.le, ht.2.le⟩
  exact ht.eventually hmin

/-- The **first-order necessary condition on a convex set**, (1.1.6) of [cartis2022evaluation]. Let
$C \subseteq E$ be convex, let $x \in C$ be a local minimizer of $f$ on $C$, and let $f$ be
differentiable at $x$. Then
$$\nabla f(x)[d] \ge 0 \quad \text{for every } d \text{ with } x + d \in C.$$
This is part of Theorem 1.1.2 of [cartis2022evaluation]. -/
theorem IsLocalMinOn.fderiv_apply_nonneg_of_convex {f : E → ℝ} {C : Set E} {x d : E}
    (hC : Convex ℝ C) (hx : x ∈ C) (hmin : IsLocalMinOn f C x) (hf : DifferentiableAt ℝ f x)
    (hd : x + d ∈ C) : 0 ≤ fderiv ℝ f x d := by
  have := Descent.fderiv_apply_sub_nonneg_of_isLocalMinOn (f' := fun _ => fderiv ℝ f x) hC hx hmin
    hf.hasFDerivAt (x + d) hd
  simpa using this

/-- The **second-order necessary condition on a convex set**, (1.1.8) of [cartis2022evaluation]. Let
$C \subseteq E$ be convex, let $x \in C$ be a local minimizer of $f$ on $C$, and let $f$ be
twice continuously differentiable at $x$. If $x + d \in C$ and $\nabla f(x)[d] = 0$, then
$$\nabla^2 f(x)[d]^2 \ge 0.$$
This is part of Theorem 1.1.2 of [cartis2022evaluation].

The derivative $\nabla^2 f(x)$ is `iteratedFDeriv ℝ 2 f x`. -/
theorem IsLocalMinOn.iteratedFDeriv_two_nonneg_of_convex {f : E → ℝ} {C : Set E} {x d : E}
    (hC : Convex ℝ C) (hx : x ∈ C) (hmin : IsLocalMinOn f C x) (hf : ContDiffAt ℝ 2 f x)
    (hd : x + d ∈ C) (hd1 : fderiv ℝ f x d = 0) : 0 ≤ iteratedFDeriv ℝ 2 f x (fun _ => d) := by
  refine iteratedFDeriv_apply_nonneg_of_ray two_ne_zero hf
    (IsLocalMinOn.eventually_le_add_smul_of_convex hC hx hmin hd) fun i hi hi2 => ?_
  obtain rfl : i = 1 := by omega
  rwa [iteratedFDeriv_one_apply]

/-- The **third-order necessary condition on a convex set**, (1.1.9) of [cartis2022evaluation]. Let
$C \subseteq E$ be convex, let $x \in C$ be a local minimizer of $f$ on $C$, and let $f$ be
three times continuously differentiable at $x$. If $x + d \in C$, $\nabla f(x)[d] = 0$ and
$\nabla^2 f(x)[d]^2 = 0$, then
$$\nabla^3 f(x)[d]^3 \ge 0.$$
This is part of Theorem 1.1.2 of [cartis2022evaluation].

The derivatives $\nabla^k f(x)$ are `iteratedFDeriv ℝ k f x`. -/
theorem IsLocalMinOn.iteratedFDeriv_three_nonneg_of_convex {f : E → ℝ} {C : Set E} {x d : E}
    (hC : Convex ℝ C) (hx : x ∈ C) (hmin : IsLocalMinOn f C x) (hf : ContDiffAt ℝ 3 f x)
    (hd : x + d ∈ C) (hd1 : fderiv ℝ f x d = 0)
    (hd2 : iteratedFDeriv ℝ 2 f x (fun _ => d) = 0) :
    0 ≤ iteratedFDeriv ℝ 3 f x (fun _ => d) := by
  refine iteratedFDeriv_apply_nonneg_of_ray three_ne_zero hf
    (IsLocalMinOn.eventually_le_add_smul_of_convex hC hx hmin hd) fun i hi hi3 => ?_
  rcases (show i = 1 ∨ i = 2 by omega) with rfl | rfl
  · rwa [iteratedFDeriv_one_apply]
  · exact hd2

/-- The **second-order sufficient condition on a set**. Let $E$ be finite-dimensional, let
$C \subseteq E$ be any set, and let $f$ be twice continuously differentiable at $x$. Suppose
that the first-order condition
$$\nabla f(x)[y - x] \ge 0$$
holds for all $y \in C$ near $x$, and that $\nabla^2 f(x)[d]^2 > 0$ for every nonzero $d$ in the
positive tangent cone of $C$ at $x$ with $\nabla f(x)[d] = 0$. Then $x$ is a strict local
minimizer of $f$ on $C$. Compare Theorems 3.2.6 and 3.2.14 of [conn2000trust]; this corrects the
converse of Theorem 1.1.2 of [cartis2022evaluation].

The tangent cone cannot be replaced by the feasible directions $d \in \mathcal{C}(x)$; see
`Optimization.not_isLocalMinOn_parabola_counterexample`. The set $C$ need not be convex, and $x$
need not be in $C$. The idea of the proof: a sequence $y_k \to x$ in $C$ that violates strict
minimality has unit directions with a limit $d$ in the tangent cone; first-order expansions give
$\nabla f(x)[d] = 0$, and the second-order expansion together with $\nabla f(x)[y_k - x] \ge 0$
gives $\nabla^2 f(x)[d]^2 \le 0$.

The positive tangent cone is `posTangentConeAt C x`, and "for all $y \in C$ near $x$" is the
filter `𝓝[C] x`. -/
theorem isStrictLocalMinOn_of_posTangentCone [FiniteDimensional ℝ E] {f : E → ℝ} {C : Set E} {x : E}
    (hf : ContDiffAt ℝ 2 f x) (hfo : ∀ᶠ y in 𝓝[C] x, 0 ≤ fderiv ℝ f x (y - x))
    (hso : ∀ d ∈ posTangentConeAt C x, d ≠ 0 → fderiv ℝ f x d = 0 →
      0 < iteratedFDeriv ℝ 2 f x (fun _ => d)) :
    IsStrictLocalMinOn f C x := by
  by_contra hcon
  obtain ⟨y, z, hy, hylim, hz, hyz⟩ := exists_seq_of_not_isStrictLocalMinOn hcon
  have hw : Tendsto (fun n => y n - x) atTop (𝓝 0) := by simpa using hylim.sub_const x
  have hr : ∀ᶠ n in atTop, 0 < ‖y n - x‖ :=
    Eventually.of_forall fun n => norm_pos_iff.2 (sub_ne_zero.2 (hy n).2.1)
  have hz0 : z ≠ 0 := by rintro rfl; simp at hz
  have hfoN : ∀ᶠ n in atTop, 0 ≤ fderiv ℝ f x (y n - x) :=
    (tendsto_nhdsWithin_iff.2 ⟨hylim, Eventually.of_forall fun n => (hy n).1⟩).eventually hfo
  -- the limit direction is tangent
  have htan : z ∈ posTangentConeAt C x := by
    apply mem_tangentConeAt_of_seq atTop (fun n => Real.toNNReal ‖y n - x‖⁻¹)
      (fun n => y n - x) hw (Eventually.of_forall fun n => by simpa using (hy n).1)
    exact hyz.congr fun n => by
      rw [NNReal.smul_def, Real.coe_toNNReal _ (inv_nonneg.2 (norm_nonneg _))]
  -- first order: `∇f(x)[z] = 0`
  have hfd : HasFDerivAt f (fderiv ℝ f x) x :=
    (hf.differentiableAt (by norm_num)).hasFDerivAt
  have h1 := tendsto_sub_div_of_hasFDerivAt hfd hr hw hyz
  simp only [add_sub_cancel] at h1
  have hle : fderiv ℝ f x z ≤ 0 :=
    le_of_tendsto' h1 fun n => div_nonpos_of_nonpos_of_nonneg (sub_nonpos.2 (hy n).2.2)
      (norm_nonneg _)
  have hge : 0 ≤ fderiv ℝ f x z := by
    refine ge_of_tendsto (((fderiv ℝ f x).continuous.tendsto z).comp hyz) ?_
    filter_upwards [hfoN] with n hn
    simp only [Function.comp_apply, map_smul, smul_eq_mul]
    exact mul_nonneg (inv_nonneg.2 (norm_nonneg _)) hn
  have hz1 : fderiv ℝ f x z = 0 := le_antisymm hle hge
  -- second order: `∇²f(x)[z]² ≤ 0`
  have h2 := tendsto_sub_div_sq_of_contDiffAt hf hr hw hyz
  simp only [add_sub_cancel] at h2
  have hle2 : iteratedFDeriv ℝ 2 f x (fun _ => z) / 2 ≤ 0 := by
    refine le_of_tendsto h2 ?_
    filter_upwards [hfoN] with n hn
    refine div_nonpos_of_nonpos_of_nonneg ?_ (sq_nonneg _)
    linarith [(hy n).2.2]
  linarith [hso z htan hz0 hz1]

/-- The second-order sufficient condition with the tangent cone over $\mathbb{R}$. Let $E$ be
finite-dimensional, let $C \subseteq E$, and let $f$ be twice continuously differentiable at
$x$. Suppose that $\nabla f(x)[y - x] \ge 0$ for all $y \in C$ near $x$, and that
$\nabla^2 f(x)[d]^2 > 0$ for every nonzero $d$ in the tangent cone `tangentConeAt ℝ C x` with
$\nabla f(x)[d] = 0$. Then $x$ is a strict local minimizer of $f$ on $C$.

This tangent cone allows real scalars of either sign and contains the positive tangent cone, so
the statement follows from `Optimization.isStrictLocalMinOn_of_posTangentCone`. -/
theorem isStrictLocalMinOn_of_tangentCone [FiniteDimensional ℝ E] {f : E → ℝ} {C : Set E} {x : E}
    (hf : ContDiffAt ℝ 2 f x) (hfo : ∀ᶠ y in 𝓝[C] x, 0 ≤ fderiv ℝ f x (y - x))
    (hso : ∀ d ∈ tangentConeAt ℝ C x, d ≠ 0 → fderiv ℝ f x d = 0 →
      0 < iteratedFDeriv ℝ 2 f x (fun _ => d)) :
    IsStrictLocalMinOn f C x :=
  isStrictLocalMinOn_of_posTangentCone hf hfo fun d hd ↦ hso d (tangentConeAt_mono_field hd)

/-- **Feasible directions do not give a sufficient condition.** On $\mathbb{R}^2$, let
$C = \{(u, v) \mid u^2 \le v\}$ and $f(u, v) = v - 2u^2$. Then $C$ is closed and convex, and at
$x = 0$:

1. the first-order condition (1.1.6) holds: $\nabla f(0)[y] \ge 0$ for all $y \in C$;
2. $\nabla f(0)[d] > 0$ for every nonzero $d \in \mathcal{C}(0)$, so the second-order condition
   over the feasible directions holds vacuously;
3. $0$ is not a local minimizer of $f$ on $C$, since $f(t, t^2) = -t^2$.

This shows that the converse of Theorem 1.1.2 of [cartis2022evaluation], with feasible
directions in place of the tangent cone, is false. -/
theorem not_isLocalMinOn_parabola_counterexample :
    Convex ℝ {p : ℝ × ℝ | p.1 ^ 2 ≤ p.2} ∧ IsClosed {p : ℝ × ℝ | p.1 ^ 2 ≤ p.2} ∧
      (∀ y ∈ {p : ℝ × ℝ | p.1 ^ 2 ≤ p.2},
        0 ≤ fderiv ℝ (fun p : ℝ × ℝ => p.2 - 2 * p.1 ^ 2) 0 (y - 0)) ∧
      (∀ d : ℝ × ℝ, d ≠ 0 → 0 + d ∈ {p : ℝ × ℝ | p.1 ^ 2 ≤ p.2} →
        0 < fderiv ℝ (fun p : ℝ × ℝ => p.2 - 2 * p.1 ^ 2) 0 d) ∧
      ¬ IsLocalMinOn (fun p : ℝ × ℝ => p.2 - 2 * p.1 ^ 2) {p : ℝ × ℝ | p.1 ^ 2 ≤ p.2} 0 := by
  set C : Set (ℝ × ℝ) := {p | p.1 ^ 2 ≤ p.2}
  set f : ℝ × ℝ → ℝ := fun p => p.2 - 2 * p.1 ^ 2
  have hfd : fderiv ℝ f 0 = ContinuousLinearMap.snd ℝ ℝ ℝ := by
    have h := (hasFDerivAt_snd (p := (0 : ℝ × ℝ))).sub
      (((hasFDerivAt_fst (𝕜 := ℝ) (p := (0 : ℝ × ℝ))).pow 2).const_mul (2 : ℝ))
    refine h.fderiv.trans ?_
    ext <;> simp
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := (even_two.convexOn_pow (𝕜 := ℝ)).convex_epigraph
    simpa [C] using this
  · exact isClosed_le (continuous_fst.pow 2) continuous_snd
  · intro y hy
    rw [hfd, sub_zero, ContinuousLinearMap.coe_snd']
    exact (sq_nonneg _).trans hy
  · intro d hd hdC
    rw [zero_add] at hdC
    rw [hfd, ContinuousLinearMap.coe_snd']
    refine lt_of_le_of_ne ((sq_nonneg _).trans hdC) fun h => hd ?_
    have h1 : d.1 = 0 := pow_eq_zero_iff (n := 2) two_ne_zero |>.1
      (le_antisymm (h ▸ hdC) (sq_nonneg _))
    exact Prod.ext h1 h.symm
  · intro hmin
    have ht : Tendsto (fun t : ℝ => ((t, t ^ 2) : ℝ × ℝ)) (𝓝[≠] 0) (𝓝[C] 0) := by
      refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_
        (Eventually.of_forall fun t => by simp [C])
      have : Tendsto (fun t : ℝ => ((t, t ^ 2) : ℝ × ℝ)) (𝓝 0) (𝓝 ((0, 0 ^ 2) : ℝ × ℝ)) :=
        (continuous_id.prodMk (continuous_id.pow 2)).tendsto 0
      rw [show ((0 : ℝ), (0 : ℝ) ^ 2) = (0 : ℝ × ℝ) by simp] at this
      exact this.mono_left nhdsWithin_le_nhds
    obtain ⟨t, htf, ht0⟩ := ((ht.eventually hmin).and self_mem_nhdsWithin).exists
    have ht0' : t ≠ 0 := ht0
    have : 0 < t ^ 2 := lt_of_le_of_ne (sq_nonneg t) (pow_ne_zero 2 ht0').symm
    simp only [f, Prod.fst_zero, Prod.snd_zero] at htf
    nlinarith

end Optimization
