import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Polynomials in an element commute with what the element commutes with

Let $A$ be an algebra over a commutative semiring $R$, and let $x, a \in A$. If $x$ commutes with
$a$, then $x$ commutes with $p(a)$ for every polynomial $p \in R[X]$, because $p(a)$ lies in the
subalgebra generated by $a$, and all elements of this subalgebra commute with $x$. This is the step
behind every argument that a matrix function or a Padé approximant commutes with the matrices that
its argument commutes with.

## Main results

* `Commute.aeval_right`: if $xa = ax$, then $x \, p(a) = p(a) \, x$.
* `Commute.aeval_left`: if $ax = xa$, then $p(a) \, x = x \, p(a)$.

## Implementation notes

* The proofs use `Algebra.commute_of_mem_adjoin_singleton_of_commute`.
-/

open Polynomial

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A] {x a : A}

/-- Let $A$ be an $R$-algebra and let $x, a \in A$. If $x$ commutes with $a$, then $x$ commutes with
$p(a)$ for every $p \in R[X]$. -/
theorem Commute.aeval_right (h : Commute x a) (p : R[X]) : Commute x (aeval a p) :=
  Algebra.commute_of_mem_adjoin_singleton_of_commute (aeval_mem_adjoin_singleton R a) h

/-- Let $A$ be an $R$-algebra and let $x, a \in A$. If $a$ commutes with $x$, then $p(a)$ commutes
with $x$ for every $p \in R[X]$. -/
theorem Commute.aeval_left (h : Commute a x) (p : R[X]) : Commute (aeval a p) x :=
  (h.symm.aeval_right p).symm
