import Numlib.Analysis.Convex.Caratheodory
import Numlib.Analysis.Convex.Recession.Cone
import Numlib.LinearAlgebra.Dimension.Finrank

/-!
# Convex hulls of points and directions

Let $E$ be a real vector space. Convex analysis often works with a set $S$ that mixes **points** and
**directions** (points at infinity). Its convex hull $\operatorname{conv} S$ is the smallest convex
set that contains every point of $S$ and recedes in every direction of $S$. If $S_0$ is the set of
points and $S_1$ the set of directions, then
$$\operatorname{conv} S = \operatorname{conv} S_0 + \operatorname{cone} S_1,$$
where $\operatorname{cone} S_1$ is the convex cone generated by $S_1$, including the origin. This
module defines this hull, proves Carathéodory's theorem for it, and describes it as a union of
generalized simplices. The presentation follows [rockafellar1970convex], §17.

Below, the set of points is $P = S_0$ and the set of directions is $D = S_1$. The main tool is
homogenization. The points $P$ are lifted to height $1$ and the directions $D$ to height $0$ in
$\mathbb{R} \times E$. Then $\operatorname{conv} S$ is the slice at height $1$ of the convex cone
generated by the lifted set.

## Main definitions

* `ConvexAnalysis.convexHullPD`: the convex hull $\operatorname{conv} P + \operatorname{cone} D$ of
  the points $P$ and the directions of the vectors in $D$.
* `ConvexAnalysis.halfLine`: the closed half-line from $x$ in the direction of $y$.
* `ConvexAnalysis.coneOverPD`: the cone over $\operatorname{conv} S$ in $\mathbb{R} \times E$,
  together with its directions at height $0$.
* `ConvexAnalysis.affineSpanPD`, `ConvexAnalysis.finrankPD`: the affine hull $\operatorname{aff} S =
  \operatorname{aff}(\operatorname{conv} S)$ and its dimension.
* `ConvexAnalysis.AffineIndepPD`: a set of points and directions is affinely independent if its
  homogenization is linearly independent in $\mathbb{R} \times E$.
* `ConvexAnalysis.IsSimplexPD`: a generalized $m$-dimensional simplex, the convex hull of $m + 1$
  affinely independent points and directions.

## Main results

* `ConvexAnalysis.isLeast_convexHullPD`: $\operatorname{conv} P + \operatorname{cone} D$ is the
  least convex set that contains $P$ and recedes in every direction of $D$.
* `ConvexAnalysis.convexHullPD_eq_slice`: $\operatorname{conv} S$ is the slice at height $1$ of the
  convex cone in $\mathbb{R} \times E$ generated by $(\{1\} \times P) \cup (\{0\} \times D)$.
* `ConvexAnalysis.exists_of_mem_convexHullPD`: **Carathéodory's theorem** for points and directions.
* `IsCompact.isClosed_convexHullPD`: $\operatorname{conv} P + \operatorname{cone} D$ is closed when
  $P$ is compact and $\operatorname{cone} D$ is closed.
* `ConvexAnalysis.finrank_span_liftPD`: the homogenization raises the dimension by exactly one.
* `ConvexAnalysis.finrankPD_add_one_of_affineIndepPD`,
  `ConvexAnalysis.finrank_vectorSpan_of_isSimplexPD`: a generalized $m$-dimensional simplex has
  dimension $m$.
* `ConvexAnalysis.convexHullPD_eq_iUnion_simplex`: $\operatorname{conv} S$ is the union of the
  generalized $d$-dimensional simplices with vertices in $S$, where
  $d = \dim(\operatorname{conv} S)$.

## Implementation notes

* A set of directions is represented by a set of vectors, one or more for each direction. The cone
  $\operatorname{cone} D$, and hence the hull, depends only on the directions of the vectors in $D$.
  So nothing is lost, and no quotient type is needed.
* A set of directions alone has empty convex hull: `ConvexAnalysis.convexHullPD ∅ D = ∅`, since the
  empty set recedes in every direction. This is the convention of [rockafellar1970convex].
* [rockafellar1970convex] defines $\operatorname{conv} S$ by its minimality property and derives the
  formula $\operatorname{conv} S_0 + \operatorname{cone} S_1$. Here the formula is the definition,
  because every proof works with it, and `ConvexAnalysis.isLeast_convexHullPD` gives the minimality
  property.
* `ConvexAnalysis.FinitelyGenerated C` in `Numlib.Analysis.Convex.Polyhedral.Defs` states that $C =
  \operatorname{conv} P + \operatorname{cone} D$ for some finite sets $P$ and $D$. This is
  definitionally the statement that $C$ is `ConvexAnalysis.convexHullPD P D` for finite $P$ and $D$.
  That module does not import this one, and so it has its own copy of the homogenization results.
-/

open Set

open scoped Pointwise

namespace ConvexAnalysis

/-! ### The definition -/

section Defs

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {P P₁ P₂ D D₁ D₂ C : Set E} {x : E}

/-- **The convex hull of a set of points and directions.** For sets $P, D \subseteq E$,
$$\operatorname{conv}(P, D) = \operatorname{conv} P + \operatorname{cone} D,$$
where $\operatorname{cone} D$ is the convex cone generated by $D$, including the origin.

This is the formula of [rockafellar1970convex] for the smallest convex set that contains the
points $P$ and recedes in the direction of every vector of $D$;
`ConvexAnalysis.isLeast_convexHullPD` proves that the two agree. Directions are represented by
vectors, since $\operatorname{cone} D$ does not change when a generator is rescaled. The cone is
`PointedCone.hull ℝ D`. -/
def convexHullPD (P D : Set E) : Set E :=
  convexHull ℝ P + (PointedCone.hull ℝ D : Set E)

/-- The hull of points and directions is the Minkowski sum
$\operatorname{conv} P + \operatorname{cone} D$. -/
theorem convexHullPD_def (P D : Set E) :
    convexHullPD P D = convexHull ℝ P + (PointedCone.hull ℝ D : Set E) := rfl

/-- A point $x$ lies in $\operatorname{conv} P + \operatorname{cone} D$ if and only if $x = u + v$
with $u \in \operatorname{conv} P$ and $v \in \operatorname{cone} D$. -/
theorem mem_convexHullPD :
    x ∈ convexHullPD P D ↔
      ∃ u ∈ convexHull ℝ P, ∃ v ∈ (PointedCone.hull ℝ D : Set E), u + v = x :=
  Set.mem_add

/-- The convex hull of the points alone is contained in the hull of the points and directions:
$\operatorname{conv} P \subseteq \operatorname{conv} P + \operatorname{cone} D$. -/
theorem convexHull_subset_convexHullPD (P D : Set E) :
    convexHull ℝ P ⊆ convexHullPD P D := fun x hx =>
  ⟨x, hx, 0, zero_mem _, add_zero x⟩

/-- The points belong to the hull: $P \subseteq \operatorname{conv} P + \operatorname{cone} D$. -/
theorem subset_convexHullPD (P D : Set E) : P ⊆ convexHullPD P D :=
  (subset_convexHull ℝ P).trans (convexHull_subset_convexHullPD P D)

/-- With no directions, the hull is the ordinary convex hull: $\operatorname{conv} P +
\operatorname{cone} \emptyset = \operatorname{conv} P$. -/
@[simp]
theorem convexHullPD_empty_right (P : Set E) : convexHullPD P ∅ = convexHull ℝ P := by
  rw [convexHullPD, PointedCone.hull, Submodule.span_empty, Submodule.bot_coe]
  simp

/-- **A set of directions alone has empty convex hull**: $\operatorname{conv} \emptyset +
\operatorname{cone} D = \emptyset$. This is the convention of [rockafellar1970convex]. -/
@[simp]
theorem convexHullPD_empty_left (D : Set E) : convexHullPD (∅ : Set E) D = ∅ := by
  rw [convexHullPD, convexHull_empty, Set.empty_add]

/-- The hull $\operatorname{conv} P + \operatorname{cone} D$ is convex. -/
theorem convex_convexHullPD (P D : Set E) : Convex ℝ (convexHullPD P D) :=
  (convex_convexHull ℝ P).add ((PointedCone.hull ℝ D : ConvexCone ℝ E)).convex

/-- **The hull recedes in every direction of $\operatorname{cone} D$**: $\operatorname{cone} D$ is
contained in the recession cone of $\operatorname{conv} P + \operatorname{cone} D$. -/
theorem coneHull_subset_recessionCone_convexHullPD (P D : Set E) :
    (PointedCone.hull ℝ D : Set E) ⊆ recessionCone (convexHullPD P D) := by
  rintro y hy x ⟨u, hu, v, hv, rfl⟩ a ha
  refine ⟨u, hu, v + a • y, add_mem hv (Submodule.smul_mem _ (⟨a, ha⟩ : {c : ℝ // 0 ≤ c}) hy), ?_⟩
  change u + (v + a • y) = u + v + a • y
  rw [add_assoc]

/-- **The hull recedes in every direction of $D$**: $D$ is contained in the recession cone of
$\operatorname{conv} P + \operatorname{cone} D$. -/
theorem subset_recessionCone_convexHullPD (P D : Set E) :
    D ⊆ recessionCone (convexHullPD P D) :=
  PointedCone.subset_hull.trans (coneHull_subset_recessionCone_convexHullPD P D)

/-- **Minimality.** Let $C \subseteq E$ be convex, with $P \subseteq C$ and $D$ contained in the
recession cone of $C$. Then $\operatorname{conv} P + \operatorname{cone} D \subseteq C$. -/
theorem convexHullPD_min (hC : Convex ℝ C) (hP : P ⊆ C) (hD : D ⊆ recessionCone C) :
    convexHullPD P D ⊆ C := by
  have hcone : PointedCone.hull ℝ D ≤ recessionPointedCone C := Submodule.span_le.2 hD
  rintro x ⟨u, hu, v, hv, rfl⟩
  exact add_mem_of_mem_recessionCone (hcone hv) (convexHull_min hP hC hu)

/-- **The definition of $\operatorname{conv} S$ in [rockafellar1970convex].** The set
$\operatorname{conv} P + \operatorname{cone} D$ is the least element, for inclusion, of the
family of convex sets $C \subseteq E$ that contain $P$ and whose recession cone contains $D$. -/
theorem isLeast_convexHullPD (P D : Set E) :
    IsLeast {C : Set E | Convex ℝ C ∧ P ⊆ C ∧ D ⊆ recessionCone C} (convexHullPD P D) :=
  ⟨⟨convex_convexHullPD P D, subset_convexHullPD P D, subset_recessionCone_convexHullPD P D⟩,
    fun _ hC => convexHullPD_min hC.1 hC.2.1 hC.2.2⟩

/-- The hull is monotone in the points and in the directions: $P_1 \subseteq P_2$ and
$D_1 \subseteq D_2$ imply $\operatorname{conv} P_1 + \operatorname{cone} D_1 \subseteq
\operatorname{conv} P_2 + \operatorname{cone} D_2$. -/
theorem convexHullPD_mono (hP : P₁ ⊆ P₂) (hD : D₁ ⊆ D₂) :
    convexHullPD P₁ D₁ ⊆ convexHullPD P₂ D₂ :=
  convexHullPD_min (convex_convexHullPD P₂ D₂) (hP.trans (subset_convexHullPD P₂ D₂))
    (hD.trans (subset_recessionCone_convexHullPD P₂ D₂))

/-- The hull is monotone in the points: $P_1 \subseteq P_2$ implies $\operatorname{conv} P_1 +
\operatorname{cone} D \subseteq \operatorname{conv} P_2 + \operatorname{cone} D$. -/
theorem convexHullPD_mono_left (hP : P₁ ⊆ P₂) (D : Set E) :
    convexHullPD P₁ D ⊆ convexHullPD P₂ D := convexHullPD_mono hP Subset.rfl

/-- The hull is monotone in the directions: $D_1 \subseteq D_2$ implies $\operatorname{conv} P +
\operatorname{cone} D_1 \subseteq \operatorname{conv} P + \operatorname{cone} D_2$. -/
theorem convexHullPD_mono_right (P : Set E) (hD : D₁ ⊆ D₂) :
    convexHullPD P D₁ ⊆ convexHullPD P D₂ := convexHullPD_mono Subset.rfl hD

/-- Replacing the points $P$ by their convex hull does not change the hull of points and directions.
-/
@[simp]
theorem convexHullPD_convexHull (P D : Set E) :
    convexHullPD (convexHull ℝ P) D = convexHullPD P D := by
  rw [convexHullPD, convexHullPD, (convex_convexHull ℝ P).convexHull_eq]

/-- Replacing the directions $D$ by the cone that they generate does not change the hull of points
and directions. -/
@[simp]
theorem convexHullPD_coneHull (P D : Set E) :
    convexHullPD P (PointedCone.hull ℝ D : Set E) = convexHullPD P D := by
  rw [convexHullPD, convexHullPD, PointedCone.hull, PointedCone.hull,
    Submodule.span_coe_eq_restrictScalars]
  rfl

/-- The hull absorbs its own recession directions: $(\operatorname{conv} P + \operatorname{cone}
D) + \operatorname{cone} D = \operatorname{conv} P + \operatorname{cone} D$. -/
theorem convexHullPD_add_coneHull (P D : Set E) :
    convexHullPD P D + (PointedCone.hull ℝ D : Set E) = convexHullPD P D := by
  refine subset_antisymm ?_ (fun x hx => ⟨x, hx, 0, zero_mem _, add_zero x⟩)
  rintro x ⟨u, hu, v, hv, rfl⟩
  exact add_mem_of_mem_recessionCone
    (coneHull_subset_recessionCone_convexHullPD P D hv) hu

/-- The hull of one point $x$ and no directions is $\{x\}$. -/
@[simp]
theorem convexHullPD_singleton_empty (x : E) : convexHullPD ({x} : Set E) ∅ = {x} := by
  rw [convexHullPD_empty_right, convexHull_singleton]

/-- With the origin as the only point, the hull of points and directions is the cone:
$\operatorname{conv}\{0\} + \operatorname{cone} D = \operatorname{cone} D$. -/
@[simp]
theorem convexHullPD_zero_singleton (D : Set E) :
    convexHullPD ({(0 : E)} : Set E) D = (PointedCone.hull ℝ D : Set E) := by
  ext z
  rw [mem_convexHullPD, convexHull_singleton]
  constructor
  · rintro ⟨u, hu, v, hv, rfl⟩
    rw [Set.mem_singleton_iff] at hu
    subst hu
    simpa using hv
  · intro hz
    exact ⟨0, rfl, z, hz, by rw [zero_add]⟩

/-- The cone generated by a single vector $y$ is the ray $\{a y \mid a \ge 0\}$. -/
theorem coe_coneHull_singleton (y : E) :
    (PointedCone.hull ℝ ({y} : Set E) : Set E) = {z | ∃ a : ℝ, 0 ≤ a ∧ z = a • y} := by
  ext z
  rw [SetLike.mem_coe, PointedCone.hull, Submodule.mem_span_singleton]
  exact ⟨fun ⟨a, ha⟩ => ⟨a, a.2, ha.symm⟩, fun ⟨a, ha, hz⟩ => ⟨⟨a, ha⟩, hz.symm⟩⟩

/-- **The closed half-line** from $x$ in the direction of $y$:
$$\{x + a y \mid a \ge 0\}.$$

Half-line faces, and with them the extreme and exposed directions of a convex set, are stated
with it. -/
def halfLine (x y : E) : Set E := {z | ∃ a : ℝ, 0 ≤ a ∧ z = x + a • y}

/-- A point $z$ lies in the half-line from $x$ in the direction of $y$ if and only if $z = x + a y$
for some $a \ge 0$. -/
theorem mem_halfLine {x y z : E} : z ∈ halfLine x y ↔ ∃ a : ℝ, 0 ≤ a ∧ z = x + a • y := Iff.rfl

/-- A half-line is the convex hull of one point and one direction: $\operatorname{conv}\{x\} +
\operatorname{cone}\{y\}$ is the closed half-line from $x$ in the direction of $y$. -/
theorem convexHullPD_singleton (x y : E) : convexHullPD ({x} : Set E) {y} = halfLine x y := by
  ext z
  rw [convexHullPD, convexHull_singleton, coe_coneHull_singleton]
  constructor
  · rintro ⟨u, rfl, v, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨a, ha, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨x, rfl, a • y, ⟨a, ha, rfl⟩, rfl⟩

/-- The endpoint $x$ belongs to the half-line from $x$ in the direction of $y$. -/
theorem left_mem_halfLine (x y : E) : x ∈ halfLine x y := ⟨0, le_rfl, by rw [zero_smul, add_zero]⟩

/-- A half-line is convex. -/
theorem convex_halfLine (x y : E) : Convex ℝ (halfLine x y) := by
  rw [← convexHullPD_singleton]
  exact convex_convexHullPD _ _

/-- A half-line depends only on the direction of $y$: for $a > 0$, the half-lines from $x$ in the
directions of $a y$ and of $y$ are equal. -/
theorem halfLine_smul (x y : E) {a : ℝ} (ha : 0 < a) : halfLine x (a • y) = halfLine x y := by
  ext z
  constructor
  · rintro ⟨b, hb, rfl⟩
    exact ⟨b * a, by positivity, by rw [mul_smul]⟩
  · rintro ⟨b, hb, rfl⟩
    refine ⟨b / a, by positivity, ?_⟩
    rw [smul_smul, div_mul_cancel₀ _ ha.ne']

/-- The half-line from $x$ in the direction of $y$ recedes in the direction of $y$: $y$ lies in its
recession cone. -/
theorem mem_recessionCone_halfLine (x y : E) : y ∈ recessionCone (halfLine x y) := by
  rw [← convexHullPD_singleton]
  exact subset_recessionCone_convexHullPD _ _ rfl

/-- **The recession cone of a half-line is the ray of its direction**: the recession cone of the
half-line from $x$ in the direction of $y$ is $\{a y \mid a \ge 0\}$. -/
theorem recessionCone_halfLine (x y : E) :
    recessionCone (halfLine x y) = {z | ∃ a : ℝ, 0 ≤ a ∧ z = a • y} := by
  ext z
  constructor
  · intro hz
    have h := hz x (left_mem_halfLine x y) 1 zero_le_one
    rw [one_smul] at h
    obtain ⟨s, hs, hzs⟩ := h
    exact ⟨s, hs, add_left_cancel hzs⟩
  · rintro ⟨a, ha, rfl⟩
    exact smul_mem_recessionCone ha (mem_recessionCone_halfLine x y)

end Defs

/-! ### Homogenization -/

section Homogenize

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {P D : Set E}

/-- The cone in $\mathbb{R} \times E$ that consists of the pairs $(a, x)$ with $a > 0$ and $a^{-1} x
\in \operatorname{conv} P + \operatorname{cone} D$, together with the pairs $(0, x)$ with
$x \in \operatorname{cone} D$.

It is the cone over the hull, together with the directions at height $0$; it is the largest cone
whose slice at height $1$ is still the hull. It is an auxiliary object in the proof of
`ConvexAnalysis.convexHullPD_eq_slice`. -/
def coneOverPD (P D : Set E) : PointedCone ℝ (ℝ × E) where
  carrier := {p : ℝ × E | (0 < p.1 ∧ p.1⁻¹ • p.2 ∈ convexHullPD P D) ∨
    (p.1 = 0 ∧ p.2 ∈ (PointedCone.hull ℝ D : Set E))}
  add_mem' {p q} hp hq := by
    rcases hp with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩
    · rcases hq with ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩
      · -- two points at positive levels: a convex combination
        have hsum : 0 < p.1 + q.1 := add_pos hp1 hq1
        have hc1 : p.1 / (p.1 + q.1) * p.1⁻¹ = (p.1 + q.1)⁻¹ := by field_simp
        have hc2 : q.1 / (p.1 + q.1) * q.1⁻¹ = (p.1 + q.1)⁻¹ := by field_simp
        have hmem := convex_convexHullPD P D hp2 hq2 (a := p.1 / (p.1 + q.1))
          (b := q.1 / (p.1 + q.1)) (by positivity) (by positivity) (by field_simp)
        refine Or.inl ⟨by simpa using hsum, ?_⟩
        have hval : (p + q).1⁻¹ • (p + q).2
            = (p.1 / (p.1 + q.1)) • (p.1⁻¹ • p.2) + (q.1 / (p.1 + q.1)) • (q.1⁻¹ • q.2) := by
          rw [smul_smul, smul_smul, hc1, hc2, ← smul_add]
          rfl
        rw [hval]
        exact hmem
      · -- a point at a positive level plus a direction
        refine Or.inl ⟨by simpa [hq1] using hp1, ?_⟩
        have hfst : (p + q).1 = p.1 := by simp [hq1]
        rw [hfst, show (p + q).2 = p.2 + q.2 from rfl, smul_add]
        refine add_mem_of_mem_recessionCone
          (coneHull_subset_recessionCone_convexHullPD P D ?_) hp2
        exact Submodule.smul_mem _ (⟨p.1⁻¹, (inv_pos.2 hp1).le⟩ : {c : ℝ // 0 ≤ c}) hq2
    · rcases hq with ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩
      · refine Or.inl ⟨by simpa [hp1] using hq1, ?_⟩
        have hfst : (p + q).1 = q.1 := by simp [hp1]
        rw [hfst, show (p + q).2 = p.2 + q.2 from rfl, smul_add, add_comm]
        refine add_mem_of_mem_recessionCone
          (coneHull_subset_recessionCone_convexHullPD P D ?_) hq2
        exact Submodule.smul_mem _ (⟨q.1⁻¹, (inv_pos.2 hq1).le⟩ : {c : ℝ // 0 ≤ c}) hp2
      · exact Or.inr ⟨by simp [hp1, hq1], add_mem hp2 hq2⟩
  zero_mem' := Or.inr ⟨rfl, zero_mem _⟩
  smul_mem' a {p} hp := by
    rcases eq_or_lt_of_le a.2 with ha | ha
    · refine Or.inr ⟨?_, ?_⟩
      · change (a : ℝ) * p.1 = 0
        rw [← ha, zero_mul]
      · change (a : ℝ) • p.2 ∈ (PointedCone.hull ℝ D : Set E)
        rw [← ha, zero_smul]
        exact zero_mem _
    · rcases hp with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩
      · refine Or.inl ⟨mul_pos ha hp1, ?_⟩
        have hval : ((a : ℝ) * p.1)⁻¹ • ((a : ℝ) • p.2) = p.1⁻¹ • p.2 := by
          rw [smul_smul, mul_inv, mul_comm ((a : ℝ))⁻¹ p.1⁻¹, mul_assoc,
            inv_mul_cancel₀ ha.ne', mul_one]
        exact hval ▸ hp2
      · exact Or.inr ⟨by change (a : ℝ) * p.1 = 0; rw [hp1, mul_zero],
          Submodule.smul_mem _ a hp2⟩

/-- A pair $(a, x)$ lies in `ConvexAnalysis.coneOverPD P D` if and only if either $a > 0$ and
$a^{-1} x \in \operatorname{conv} P + \operatorname{cone} D$, or $a = 0$ and
$x \in \operatorname{cone} D$. -/
@[simp]
theorem mem_coneOverPD {p : ℝ × E} :
    p ∈ coneOverPD P D ↔ (0 < p.1 ∧ p.1⁻¹ • p.2 ∈ convexHullPD P D) ∨
      (p.1 = 0 ∧ p.2 ∈ (PointedCone.hull ℝ D : Set E)) := Iff.rfl

/-- **The homogenization of the hull.** Let $S' = (\{1\} \times P) \cup (\{0\} \times D) \subseteq
\mathbb{R} \times E$ be the copy of $P$ at height $1$ together with the copy of $D$ at height
$0$ (`ConvexAnalysis.liftPD P D`). Then
$$\{x \in E \mid (1, x) \in \operatorname{cone} S'\} = \operatorname{conv} P +
  \operatorname{cone} D,$$
where $\operatorname{cone} S'$ is the convex cone generated by $S'$, including the origin.

The set $S'$ is the set of the same name in [rockafellar1970convex]. Almost every proof about
the hull uses this identification. -/
theorem convexHullPD_eq_slice (P D : Set E) :
    {x : E | ((1 : ℝ), x) ∈ (PointedCone.hull ℝ (liftPD P D) : Set (ℝ × E))}
      = convexHullPD P D := by
  refine subset_antisymm (fun x hx => ?_) (fun x hx => lift_mem_coneHull_liftPD hx)
  have hle : PointedCone.hull ℝ (liftPD P D) ≤ coneOverPD P D := by
    refine Submodule.span_le.2 ?_
    rintro q (⟨y, hy, rfl⟩ | ⟨y, hy, rfl⟩)
    · refine Or.inl ⟨by norm_num, ?_⟩
      change ((1 : ℝ))⁻¹ • y ∈ convexHullPD P D
      rw [inv_one, one_smul]
      exact subset_convexHullPD P D hy
    · exact Or.inr ⟨rfl, PointedCone.subset_hull hy⟩
  rcases hle hx with ⟨-, h⟩ | ⟨h, -⟩
  · change ((1 : ℝ))⁻¹ • x ∈ convexHullPD P D at h
    rwa [inv_one, one_smul] at h
  · exact absurd h one_ne_zero

/-- A point $x$ lies in $\operatorname{conv} P + \operatorname{cone} D$ if and only if $(1, x)$ lies
in the convex cone generated by `ConvexAnalysis.liftPD P D`. -/
theorem mem_convexHullPD_iff_lift_mem {x : E} :
    x ∈ convexHullPD P D ↔ ((1 : ℝ), x) ∈ (PointedCone.hull ℝ (liftPD P D) : Set (ℝ × E)) := by
  rw [← convexHullPD_eq_slice P D]
  exact Iff.rfl

end Homogenize

/-! ### Half-lines in a normed space -/

section Normed

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- **A half-line in a nonzero direction is unbounded.** Let $E$ be a real normed space and
$y \neq 0$. Then the half-line from $x$ in the direction of $y$ is not bounded. -/
theorem not_isBounded_halfLine {x y : E} (hy : y ≠ 0) :
    ¬ Bornology.IsBounded (halfLine x y) := by
  intro hb
  obtain ⟨r, hr⟩ := hb.subset_closedBall x
  have hyn : 0 < ‖y‖ := norm_pos_iff.2 hy
  have hyne : ‖y‖ ≠ 0 := ne_of_gt hyn
  have hr0 : 0 ≤ r := by
    have h := Metric.mem_closedBall.1 (hr (left_mem_halfLine x y))
    simpa using h
  have hcnn : 0 ≤ (r + 1) / ‖y‖ := div_nonneg (by linarith) hyn.le
  have h := Metric.mem_closedBall.1 (hr (show x + ((r + 1) / ‖y‖) • y ∈ halfLine x y from
    ⟨(r + 1) / ‖y‖, hcnn, rfl⟩))
  rw [dist_eq_norm, show x + ((r + 1) / ‖y‖) • y - x = ((r + 1) / ‖y‖) • y by abel,
    norm_smul, Real.norm_eq_abs, abs_of_nonneg hcnn, div_mul_cancel₀ _ hyne] at h
  linarith

end Normed

/-! ### Carathéodory's theorem, and closedness -/

section FiniteDimensional

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {P D : Set E} {x : E}

/-- **Carathéodory's theorem for points and directions.** Let $E$ be a real normed space of finite
dimension $n$, and let $x \in \operatorname{conv} P + \operatorname{cone} D$. Then there are
finite sets $p \subseteq P$ and $d \subseteq D$ with $|p| + |d| \le n + 1$, and coefficients
$a_y > 0$ for $y \in p$ and $b_y > 0$ for $y \in d$, such that
$$\sum_{y \in p} a_y = 1, \qquad x = \sum_{y \in p} a_y y + \sum_{y \in d} b_y y.$$
-/
theorem exists_of_mem_convexHullPD (hx : x ∈ convexHullPD P D) :
    ∃ (p d : Finset E) (a b : E → ℝ), ↑p ⊆ P ∧ ↑d ⊆ D ∧
      (∀ y ∈ p, 0 < a y) ∧ (∀ y ∈ d, 0 < b y) ∧ ∑ y ∈ p, a y = 1 ∧
      p.card + d.card ≤ Module.finrank ℝ E + 1 ∧
      (∑ y ∈ p, a y • y) + ∑ y ∈ d, b y • y = x :=
  exists_of_mem_convexHull_add_coneHull hx

omit [FiniteDimensional ℝ E] in
/-- **The converse of `ConvexAnalysis.exists_of_mem_convexHullPD`.** Let $p \subseteq P$ and
$d \subseteq D$ be finite, and let $a_y \ge 0$ for $y \in p$ and $b_y \ge 0$ for $y \in d$, with
$\sum_{y \in p} a_y = 1$. Then $\sum_{y \in p} a_y y + \sum_{y \in d} b_y y \in
\operatorname{conv} P + \operatorname{cone} D$. -/
theorem sum_mem_convexHullPD {p d : Finset E} {a b : E → ℝ} (hp : ↑p ⊆ P) (hd : ↑d ⊆ D)
    (ha : ∀ y ∈ p, 0 ≤ a y) (hb : ∀ y ∈ d, 0 ≤ b y) (hsum : ∑ y ∈ p, a y = 1) :
    (∑ y ∈ p, a y • y) + ∑ y ∈ d, b y • y ∈ convexHullPD P D := by
  refine ⟨∑ y ∈ p, a y • y, ?_, ∑ y ∈ d, b y • y, ?_, rfl⟩
  · exact (convex_convexHull ℝ P).sum_mem ha hsum fun y hy => subset_convexHull ℝ P (hp hy)
  · exact Submodule.sum_mem _ fun y hy =>
      Submodule.smul_mem _ (⟨b y, hb y hy⟩ : {c : ℝ // 0 ≤ c}) (PointedCone.subset_hull (hd hy))

/-- **A closedness criterion.** Let $E$ be a finite-dimensional real normed space, let
$P \subseteq E$ be compact, and let $\operatorname{cone} D$ be closed. Then
$\operatorname{conv} P + \operatorname{cone} D$ is closed.

The convex hull of a compact set is compact, and the sum of a compact set and a closed set is
closed. -/
theorem _root_.IsCompact.isClosed_convexHullPD (hP : IsCompact P)
    (hD : IsClosed (PointedCone.hull ℝ D : Set E)) : IsClosed (convexHullPD P D) :=
  hD.add_left_of_isCompact (IsCompact.convexHull hP)

/-- Let $E$ be a finite-dimensional real normed space and $P \subseteq E$ compact. Then the hull of
$P$ with no directions is compact. -/
theorem _root_.IsCompact.isCompact_convexHullPD (hP : IsCompact P) :
    IsCompact (convexHullPD P (∅ : Set E)) := by
  rw [convexHullPD_empty_right]
  exact IsCompact.convexHull hP

end FiniteDimensional

/-! ### Vertices: affine independence, dimension, generalized simplices -/

section Vertices

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {P D : Set E}

/-- **The affine hull of a set of points and directions**: $\operatorname{aff} S =
\operatorname{aff}(\operatorname{conv} S)$, the affine span of
$\operatorname{conv} P + \operatorname{cone} D$.

It is the smallest affine set that contains the points of $S$ and recedes in all the directions
of $S$. -/
def affineSpanPD (P D : Set E) : AffineSubspace ℝ E := affineSpan ℝ (convexHullPD P D)

/-- **The dimension of a set of points and directions**: $\dim S = \dim(\operatorname{aff} S)$, the
dimension of the vector span of $\operatorname{conv} P + \operatorname{cone} D$.

[rockafellar1970convex] gives the empty set the dimension $-1$. A natural number cannot take
this value, so the dimension is $0$ for $P = \emptyset$, and every result about it has a
hypothesis that $P$ is nonempty. -/
noncomputable def finrankPD (P D : Set E) : ℕ :=
  Module.finrank ℝ (vectorSpan ℝ (convexHullPD P D))

/-- The dimension `ConvexAnalysis.finrankPD P D` is the dimension of the vector span of
$\operatorname{conv} P + \operatorname{cone} D$. -/
theorem finrankPD_def (P D : Set E) :
    finrankPD P D = Module.finrank ℝ (vectorSpan ℝ (convexHullPD P D)) := rfl

/-- The dimension `ConvexAnalysis.finrankPD P D` is the dimension of the direction space of
$\operatorname{aff} S$. -/
theorem finrankPD_eq_finrank_direction (P D : Set E) :
    finrankPD P D = Module.finrank ℝ (affineSpanPD P D).direction := by
  rw [finrankPD_def, affineSpanPD, direction_affineSpan]

/-- **A set of points and directions is affinely independent** if its homogenization
`ConvexAnalysis.liftPD P D`, with the points lifted to height $1$ and the directions to height
$0$, is linearly independent in $\mathbb{R} \times E$.

[rockafellar1970convex] defines the notion by the condition $\dim S = m - 1$ for a set of $m$
elements, and derives this criterion. Here the criterion is the definition, and
`ConvexAnalysis.finrankPD_add_one_of_affineIndepPD` gives the condition on the dimension. With
no directions, the notion is the affine independence of the points. -/
def AffineIndepPD (P D : Set E) : Prop := LinearIndepOn ℝ id (liftPD P D)

/-- A set of points and directions is affinely independent if and only if
`ConvexAnalysis.liftPD P D` is linearly independent. -/
theorem affineIndepPD_iff : AffineIndepPD P D ↔ LinearIndepOn ℝ id (liftPD P D) := Iff.rfl

/-- **A generalized $m$-dimensional simplex**: a set $C$ of the form
$\operatorname{conv} p + \operatorname{cone} d$, for finite sets $p$ of points and $d$ of
directions that are together affinely independent, with $|p| + |d| = m + 1$.

The points are its ordinary vertices, and the directions are its vertices at infinity. The
one-dimensional generalized simplices are the line segments and the closed half-lines. A
generalized simplex with a single ordinary vertex is a skew orthant. -/
def IsSimplexPD (m : ℕ) (C : Set E) : Prop :=
  ∃ p d : Finset E, AffineIndepPD (↑p : Set E) (↑d : Set E) ∧ p.card + d.card = m + 1 ∧
    C = convexHullPD (↑p : Set E) (↑d : Set E)

/-- The hull of $m + 1$ affinely independent points and directions is a generalized $m$-dimensional
simplex. -/
theorem isSimplexPD_convexHullPD {p d : Finset E} {m : ℕ}
    (hai : AffineIndepPD (↑p : Set E) (↑d : Set E)) (hcard : p.card + d.card = m + 1) :
    IsSimplexPD m (convexHullPD (↑p : Set E) (↑d : Set E)) :=
  ⟨p, d, hai, hcard, rfl⟩

omit [AddCommGroup E] [Module ℝ E] in
/-- For finite sets $p$ and $d$, the homogenization `ConvexAnalysis.liftPD p d` has exactly
$|p| + |d|$ elements.

The heights $1$ and $0$ keep the two families apart, and each lift is injective. -/
theorem ncard_liftPD_coe (p d : Finset E) :
    (liftPD (↑p : Set E) (↑d : Set E)).ncard = p.card + d.card := by
  have hf : Function.Injective (fun y : E => ((1 : ℝ), y)) := fun _ _ h => congrArg Prod.snd h
  have hg : Function.Injective (fun y : E => ((0 : ℝ), y)) := fun _ _ h => congrArg Prod.snd h
  have hdisj : Disjoint ((fun y : E => ((1 : ℝ), y)) '' (↑p : Set E))
      ((fun y : E => ((0 : ℝ), y)) '' (↑d : Set E)) := by
    rw [Set.disjoint_left]
    rintro q ⟨y, -, hyq⟩ ⟨z, -, hzq⟩
    have hyq' : ((1 : ℝ), y) = q := hyq
    have hzq' : ((0 : ℝ), z) = q := hzq
    have h1 : q.1 = 1 := by rw [← hyq']
    have h0 : q.1 = 0 := by rw [← hzq']
    rw [h1] at h0
    exact absurd h0 one_ne_zero
  rw [liftPD, Set.ncard_union_eq hdisj (p.finite_toSet.image _) (d.finite_toSet.image _),
    Set.ncard_image_of_injective _ hf, Set.ncard_image_of_injective _ hg,
    Set.ncard_coe_finset, Set.ncard_coe_finset]

end Vertices

/-! ### The hull as a union of simplices -/

section Simplices

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {P D : Set E}

/-- **The homogenization raises the dimension by exactly one.** Let $E$ be a finite-dimensional real
normed space and $P$ nonempty. Then the span of `ConvexAnalysis.liftPD P D` in
$\mathbb{R} \times E$ has dimension $\dim S + 1$.

This is the equation $\dim K = d + 1$ of [rockafellar1970convex]. For a fixed $x_0 \in P$, the
span is the direct sum of the line through $(1, x_0)$ and the copy at height $0$ of the
direction space of $\operatorname{aff} S$. -/
theorem finrank_span_liftPD (hP : P.Nonempty) :
    Module.finrank ℝ (Submodule.span ℝ (liftPD P D)) = finrankPD P D + 1 := by
  obtain ⟨x₀, hx₀⟩ := hP
  have hx₀C : x₀ ∈ convexHullPD P D := subset_convexHullPD P D hx₀
  have hinrInj : Function.Injective (LinearMap.inr ℝ ℝ E) := fun a b h => congrArg Prod.snd h
  have hone : ((1 : ℝ), x₀) ∈ Submodule.span ℝ (liftPD P D) :=
    Submodule.subset_span (mem_liftPD_one hx₀)
  have hliftC : ∀ y ∈ convexHullPD P D, ((1 : ℝ), y) ∈ Submodule.span ℝ (liftPD P D) :=
    fun y hy => Submodule.span_subset_span _ ℝ (liftPD P D) (lift_mem_coneHull_liftPD hy)
  -- the direction space of `aff S`, lifted to height `0`, lies in the span
  have hVW : vectorSpan ℝ (convexHullPD P D)
      ≤ (Submodule.span ℝ (liftPD P D)).comap (LinearMap.inr ℝ ℝ E) := by
    rw [vectorSpan_eq_span_vsub_set_right ℝ hx₀C]
    refine Submodule.span_le.2 ?_
    rintro v ⟨y, hy, hvy⟩
    have hv : v = y - x₀ := hvy.symm
    have hsplit : ((0 : ℝ), y - x₀) = ((1 : ℝ), y) - ((1 : ℝ), x₀) := by
      refine Prod.ext ?_ rfl
      change (0 : ℝ) = 1 - 1
      rw [sub_self]
    have hmem : LinearMap.inr ℝ ℝ E v ∈ Submodule.span ℝ (liftPD P D) := by
      rw [hv]
      change ((0 : ℝ), y - x₀) ∈ Submodule.span ℝ (liftPD P D)
      rw [hsplit]
      exact sub_mem (hliftC y hy) hone
    exact hmem
  -- and the span is exactly that sum
  have hkey : Submodule.span ℝ (liftPD P D)
      = Submodule.span ℝ {((1 : ℝ), x₀)}
        ⊔ (vectorSpan ℝ (convexHullPD P D)).map (LinearMap.inr ℝ ℝ E) := by
    refine le_antisymm (Submodule.span_le.2 ?_) (sup_le ?_ ?_)
    · rintro q (⟨y, hy, hqy⟩ | ⟨y, hy, hqy⟩)
      · have hq : q = ((1 : ℝ), y) := hqy.symm
        have hyV : y - x₀ ∈ vectorSpan ℝ (convexHullPD P D) :=
          vsub_mem_vectorSpan ℝ (subset_convexHullPD P D hy) hx₀C
        have hsplit : ((1 : ℝ), y) = ((1 : ℝ), x₀) + LinearMap.inr ℝ ℝ E (y - x₀) := by
          refine Prod.ext ?_ ?_
          · change (1 : ℝ) = 1 + 0
            rw [add_zero]
          · change y = x₀ + (y - x₀)
            rw [add_sub_cancel]
        rw [hq, hsplit]
        exact Submodule.add_mem _
          (Submodule.mem_sup_left (Submodule.mem_span_singleton_self _))
          (Submodule.mem_sup_right (Submodule.mem_map_of_mem hyV))
      · have hq : q = ((0 : ℝ), y) := hqy.symm
        have hmem : x₀ + (1 : ℝ) • y ∈ convexHullPD P D :=
          subset_recessionCone_convexHullPD P D hy x₀ hx₀C 1 zero_le_one
        rw [one_smul] at hmem
        have hyV : y ∈ vectorSpan ℝ (convexHullPD P D) := by
          have hy' : x₀ + y - x₀ ∈ vectorSpan ℝ (convexHullPD P D) :=
            vsub_mem_vectorSpan ℝ hmem hx₀C
          simpa using hy'
        rw [hq]
        exact Submodule.mem_sup_right (Submodule.mem_map_of_mem hyV)
    · rw [Submodule.span_le]
      rintro q hq
      rw [Set.mem_singleton_iff] at hq
      rw [hq]
      exact hone
    · rw [Submodule.map_le_iff_le_comap]
      exact hVW
  -- the two summands meet only at the origin
  have hdisj : Submodule.span ℝ {((1 : ℝ), x₀)}
      ⊓ (vectorSpan ℝ (convexHullPD P D)).map (LinearMap.inr ℝ ℝ E) = ⊥ := by
    refine le_antisymm (fun q hq => ?_) bot_le
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 hq.1
    obtain ⟨v, -, hvq⟩ := hq.2
    have h1 : q.1 = a := by rw [← ha]; simp
    have h2 : q.1 = 0 := by rw [← hvq]; rfl
    have ha0 : a = 0 := by rw [← h1]; exact h2
    rw [Submodule.mem_bot, ← ha, ha0, zero_smul]
  have hne0 : ((1 : ℝ), x₀) ≠ 0 := fun h => one_ne_zero (congrArg Prod.fst h)
  have hA : Module.finrank ℝ (Submodule.span ℝ {((1 : ℝ), x₀)}) = 1 :=
    finrank_span_singleton hne0
  have hB : Module.finrank ℝ ((vectorSpan ℝ (convexHullPD P D)).map (LinearMap.inr ℝ ℝ E))
      = finrankPD P D := by
    rw [finrankPD_def]
    exact LinearMap.finrank_map_of_injective _ hinrInj _
  have hsup := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span ℝ {((1 : ℝ), x₀)})
    ((vectorSpan ℝ (convexHullPD P D)).map (LinearMap.inr ℝ ℝ E))
  rw [← hkey, hdisj, finrank_bot, hA, hB, add_zero] at hsup
  omega

/-- Let $E$ be a finite-dimensional real normed space, and let $p$ and $d$ be finite sets of points
and directions, with $p$ nonempty and $(p, d)$ affinely independent. Then
$$\dim(p, d) + 1 = |p| + |d|.$$

[rockafellar1970convex] defines the affine independence of a mixed set by this condition on the
dimension. This result recovers that definition from the criterion of linear independence that
`ConvexAnalysis.AffineIndepPD` takes as the definition. -/
theorem finrankPD_add_one_of_affineIndepPD {p d : Finset E} (hp : (↑p : Set E).Nonempty)
    (hai : AffineIndepPD (↑p : Set E) (↑d : Set E)) :
    finrankPD (↑p : Set E) (↑d : Set E) + 1 = p.card + d.card := by
  have hfinite : Finite (↥(liftPD (↑p : Set E) (↑d : Set E))) :=
    LinearIndependent.finite_of_isNoetherian hai
  let : Fintype (↥(liftPD (↑p : Set E) (↑d : Set E))) := Fintype.ofFinite _
  have h1 := finrank_span_set_eq_card (R := ℝ) hai
  rw [finrank_span_liftPD hp] at h1
  rw [h1, ← Set.ncard_eq_toFinset_card', ncard_liftPD_coe]

/-- **A generalized $m$-dimensional simplex has dimension $m$.** Let $E$ be a finite-dimensional
real normed space, and let $C \subseteq E$ be a nonempty generalized $m$-dimensional simplex.
Then the vector span of $C$ has dimension $m$. -/
theorem finrank_vectorSpan_of_isSimplexPD {m : ℕ} {C : Set E} (hC : IsSimplexPD m C)
    (hne : C.Nonempty) : Module.finrank ℝ (vectorSpan ℝ C) = m := by
  obtain ⟨p, d, hai, hcard, rfl⟩ := hC
  have hp : (↑p : Set E).Nonempty := by
    rcases Set.eq_empty_or_nonempty (↑p : Set E) with h | h
    · rw [h, convexHullPD_empty_left] at hne
      exact absurd hne (by simp)
    · exact h
  have h := finrankPD_add_one_of_affineIndepPD hp hai
  rw [hcard] at h
  rw [← finrankPD_def]
  omega

/-- **The hull is the union of the generalized simplices with vertices in $S$.** Let $E$ be a
finite-dimensional real normed space and $P$ nonempty, and let $d = \dim S$. Then
$\operatorname{conv} P + \operatorname{cone} D$ is the union of the sets
$\operatorname{conv} p + \operatorname{cone} d'$ over all finite $p \subseteq P$ and
$d' \subseteq D$ that are affinely independent with $|p| + |d'| = d + 1$.

Carathéodory's theorem gives an independent family of at most $d + 1$ generators. The proof
extends this family to a basis of the span of `ConvexAnalysis.liftPD P D`, with the added
vectors taken from `ConvexAnalysis.liftPD P D` itself. This is possible because the span has
dimension exactly $d + 1$. -/
theorem convexHullPD_eq_iUnion_simplex (hP : P.Nonempty) :
    convexHullPD P D =
      ⋃ (p : Finset E) (d : Finset E) (_ : (↑p : Set E) ⊆ P) (_ : (↑d : Set E) ⊆ D)
        (_ : AffineIndepPD (↑p : Set E) (↑d : Set E))
        (_ : p.card + d.card = finrankPD P D + 1),
        convexHullPD (↑p : Set E) (↑d : Set E) := by
  refine subset_antisymm (fun x hx => ?_) ?_
  · obtain ⟨t, w, hts, hw, hli, hsum⟩ := exists_linearIndepOn_subset_liftPD hx
    obtain ⟨b, hbsub, htb, hspanb, hbli⟩ := exists_linearIndepOn_id_extension hli hts
    have hbfinite : Finite (↥b) := LinearIndependent.finite_of_isNoetherian hbli
    have hbfin : b.Finite := Set.toFinite b
    let : Fintype (↥b) := hbfin.fintype
    have hBcoe : (↑b.toFinset : Set (ℝ × E)) = b := Set.coe_toFinset b
    obtain ⟨p, d, hp, hd, hcard, hlift⟩ :=
      exists_finset_liftPD_eq (P := P) (D := D) (t := b.toFinset) (by rw [hBcoe]; exact hbsub)
    rw [hBcoe] at hlift
    -- the padded family has exactly `d + 1` members
    have hspaneq : Submodule.span ℝ b = Submodule.span ℝ (liftPD P D) :=
      le_antisymm (Submodule.span_mono hbsub) (Submodule.span_le.2 hspanb)
    have hcount : b.toFinset.card = finrankPD P D + 1 := by
      have h1 := finrank_span_set_eq_card (R := ℝ) hbli
      rw [hspaneq, finrank_span_liftPD (D := D) hP] at h1
      omega
    -- the point still lies in the hull of the padded family
    have hmem : x ∈ convexHullPD (↑p : Set E) (↑d : Set E) := by
      refine mem_convexHullPD_iff_lift_mem.2 ?_
      rw [← hsum]
      refine Submodule.sum_mem _ fun q hq => ?_
      have hqmem : q ∈ liftPD (↑p : Set E) (↑d : Set E) := by
        rw [hlift]
        exact htb (Finset.mem_coe.2 hq)
      exact Submodule.smul_mem _ (⟨w q, (hw q hq).le⟩ : {c : ℝ // 0 ≤ c})
        (PointedCone.subset_hull hqmem)
    have hai : AffineIndepPD (↑p : Set E) (↑d : Set E) := by
      change LinearIndepOn ℝ id (liftPD (↑p : Set E) (↑d : Set E))
      rw [hlift]
      exact hbli
    simp only [Set.mem_iUnion, exists_prop]
    exact ⟨p, d, hp, hd, hai, by rw [hcard, hcount], hmem⟩
  · refine Set.iUnion_subset fun p => Set.iUnion_subset fun d => Set.iUnion_subset fun hp =>
      Set.iUnion_subset fun hd => Set.iUnion_subset fun _ => Set.iUnion_subset fun _ => ?_
    exact convexHullPD_mono hp hd

end Simplices

end ConvexAnalysis
