import Mathlib.Data.EReal.Inv
import Mathlib.Geometry.Convex.Cone.Basic
import Mathlib.Topology.Algebra.ConstMulAction
import Numlib.Analysis.Convex.Indicator

/-!
# Positively homogeneous convex functions

Let $E$ be a real vector space. A function $f \colon E \to [-\infty, +\infty]$ is **positively
homogeneous** if $f(ax) = a f(x)$ for every $x \in E$ and every $a > 0$, that is, if its epigraph is
a cone. For such a function with values in $(-\infty, +\infty]$, convexity is equivalent to
**subadditivity**, $f(x + y) \le f(x) + f(y)$, and the theory of support functions and gauges rests
on this equivalence. A positively homogeneous convex function is linear on a subspace $L$ if and
only if $f(-x) = -f(x)$ for all $x \in L$, and it suffices to check this on a nonempty spanning set
of $L$. The presentation follows [rockafellar1970convex], §2 and §4.

The definition constrains only positive multipliers. It says nothing about $f(0)$ beyond
$f(0) \in \{0, +\infty, -\infty\}$, and the value $f(0) = +\infty$ does occur: the indicator
function $\delta(\cdot \mid C)$ of a convex cone $C$ that does not contain the origin is positively
homogeneous and proper. For this reason the form of subadditivity for finite combinations needs a
nonempty index set, because the empty sum would assert $f(0) \le 0$. The form of the linearity
criterion for spanning sets needs a nonempty set for the same reason.

## Main definitions

* `ConvexAnalysis.IsCone`: a set closed under multiplication by positive scalars.
* `ConvexAnalysis.PosHomogeneous`: $f(ax) = a f(x)$ for every $a > 0$.

## Main results

* `ConvexAnalysis.posHomogeneous_iff_isCone_epi`: $f$ is positively homogeneous if and only if its
  epigraph is a cone.
* `ConvexAnalysis.convex_iff_add_mem_of_isCone`: a cone is convex if and only if it is closed under
  addition.
* `ConvexAnalysis.span_eq_sub_of_isCone`: the linear subspace generated by a convex cone $s$ that
  contains the origin is $s - s$.
* `ConvexAnalysis.smul_closure_eq_of_isCone`: the closure of a cone is a cone.
* `ConvexAnalysis.PosHomogeneous.convexFn_iff_subadditive`: a positively homogeneous $f$ with values
  in $(-\infty, +\infty]$ is convex if and only if it is subadditive.
* `ConvexAnalysis.PosHomogeneous.sum_le`: $f\bigl(\sum_i a_i x_i\bigr) \le \sum_i a_i f(x_i)$ for a
  nonempty finite family with $a_i > 0$.
* `ConvexAnalysis.PosHomogeneous.neg_le`: $-f(x) \le f(-x)$.
* `ConvexAnalysis.PosHomogeneous.neg_eq_of_mem_span`: if $f(-b) = -f(b)$ on a nonempty set $s$, then
  $f(-x) = -f(x)$ on the span of $s$.
* `ConvexAnalysis.PosHomogeneous.isLinearOn_iff`,
  `ConvexAnalysis.PosHomogeneous.exists_linearMap_iff`: $f$ is linear on a subspace $L$ if and only
  if $f(-x) = -f(x)$ for all $x \in L$.

## Implementation notes

* The equivalence of convexity and subadditivity is for functions with values in
  $(-\infty, +\infty]$. This hypothesis is written inline as `∀ x, f x ≠ ⊥`.
* There is no instance `SMul ℝ EReal`, so positive homogeneity is written with the product
  `(a : EReal) * z` and not with a scalar action on `EReal`.
* The span of a convex cone that contains the origin is also its affine hull, by
  `vectorSpan_eq_span_of_zero_mem`.
-/

open Set Pointwise

namespace ConvexAnalysis

/-!
### Cones

A **cone**, in the sense of Rockafellar, is a set that is closed under multiplication by positive
scalars. It need not contain the origin. The definition `ConvexAnalysis.IsCone` is the membership
form of Mathlib's `ConvexCone.smul_mem'`. `ConvexAnalysis.isCone_iff_smul_eq` gives the set form
$as = s$ for all $a > 0$, which is the form of `ConvexAnalysis.posHomogeneous_iff_isCone_epi`.
-/

section Cone

variable {M : Type*} [AddCommGroup M] [Module ℝ M] {s : Set M}

/-- A **cone** is a set $s$ such that $ax \in s$ for every $x \in s$ and every real $a > 0$. A cone
need not contain the origin, and it need not be convex. -/
def IsCone (s : Set M) : Prop :=
  ∀ ⦃a : ℝ⦄, 0 < a → ∀ ⦃x⦄, x ∈ s → a • x ∈ s

/-- A set $s$ is a cone if and only if $as = s$ for every real $a > 0$. -/
theorem isCone_iff_smul_eq : IsCone s ↔ ∀ a : ℝ, 0 < a → a • s = s := by
  constructor
  · intro h a ha
    refine Set.Subset.antisymm ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact h ha hx
    · intro x hx
      refine ⟨a⁻¹ • x, h (inv_pos.2 ha) hx, ?_⟩
      simp [smul_smul, mul_inv_cancel₀ ha.ne']
  · intro h a ha x hx
    rw [← h a ha]
    exact ⟨x, hx, rfl⟩

/-- If $s$ is a cone and $a > 0$, then $as = s$. -/
theorem IsCone.smul_set_eq (hs : IsCone s) (a : ℝ) (ha : 0 < a) : a • s = s :=
  isCone_iff_smul_eq.1 hs a ha

/-- If $s$ is a cone, $a > 0$ and $x \in s$, then $ax \in s$. -/
theorem IsCone.smul_mem (hs : IsCone s) {a : ℝ} (ha : 0 < a) {x : M} (hx : x ∈ s) : a • x ∈ s :=
  hs ha hx

/-- If $s$ is a cone and $a > 0$, then $ax \in s$ if and only if $x \in s$. -/
theorem smul_mem_iff_of_isCone (hs : IsCone s) {a : ℝ} (ha : 0 < a) {x : M} :
    a • x ∈ s ↔ x ∈ s := by
  conv_lhs => rw [← hs.smul_set_eq a ha]
  exact Set.smul_mem_smul_set_iff₀ ha.ne' s x

/-- **A cone is convex if and only if it is closed under addition.** Let $s$ be a cone. Then $s$ is
convex if and only if $x + y \in s$ for all $x, y \in s$.

The forward direction uses $x + y = 2 \cdot \tfrac12 (x + y)$. -/
theorem convex_iff_add_mem_of_isCone (hs : IsCone s) :
    Convex ℝ s ↔ ∀ x ∈ s, ∀ y ∈ s, x + y ∈ s := by
  constructor
  · intro hconv x hx y hy
    have hmid : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y ∈ s :=
      hconv hx hy (by norm_num) (by norm_num) (by norm_num)
    have h2 : (2 : ℝ) • ((1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y) ∈ (2 : ℝ) • s :=
      Set.smul_mem_smul_set hmid
    rw [hs.smul_set_eq 2 two_pos] at h2
    have harith : (2 : ℝ) • ((1 / 2 : ℝ) • x + (1 / 2 : ℝ) • y) = x + y := by
      rw [smul_add, smul_smul, smul_smul]; norm_num
    rwa [harith] at h2
  · intro hadd
    exact ConvexCone.convex
      ⟨s, fun c hc x hx => by rw [← hs.smul_set_eq c hc]; exact Set.smul_mem_smul_set hx,
        fun x hx y hy => hadd x hx y hy⟩

/-- **The positive multiples of a set, together with the origin, form a cone.** For every set $S$
and every $a > 0$,
$$a \Bigl(\{0\} \cup \bigcup_{b > 0} bS\Bigr) = \{0\} \cup \bigcup_{b > 0} bS.$$
This is the cone generated by $S$ before convexity enters. `ConvexAnalysis.homCone` and
`ConvexAnalysis.posHomGenCone` are instances of it. -/
theorem smul_zero_union_iUnion_smul {a : ℝ} (ha : 0 < a) (S : Set M) :
    a • ({0} ∪ ⋃ b > (0 : ℝ), b • S) = {0} ∪ ⋃ b > (0 : ℝ), b • S := by
  ext q
  have hmem : ∀ p : M, p ∈ ({0} ∪ ⋃ b > (0 : ℝ), b • S) ↔ p = 0 ∨ ∃ b > (0 : ℝ), p ∈ b • S :=
    fun p => by simp
  rw [Set.mem_smul_set_iff_inv_smul_mem₀ ha.ne', hmem, hmem]
  constructor
  · rintro (h | ⟨b, hb, hq⟩)
    · left
      have hz : a • (a⁻¹ • q) = a • (0 : M) := by rw [h]
      rwa [smul_inv_smul₀ ha.ne', smul_zero] at hz
    · refine Or.inr ⟨a * b, mul_pos ha hb, ?_⟩
      have hmem' : a • (a⁻¹ • q) ∈ a • (b • S) := Set.smul_mem_smul_set hq
      rwa [smul_inv_smul₀ ha.ne', smul_smul] at hmem'
  · rintro (rfl | ⟨b, hb, hq⟩)
    · exact Or.inl (smul_zero _)
    · refine Or.inr ⟨a⁻¹ * b, mul_pos (inv_pos.2 ha) hb, ?_⟩
      rw [← smul_smul]
      exact Set.smul_mem_smul_set hq

/-- **The subspace generated by a convex cone that contains the origin is the set of its
differences.** Let $s$ be a convex cone with $0 \in s$. Then
$$\operatorname{span} s = s - s.$$

Closure under addition and positive scaling collects the positive terms of a linear combination
into one element of $s$, and the negative terms into another. With
`vectorSpan_eq_span_of_zero_mem`, the span, the affine hull and $s - s$ coincide. -/
theorem span_eq_sub_of_isCone (hs : IsCone s) (hconv : Convex ℝ s)
    (h0 : (0 : M) ∈ s) : (Submodule.span ℝ s : Set M) = s - s := by
  have hadd := (convex_iff_add_mem_of_isCone hs).1 hconv
  have hsmul : ∀ a : ℝ, 0 < a → ∀ x ∈ s, a • x ∈ s := fun a ha x hx =>
    (smul_mem_iff_of_isCone hs ha).2 hx
  refine Set.Subset.antisymm (fun z hz => ?_) ?_
  · induction hz using Submodule.span_induction with
    | mem w hw => exact ⟨w, hw, 0, h0, by simp⟩
    | zero => exact ⟨0, h0, 0, h0, by simp⟩
    | add u v _ _ hu hv =>
        obtain ⟨x₁, hx₁, y₁, hy₁, rfl⟩ := hu
        obtain ⟨x₂, hx₂, y₂, hy₂, rfl⟩ := hv
        exact ⟨x₁ + x₂, hadd _ hx₁ _ hx₂, y₁ + y₂, hadd _ hy₁ _ hy₂, by module⟩
    | smul c u _ hu =>
        obtain ⟨x, hx, y, hy, rfl⟩ := hu
        rcases lt_trichotomy c 0 with hc | hc | hc
        · exact ⟨(-c) • y, hsmul _ (by linarith) y hy, (-c) • x, hsmul _ (by linarith) x hx,
            by module⟩
        · subst hc
          exact ⟨0, h0, 0, h0, by simp⟩
        · exact ⟨c • x, hsmul c hc x hx, c • y, hsmul c hc y hy, by module⟩
  · rintro _ ⟨x, hx, y, hy, rfl⟩
    exact (Submodule.span ℝ s).sub_mem (Submodule.subset_span hx) (Submodule.subset_span hy)

end Cone

section ConeClosure

variable {M : Type*} [AddCommGroup M] [Module ℝ M] [TopologicalSpace M]
  [ContinuousConstSMul ℝ M] {s : Set M}

/-- **The closure of a cone is a cone.** Let $M$ be a real vector space with a topology in which
each scaling $x \mapsto ax$ is continuous, and let $s \subseteq M$ be a cone. Then for every
$a > 0$,
$$a \operatorname{cl} s = \operatorname{cl} s.$$

Multiplication by a nonzero scalar is a homeomorphism, so it commutes with closure. Convexity
plays no part, and only the continuity of each scaling is used, not a topological vector space
structure. -/
theorem smul_closure_eq_of_isCone (hs : IsCone s) (a : ℝ) (ha : 0 < a) :
    a • closure s = closure s := by
  rw [← closure_smul₀' ha.ne' s, hs.smul_set_eq a ha]

end ConeClosure

/-! ### Positively homogeneous functions -/

section Module

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- A function $f \colon E \to [-\infty, +\infty]$ is **positively homogeneous** (of degree one) if
$$f(ax) = a f(x) \quad \text{for every } x \in E \text{ and every real } a > 0.$$
Only positive scalars are constrained. In particular $f(0)$ is not determined: see
`ConvexAnalysis.PosHomogeneous.map_zero_trichotomy`. -/
def PosHomogeneous (f : E → EReal) : Prop :=
  ∀ (a : ℝ), 0 < a → ∀ x, f (a • x) = (a : EReal) * f x

variable {f : E → EReal}

/-- If $f$ is positively homogeneous, then $f(0) = 0$, $f(0) = +\infty$ or $f(0) = -\infty$.

Rockafellar notes the same: for a positively homogeneous function, $f(0)$ can be $0$ or
$-\infty$, and also $+\infty$ when improper functions are admitted. -/
theorem PosHomogeneous.map_zero_trichotomy (hf : PosHomogeneous f) :
    f 0 = 0 ∨ f 0 = ⊤ ∨ f 0 = ⊥ := by
  refine EReal.eq_zero_or_eq_top_or_eq_bot (a := 2) (by norm_num) ?_
  have h := hf 2 two_pos 0
  rw [smul_zero] at h
  exact h.symm

/-- If $f$ is positively homogeneous and $f(0) \neq -\infty$, then $f(0) \ge 0$. -/
theorem PosHomogeneous.zero_le_map_zero (hf : PosHomogeneous f) (h : f 0 ≠ ⊥) : 0 ≤ f 0 := by
  rcases hf.map_zero_trichotomy with h0 | h0 | h0
  · exact h0.ge
  · exact h0 ▸ le_top
  · exact absurd h0 h

/-- **A function is positively homogeneous if and only if its epigraph is a cone.** For
$f \colon E \to [-\infty, +\infty]$, $f$ is positively homogeneous if and only if
$a \operatorname{epi} f = \operatorname{epi} f$ for every real $a > 0$.

The epigraph is `ConvexAnalysis.epi f`, a subset of $E \times \mathbb{R}$. -/
theorem posHomogeneous_iff_isCone_epi :
    PosHomogeneous f ↔ ∀ a : ℝ, 0 < a → a • epi f = epi f := by
  constructor
  · intro hf a ha
    have hainv : 0 < a⁻¹ := inv_pos.2 ha
    ext p
    rw [Set.mem_smul_set_iff_inv_smul_mem₀ ha.ne']
    simp only [mem_epi, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    rw [hf a⁻¹ hainv, EReal.coe_mul, EReal.coe_mul_le_coe_mul_iff hainv]
  · intro hcone a ha x
    refine EReal.eq_of_forall_le_coe_iff fun r => ?_
    have hsmul : a • ((x, r / a) : E × ℝ) = ((a • x, r) : E × ℝ) := by
      have : a • (r / a) = r := by
        rw [smul_eq_mul, mul_div_cancel₀ r ha.ne']
      rw [Prod.smul_mk, this]
    have hmem := smul_mem_iff_of_isCone (isCone_iff_smul_eq.2 hcone) ha (x := ((x, r / a) : E × ℝ))
      (s := epi f)
    rw [hsmul] at hmem
    simp only [mk_mem_epi] at hmem
    exact hmem.trans (EReal.coe_mul_le_coe_iff ha).symm

/-- The indicator function $\delta(\cdot \mid s)$ of a set $s$ is positively homogeneous if and only
if $as = s$ for every $a > 0$, that is, if and only if $s$ is a cone. -/
theorem posHomogeneous_indicatorFn {s : Set E} :
    PosHomogeneous (indicatorFn s) ↔ ∀ a : ℝ, 0 < a → a • s = s := by
  constructor
  · intro h a ha
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      by_contra hc
      have hay := h a ha y
      rw [indicatorFn_of_mem hy, mul_zero, indicatorFn_of_notMem hc] at hay
      exact absurd hay (by simp)
    · intro hx
      refine ⟨a⁻¹ • x, ?_, smul_inv_smul₀ ha.ne' x⟩
      by_contra hc
      have hax := h a ha (a⁻¹ • x)
      rw [smul_inv_smul₀ ha.ne', indicatorFn_of_mem hx, indicatorFn_of_notMem hc,
        EReal.coe_mul_top_of_pos ha] at hax
      exact absurd hax (by simp)
  · intro h a ha x
    replace h := isCone_iff_smul_eq.2 h
    by_cases hx : x ∈ s
    · rw [indicatorFn_of_mem hx, indicatorFn_of_mem ((smul_mem_iff_of_isCone h ha).2 hx), mul_zero]
    · rw [indicatorFn_of_notMem hx,
        indicatorFn_of_notMem fun hc => hx ((smul_mem_iff_of_isCone h ha).1 hc),
        EReal.coe_mul_top_of_pos ha]

/-! ### Convexity is subadditivity -/

/-- **A positively homogeneous function is convex if and only if it is subadditive.** Let
$f \colon E \to (-\infty, +\infty]$ be positively homogeneous. Then $f$ is convex if and only if
$$f(x + y) \le f(x) + f(y) \quad \text{for all } x, y \in E.$$

Subadditivity of $f$ is the closure of the cone $\operatorname{epi} f$ under addition. -/
theorem PosHomogeneous.convexFn_iff_subadditive (hf : PosHomogeneous f) (hbot : ∀ x, f x ≠ ⊥) :
    ConvexFn f ↔ ∀ x y, f (x + y) ≤ f x + f y := by
  rw [convexFn_iff_convex_epi,
    convex_iff_add_mem_of_isCone (isCone_iff_smul_eq.2 (posHomogeneous_iff_isCone_epi.1 hf))]
  constructor
  · intro hadd x y
    rcases eq_top_or_lt_top (f x) with hx | hx
    · rw [hx, EReal.top_add_of_ne_bot (hbot y)]; exact le_top
    rcases eq_top_or_lt_top (f y) with hy | hy
    · rw [hy, EReal.add_top_of_ne_bot (hbot x)]; exact le_top
    obtain ⟨p, hp⟩ := EReal.exists_coe_of_ne_bot_of_lt_top (hbot x) hx
    obtain ⟨q, hq⟩ := EReal.exists_coe_of_ne_bot_of_lt_top (hbot y) hy
    have hmem : ((x, p) + (y, q) : E × ℝ) ∈ epi f :=
      hadd _ (by simp [hp]) _ (by simp [hq])
    simp only [mem_epi, Prod.fst_add, Prod.snd_add] at hmem
    rw [hp, hq, ← EReal.coe_add]
    exact hmem
  · intro hsub p hp q hq
    simp only [mem_epi, Prod.fst_add, Prod.snd_add] at hp hq ⊢
    refine (hsub p.1 q.1).trans ?_
    calc f p.1 + f q.1 ≤ (p.2 : EReal) + (q.2 : EReal) := add_le_add hp hq
      _ = ((p.2 + q.2 : ℝ) : EReal) := (EReal.coe_add _ _).symm

/-! ### Finite combinations, and the value at $-x$ -/

/-- **Subadditivity extends to positive linear combinations.** Let
$f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. Let $s$ be a nonempty
finite index set, let $a_i > 0$ for $i \in s$, and let $x_i \in E$. Then
$$f\Bigl(\sum_{i \in s} a_i x_i\Bigr) \le \sum_{i \in s} a_i f(x_i).$$

The index set must be nonempty: the empty sum would assert $f(0) \le 0$, and $f(0) = +\infty$ is
possible. -/
theorem PosHomogeneous.sum_le (hf : PosHomogeneous f) (hconv : ConvexFn f) (hbot : ∀ x, f x ≠ ⊥)
    {ι : Type*} {s : Finset ι} (hs : s.Nonempty) {a : ι → ℝ} (ha : ∀ i ∈ s, 0 < a i) (x : ι → E) :
    f (∑ i ∈ s, a i • x i) ≤ ∑ i ∈ s, (a i : EReal) * f (x i) := by
  have hsub := (hf.convexFn_iff_subadditive hbot).1 hconv
  induction hs using Finset.Nonempty.cons_induction with
  | singleton i =>
    rw [Finset.sum_singleton, Finset.sum_singleton]
    exact le_of_eq (hf (a i) (ha i (by simp)) (x i))
  | cons j t hj ht ih =>
    rw [Finset.sum_cons, Finset.sum_cons]
    refine (hsub _ _).trans (add_le_add ?_ ?_)
    · exact le_of_eq (hf (a j) (ha j (by simp)) (x j))
    · exact ih fun i hi => ha i (by simp [hi])

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. Then for every
$x \in E$,
$$-f(x) \le f(-x).$$
-/
theorem PosHomogeneous.neg_le (hf : PosHomogeneous f) (hconv : ConvexFn f) (hbot : ∀ x, f x ≠ ⊥)
    (x : E) : -(f x) ≤ f (-x) := by
  have hsub := (hf.convexFn_iff_subadditive hbot).1 hconv
  have h := hsub x (-x)
  rw [add_neg_cancel] at h
  exact EReal.neg_le_of_zero_le_add (hbot x) ((hf.zero_le_map_zero (hbot 0)).trans h)

/-! ### Linearity on a subspace -/

omit [Module ℝ E] in
/-- Let $f$ take values in $(-\infty, +\infty]$. If $f(-x) = -f(x)$ at a point $x$, then
$f(x) < +\infty$. -/
theorem ne_top_of_neg_eq (hbot : ∀ x, f x ≠ ⊥) {x : E} (h : f (-x) = -(f x)) : f x ≠ ⊤ := by
  intro htop
  exact hbot (-x) (by rw [h, htop, EReal.neg_top])

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. If $f(-b) = -f(b)$
for some $b$, then $f(0) = 0$. -/
theorem PosHomogeneous.map_zero_eq_zero (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {b : E} (hb : f (-b) = -(f b)) : f 0 = 0 := by
  have hsub := (hf.convexFn_iff_subadditive hbot).1 hconv
  refine le_antisymm ?_ (hf.zero_le_map_zero (hbot 0))
  obtain ⟨r, hr⟩ := EReal.exists_coe_of_ne_bot_of_lt_top (hbot b)
    (lt_top_iff_ne_top.2 (ne_top_of_neg_eq hbot hb))
  have h := hsub b (-b)
  rw [add_neg_cancel, hb, hr, ← EReal.coe_neg, ← EReal.coe_add, add_neg_cancel,
    EReal.coe_zero] at h
  exact h

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. Then
$f(-x) = -f(x)$ if and only if $f(-x) \le -f(x)$, because $-f(x) \le f(-x)$ always holds. -/
theorem PosHomogeneous.neg_eq_iff_le (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {x : E} : f (-x) = -(f x) ↔ f (-x) ≤ -(f x) :=
  ⟨le_of_eq, fun h => le_antisymm h (hf.neg_le hconv hbot x)⟩

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex, and let
$f(-x) = -f(x)$. Then $f(cx) = c f(x)$ for every real $c$, not only for $c > 0$. -/
theorem PosHomogeneous.map_smul_of_neg_eq (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {x : E} (hx : f (-x) = -(f x)) (c : ℝ) :
    f (c • x) = (c : EReal) * f x := by
  rcases lt_trichotomy c 0 with hc | rfl | hc
  · have hcx : (-c) • (-x) = c • x := by rw [neg_smul, smul_neg, neg_neg]
    rw [← hcx, hf (-c) (neg_pos.2 hc) (-x), hx, EReal.coe_neg, neg_mul_neg]
  · rw [zero_smul, hf.map_zero_eq_zero hconv hbot hx, EReal.coe_zero, zero_mul]
  · exact hf c hc x

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. If $f(-x) = -f(x)$
and $f(-y) = -f(y)$, then $f(x + y) = f(x) + f(y)$. -/
theorem PosHomogeneous.map_add_of_neg_eq (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {x y : E} (hx : f (-x) = -(f x)) (hy : f (-y) = -(f y)) :
    f (x + y) = f x + f y := by
  have hsub := (hf.convexFn_iff_subadditive hbot).1 hconv
  refine le_antisymm (hsub x y) ?_
  have h1 : f (-(x + y)) ≤ -(f x + f y) := by
    rw [neg_add x y,
      EReal.neg_add (Or.inl (hbot x)) (Or.inl (ne_top_of_neg_eq hbot hx))]
    calc f (-x + -y) ≤ f (-x) + f (-y) := hsub _ _
      _ = -(f x) + -(f y) := by rw [hx, hy]
  have h2 := hf.neg_le hconv hbot (-(x + y))
  rw [neg_neg] at h2
  calc f x + f y = -(-(f x + f y)) := (neg_neg _).symm
    _ ≤ -f (-(x + y)) := by rwa [EReal.neg_le_neg_iff]
    _ ≤ f (x + y) := h2

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. If $f(-x) = -f(x)$
and $f(-y) = -f(y)$, then $f(-(x + y)) = -f(x + y)$. -/
theorem PosHomogeneous.neg_eq_add (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {x y : E} (hx : f (-x) = -(f x)) (hy : f (-y) = -(f y)) :
    f (-(x + y)) = -(f (x + y)) := by
  have hnx : f (-(-x)) = -(f (-x)) := by rw [neg_neg, hx, neg_neg]
  have hny : f (-(-y)) = -(f (-y)) := by rw [neg_neg, hy, neg_neg]
  rw [neg_add x y, hf.map_add_of_neg_eq hconv hbot hnx hny,
    hf.map_add_of_neg_eq hconv hbot hx hy, hx, hy,
    EReal.neg_add (Or.inl (hbot x)) (Or.inl (ne_top_of_neg_eq hbot hx)),
    sub_eq_add_neg]

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex. If
$f(-x) = -f(x)$, then $f(-(cx)) = -f(cx)$ for every real $c$. -/
theorem PosHomogeneous.neg_eq_smul (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {x : E} (hx : f (-x) = -(f x)) (c : ℝ) :
    f (-(c • x)) = -(f (c • x)) := by
  have hnx : f (-(-x)) = -(f (-x)) := by rw [neg_neg, hx, neg_neg]
  rw [← smul_neg, hf.map_smul_of_neg_eq hconv hbot hnx c, hx,
    hf.map_smul_of_neg_eq hconv hbot hx c, mul_neg]

/-- **Oddness on a set extends to its span.** Let $f \colon E \to (-\infty, +\infty]$ be positively
homogeneous and convex, and let $s \subseteq E$ be nonempty with $f(-b) = -f(b)$ for every
$b \in s$. Then
$$f(-x) = -f(x) \quad \text{for every } x \in \operatorname{span} s.$$

The set $s$ must be nonempty: this gives $f(0) = 0$, which is needed when a coefficient of the
linear combination vanishes. -/
theorem PosHomogeneous.neg_eq_of_mem_span (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {s : Set E} (hs : s.Nonempty) (hb : ∀ b ∈ s, f (-b) = -(f b)) {x : E}
    (hx : x ∈ Submodule.span ℝ s) : f (-x) = -(f x) := by
  obtain ⟨b, hbs⟩ := hs
  have h0 : f 0 = 0 := hf.map_zero_eq_zero hconv hbot (hb b hbs)
  induction hx using Submodule.span_induction with
  | mem y hy => exact hb y hy
  | zero => rw [neg_zero, h0, neg_zero]
  | add u v _ _ ihu ihv => exact hf.neg_eq_add hconv hbot ihu ihv
  | smul c u _ ihu => exact hf.neg_eq_smul hconv hbot ihu c

/-- **Linearity on a subspace.** Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous
and convex, and let $L$ be a linear subspace of $E$. Then $f$ is linear on $L$, that is,
$$f(x + y) = f(x) + f(y) \quad \text{and} \quad f(cx) = c f(x) \qquad \text{for all } x, y \in L
  \text{ and } c \in \mathbb{R},$$
if and only if $f(-x) = -f(x)$ for every $x \in L$. -/
theorem PosHomogeneous.isLinearOn_iff (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) (L : Submodule ℝ E) :
    ((∀ x ∈ L, ∀ y ∈ L, f (x + y) = f x + f y) ∧
        ∀ (c : ℝ), ∀ x ∈ L, f (c • x) = (c : EReal) * f x) ↔ ∀ x ∈ L, f (-x) = -(f x) := by
  constructor
  · rintro ⟨-, hsmul⟩ x hx
    rw [← neg_one_smul ℝ x, hsmul (-1) x hx, EReal.coe_neg, EReal.coe_one,
      neg_one_mul]
  · intro hodd
    exact ⟨fun x hx y hy => hf.map_add_of_neg_eq hconv hbot (hodd x hx) (hodd y hy),
      fun c x hx => hf.map_smul_of_neg_eq hconv hbot (hodd x hx) c⟩

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex, and let $L$ be a
linear subspace of $E$. Then there is a linear functional $g \colon L \to \mathbb{R}$ with
$f(x) = g(x)$ for all $x \in L$ if and only if $f(-x) = -f(x)$ for every $x \in L$.

This is `ConvexAnalysis.PosHomogeneous.isLinearOn_iff` in packaged form. Such an $f$ is finite
on $L$, so a real-valued linear map exists. -/
theorem PosHomogeneous.exists_linearMap_iff (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) (L : Submodule ℝ E) :
    (∃ g : L →ₗ[ℝ] ℝ, ∀ x : L, f x = (g x : EReal)) ↔ ∀ x ∈ L, f (-x) = -(f x) := by
  constructor
  · rintro ⟨g, hg⟩ x hx
    have hneg : f (-x) = ((g (-⟨x, hx⟩ : L) : ℝ) : EReal) := hg (-⟨x, hx⟩ : L)
    rw [hneg, map_neg, EReal.coe_neg, hg ⟨x, hx⟩]
  · intro hodd
    have hodd' : ∀ x : L, f (x : E) = ((f (x : E)).toReal : EReal) := fun x =>
      (EReal.coe_toReal (ne_top_of_neg_eq hbot (hodd x x.2)) (hbot x)).symm
    refine ⟨{ toFun := fun x => (f (x : E)).toReal
              map_add' := fun x y => ?_
              map_smul' := fun c x => ?_ }, fun x => hodd' x⟩
    · have h : f ((x : E) + (y : E)) = f (x : E) + f (y : E) :=
        hf.map_add_of_neg_eq hconv hbot (hodd x x.2) (hodd y y.2)
      have hcast : ((f (((x + y : L) : E))).toReal : EReal)
          = (((f (x : E)).toReal + (f (y : E)).toReal : ℝ) : EReal) := by
        rw [← hodd' (x + y), Submodule.coe_add, h, EReal.coe_add, ← hodd' x, ← hodd' y]
      exact_mod_cast hcast
    · have h : f (c • (x : E)) = (c : EReal) * f (x : E) :=
        hf.map_smul_of_neg_eq hconv hbot (hodd x x.2) c
      have hcast : ((f (((c • x : L) : E))).toReal : EReal)
          = ((c * (f (x : E)).toReal : ℝ) : EReal) := by
        rw [← hodd' (c • x), Submodule.coe_smul, h, EReal.coe_mul, ← hodd' x]
      exact_mod_cast hcast

/-- Let $f \colon E \to (-\infty, +\infty]$ be positively homogeneous and convex, and let
$s \subseteq E$ be nonempty with $f(-b) = -f(b)$ for every $b \in s$. Then $f$ agrees on
$\operatorname{span} s$ with a linear functional
$g \colon \operatorname{span} s \to \mathbb{R}$. In particular, it suffices to check the
condition on a basis of the subspace. -/
theorem PosHomogeneous.exists_linearMap_span (hf : PosHomogeneous f) (hconv : ConvexFn f)
    (hbot : ∀ x, f x ≠ ⊥) {s : Set E} (hs : s.Nonempty) (hb : ∀ b ∈ s, f (-b) = -(f b)) :
    ∃ g : Submodule.span ℝ s →ₗ[ℝ] ℝ, ∀ x : Submodule.span ℝ s, f x = (g x : EReal) :=
  (hf.exists_linearMap_iff hconv hbot _).2 fun _ hx =>
    hf.neg_eq_of_mem_span hconv hbot hs hb hx

/-- The epigraph of a positively homogeneous convex function $f$, as a Mathlib `ConvexCone` in
$E \times \mathbb{R}$. This makes the `ConvexCone` API of Mathlib available for support
functions and polarity.

No hypothesis on the values of $f$ is needed: closure under addition comes from the convexity of
the cone, not from subadditivity. -/
def PosHomogeneous.epiCone (hf : PosHomogeneous f) (hconv : ConvexFn f) : ConvexCone ℝ (E × ℝ) where
  carrier := epi f
  smul_mem' c hc p hp := by
    rw [← (posHomogeneous_iff_isCone_epi (f := f)).1 hf c hc]
    exact Set.smul_mem_smul_set hp
  add_mem' p hp q hq :=
    (convex_iff_add_mem_of_isCone
      (isCone_iff_smul_eq.2 ((posHomogeneous_iff_isCone_epi (f := f)).1 hf))).1
      hconv.convex_epi p hp q hq

/-- The underlying set of `ConvexAnalysis.PosHomogeneous.epiCone` is the epigraph of $f$. -/
@[simp] theorem PosHomogeneous.coe_epiCone (hf : PosHomogeneous f) (hconv : ConvexFn f) :
    (hf.epiCone hconv : Set (E × ℝ)) = epi f := rfl

end Module




