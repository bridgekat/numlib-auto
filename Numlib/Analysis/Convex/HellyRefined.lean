/-- For a continuous pairing, the affine function $x \mapsto \langle x, a \rangle - c$ is closed,
proper and convex. -/
theorem closedProperConvexFn_affineFn [IsContinuousPairing B] (a : F) (c : ℝ) :
    ClosedProperConvexFn (affineFn B a c) :=
  ⟨convexFn_affineFn a c, closedConvex_affineFn (continuous_pairing B a), properConvex_affineFn a c⟩

