/-- If the pairing separates the points of $F$, the effective domain of the conjugate of
$x \mapsto \langle x, a \rangle - c$ is the single point $\{a\}$. -/
theorem convexDom_convexConj_affineFn (hB : B.SeparatingRight) (a : F) (c : ℝ) :
    convexDom (convexConj B (affineFn B a c)) = {a} := by
  ext y
  rw [mem_convexDom]
  by_cases hy : y = a
  · subst hy
    rw [convexConj_affineFn_apply_self]
    simp
  · rw [convexConj_affineFn_apply_of_ne hB hy]
    simp [hy]

omit [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] in
/-- **Directions of recession of an affine function.** Let $B \colon E \times F \to \mathbb{R}$ be a
compatible pairing that separates the points of $F$, let $a \in F$, $c \in \mathbb{R}$ and
$y \in E$. Then $y$ is a direction of recession of $x \mapsto \langle x, a \rangle - c$ if and
only if
$$\langle y, a \rangle \le 0.$$

The effective domain of the conjugate of the affine function is the single point $a$. -/
theorem recessionFn_affineFn_nonpos_iff [IsCompatiblePairing B] (hB : B.SeparatingRight)
    (a : F) (c : ℝ) (y : E) :
    recessionFn (affineFn B a c) y ≤ 0 ↔ B y a ≤ 0 := by
  rw [recessionFn_nonpos_iff_forall_mem_convexDom_convexConj
      (B := B) (closedProperConvexFn_affineFn a c) y,
    convexDom_convexConj_affineFn hB]
  simp

omit [FiniteDimensional ℝ F] in
/-- **Every polyhedral convex set is cut out by finitely many inequalities of the pairing.** Let $E$
be a finite-dimensional real normed space, and let $B \colon E \times F \to \mathbb{R}$ be a
compatible pairing. If $C \subseteq E$ is polyhedral, then there is a finite set
$s \subseteq F \times \mathbb{R}$ with
$$C = \{x \in E \mid \langle x, a \rangle \le c \text{ for all } (a, c) \in s\}.$$

The usual definition of a polyhedral set uses linear functionals. In finite dimension a
compatible pairing represents each of them. This lets the refined Helly theorem replace the
polyhedral members of a family by half-spaces described by affine functions of the pairing. -/
theorem Polyhedral.exists_finset_pairing [IsCompatiblePairing B] {C : Set E} (hC : Polyhedral C) :
    ∃ s : Finset (F × ℝ), C = {x : E | ∀ q ∈ s, B x q.1 ≤ q.2} := by
  classical
  have hrep : ∀ φ : E →ₗ[ℝ] ℝ, ∃ a : F, ∀ x, φ x = B x a := by
    intro φ
    obtain ⟨a, ha⟩ := exists_pairing_eq B (LinearMap.toContinuousLinearMap φ)
    exact ⟨a, fun x => ha x⟩
  choose rep hrep using hrep
  obtain ⟨t, ht⟩ := hC
  refine ⟨t.image fun q => (rep q.1, q.2), ?_⟩
  rw [ht]
  ext x
  simp only [Set.mem_ofPred_eq, Finset.mem_image]
  constructor
  · rintro h p ⟨q, hq, rfl⟩
    rw [← hrep q.1 x]
    exact h q hq
  · intro h q hq
    rw [hrep q.1 x]
    exact h (rep q.1, q.2) ⟨q, hq, rfl⟩

omit [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] in
/-- Let $t \subseteq F \times \mathbb{R}$ be finite, and let $y \in E$ satisfy
$\langle y, a \rangle \le 0$ for every $(a, c) \in t$. Then $y$ is a direction of recession of
the polyhedron
$$\{x \in E \mid \langle x, a \rangle \le c \text{ for all } (a, c) \in t\}.$$
-/
theorem mem_recessionCone_of_forall_pairing_nonpos {t : Finset (F × ℝ)} {y : E}
    (hy : ∀ q ∈ t, B y q.1 ≤ 0) :
    y ∈ recessionCone {x : E | ∀ q ∈ t, B x q.1 ≤ q.2} := by
  intro x hx a ha q hq
  have hval : B (x + a • y) q.1 = B x q.1 + a * B y q.1 := by
    rw [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply, smul_eq_mul]
  have hxq : B x q.1 ≤ q.2 := hx q hq
  have hterm : a * B y q.1 ≤ 0 := mul_nonpos_of_nonneg_of_nonpos ha (hy q hq)
  rw [hval]
  linarith

omit [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] in
/-- **The constancy space of an indicator function is the lineality space of the set.** If
$C \subseteq E$ is nonempty, then the directions in which $\delta(\cdot \mid C)$ is constant are
exactly the directions in which $C$ is linear:
$$\{y \mid (\delta_C 0^+)(y) \le 0 \text{ and } (\delta_C 0^+)(-y) \le 0\} = 0^+ C \cap (-0^+
  C).$$
This turns "a direction in which $C_i$ is linear" into "a direction in which $f_i$ is constant". -/
theorem constancySpace_indicatorFn {C : Set E} (hC : C.Nonempty) :
    constancySpace (indicatorFn C) = linealitySpace C := by
  have hle : ∀ z : E, indicatorFn (recessionCone C) z ≤ 0 ↔ z ∈ recessionCone C := by
    intro z
    by_cases hz : z ∈ recessionCone C
    · simp [hz]
    · simp [hz]
  ext y
  rw [mem_constancySpace, mem_linealitySpace, recessionFn_indicatorFn hC, hle, hle]

end Halves

section Refined

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {ι : Type*} {f : ι → E → EReal}

/-- **The refined alternative on the whole space.** Let $E$ be a real normed space of finite
dimension $n$, let $F$ be a finite-dimensional real normed space, and let
$B \colon E \times F \to \mathbb{R}$ be a pairing that is compatible in both directions and
separates the points of $F$. Let $f_i$, $i \in I$, be closed proper convex functions on $E$,
indexed by an arbitrary set $I$. Let $I_0 \subseteq I$ be finite, with $f_i$ affine, of the form
$f_i(x) = \langle x, a_i \rangle - c_i$, for $i \in I_0$. Suppose that every direction of
recession common to all the $f_i$ is a direction in which $f_i$ is constant for every
$i \notin I_0$. Then one of the following holds:

* there is $x \in E$ with $f_i(x) \le 0$ for all $i$;
* there are a finite set $t \subseteq I$ with $|t| \le n + 1$, multipliers $\lambda_i \ge 0$
  with $\lambda_i = 0$ for $i \notin t$, and $\varepsilon > 0$ with $\sum_{i \in t} \lambda_i
  f_i(x) \ge \varepsilon$ for all $x \in E$.

This is Theorem 21.4 of [rockafellar1970convex]. The hypothesis of
`ConvexAnalysis.alternative_infinite_system_univ`, that the only common direction of recession
is $0$, implies this one with $I_0 = \emptyset$. The gain is that the affine members may now
recede, and so may the others if they are constant in every direction in which the whole family
recedes. Only one step of the unrefined proof changes: the proof of $k(0) = -\infty$, which is
here `ConvexAnalysis.apply_zero_eq_bot_of_le_of_le`. A direction of constancy is an element of
`ConvexAnalysis.constancySpace`. -/
theorem alternative_infinite_system_univ_of_affine_tail [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hB : B.SeparatingRight)
    (hf : ∀ i, ClosedProperConvexFn (f i)) (I₀ : Finset ι)
    (haff : ∀ i ∈ I₀, ∃ (a : F) (c : ℝ), f i = affineFn B a c)
    (hrec : ∀ y : E, (∀ i, recessionFn (f i) y ≤ 0) → ∀ i ∉ I₀, y ∈ constancySpace (f i)) :
    (∃ x : E, ∀ i, f i x ≤ 0) ∨
      ∃ (t : Finset ι) (l : ι → ℝ) (ε : ℝ), (∀ i, 0 ≤ l i) ∧ (∀ i ∉ t, l i = 0) ∧ 0 < ε ∧
        t.card ≤ Module.finrank ℝ E + 1 ∧
        ∀ x : E, (ε : EReal) ≤ ∑ i ∈ t, (l i : EReal) * f i x := by
  classical
  by_cases halt : ∃ x : E, ∀ i, f i x ≤ 0
  · exact Or.inl halt
  refine Or.inr (exists_multipliers_of_posHomGen_convFn_convexConj_eq_bot (B := B) hf ?_)
  have hg₀ : ∀ j : {i // i ∈ I₀}, ClosedProperConvexFn ((fun j : {i // i ∈ I₀} => f j.1) j) :=
    fun j => hf j.1
  have hg₁ : ∀ j : {i // i ∉ I₀}, ClosedProperConvexFn ((fun j : {i // i ∉ I₀} => f j.1) j) :=
    fun j => hf j.1
  have hpoly : PolyhedralFn
      (posHomGen (convFn fun j : {i // i ∈ I₀} => convexConj B ((fun j => f j.1) j))) :=
    polyhedralFn_posHomGen_convFn_convexConj_affineFn hB fun j => haff j.1 j.2
  have hrec' : ∀ y : E, (∀ j : {i // i ∈ I₀}, recessionFn (f j.1) y ≤ 0) →
      (∀ j : {i // i ∉ I₀}, recessionFn (f j.1) y ≤ 0) →
      ∀ j : {i // i ∉ I₀}, recessionFn (f j.1) (-y) ≤ 0 := by
    intro y h0 h1 j
    have hall : ∀ i, recessionFn (f i) y ≤ 0 := by
      intro i
      by_cases hi : i ∈ I₀
      · exact h0 ⟨i, hi⟩
      · exact h1 ⟨i, hi⟩
    exact (mem_constancySpace.1 (hrec y hall j.1 j.2)).2
  have hempty : ¬ ∃ x : E, (∀ j : {i // i ∈ I₀}, f j.1 x ≤ 0) ∧
      ∀ j : {i // i ∉ I₀}, f j.1 x ≤ 0 := by
    rintro ⟨x, h0, h1⟩
    refine halt ⟨x, fun i => ?_⟩
    by_cases hi : i ∈ I₀
    · exact h0 ⟨i, hi⟩
    · exact h1 ⟨i, hi⟩
  have hle₀ : posHomGen (convFn fun i => convexConj B (f i))
      ≤ posHomGen (convFn fun j : {i // i ∈ I₀} => convexConj B (f j.1)) :=
    posHomGen_mono (le_convFn (convexFn_convFn _) fun j => convFn_le _ j.1)
  have hle₁ : posHomGen (convFn fun i => convexConj B (f i))
      ≤ posHomGen (convFn fun j : {i // i ∉ I₀} => convexConj B (f j.1)) :=
    posHomGen_mono (le_convFn (convexFn_convFn _) fun j => convFn_le _ j.1)
  exact apply_zero_eq_bot_of_le_of_le hg₀ hg₁ hpoly hrec' hempty
    (posHomogeneous_posHomGen _) (convexFn_posHomGen _) hle₀ hle₁

/-- **Solvability under the refined hypothesis.** Let $E$, $F$, the pairing $B$, the closed proper
convex functions $f_i$, $i \in I$, and the finite set $I_0$ satisfy the hypotheses of
`ConvexAnalysis.alternative_infinite_system_univ_of_affine_tail`. Suppose that for every
$\delta > 0$ and every set $S$ of at most $n + 1$ indices there is $x \in E$ with
$f_i(x) < \delta$ for all $i \in S$. Then there is $x \in E$ with
$$f_i(x) \le 0 \quad \text{for all } i \in I.$$
-/
theorem exists_forall_le_zero_of_forall_subsystem_of_affine_tail [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hB : B.SeparatingRight)
    (hf : ∀ i, ClosedProperConvexFn (f i)) (I₀ : Finset ι)
    (haff : ∀ i ∈ I₀, ∃ (a : F) (c : ℝ), f i = affineFn B a c)
    (hrec : ∀ y : E, (∀ i, recessionFn (f i) y ≤ 0) → ∀ i ∉ I₀, y ∈ constancySpace (f i))
    (hsub : ∀ δ : ℝ, 0 < δ → ∀ S : Finset ι, S.card ≤ Module.finrank ℝ E + 1 →
      ∃ x : E, ∀ i ∈ S, f i x < (δ : EReal)) :
    ∃ x : E, ∀ i, f i x ≤ 0 := by
  rcases alternative_infinite_system_univ_of_affine_tail hB hf I₀ haff hrec with
    hgood | ⟨t, l, ε, hl0, -, hε, hcard, hineq⟩
  · exact hgood
  refine absurd (fun x (_ : x ∈ (Set.univ : Set E)) => hineq x)
    (not_forall_le_weighted_of_forall_subsystem (C := (Set.univ : Set E)) ⟨0, Set.mem_univ 0⟩
      hl0 hε hcard fun δ hδ S hS => ?_)
  obtain ⟨x, hx⟩ := hsub δ hδ S hS
  exact ⟨x, Set.mem_univ x, hx⟩

/-- **The refined Helly theorem.** Let $E$ be a real normed space of finite dimension $n$, let $F$
be a finite-dimensional real normed space, and let $B \colon E \times F \to \mathbb{R}$ be a
pairing that is compatible in both directions and separates the points of $F$. Let $K_i$,
$i \in I$, be nonempty closed convex subsets of $E$, indexed by an arbitrary set $I$. Let
$I_0 \subseteq I$ be finite, with $K_i$ polyhedral for $i \in I_0$. Suppose that every direction
of recession common to all the $K_i$ is a direction in which $K_i$ is linear for every
$i \notin I_0$, that is, it lies in $0^+ K_i \cap (-0^+ K_i)$. If every subfamily of at most
$n + 1$ of the sets has a common point, then
$$\bigcap_{i \in I} K_i \neq \emptyset.$$

This is Theorem 21.5 of [rockafellar1970convex]. Compare
`ConvexAnalysis.helly_of_no_common_recession`, whose hypothesis is that the only common
direction of recession is $0$. Each polyhedral $K_i$, $i \in I_0$, is replaced by the finitely
many closed half-spaces that cut it out, and the refined alternative applies with these
half-spaces as its affine part. -/
theorem helly_of_polyhedral_tail [IsCompatiblePairing B] [IsCompatiblePairing B.flip]
    (hB : B.SeparatingRight) {K : ι → Set E}
    (hconv : ∀ i, Convex ℝ (K i)) (hcl : ∀ i, IsClosed (K i)) (hne : ∀ i, (K i).Nonempty)
    (I₀ : Finset ι) (hpoly : ∀ i ∈ I₀, Polyhedral (K i))
    (hrec : ∀ y : E, (∀ i, y ∈ recessionCone (K i)) → ∀ i ∉ I₀, y ∈ linealitySpace (K i))
    (hinter : ∀ S : Finset ι, S.card ≤ Module.finrank ℝ E + 1 → (⋂ i ∈ S, K i).Nonempty) :
    (⋂ i, K i).Nonempty := by
  classical
  have hex : ∀ j : {i // i ∈ I₀},
      ∃ t : Finset (F × ℝ), K j.1 = {x : E | ∀ q ∈ t, B x q.1 ≤ q.2} :=
    fun j => Polyhedral.exists_finset_pairing (hpoly j.1 j.2)
  choose t ht using hex
  set g : ({i // i ∉ I₀} ⊕ ((j : {i // i ∈ I₀}) × {q : F × ℝ // q ∈ t j})) → E → EReal :=
    Sum.elim (fun j => indicatorFn (K j.1)) (fun p => affineFn B p.2.1.1 p.2.1.2) with hgdef
  have hg_inl : ∀ j, g (Sum.inl j) = indicatorFn (K j.1) := fun _ => rfl
  have hg_inr : ∀ p, g (Sum.inr p) = affineFn B p.2.1.1 p.2.1.2 := fun _ => rfl
  set J₀ : Finset ({i // i ∉ I₀} ⊕ ((j : {i // i ∈ I₀}) × {q : F × ℝ // q ∈ t j})) :=
    Finset.image Sum.inr Finset.univ with hJ₀def
  have hmemJ₀ : ∀ p, Sum.inr p ∈ J₀ := fun p => Finset.mem_image.2 ⟨p, Finset.mem_univ p, rfl⟩
  have hnotJ₀ : ∀ j, (Sum.inl j : _) ∉ J₀ := by
    intro j hj
    obtain ⟨p, -, hp⟩ := Finset.mem_image.1 hj
    exact absurd hp (by simp)
  have hgc : ∀ i, ClosedProperConvexFn (g i) := by
    rintro (j | p)
    · rw [hg_inl]
      exact ⟨convexFn_indicatorFn.2 (hconv j.1), closedConvex_indicatorFn (hcl j.1),
        ⟨by rw [convexDom_indicatorFn]; exact hne j.1, indicatorFn_ne_bot (K j.1)⟩⟩
    · rw [hg_inr]
      exact closedProperConvexFn_affineFn _ _
  have haff : ∀ i ∈ J₀, ∃ (a : F) (c : ℝ), g i = affineFn B a c := by
    rintro (j | p) hi
    · exact absurd hi (hnotJ₀ j)
    · exact ⟨p.2.1.1, p.2.1.2, hg_inr p⟩
  have hrecg : ∀ y : E, (∀ i, recessionFn (g i) y ≤ 0) → ∀ i ∉ J₀, y ∈ constancySpace (g i) := by
    rintro y hy (j | p) hi
    · have hall : ∀ i : ι, y ∈ recessionCone (K i) := by
        intro i
        by_cases hi₀ : i ∈ I₀
        · rw [ht ⟨i, hi₀⟩]
          refine mem_recessionCone_of_forall_pairing_nonpos fun q hq => ?_
          have h := hy (Sum.inr ⟨⟨i, hi₀⟩, ⟨q, hq⟩⟩)
          rw [hg_inr] at h
          exact (recessionFn_affineFn_nonpos_iff hB _ _ y).1 h
        · have h := hy (Sum.inl ⟨i, hi₀⟩)
          rw [hg_inl, recessionFn_indicatorFn (hne i)] at h
          by_contra hcon
          rw [indicatorFn_of_notMem hcon] at h
          exact absurd h (by simp)
      rw [hg_inl, constancySpace_indicatorFn (hne j.1)]
      exact hrec y hall j.1 j.2
    · exact absurd (hmemJ₀ p) hi
  have hsubs : ∀ δ : ℝ, 0 < δ →
      ∀ S : Finset ({i // i ∉ I₀} ⊕ ((j : {i // i ∈ I₀}) × {q : F × ℝ // q ∈ t j})),
      S.card ≤ Module.finrank ℝ E + 1 → ∃ x : E, ∀ i ∈ S, g i x < (δ : EReal) := by
    intro δ hδ S hS
    obtain ⟨x, hx⟩ := hinter (S.image (Sum.elim (fun j => j.1) fun p => p.1.1))
      (le_trans (Finset.card_image_le) hS)
    refine ⟨x, ?_⟩
    rintro (j | p) hi
    · have hxK : x ∈ K j.1 :=
        Set.mem_iInter₂.1 hx j.1 (Finset.mem_image.2 ⟨Sum.inl j, hi, rfl⟩)
      rw [hg_inl, indicatorFn_of_mem hxK]
      exact_mod_cast hδ
    · have hxK : x ∈ K p.1.1 :=
        Set.mem_iInter₂.1 hx p.1.1 (Finset.mem_image.2 ⟨Sum.inr p, hi, rfl⟩)
      rw [ht p.1] at hxK
      have hle : B x p.2.1.1 ≤ p.2.1.2 := hxK p.2.1 p.2.2
      rw [hg_inr, affineFn_eq_coe]
      have hlt : B x p.2.1.1 - p.2.1.2 < δ := by linarith
      exact_mod_cast hlt
  obtain ⟨x, hx⟩ :=
    exists_forall_le_zero_of_forall_subsystem_of_affine_tail hB hgc J₀ haff hrecg hsubs
  refine ⟨x, Set.mem_iInter.2 fun i => ?_⟩
  by_cases hi₀ : i ∈ I₀
  · rw [ht ⟨i, hi₀⟩]
    intro q hq
    have h := hx (Sum.inr ⟨⟨i, hi₀⟩, ⟨q, hq⟩⟩)
    rw [hg_inr, affineFn_eq_coe] at h
    have h' : B x q.1 - q.2 ≤ 0 := by exact_mod_cast h
    linarith
  · have h := hx (Sum.inl ⟨i, hi₀⟩)
    by_contra hcon
    rw [hg_inl, indicatorFn_of_notMem hcon] at h
    exact absurd h (by simp)

end Refined

end ConvexAnalysis
