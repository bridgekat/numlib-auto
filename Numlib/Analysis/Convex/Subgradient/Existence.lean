import Numlib.Analysis.Convex.Duality.Polar
import Numlib.Analysis.Convex.Duality.SupportRelint
import Numlib.Analysis.Convex.Polyhedral.Conjugate
import Numlib.Analysis.Convex.Recession.ConeHull
import Numlib.Analysis.Convex.RelativeInterior
import Numlib.Analysis.Convex.Subgradient.Defs

/-!
# Existence of subgradients

A proper convex function is subdifferentiable at every relative interior point of its effective
domain, and a polyhedral convex function is subdifferentiable wherever it is finite. In both cases
the directional derivative `f'(x; ·)` is *exactly* the support function of `∂f x`, not merely its
closure.

That `cl (f'(x; ·)) = δ*(· | ∂f x)` for any convex `f` finite at `x` is already known, so both
existence theorems reduce to one question: **is `f'(x; ·)` closed?** At a relative interior point
its effective domain is the subspace parallel to `aff (dom f)`, and a proper convex function with
affine effective domain is closed. For polyhedral `f`, the epigraph of `f'(x; ·)` is the convex
cone generated by `epi f - (x, f x)`, which is again polyhedral and in particular closed. Once
`f'(x; ·)` is closed, nonemptiness of `∂f x` follows at once: the support function of the empty set
is the constant `−∞`, while `f'(x; 0) = 0`.

The first consumer of that identity on the other side is here too: the normal cone to the level set
`{z | f z ≤ f x}` is the closed convex cone generated by `∂f x`. So is the *non*-existence
statement that where there is no subgradient the directional derivative is `−∞` in every direction
pointing into `ri (dom f)`.

## Main results

* `dirDeriv_eq_supportFn_of_mem_relint_dom`, `subgradient_nonempty_of_mem_relint_dom` —
  subdifferentiability on the relative interior (Theorem 23.4 in [^1]);
  `bddAbove_subgradient_iff_mem_interior_dom` is its last clause, that `∂f x` is bounded exactly
  when `x` is an *interior* point of `dom f`.
* `dirDeriv_eq_supportFn_of_polyhedralFn`, `subgradient_nonempty_of_polyhedralFn`,
  `polyhedral_subgradient_of_polyhedralFn` — the polyhedral case (Theorem 23.10 in [^1]).
* `normalCone_setOf_le_eq_closure_coe_hull_subgradient` — the normal cone to a level set;
  `normalCone_setOf_le_eq_coe_hull_subgradient` drops the closure when `∂f x` is bounded.
* `mem_interior_of_normalCone_eq_zero` — a convex set is a neighbourhood of every point at which
  its normal cone is trivial.
* `subgradient_eq_empty_iff_exists_dirDeriv_eq_bot` — failure of subdifferentiability is exactly a
  `−∞` value of `f'(x; ·)`.

## Implementation notes

The two existence theorems share their last two steps: `dirDeriv_eq_supportFn_of_closedFn` and
`subgradient_nonempty_of_closedFn_dirDeriv` take `ClosedFn (dirDeriv f x)` as a hypothesis, and
only the *supply* of that hypothesis differs between the two.

## References

[^1]: R. T. Rockafellar, *Convex Analysis*, Princeton University Press, 1970, §23.
-/

open Set
open scoped Pointwise

namespace ConvexAnalysis

/-! ### The epigraph of the directional derivative as a cone -/

section EpiCone

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {f : E → EReal} {x : E} {r : ℝ}

/-- The convex cone generated by `epi f - (x, f x)` always lies inside the epigraph of
`f'(x; ·)`: the generators are there because `f'(x; z - x) ≤ f z - f x`, and the epigraph of a
positively homogeneous convex function is a cone. -/
theorem coe_hull_epi_sub_subset_epi_dirDeriv (hf : ConvexFn f) (hr : f x = (r : EReal)) :
    (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) ⊆ epi (dirDeriv f x) := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hisCone : ∀ a : ℝ, 0 < a → a • epi (dirDeriv f x) = epi (dirDeriv f x) :=
    (posHomogeneous_iff_isCone_epi (f := dirDeriv f x)).1 (posHomogeneous_dirDeriv f x)
  have hadd : ∀ p ∈ epi (dirDeriv f x), ∀ q ∈ epi (dirDeriv f x), p + q ∈ epi (dirDeriv f x) :=
    (convex_iff_add_mem_of_isCone hisCone).1 (convexFn_dirDeriv hf ht hb).convex_epi
  have hzero : (0 : E × ℝ) ∈ epi (dirDeriv f x) := by
    change dirDeriv f x (0 : E × ℝ).1 ≤ (((0 : E × ℝ).2 : ℝ) : EReal)
    simp [dirDeriv_zero ht hb]
  have hsmul : ∀ a : ℝ, 0 ≤ a → ∀ w ∈ epi (dirDeriv f x), a • w ∈ epi (dirDeriv f x) := by
    intro a ha w hw
    rcases eq_or_lt_of_le ha with h | h
    · rw [← h, zero_smul]; exact hzero
    · rw [← hisCone a h]; exact Set.smul_mem_smul_set hw
  intro w hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨p, hp, q, hq, hpq⟩ := hw
      rw [Set.mem_singleton_iff] at hq
      subst hq
      have hpq' : p - (x, r) = w := hpq
      have hfp : f p.1 ≤ ((p.2 : ℝ) : EReal) := hp
      have h1 : dirDeriv f x (p.1 - x)
          ≤ (f (x + (1 : ℝ) • (p.1 - x)) - f x) / ((1 : ℝ) : EReal) := dirDeriv_le f x _ one_pos
      have hx1 : x + (1 : ℝ) • (p.1 - x) = p.1 := by module
      rw [hx1, hr] at h1
      have h2 : (f p.1 - (r : EReal)) / ((1 : ℝ) : EReal) ≤ ((p.2 - r : ℝ) : EReal) := by
        rw [EReal.sub_div_le_coe_iff one_pos]
        have hc : (r + (p.2 - r) * 1 : ℝ) = p.2 := by ring
        rw [hc]
        exact hfp
      rw [← hpq']
      change dirDeriv f x (p - (x, r)).1 ≤ (((p - (x, r)).2 : ℝ) : EReal)
      simpa using h1.trans h2
  | zero => exact hzero
  | add w₁ w₂ _ _ ih₁ ih₂ => exact hadd w₁ ih₁ w₂ ih₂
  | smul c w _ ih => exact hsmul (c : ℝ) c.2 w ih

end EpiCone

section EpiConeClosed

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : E → EReal} {x : E} {r : ℝ}

/-- If the convex cone generated by `epi f - (x, f x)` is closed, it *is* the epigraph of
`f'(x; ·)`. Only this inclusion needs the closedness, and it cannot be dropped: for `f y = y²` at
`x = 0` the cone is the open upper half plane together with the origin, while `epi (f'(0; ·))` is
the closed upper half plane. For polyhedral `f` the cone is finitely generated, hence closed. -/
theorem epi_dirDeriv_subset_coe_hull (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hK : IsClosed (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))) :
    epi (dirDeriv f x) ⊆ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) := by
  intro w hw
  have hle : dirDeriv f x w.1 ≤ ((w.2 : ℝ) : EReal) := hw
  have hcont : Continuous fun t : ℝ => ((w.1, t) : E × ℝ) := by fun_prop
  have hsec : IsClosed {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} :=
    hK.preimage hcont
  have hsub : Set.Ioi w.2 ⊆ {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} := by
    intro t ht
    have hlt : dirDeriv f x w.1 < (t : EReal) :=
      lt_of_le_of_lt hle (by exact_mod_cast (ht : w.2 < t))
    obtain ⟨a, ha, hbound⟩ := exists_le_of_dirDeriv_lt hf hr hlt
    have hmem : ((x + a • w.1, r + t * a) : E × ℝ) ∈ epi f := hbound a ha le_rfl
    have hmem2 : ((a • w.1, t * a) : E × ℝ) ∈ epi f - {((x, r) : E × ℝ)} := by
      refine ⟨(x + a • w.1, r + t * a), hmem, (x, r), rfl, ?_⟩
      have h : ((x + a • w.1, r + t * a) : E × ℝ) - (x, r) = (a • w.1, t * a) := by
        rw [Prod.mk_sub_mk, add_sub_cancel_left, add_sub_cancel_left]
      exact h
    have hscal := Submodule.smul_mem (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}))
      (⟨a⁻¹, le_of_lt (inv_pos.2 ha)⟩ : {c : ℝ // 0 ≤ c}) (PointedCone.subset_hull hmem2)
    have heq : (a⁻¹ : ℝ) • ((a • w.1, t * a) : E × ℝ) = (w.1, t) := by
      rw [Prod.smul_mk, smul_smul, inv_mul_cancel₀ ha.ne', one_smul, smul_eq_mul]
      congr 1
      field_simp
    have hfin : (a⁻¹ : ℝ) • ((a • w.1, t * a) : E × ℝ)
        ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) := hscal
    rw [heq] at hfin
    exact hfin
  have hclos := hsec.closure_subset_iff.2 hsub
  rw [closure_Ioi] at hclos
  have hmem : w.2 ∈ {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} :=
    hclos (by simp)
  simpa using hmem

/-- The epigraph of `f'(x; ·)` *is* the convex cone generated by `epi f - (x, f x)`, whenever that
cone is closed. -/
theorem epi_dirDeriv_eq_coe_hull (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hK : IsClosed (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))) :
    epi (dirDeriv f x) = (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) :=
  subset_antisymm (epi_dirDeriv_subset_coe_hull hf hr hK)
    (coe_hull_epi_sub_subset_epi_dirDeriv hf hr)

end EpiConeClosed

/-! ### The common ending: a closed directional derivative -/

section Closed

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- **The closure removed.** As soon as `f'(x; ·)` is closed it *is* the support function of
`∂f x`; this is the last step of both existence theorems. -/
theorem dirDeriv_eq_supportFn_of_closedFn [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hcl : ClosedFn (dirDeriv f x)) :
    dirDeriv f x = supportFn B.flip (subgradient B f x) :=
  hcl.symm.trans (clFn_dirDeriv hf ht hb)

/-- **Subdifferentiability from closedness.** The support function of the empty set is the
constant `−∞`, but `f'(x; 0) = 0`; so a closed `f'(x; ·)` forces `∂f x ≠ ∅`. -/
theorem subgradient_nonempty_of_closedFn_dirDeriv [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hcl : ClosedFn (dirDeriv f x)) :
    (subgradient B f x).Nonempty := by
  rcases Set.eq_empty_or_nonempty (subgradient B f x) with he | hne
  · exfalso
    have hEq := dirDeriv_eq_supportFn_of_closedFn (B := B) hf ht hb hcl
    rw [he, supportFn_empty] at hEq
    have h0 := congrFun hEq 0
    rw [dirDeriv_zero ht hb] at h0
    exact absurd h0 (by simp)
  · exact hne

end Closed

/-! ### Subdifferentiability on the relative interior -/

section Relint

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

omit [FiniteDimensional ℝ E] in
/-- The effective domain of `f'(x; ·)` never leaves the subspace parallel to the affine hull of
`dom f`: a direction along which some difference quotient is finite points from `x` into `dom f`.

Unlike the reverse inclusion this needs nothing of `x` beyond finiteness of `f x`. -/
theorem dom_dirDeriv_subset_direction (hf : ConvexFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    dom (dirDeriv f x) ⊆ ((affineSpan ℝ (dom f)).direction : Set E) := by
  have hxdom : x ∈ dom f := mem_dom.2 (lt_top_iff_ne_top.2 ht)
  have hxaff : x ∈ affineSpan ℝ (dom f) := subset_affineSpan ℝ (dom f) hxdom
  obtain ⟨r, hr⟩ := EReal.exists_coe_of_ne_bot_of_lt_top hb (mem_dom.1 hxdom)
  intro y hy
  obtain ⟨m, hm, -⟩ := EReal.lt_iff_exists_real_btwn.1 (mem_dom.1 hy)
  obtain ⟨a, ha, hbound⟩ := exists_le_of_dirDeriv_lt hf hr hm
  have hmem : x + a • y ∈ dom f :=
    mem_dom.2 (lt_of_le_of_lt (hbound a ha le_rfl) (EReal.coe_lt_top _))
  have hvs : (x + a • y) - x ∈ (affineSpan ℝ (dom f)).direction :=
    AffineSubspace.vsub_mem_direction (subset_affineSpan ℝ (dom f) hmem) hxaff
  have hay : a • y ∈ (affineSpan ℝ (dom f)).direction := by
    have h : (x + a • y) - x = a • y := by abel
    rwa [h] at hvs
  have hfinal := Submodule.smul_mem _ (a⁻¹ : ℝ) hay
  rwa [smul_smul, inv_mul_cancel₀ ha.ne', one_smul] at hfinal

omit [FiniteDimensional ℝ E] in
/-- First step: at a relative interior point of `dom f` the effective domain of `f'(x; ·)` is the
subspace parallel to the affine hull of `dom f`.

Both inclusions are elementary: a direction along which the difference quotient is ever finite
points from `x` into `dom f`, and conversely a relative interior point can be moved a little in
any direction of the affine hull without leaving `dom f`. -/
theorem dom_dirDeriv_of_mem_relint_dom (hf : ConvexFn f) (hp : Proper f) (hx : x ∈ ri (dom f)) :
    dom (dirDeriv f x) = ((affineSpan ℝ (dom f)).direction : Set E) := by
  obtain ⟨hxaff, ε, hε, hball⟩ := mem_intrinsicInterior_iff.1 hx
  have hxdom : x ∈ dom f := intrinsicInterior_subset hx
  obtain ⟨r, hr⟩ :=
    EReal.exists_coe_of_ne_bot_of_lt_top (hp.ne_bot x) (mem_dom.1 hxdom)
  refine Set.Subset.antisymm
    (dom_dirDeriv_subset_direction hf (mem_dom.1 hxdom).ne (hp.ne_bot x)) fun y hy => ?_
  · have hyd : y ∈ (affineSpan ℝ (dom f)).direction := hy
    set a : ℝ := ε / (‖y‖ + 1) with hadef
    have hpos : 0 < a := by positivity
    have hnorm : ‖a • y‖ < ε := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hpos, hadef, div_mul_eq_mul_div]
      rw [div_lt_iff₀ (by positivity)]
      nlinarith [norm_nonneg y, hε]
    have haff : x + a • y ∈ affineSpan ℝ (dom f) := by
      have h := AffineSubspace.vadd_mem_of_mem_direction
        (Submodule.smul_mem _ a hyd) hxaff
      have he : (a • y) +ᵥ x = x + a • y := by
        rw [vadd_eq_add]; abel
      rwa [he] at h
    have hdist : dist (x + a • y) x < ε := by
      rw [dist_eq_norm]
      have h : (x + a • y) - x = a • y := by abel
      rwa [h]
    have hmem : x + a • y ∈ dom f := hball _ haff hdist
    obtain ⟨c, hc, -⟩ := EReal.lt_iff_exists_real_btwn.1 (mem_dom.1 hmem)
    refine mem_dom.2 (lt_of_le_of_lt (dirDeriv_le f x y hpos) ?_)
    rw [hr]
    have hbound : (f (x + a • y) - (r : EReal)) / ((a : ℝ) : EReal)
        ≤ (((c - r) / a : ℝ) : EReal) := by
      rw [EReal.sub_div_le_coe_iff hpos]
      have hcc : (r + (c - r) / a * a : ℝ) = c := by
        rw [div_mul_cancel₀ _ hpos.ne']; ring
      rw [hcc]
      exact hc.le
    exact lt_of_le_of_lt hbound (EReal.coe_lt_top _)

omit [FiniteDimensional ℝ E] in
/-- Second step: at a relative interior point `f'(x; ·)` is proper. Its effective domain is a
subspace, hence relatively open, so a `−∞` value anywhere would spread over all of it — including
the origin, where `f'(x; 0) = 0`. Relative interiority is essential: for `f y = -√y` on `[0, ∞)` and
`+∞` elsewhere, `f'(0; y) = −∞` for every `y > 0` while `f'(0; 0) = 0`. -/
theorem proper_dirDeriv_of_mem_relint_dom (hf : ConvexFn f) (hp : Proper f)
    (hx : x ∈ ri (dom f)) : Proper (dirDeriv f x) := by
  have hxdom : x ∈ dom f := intrinsicInterior_subset hx
  have ht : f x ≠ ⊤ := (mem_dom.1 hxdom).ne
  have hb : f x ≠ ⊥ := hp.ne_bot x
  have hdom := dom_dirDeriv_of_mem_relint_dom hf hp hx
  have h0 : (0 : E) ∈ dom (dirDeriv f x) := by
    rw [mem_dom, dirDeriv_zero ht hb]; exact EReal.zero_lt_top
  by_contra hcon
  have hopen : ri (dom (dirDeriv f x)) = dom (dirDeriv f x) := by
    have h := AffineSubspace.intrinsicInterior_coe
      (((affineSpan ℝ (dom f)).direction : Submodule ℝ E).toAffineSubspace)
    rw [hdom]
    exact h
  have hbot := (convexFn_dirDeriv hf ht hb).eq_bot_of_mem_relint_dom hcon
    (by rw [hopen]; exact h0)
  rw [dirDeriv_zero ht hb] at hbot
  exact absurd hbot (by simp)

/-- Third step: `f'(x; ·)` is closed, a proper convex function whose effective domain is affine
being closed. -/
theorem closedFn_dirDeriv_of_mem_relint_dom (hf : ConvexFn f) (hp : Proper f)
    (hx : x ∈ ri (dom f)) : ClosedFn (dirDeriv f x) := by
  have hxdom : x ∈ dom f := intrinsicInterior_subset hx
  refine (convexFn_dirDeriv hf (mem_dom.1 hxdom).ne (hp.ne_bot x)).closedFn_of_dom_eq_coe
    (proper_dirDeriv_of_mem_relint_dom hf hp hx)
    (M := ((affineSpan ℝ (dom f)).direction : Submodule ℝ E).toAffineSubspace) ?_
  rw [dom_dirDeriv_of_mem_relint_dom hf hp hx]
  rfl

/-- At a relative interior point of `dom f` the directional derivative is *exactly* the support
function of the subdifferential. -/
theorem dirDeriv_eq_supportFn_of_mem_relint_dom [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : Proper f) (hx : x ∈ ri (dom f)) :
    dirDeriv f x = supportFn B.flip (subgradient B f x) := by
  have hxdom : x ∈ dom f := intrinsicInterior_subset hx
  exact dirDeriv_eq_supportFn_of_closedFn hf (mem_dom.1 hxdom).ne (hp.ne_bot x)
    (closedFn_dirDeriv_of_mem_relint_dom hf hp hx)

/-- A proper convex function is subdifferentiable at every relative interior point of its
effective domain. -/
theorem subgradient_nonempty_of_mem_relint_dom [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : Proper f) (hx : x ∈ ri (dom f)) : (subgradient B f x).Nonempty := by
  have hxdom : x ∈ dom f := intrinsicInterior_subset hx
  exact subgradient_nonempty_of_closedFn_dirDeriv hf (mem_dom.1 hxdom).ne (hp.ne_bot x)
    (closedFn_dirDeriv_of_mem_relint_dom hf hp hx)

/-- In terms of the directional derivative: `f'(x; ·)` is finite everywhere exactly when `x` is an
interior point of `dom f`. -/
theorem dom_dirDeriv_eq_univ_iff_mem_interior_dom (hf : ConvexFn f) (hp : Proper f)
    (hx : x ∈ ri (dom f)) : dom (dirDeriv f x) = univ ↔ x ∈ interior (dom f) := by
  have hxaff : x ∈ affineSpan ℝ (dom f) := subset_affineSpan ℝ (dom f) (intrinsicInterior_subset hx)
  have hdom := dom_dirDeriv_of_mem_relint_dom hf hp hx
  constructor
  · intro huniv
    have hdir : ((affineSpan ℝ (dom f)).direction : Set E) = univ := by rw [← hdom, huniv]
    have htop : affineSpan ℝ (dom f) = ⊤ := by
      refine eq_top_iff.2 fun z _ => ?_
      have hz : z - x ∈ (affineSpan ℝ (dom f)).direction := by
        rw [← SetLike.mem_coe, hdir]; trivial
      have h := AffineSubspace.vadd_mem_of_mem_direction hz hxaff
      have he : (z - x) +ᵥ x = z := by rw [vadd_eq_add]; abel
      rwa [he] at h
    rw [← intrinsicInterior_eq_interior htop]
    exact hx
  · intro hint
    have htop : affineSpan ℝ (dom f) = ⊤ :=
      (Convex.interior_nonempty_iff_affineSpan_eq_top hf.convex_dom).1 ⟨x, hint⟩
    rw [hdom, htop, AffineSubspace.direction_top]
    exact Submodule.top_coe

/-- `∂f x` is bounded — in the pairing sense, that every `⟨v, ·⟩` is bounded above on it —
exactly when `x` is an interior point of `dom f`. -/
theorem bddAbove_subgradient_iff_mem_interior_dom [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : Proper f) (hx : x ∈ ri (dom f)) :
    (∀ v : E, ∃ c : ℝ, ∀ y ∈ subgradient B f x, B v y ≤ c) ↔ x ∈ interior (dom f) := by
  rw [← dom_dirDeriv_eq_univ_iff_mem_interior_dom hf hp hx,
    dirDeriv_eq_supportFn_of_mem_relint_dom (B := B) hf hp hx]
  constructor
  · intro h
    refine eq_univ_of_forall fun v => ?_
    exact mem_dom.2 (supportFn_lt_top_iff.2 (h v))
  · intro h v
    exact supportFn_lt_top_iff.1 (mem_dom.1 (h ▸ Set.mem_univ v))

/-! ### What happens when there is no subgradient -/

omit [FiniteDimensional ℝ E] in
/-- Every point of `dom f` gives a direction in the effective domain of `f'(x; ·)`: the difference
quotient at `a = 1` is `f z - f x`, which stays below `⊤` as soon as `f x ≠ ⊥`. -/
theorem sub_mem_dom_dirDeriv (hb : f x ≠ ⊥) {z : E} (hz : z ∈ dom f) :
    z - x ∈ dom (dirDeriv f x) := by
  refine mem_dom.2 (dirDeriv_lt_iff.2 ⟨1, one_pos, ?_⟩)
  rw [one_smul, show x + (z - x) = z from by abel, EReal.coe_one, div_one, sub_eq_add_neg]
  exact EReal.add_lt_top (mem_dom.1 hz).ne
    (by rw [Ne, EReal.neg_eq_top_iff]; exact hb)

/-- Directions pointing from `x` into the relative interior of `dom f` are relative interior points
of the effective domain of `f'(x; ·)`. This is the geometric core of the non-existence statement
below, proved through the prolongation criterion for relative interiors. -/
theorem sub_mem_relint_dom_dirDeriv (hf : ConvexFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) {z : E}
    (hz : z ∈ ri (dom f)) : z - x ∈ ri (dom (dirDeriv f x)) := by
  have hconv : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  have h0 : (0 : E) ∈ dom (dirDeriv f x) :=
    mem_dom.2 (by rw [dirDeriv_zero ht hb]; exact EReal.zero_lt_top)
  have hxaff : x ∈ affineSpan ℝ (dom f) :=
    subset_affineSpan ℝ (dom f) (mem_dom.2 (lt_top_iff_ne_top.2 ht))
  refine (Convex.mem_relint_iff_prolong hconv.convex_dom ⟨0, h0⟩).2 fun w hw => ?_
  have hxw : x + w ∈ affineSpan ℝ (dom f) := by
    have h := AffineSubspace.vadd_mem_of_mem_direction
      (dom_dirDeriv_subset_direction hf ht hb hw) hxaff
    rwa [show w +ᵥ x = x + w from by rw [vadd_eq_add]; abel] at h
  obtain ⟨μ, hμ, hmem⟩ := exists_one_lt_smul_mem_of_mem_relint hz hxw
  refine ⟨μ, hμ, ?_⟩
  rw [show (1 - μ) • w + μ • (z - x) = ((1 - μ) • (x + w) + μ • z) - x from by module]
  exact sub_mem_dom_dirDeriv hb hmem

/-- Where a convex function is finite but has no subgradient, the directional derivative is `−∞`
in every direction pointing into the relative interior of `dom f`. No properness of `f` is needed,
the argument running entirely inside `f'(x; ·)`.

The classical proof overshoots in its last sentence, concluding that `f'(x; ·)` is `−∞` throughout
`(dom f) - x`. That is false: for `f y = -√y` on `[0, ∞)` at `x = 0` one has `∂f 0 = ∅` and
`f'(0; y) = −∞` for every `y > 0`, but `f'(0; 0) = 0` and `0 ∈ (dom f) - x`. -/
theorem dirDeriv_eq_bot_of_subgradient_eq_empty [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hsub : subgradient B f x = ∅) {z : E}
    (hz : z ∈ ri (dom f)) : dirDeriv f x (z - x) = ⊥ := by
  have hconv : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  refine hconv.eq_bot_of_mem_relint_dom (fun hpd => ?_) (sub_mem_relint_dom_dirDeriv hf ht hb hz)
  have hcl : clFn (dirDeriv f x) = fun _ => (⊥ : EReal) := by
    rw [clFn_dirDeriv (B := B) hf ht hb, hsub, supportFn_empty]
  exact (hconv.proper_clFn hpd).ne_bot 0 (congrFun hcl 0)

/-- In its usual shape: where a convex function is finite but has no subgradient there is an
*infinite two-sided* directional derivative, `f'(x; y) = -f'(x; -y) = −∞`. -/
theorem exists_dirDeriv_eq_bot_and_dirDeriv_neg_eq_top [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hsub : subgradient B f x = ∅) :
    ∃ y : E, dirDeriv f x y = ⊥ ∧ dirDeriv f x (-y) = ⊤ := by
  obtain ⟨z, hz⟩ := Convex.relint_nonempty hf.convex_dom ⟨x, mem_dom.2 (lt_top_iff_ne_top.2 ht)⟩
  refine ⟨z - x, dirDeriv_eq_bot_of_subgradient_eq_empty (B := B) hf ht hb hsub hz, ?_⟩
  have h := neg_dirDeriv_neg_le hf ht hb (z - x)
  rwa [dirDeriv_eq_bot_of_subgradient_eq_empty (B := B) hf ht hb hsub hz, le_bot_iff,
    EReal.neg_eq_bot_iff] at h

/-- As a criterion: a convex function finite at `x` fails to be subdifferentiable there exactly
when `f'(x; ·)` takes the value `−∞` somewhere. Only the forward direction needs the work above;
the converse needs no convexity. -/
theorem subgradient_eq_empty_iff_exists_dirDeriv_eq_bot [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    subgradient B f x = ∅ ↔ ∃ y : E, dirDeriv f x y = ⊥ := by
  constructor
  · intro hsub
    obtain ⟨y, hy, -⟩ := exists_dirDeriv_eq_bot_and_dirDeriv_neg_eq_top (B := B) hf ht hb hsub
    exact ⟨y, hy⟩
  · rintro ⟨y, hy⟩
    refine Set.eq_empty_of_forall_notMem fun v hv => ?_
    have h := (mem_subgradient_iff_le_dirDeriv ht hb).1 hv y
    rw [hy, le_bot_iff] at h
    exact EReal.coe_ne_bot _ h

end Relint

/-! ### Polyhedral functions -/

section Polyhedral

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- First step: the directional derivative of a polyhedral convex function at a point where it is
finite is again polyhedral. The cone generated by `epi f - (x, f x)` is finitely generated, hence
closed, and a closed cone of this kind *is* `epi (f'(x; ·))`. -/
theorem polyhedralFn_dirDeriv (hf : PolyhedralFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    PolyhedralFn (dirDeriv f x) := by
  obtain ⟨r, hr⟩ := EReal.exists_coe_of_ne_bot_of_lt_top hb (lt_top_iff_ne_top.2 ht)
  have hsub : Polyhedral (epi f - {((x, r) : E × ℝ)}) :=
    Polyhedral.sub hf (polyhedral_singleton _)
  have h0 : (0 : E × ℝ) ∈ epi f - {((x, r) : E × ℝ)} :=
    ⟨(x, r), (mk_mem_epi.2 hr.le : ((x, r) : E × ℝ) ∈ epi f), (x, r), rfl, sub_self _⟩
  have hfg := finitelyGeneratedCone_hull_of_zero_mem hsub h0
  change Polyhedral (epi (dirDeriv f x))
  rw [epi_dirDeriv_eq_coe_hull hf.convexFn hr hfg.isClosed]
  exact hfg.polyhedralCone.polyhedral

/-- Second step: `f'(x; ·)` is proper. A lower semicontinuous convex function taking the value
`−∞` somewhere is `−∞` on the whole closure of its effective domain, and `f'(x; 0) = 0`. -/
theorem proper_dirDeriv_of_polyhedralFn (hf : PolyhedralFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    Proper (dirDeriv f x) := by
  have hpoly := polyhedralFn_dirDeriv hf ht hb
  have h0 : (0 : E) ∈ dom (dirDeriv f x) := by
    rw [mem_dom, dirDeriv_zero ht hb]; exact EReal.zero_lt_top
  by_contra hcon
  have hbot := hpoly.convexFn.eq_bot_of_mem_closure_dom hpoly.lowerSemicontinuous hcon
    (subset_closure h0)
  rw [dirDeriv_zero ht hb] at hbot
  exact absurd hbot (by simp)

/-- For a polyhedral convex function the directional derivative is exactly the support function
of the subdifferential. -/
theorem dirDeriv_eq_supportFn_of_polyhedralFn [IsCompatiblePairing B] (hf : PolyhedralFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    dirDeriv f x = supportFn B.flip (subgradient B f x) :=
  dirDeriv_eq_supportFn_of_closedFn hf.convexFn ht hb
    ((polyhedralFn_dirDeriv hf ht hb).closedFn (proper_dirDeriv_of_polyhedralFn hf ht hb).ne_bot)

/-- A polyhedral convex function is subdifferentiable at every point where it is finite. -/
theorem subgradient_nonempty_of_polyhedralFn [IsCompatiblePairing B] (hf : PolyhedralFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) : (subgradient B f x).Nonempty :=
  subgradient_nonempty_of_closedFn_dirDeriv hf.convexFn ht hb
    ((polyhedralFn_dirDeriv hf ht hb).closedFn (proper_dirDeriv_of_polyhedralFn hf ht hb).ne_bot)

end Polyhedral

section PolyhedralSubgradient

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- The subdifferential of a polyhedral convex function is a polyhedral convex set: `∂f x` is the
effective domain of `(f'(x; ·))*`, which is the indicator of `∂f x`, and the conjugate of a
polyhedral convex function is again polyhedral. -/
theorem polyhedral_subgradient_of_polyhedralFn (hf : PolyhedralFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    Polyhedral (subgradient B f x) := by
  have hconj : PolyhedralFn (conj B (dirDeriv f x)) :=
    PolyhedralFn.conj (polyhedralFn_dirDeriv hf ht hb)
  rw [conj_dirDeriv ht hb] at hconj
  have h := hconj.polyhedral_dom
  rwa [dom_indicatorFn] at h

end PolyhedralSubgradient

/-! ### The normal cone to a level set

Read backwards from the bipolar: `cl (cone (∂f x))` is the bipolar `(∂f x)°°`, its inner polar is
the sublevel set `{v | (cl f'(x; ·)) v ≤ 0}`, and that set is `cl {v | f'(x; v) < 0}`. -/

section NormalCone

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] [TopologicalSpace F] [IsTopologicalAddGroup F]
  [ContinuousSMul ℝ F] [LocallyConvexSpace ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal}
  {x : E} {r : ℝ}

omit [FiniteDimensional ℝ E] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- The normal cone is closed: it is an intersection of half-spaces of `F`, one for each point
of `C`. -/
theorem isClosed_normalCone [IsContinuousPairing B.flip] (C : Set E) (x : E) :
    IsClosed (normalCone B C x) := by
  rw [show normalCone B C x = ⋂ z ∈ C, {y : F | B (z - x) y ≤ 0} from
    Set.ext fun y => by simp]
  exact isClosed_biInter fun z _ =>
    isClosed_le (continuous_pairing B.flip (z - x)) continuous_const

omit [FiniteDimensional ℝ E] [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- Every subgradient at `x` is normal to the level set through `x`: the elementary half of
the theorem below, being the subgradient inequality read at a point of the level set. -/
theorem subgradient_subset_normalCone_setOf_le (hr : f x = (r : EReal)) :
    subgradient B f x ⊆ normalCone B {z | f z ≤ (r : EReal)} x := by
  intro y hy z hz
  have h0 := hy z
  rw [hr] at h0
  have h1 : (r : EReal) + ((B (z - x) y : ℝ) : EReal) ≤ (r : EReal) := h0.trans hz
  rw [← EReal.coe_add, EReal.coe_le_coe_iff] at h1
  linarith

omit [FiniteDimensional ℝ E] [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- The polar of the subdifferential is a sublevel set of the closed directional derivative. -/
theorem polarCone_subgradient [IsCompatiblePairing B] (hf : ConvexFn f) (ht : f x ≠ ⊤)
    (hb : f x ≠ ⊥) :
    polarCone B.flip (subgradient B f x) = {v : E | clFn (dirDeriv f x) v ≤ 0} := by
  rw [clFn_dirDeriv (B := B) hf ht hb]
  ext v
  simp only [mem_polarCone, Set.mem_ofPred_eq, supportFn_apply, LinearMap.flip_apply,
    iSup₂_le_iff]
  exact ⟨fun h y hy => by exact_mod_cast h y hy, fun h y hy => by exact_mod_cast h y hy⟩

/-- The normal cone to the level set `{z | f z ≤ f x}` at `x` is the closure of the convex cone
generated by the subdifferential at `x`, provided `f x > inf f`.

`hne` says that `f` is subdifferentiable at `x`, and `hinf` that `f` does not achieve its minimum
there. Neither can be dropped: for `f y = -√y` on `[0, ∞)` and `+∞` elsewhere, at `x = 0` the level
set is `[0, ∞)` with normal cone `(-∞, 0]`, while `∂f 0 = ∅` generates only `{0}`; and without
`hinf` the level set is all of `dom f` around a minimizer. Properness of `f` is implied by `hne`
and so is not asked for separately. -/
theorem normalCone_setOf_le_eq_closure_coe_hull_subgradient [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hne : (subgradient B f x).Nonempty) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = closure ((PointedCone.hull ℝ (subgradient B f x) : Set F)) := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hk : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  have hkp : Proper (dirDeriv f x) := by
    obtain ⟨y₀, hy₀⟩ := hne
    refine ⟨⟨0, ?_⟩, fun v => ?_⟩
    · rw [mem_dom, dirDeriv_zero ht hb]
      simp
    · exact ne_bot_of_le_ne_bot (EReal.coe_ne_bot _)
        ((mem_subgradient_iff_le_dirDeriv ht hb).1 hy₀ v)
  have hneg : (⨅ v, dirDeriv f x v) < ((0 : ℝ) : EReal) := by
    obtain ⟨z, hz⟩ := iInf_lt_iff.1 hinf
    obtain ⟨μ, hzμ, hμr⟩ := EReal.lt_iff_exists_real_btwn.1 hz
    have hμr2 : μ < r := by exact_mod_cast hμr
    have hquot : dirDeriv f x (z - x) ≤ ((μ - r : ℝ) : EReal) := by
      have h1 := dirDeriv_le f x (z - x) one_pos
      rw [one_smul, show x + (z - x) = z from by abel, hr] at h1
      refine h1.trans ?_
      rw [EReal.sub_div_le_coe_iff one_pos, show r + (μ - r) * 1 = μ from by ring]
      exact hzμ.le
    refine lt_of_le_of_lt ((iInf_le _ (z - x)).trans hquot) ?_
    exact_mod_cast (by linarith : μ - r < 0)
  have hpol : polarCone B.flip (subgradient B f x) = closure {v : E | dirDeriv f x v < 0} := by
    have h76 := hk.closure_setOf_lt hneg
    rw [EReal.coe_zero] at h76
    rw [polarCone_subgradient hf ht hb, h76, hk.clFn_eq_lscHull hkp]
  have hbip : closure ((PointedCone.hull ℝ (subgradient B f x) : Set F))
      = polarCone B (polarCone B.flip (subgradient B f x)) := by
    have h := polarCone_polarCone (B := B.flip)
      (K := (PointedCone.hull ℝ (subgradient B f x) : Set F))
      ((PointedCone.hull ℝ (subgradient B f x) : ConvexCone ℝ F).convex)
      (fun a ha => smul_coe_pointedCone _ a ha) ⟨0, Submodule.zero_mem _⟩
    rw [polarCone_hull, LinearMap.flip_flip] at h
    exact h.symm
  refine subset_antisymm ?_ ?_
  · rw [hbip]
    intro y hy v hv
    rw [hpol] at hv
    refine closure_minimal (fun w hw => ?_)
      (isClosed_le (continuous_pairing B y) continuous_const) hv
    obtain ⟨a, ha, hlt⟩ := dirDeriv_lt_iff.1 hw
    have hmem : x + a • w ∈ {z : E | f z ≤ (r : EReal)} := by
      have h2 : (f (x + a • w) - f x) / (a : EReal) ≤ ((0 : ℝ) : EReal) := by
        rw [EReal.coe_zero]
        exact hlt.le
      rw [hr, EReal.sub_div_le_coe_iff ha, show r + 0 * a = r from by ring] at h2
      exact h2
    have h3 := hy _ hmem
    rw [add_sub_cancel_left, map_smul, LinearMap.smul_apply, smul_eq_mul] at h3
    exact nonpos_of_mul_nonpos_right h3 ha
  · refine closure_minimal ?_ (isClosed_normalCone _ x)
    have hle : PointedCone.hull ℝ (subgradient B f x)
        ≤ normalPointedCone B {z | f z ≤ (r : EReal)} x :=
      Submodule.span_le.2 (subgradient_subset_normalCone_setOf_le hr)
    exact hle

end NormalCone

section NormalConeBounded

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ}
  {f : E → EReal} {x : E} {r : ℝ}

/-- Boundedness of `∂f x` with "bounded" read in the norm rather than in the pairing sense. The
pairing form is all a general dual pair supports; the upgrade is what costs the
finite-dimensionality of `F`. -/
theorem isBounded_subgradient_iff_mem_interior_dom [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hp : Proper f) (hx : x ∈ ri (dom f)) :
    Bornology.IsBounded (subgradient B f x) ↔ x ∈ interior (dom f) := by
  rw [← bddAbove_subgradient_iff_mem_interior_dom (B := B) hf hp hx,
    isBounded_iff_forall_bddAbove (B := B.flip)]
  simp

/-- When `∂f x` is bounded — which is the case `x ∈ int (dom f)` — the closure operation may be
dropped, the cone generated by a nonempty bounded closed convex set missing the origin being
already closed. That the origin is missed is not an extra hypothesis: it is exactly `f x > inf f`,
the standing hypothesis above. -/
theorem normalCone_setOf_le_eq_coe_hull_subgradient [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hne : (subgradient B f x).Nonempty)
    (hbdd : Bornology.IsBounded (subgradient B f x)) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = (PointedCone.hull ℝ (subgradient B f x) : Set F) := by
  have h0 : (0 : F) ∉ subgradient B f x := by
    intro hmem
    refine absurd (le_iInf fun z => ?_) (not_le_of_gt hinf)
    have h1 := hmem z
    rwa [map_zero, EReal.coe_zero, add_zero, hr] at h1
  have hcl := isClosed_coe_hull_of_isBounded (convex_subgradient B f x)
    (isClosed_subgradient (B := B) f x) hne h0 hbdd
  rw [normalCone_setOf_le_eq_closure_coe_hull_subgradient hf hr hinf hne, hcl.closure_eq]

/-- The same under the hypothesis `x ∈ int (dom f)`, which supplies both non-emptiness and
boundedness of `∂f x`. Properness of `f` is assumed rather than deduced from `∂f x ≠ ∅`, because
the relative-interior existence theorem needs it first. -/
theorem normalCone_setOf_le_eq_coe_hull_subgradient_of_mem_interior_dom [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hp : Proper f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hx : x ∈ interior (dom f)) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = (PointedCone.hull ℝ (subgradient B f x) : Set F) := by
  have hri : x ∈ ri (dom f) := interior_subset_intrinsicInterior hx
  exact normalCone_setOf_le_eq_coe_hull_subgradient hf hr hinf
    (subgradient_nonempty_of_mem_relint_dom (B := B) hf hp hri)
    ((isBounded_subgradient_iff_mem_interior_dom (B := B) hf hp hri).2 hx)

end NormalConeBounded

/-! ### A trivial normal cone means an interior point -/

section NormalConeInterior

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {C : Set E} {x : E}

/-- A convex set is a neighbourhood of every point whose normal cone is trivial: the converse of
the obvious `x ∈ interior C ⇒ normalCone B C x = {0}`, and the supporting-hyperplane theorem in
disguise, since a boundary point of a convex set carries a non-zero supporting functional.

Finite-dimensionality is not decoration. In an infinite-dimensional space a convex set can have
empty interior and still be dense — the linear span of an orthonormal basis in a Hilbert space —
and then no non-zero functional supports it anywhere, so the normal cone is trivial at every point
while the interior is empty. In finite dimensions a convex set with no interior lies in a proper
affine subspace, and a functional vanishing on that subspace is normal everywhere. -/
theorem mem_interior_of_normalCone_eq_zero [IsCompatiblePairing B] (hC : Convex ℝ C)
    (hx : x ∈ C) (h : normalCone B C x = {0}) : x ∈ interior C := by
  by_contra hnot
  obtain ⟨g, hg0, hgmax⟩ :=
    exists_ne_zero_isMaxOn_of_mem_frontier hC hx ⟨subset_closure hx, hnot⟩
  obtain ⟨y, hy⟩ := exists_pairing_eq B g
  have hmem : y ∈ normalCone B C x := by
    intro z hz
    have hle : g z ≤ g x := hgmax z hz
    rw [hy z, hy x] at hle
    simpa using sub_nonpos.2 hle
  rw [h, Set.mem_singleton_iff] at hmem
  exact hg0 (ContinuousLinearMap.ext fun z => by simp [hy z, hmem])

end NormalConeInterior

end ConvexAnalysis
