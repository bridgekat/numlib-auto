/-- With a point interior to the solution set at hand, every generator lies strictly on one side of
the hyperplane `⟪x₀, ·⟫ = ·` of `F × ℝ`, so the origin is outside their convex hull. -/
private theorem zero_notMem_convexHull_insert [IsCompatiblePairing B.flip]
    (hS0 : (0 : F × ℝ) ∉ S) (hint : (interior (inequalitySet B S)).Nonempty) :
    (0 : F × ℝ) ∉ convexHull ℝ (insert ((0 : F), (1 : ℝ)) S) := by
  obtain ⟨x₀, hx₀⟩ := hint
  have hgen : insert ((0 : F), (1 : ℝ)) S ⊆
      {z : F × ℝ | ((B x₀).comp (LinearMap.fst ℝ F ℝ) - LinearMap.snd ℝ F ℝ) z < 0} := by
    rintro q (rfl | hq)
    · have h : ((B x₀).comp (LinearMap.fst ℝ F ℝ) - LinearMap.snd ℝ F ℝ)
          ((0 : F), (1 : ℝ)) = -1 := by simp
      rw [Set.mem_ofPred, h]
      norm_num
    · have h : ((B x₀).comp (LinearMap.fst ℝ F ℝ) - LinearMap.snd ℝ F ℝ) q
          = B x₀ q.1 - q.2 := rfl
      rw [Set.mem_ofPred, h]
      exact sub_neg_of_mem_interior hx₀ hS0 hq
  have hconv : Convex ℝ
      {z : F × ℝ | ((B x₀).comp (LinearMap.fst ℝ F ℝ) - LinearMap.snd ℝ F ℝ) z < 0} :=
    convex_halfSpace_lt (LinearMap.isLinear _) 0
  intro h0
  have hlt := convexHull_min hgen hconv h0
  rw [Set.mem_ofPred, map_zero] at hlt
  exact lt_irrefl (0 : ℝ) hlt

/-- The cone generated by a compact convex set missing the origin is closed; applied to the
convex hull of the generators, this closes the cone generated by `S` and the upward vertical
direction. -/
private theorem isClosed_coneHull_insert [IsCompatiblePairing B.flip] (hScl : IsClosed S)
    (hSb : Bornology.IsBounded S) (hS0 : (0 : F × ℝ) ∉ S)
    (hint : (interior (inequalitySet B S)).Nonempty) :
    IsClosed (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)) := by
  have hcpt : IsCompact (insert ((0 : F), (1 : ℝ)) S) :=
    IsCompact.insert (Metric.isCompact_of_isClosed_isBounded hScl hSb) _
  have hT : IsCompact (convexHull ℝ (insert ((0 : F), (1 : ℝ)) S)) :=
    IsCompact.convexHull hcpt
  have hcl := isClosed_coe_hull_of_isBounded (convex_convexHull ℝ _) hT.isClosed
    ⟨((0 : F), (1 : ℝ)), subset_convexHull ℝ _ (Set.mem_insert _ _)⟩
    (zero_notMem_convexHull_insert hS0 hint) hT.isBounded
  rwa [coe_hull_convexHull] at hcl

/-- The converse of `inequalitySet_subset_halfSpace_of_mem_coneHull`: a closed half-space containing
the solution set has its defining pair in the cone generated by `S` and `(0, 1)`. The pair is
separated from that (closed) cone by a functional `(y, μ) ↦ ⟪u, y⟫ + c μ` with `c ≤ 0`; a negative
`c` rescales `u` into a point of the solution set violating the half-space, a vanishing `c` makes
`u` a direction along which the solution set escapes it. -/
theorem mem_coneHull_insert_of_subset_halfSpace [IsCompatiblePairing B.flip] (hScl : IsClosed S)
    (hSb : Bornology.IsBounded S) (hS0 : (0 : F × ℝ) ∉ S)
    (hint : (interior (inequalitySet B S)).Nonempty) {y₀ : F} {μ₀ : ℝ}
    (hsub : inequalitySet B S ⊆ {x : E | B x y₀ ≤ μ₀}) :
    ((y₀, μ₀) : F × ℝ) ∈ PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) := by
  classical
  have hKcl : IsClosed (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)) :=
    isClosed_coneHull_insert hScl hSb hS0 hint
  have hKconv : Convex ℝ (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)) :=
    ((PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : PointedCone ℝ (F × ℝ)) :
      ConvexCone ℝ (F × ℝ)).convex
  have hKcone : ∀ ⦃a : ℝ⦄, 0 < a → ∀ ⦃z : F × ℝ⦄,
      z ∈ (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)) →
      a • z ∈ (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)) := by
    intro a ha z hz
    exact Submodule.smul_mem _ (⟨a, ha.le⟩ : {c : ℝ // 0 ≤ c}) hz
  have hKne : (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)).Nonempty :=
    ⟨0, Submodule.zero_mem _⟩
  by_contra hnot
  have hmem : ((y₀, μ₀) : F × ℝ) ∉ ⋂ (f : (F × ℝ) →L[ℝ] ℝ)
      (_ : ∀ z ∈ (PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S) : Set (F × ℝ)), f z ≤ 0),
      (halfSpaceCone f : Set (F × ℝ)) := by
    rw [isClosed_convex_isCone_eq_iInter_halfSpaceCone hKconv hKcone hKcl hKne]
    exact hnot
  simp only [Set.mem_iInter, coe_halfSpaceCone, Set.mem_ofPred, not_forall, not_le] at hmem
  obtain ⟨φ, hφK, hφpos⟩ := hmem
  have hdecomp : ∀ (y : F) (μ : ℝ),
      φ (y, μ) = (φ.comp (ContinuousLinearMap.inl ℝ F ℝ)) y + φ ((0 : F), (1 : ℝ)) * μ :=
    dual_prod_apply φ
  obtain ⟨u, hu⟩ := exists_pairing_eq B.flip (φ.comp (ContinuousLinearMap.inl ℝ F ℝ))
  have hu' : ∀ y : F, (φ.comp (ContinuousLinearMap.inl ℝ F ℝ)) y = B u y := hu
  have hc0 : φ ((0 : F), (1 : ℝ)) ≤ 0 :=
    hφK _ (PointedCone.subset_hull (Set.mem_insert _ _))
  have hSK : ∀ q ∈ S, B u q.1 + φ ((0 : F), (1 : ℝ)) * q.2 ≤ 0 := by
    intro q hq
    have h := hφK q (PointedCone.subset_hull (Set.mem_insert_of_mem _ hq))
    rwa [show q = (q.1, q.2) from rfl, hdecomp q.1 q.2, hu' q.1] at h
  have hpos : 0 < B u y₀ + φ ((0 : F), (1 : ℝ)) * μ₀ := by
    rwa [hdecomp y₀ μ₀, hu' y₀] at hφpos
  rcases lt_or_eq_of_le hc0 with hcneg | hceq
  · -- the separating functional is not vertical: rescale `u` into the solution set
    have hane : φ ((0 : F), (1 : ℝ)) ≠ 0 := ne_of_lt hcneg
    have hapos : 0 < -(φ ((0 : F), (1 : ℝ)))⁻¹ := by
      rw [neg_pos, inv_neg'' ]
      exact hcneg
    have hprod : -(φ ((0 : F), (1 : ℝ)))⁻¹ * -(φ ((0 : F), (1 : ℝ))) = 1 := by
      field_simp
    have hxmem : (-(φ ((0 : F), (1 : ℝ)))⁻¹) • u ∈ inequalitySet B S := by
      intro q hq
      have h := hSK q hq
      have hval : B ((-(φ ((0 : F), (1 : ℝ)))⁻¹) • u) q.1
          = -(φ ((0 : F), (1 : ℝ)))⁻¹ * B u q.1 := by
        rw [map_smul, LinearMap.smul_apply, smul_eq_mul]
      rw [hval]
      have h1 : B u q.1 ≤ -(φ ((0 : F), (1 : ℝ))) * q.2 := by linarith
      calc -(φ ((0 : F), (1 : ℝ)))⁻¹ * B u q.1
          ≤ -(φ ((0 : F), (1 : ℝ)))⁻¹ * (-(φ ((0 : F), (1 : ℝ))) * q.2) :=
            mul_le_mul_of_nonneg_left h1 hapos.le
        _ = q.2 := by rw [← mul_assoc, hprod, one_mul]
    have hgoal := hsub hxmem
    rw [Set.mem_ofPred, map_smul, LinearMap.smul_apply, smul_eq_mul] at hgoal
    have h2 : -(φ ((0 : F), (1 : ℝ))) * μ₀ < B u y₀ := by linarith
    have h3 := mul_lt_mul_of_pos_left h2 hapos
    rw [← mul_assoc, hprod, one_mul] at h3
    linarith
  · -- the separating functional is vertical: `u` is a direction of escape
    obtain ⟨x₀, hx₀⟩ := hint
    have hx₀' : x₀ ∈ inequalitySet B S := interior_subset hx₀
    have hSu : ∀ q ∈ S, B u q.1 ≤ 0 := by
      intro q hq
      have h := hSK q hq
      rw [hceq, zero_mul, add_zero] at h
      exact h
    have hposu : 0 < B u y₀ := by rw [hceq, zero_mul, add_zero] at hpos; exact hpos
    set s : ℝ := (|μ₀ - B x₀ y₀| + 1) / B u y₀ with hs
    have hspos : 0 < s := by positivity
    have hxs : x₀ + s • u ∈ inequalitySet B S := by
      intro q hq
      have hval : B (x₀ + s • u) q.1 = B x₀ q.1 + s * B u q.1 := by
        rw [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply, smul_eq_mul]
      rw [hval]
      nlinarith [hx₀' q hq, mul_nonpos_of_nonneg_of_nonpos hspos.le (hSu q hq)]
    have hgoal := hsub hxs
    rw [Set.mem_ofPred, map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply,
      smul_eq_mul] at hgoal
    have hsval : s * B u y₀ = |μ₀ - B x₀ y₀| + 1 := by
      rw [hs]; field_simp
    have habs : μ₀ - B x₀ y₀ ≤ |μ₀ - B x₀ y₀| := le_abs_self _
    linarith

/-- Carathéodory's theorem thins a conical representation down to `dim F` generators drawn from `S`
itself. The upward direction always disappears: either it does not occur, or it can be eliminated,
because a maximal linearly independent family of members of `S` already spans it — and a family of
members of `S` combining to `(0, 1)` with non-positive coefficients would contradict the existence
of a solution. -/
theorem exists_card_le_finrank_of_mem_coneHull_insert (hne : (inequalitySet B S).Nonempty)
    {y₀ : F} {μ₀ : ℝ}
    (h : ((y₀, μ₀) : F × ℝ) ∈ PointedCone.hull ℝ (insert ((0 : F), (1 : ℝ)) S)) :
    ∃ (t : Finset (F × ℝ)) (l : (F × ℝ) → ℝ), ↑t ⊆ S ∧ (∀ q ∈ t, 0 ≤ l q) ∧
      t.card ≤ Module.finrank ℝ F ∧
      (∑ q ∈ t, l q • q.1 = y₀) ∧ ∑ q ∈ t, l q * q.2 ≤ μ₀ := by
  classical
  obtain ⟨t, w, hts, hwpos, hli, hsum⟩ := exists_linearIndepOn_of_mem_coneHull h
  have hfr : Module.finrank ℝ (F × ℝ) = Module.finrank ℝ F + 1 := by
    rw [Module.finrank_prod, Module.finrank_self]
  have hcard : t.card ≤ Module.finrank ℝ F + 1 := by
    have hb := LinearIndependent.finset_card_le_finrank hli
    rwa [hfr] at hb
  have hfst : ∑ q ∈ t, w q • q.1 = y₀ := by
    simpa [Prod.fst_sum, Prod.smul_fst] using congrArg Prod.fst hsum
  have hsnd : ∑ q ∈ t, w q * q.2 = μ₀ := by
    simpa [Prod.snd_sum, Prod.smul_snd, smul_eq_mul] using congrArg Prod.snd hsum
  by_cases hv : ((0 : F), (1 : ℝ)) ∈ t
  · -- the upward direction occurs: drop it, which only lowers the right-hand side
    refine ⟨t.erase ((0 : F), (1 : ℝ)), w, ?_, ?_, ?_, ?_, ?_⟩
    · intro q hq
      have hq' := Finset.mem_erase.1 (by exact_mod_cast hq)
      rcases hts (by exact_mod_cast hq'.2) with hq'' | hq''
      · exact absurd hq'' hq'.1
      · exact hq''
    · exact fun q hq => (hwpos q (Finset.mem_of_mem_erase hq)).le
    · have hc := Finset.card_erase_of_mem hv
      omega
    · have hsplit : (∑ q ∈ t.erase ((0 : F), (1 : ℝ)), w q • q.1)
          + w ((0 : F), (1 : ℝ)) • ((0 : F), (1 : ℝ)).1 = ∑ q ∈ t, w q • q.1 :=
        Finset.sum_erase_add t (fun q => w q • q.1) hv
      simp only [smul_zero, add_zero] at hsplit
      rw [hsplit]
      exact hfst
    · have hsplit : (∑ q ∈ t.erase ((0 : F), (1 : ℝ)), w q * q.2)
          + w ((0 : F), (1 : ℝ)) * (1 : ℝ) = ∑ q ∈ t, w q * q.2 :=
        Finset.sum_erase_add t (fun q => w q * q.2) hv
      have hwv : 0 < w ((0 : F), (1 : ℝ)) := hwpos _ hv
      rw [hsnd, mul_one] at hsplit
      linarith
  · have htS : (t : Set (F × ℝ)) ⊆ S := by
      intro q hq
      rcases hts hq with hq' | hq'
      · exact absurd (hq' ▸ (by exact_mod_cast hq : q ∈ t)) hv
      · exact hq'
    by_cases hcard' : t.card ≤ Module.finrank ℝ F
    · exact ⟨t, w, htS, fun q hq => (hwpos q hq).le, hcard', hfst, le_of_eq hsnd⟩
    · -- a maximal independent family: it spans, so it produces the upward direction itself
      have hteq : t.card = Module.finrank ℝ F + 1 := le_antisymm hcard (by omega)
      have hspan : Submodule.span ℝ (t : Set (F × ℝ)) = ⊤ := by
        refine Submodule.eq_top_of_finrank_eq ?_
        rw [finrank_span_set_eq_card hli, hfr, ← hteq]
        simp
      have hmem01 : ((0 : F), (1 : ℝ)) ∈ Submodule.span ℝ (t : Set (F × ℝ)) := by
        rw [hspan]; trivial
      obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 hmem01
      have hcfst : ∑ q ∈ t, c q • q.1 = (0 : F) := by
        simpa [Prod.fst_sum, Prod.smul_fst] using congrArg Prod.fst hc
      have hcsnd : ∑ q ∈ t, c q * q.2 = (1 : ℝ) := by
        simpa [Prod.snd_sum, Prod.smul_snd, smul_eq_mul] using congrArg Prod.snd hc
      obtain ⟨x₀, hx₀⟩ := hne
      have hexpos : ∃ q ∈ t, 0 < c q := by
        by_contra hcon
        push Not at hcon
        have hzero : ∑ q ∈ t, c q * B x₀ q.1 = 0 := by
          have hmap : B x₀ (∑ q ∈ t, c q • q.1) = ∑ q ∈ t, c q * B x₀ q.1 := by
            rw [map_sum]
            exact Finset.sum_congr rfl fun q _ => by rw [map_smul, smul_eq_mul]
          rw [hcfst, map_zero] at hmap
          exact hmap.symm
        have hge : ∀ q ∈ t, c q * q.2 ≤ c q * B x₀ q.1 := fun q hq =>
          mul_le_mul_of_nonpos_left (hx₀ q (htS hq)) (hcon q hq)
        have hle := Finset.sum_le_sum hge
        rw [hcsnd, hzero] at hle
        linarith
      obtain ⟨qm, hqm, hqmmin⟩ :=
        (t.filter (fun q => 0 < c q)).exists_min_image (fun q => w q / c q)
          (by obtain ⟨q, hqt, hqc⟩ := hexpos; exact ⟨q, Finset.mem_filter.2 ⟨hqt, hqc⟩⟩)
      have hqmt : qm ∈ t := (Finset.mem_filter.1 hqm).1
      have hqmc : 0 < c qm := (Finset.mem_filter.1 hqm).2
      have hspos : 0 < w qm / c qm := div_pos (hwpos qm hqmt) hqmc
      have hl0 : ∀ q ∈ t, 0 ≤ w q - (w qm / c qm) * c q := by
        intro q hq
        rcases le_or_gt (c q) 0 with hcq | hcq
        · nlinarith [hwpos q hq]
        · have hmin := hqmmin q (Finset.mem_filter.2 ⟨hq, hcq⟩)
          have := (le_div_iff₀ hcq).1 hmin
          linarith
      have hlq : w qm - (w qm / c qm) * c qm = 0 := by field_simp; ring
      have hsum' : ∑ q ∈ t, (w q - (w qm / c qm) * c q) • q
          = ((y₀, μ₀ - w qm / c qm) : F × ℝ) := by
        have hstep : ∑ q ∈ t, (w q - (w qm / c qm) * c q) • q
            = (∑ q ∈ t, w q • q) - (w qm / c qm) • ∑ q ∈ t, c q • q := by
          rw [Finset.smul_sum, ← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl fun q _ => by rw [sub_smul, smul_smul]
        rw [hstep, hsum, hc]
        refine Prod.ext ?_ ?_ <;> simp
      have hfst' : ∑ q ∈ t, (w q - (w qm / c qm) * c q) • q.1 = y₀ := by
        simpa [Prod.fst_sum, Prod.smul_fst] using congrArg Prod.fst hsum'
      have hsnd' : ∑ q ∈ t, (w q - (w qm / c qm) * c q) * q.2 = μ₀ - w qm / c qm := by
        simpa [Prod.snd_sum, Prod.smul_snd, smul_eq_mul] using congrArg Prod.snd hsum'
      refine ⟨t.erase qm, fun q => w q - (w qm / c qm) * c q, ?_, ?_, ?_, ?_, ?_⟩
      · exact fun q hq => htS (by exact_mod_cast Finset.mem_of_mem_erase (by exact_mod_cast hq))
      · exact fun q hq => hl0 q (Finset.mem_of_mem_erase hq)
      · have hcerase := Finset.card_erase_of_mem hqmt
        omega
      · have hsp : (∑ q ∈ t.erase qm, (w q - (w qm / c qm) * c q) • q.1)
            + (w qm - (w qm / c qm) * c qm) • qm.1
            = ∑ q ∈ t, (w q - (w qm / c qm) * c q) • q.1 :=
          Finset.sum_erase_add t (fun q => (w q - (w qm / c qm) * c q) • q.1) hqmt
        rw [hlq, zero_smul, add_zero] at hsp
        rw [hsp]
        exact hfst'
      · have hsp : (∑ q ∈ t.erase qm, (w q - (w qm / c qm) * c q) * q.2)
            + (w qm - (w qm / c qm) * c qm) * qm.2
            = ∑ q ∈ t, (w q - (w qm / c qm) * c q) * q.2 :=
          Finset.sum_erase_add t (fun q => (w q - (w qm / c qm) * c q) * q.2) hqmt
        rw [hlq, zero_mul, add_zero] at hsp
        rw [hsp, hsnd']
        linarith

