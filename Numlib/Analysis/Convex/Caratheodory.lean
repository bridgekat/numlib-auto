/-- An interior point of the solution set satisfies every one of the defining inequalities
*strictly*, unless the inequality is the trivial one `0 ≤ 0`. -/
private theorem sub_neg_of_mem_interior [IsCompatiblePairing B.flip] {x₀ : E}
    (hx₀ : x₀ ∈ interior (inequalitySet B S)) (hS0 : (0 : F × ℝ) ∉ S) {q : F × ℝ} (hq : q ∈ S) :
    B x₀ q.1 - q.2 < 0 := by
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 isOpen_interior x₀ hx₀
  have hsub : Metric.ball x₀ ε ⊆ inequalitySet B S := hball.trans interior_subset
  have hx₀' : x₀ ∈ inequalitySet B S := interior_subset hx₀
  by_cases hq1 : q.1 = 0
  · have h0 : B x₀ q.1 = 0 := by rw [hq1, map_zero]
    have hle : (0 : ℝ) ≤ q.2 := by rw [← h0]; exact hx₀' q hq
    rcases eq_or_lt_of_le hle with h | h
    · have hq0 : q = (0 : F × ℝ) := Prod.ext hq1 h.symm
      exact absurd (hq0 ▸ hq) hS0
    · rw [h0]; linarith
  · obtain ⟨u, hu⟩ := exists_pairing_ne_zero (B := B) hq1
    obtain ⟨v, hv⟩ : ∃ v : E, 0 < B v q.1 := by
      rcases lt_or_gt_of_ne hu with h | h
      · refine ⟨-u, ?_⟩
        rw [map_neg, LinearMap.neg_apply]
        linarith
      · exact ⟨u, h⟩
    have hvne : v ≠ 0 := by rintro rfl; simp at hv
    have hvnorm : (0 : ℝ) < ‖v‖ := norm_pos_iff.2 hvne
    have hcpos : (0 : ℝ) < ε / (2 * ‖v‖) := by positivity
    have hnorm : ε / (2 * ‖v‖) * ‖v‖ = ε / 2 := by field_simp
    have hmem : x₀ + (ε / (2 * ‖v‖)) • v ∈ Metric.ball x₀ ε := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
        abs_of_pos hcpos, hnorm]
      linarith
    have hineq := hsub hmem q hq
    have hval : B (x₀ + (ε / (2 * ‖v‖)) • v) q.1 = B x₀ q.1 + ε / (2 * ‖v‖) * B v q.1 := by
      rw [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply, smul_eq_mul]
    rw [hval] at hineq
    nlinarith [mul_pos hcpos hv]

