import Numlib.Analysis.Convex.Duality.Gauge
import Numlib.Analysis.Convex.Recession.Conjugate

/-!
# Boundedness of a polar

Let $E$ and $F$ be finite-dimensional normed spaces paired by a bilinear form $\langle x, y \rangle$
that is compatible with both topologies. For a closed convex set $C \subseteq E$ that contains the
origin, the polar $C^\circ = \{y \in F \mid \langle x, y \rangle \le 1 \text{ for all } x \in C\}$
is bounded exactly when the origin is an interior point of $C$. So polarity exchanges boundedness on
one side with interiority on the other. The presentation follows §14 of [rockafellar1970convex].

## Main results

* `ConvexAnalysis.isBounded_polarSet_iff_zero_mem_interior`: $C^\circ$ is bounded if and only if
  $0 \in \operatorname{int} C$ (Corollary 14.5.1 of [rockafellar1970convex]).
* `ConvexAnalysis.isBounded_iff_zero_mem_interior_polarSet`: the dual statement, $C$ is bounded if
  and only if $0 \in \operatorname{int} C^\circ$.
-/

open Bornology Set

namespace ConvexAnalysis

section PolarBounded

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} [IsCompatiblePairing B] [IsCompatiblePairing B.flip] {C : Set E}

/-- **The polar is bounded exactly when the origin is interior.** Let $E$ and $F$ be
finite-dimensional real normed spaces, and let the pairing and its flip be compatible with their
topologies. Let $C \subseteq E$ be a closed convex set that contains the origin. Then
$$C^\circ \text{ is bounded} \iff 0 \in \operatorname{int} C.$$
This is Corollary 14.5.1 of [rockafellar1970convex].

Finite dimension is necessary for the proof: it is what
`ConvexAnalysis.isBounded_iff_recessionCone_eq_zero` needs, and it turns "the cone generated by
$C^\circ$ is dense" into "the cone generated by $C^\circ$ is the whole space". -/
theorem isBounded_polarSet_iff_zero_mem_interior (hconv : Convex ℝ C) (hcl : IsClosed C)
    (h0 : (0 : E) ∈ C) : IsBounded (polarSet B C) ↔ (0 : E) ∈ interior C := by
  rw [isBounded_iff_recessionCone_eq_zero (convex_polarSet B C) isClosed_polarSet
      ⟨0, zero_mem_polarSet B C⟩, recessionCone_polarSet hconv hcl h0]
  exact (zero_mem_interior_iff_polarCone_eq_zero (B := B.flip) (D := C) hconv ⟨0, h0⟩).symm

/-- **A set is bounded exactly when the origin is interior to its polar.** Let $E$ and $F$ be
finite-dimensional real normed spaces, and let the pairing and its flip be compatible with their
topologies. Let $C \subseteq E$ be a closed convex set that contains the origin. Then
$$C \text{ is bounded} \iff 0 \in \operatorname{int} C^\circ.$$
This is the dual form of `ConvexAnalysis.isBounded_polarSet_iff_zero_mem_interior`. -/
theorem isBounded_iff_zero_mem_interior_polarSet (hconv : Convex ℝ C) (hcl : IsClosed C)
    (h0 : (0 : E) ∈ C) : IsBounded C ↔ (0 : F) ∈ interior (polarSet B C) := by
  have h := isBounded_polarSet_iff_zero_mem_interior (B := B.flip) (C := polarSet B C)
    (convex_polarSet B C) isClosed_polarSet (zero_mem_polarSet B C)
  rwa [polarSet_polarSet (B := B) hconv hcl h0] at h

end PolarBounded

end ConvexAnalysis
