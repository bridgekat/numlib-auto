import Numlib.Analysis.Convex.Duality.Gauge
import Numlib.Analysis.Convex.Duality.Level

/-!
# The conjugate read off the polar of the homogenized epigraph

Let $E$ and $F$ be real vector spaces paired by a bilinear form $\langle x, y \rangle = B(x, y)$,
and let $f : E \to [-\infty, +\infty]$ be convex. One dimension up, $f$ is encoded by the cone $K_f
\subseteq \mathbb{R} \times E \times \mathbb{R}$ generated by the vectors $(1, x, \mu)$ with
$\mu \ge f(x)$, which is `ConvexAnalysis.homCone` of `Numlib.Analysis.Convex.Homogenize`. This
module computes the polar $K_f^\circ$ of this cone for the pairing $$\langle (\lambda, x, \mu),
(\lambda^*, y, \mu^*) \rangle = \lambda \lambda^* + \langle x, y \rangle + \mu \mu^*,$$ and finds
the conjugate $f^*$ inside it: under the reflection $(\lambda^*, y, \mu^*) \mapsto (-\mu^*, y,
-\lambda^*)$, the polar $K_f^\circ$ is exactly the closure of $K_{f^*}$. This is Theorem 14.4 of
[rockafellar1970convex], in the setting of §14 there.

So conjugacy of functions and polarity of cones are the same correspondence, read in two coordinate
systems one dimension apart. The module `Numlib.Analysis.Convex.Duality.Polar` develops polarity
from conjugacy; this module gives the derivation in the other direction.

## Main definitions

* `ConvexAnalysis.homConePairing`: the pairing of $\mathbb{R} \times E \times \mathbb{R}$ with
  $\mathbb{R} \times F \times \mathbb{R}$ induced by $B$.
* `ConvexAnalysis.homCoord`: the homogenizing coordinate $(\lambda^*, y, \mu^*) \mapsto \lambda^*$.
  The conjugate lives on its cross-section $\lambda^* = 1$, and the density argument cuts on its
  positivity.
* `ConvexAnalysis.negSwapEnds`: the reflection $(\lambda^*, y, \mu^*) \mapsto (-\mu^*, y,
  -\lambda^*)$, a linear involution.

## Main results

* `ConvexAnalysis.convexConj_le_coe_iff_forall_mem_epi`: $f^*(y) \le c$ if and only if
  $\langle x, y \rangle - \mu \le c$ for every $(x, \mu) \in \operatorname{epi} f$.
* `ConvexAnalysis.polarCone_homCone`: for convex $f$, the polar of $K_f$ is cut out by the
  generating vectors $(1, x, \mu)$ alone.
* `ConvexAnalysis.mem_homCone_convexConj_iff_of_pos`: for $\lambda^* > 0$, the vector
  $(-\mu^*, y, -\lambda^*)$ lies in $K_f^\circ$ if and only if $(\lambda^*, y, \mu^*)$ lies in
  $K_{f^*}$.
* `ConvexAnalysis.closure_homCone_convexConj`: $\operatorname{cl} K_{f^*} = \{(\lambda^*, y, \mu^*)
  \mid (-\mu^*, y, -\lambda^*) \in K_f^\circ\}$ (Theorem 14.4 of [rockafellar1970convex]).

## Proof outline

The proof of the main theorem has three steps. On the open half-space $\lambda^* > 0$, the
cross-section computation identifies the reflected polar with $K_{f^*}$. The reflected polar lies in
the closed half-space $\lambda^* \ge 0$. A convex set that meets the open half-space is contained in
the closure of its part in the open half-space (`Convex.closure_inter_setOf_pos`).

## Notation

* $(\lambda, x, \mu)$: a point of $\mathbb{R} \times E \times \mathbb{R}$, which is
  `((λ, x), μ) : (ℝ × E) × ℝ` in Lean.
* $K_f$: the cone `ConvexAnalysis.homCone f`.
* $K^\circ = \{q \mid \langle p, q \rangle \le 0 \text{ for all } p \in K\}$: the one-sided polar
  `ConvexAnalysis.polarCone`.

## Implementation notes

* The hypotheses of the main theorem are the two properness conditions instead of "closed proper
  convex": $\operatorname{dom} f$ is nonempty, to see that the polar lies in the half-space
  $\lambda^* \ge 0$; $\operatorname{dom} f^*$ is nonempty, to see that the polar is not contained in
  the boundary hyperplane $\lambda^* = 0$; and $f$ is convex. Closedness of $f$ makes the second
  condition automatic, and belongs at the call site.
* No bipolar theorem is used, and no closure of $K_f$. The classical argument says that
  $\operatorname{cl} K_f$ contains $(0, 0, 1)$ but not $(0, 0, -1)$. Both facts are already visible
  in $K_f$: the first from the ray $(1, x_0, r + t)$, $t \ge 0$, above a point of
  $\operatorname{dom} f$, and the second from a single affine minorant of $f$. So the module needs
  no local convexity, no compatibility of the pairing and no finite dimension.
-/

open Set Pointwise

namespace ConvexAnalysis

/-! ### The pairing, the coordinate and the reflection -/

section Defs

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]

/-- The pairing of $\mathbb{R} \times E \times \mathbb{R}$ with
$\mathbb{R} \times F \times \mathbb{R}$ induced by a pairing $B$ of $E$ with $F$: $$\langle
(\lambda, x, \mu), (\lambda^*, y, \mu^*) \rangle = \lambda \lambda^* + B(x, y) + \mu \mu^*.$$

It is `ConvexAnalysis.epiPairing` of `ConvexAnalysis.prodPairing ConvexAnalysis.mulPairing B`.
It is an `abbrev`, so that the instances for `ConvexAnalysis.prodPairing` remain visible to
instance search. -/
abbrev homConePairing (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) :
    ((ℝ × E) × ℝ) →ₗ[ℝ] ((ℝ × F) × ℝ) →ₗ[ℝ] ℝ :=
  epiPairing (prodPairing mulPairing B)

/-- The pairing `ConvexAnalysis.homConePairing B` sends $(\lambda, x, \mu)$ and
$(\lambda^*, y, \mu^*)$ to $\lambda \lambda^* + B(x, y) + \mu \mu^*$. -/
@[simp] theorem homConePairing_apply (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (p : (ℝ × E) × ℝ)
    (q : (ℝ × F) × ℝ) :
    homConePairing B p q = p.1.1 * q.1.1 + B p.1.2 q.1.2 + p.2 * q.2 := rfl

/-- The flip of the pairing induced by $B$ is the pairing induced by the flip of $B$. -/
theorem homConePairing_flip (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) :
    (homConePairing B).flip = homConePairing B.flip := by
  simp only [homConePairing, prodPairing_flip, mulPairing_flip]

/-- The **homogenizing coordinate** $(\lambda^*, y, \mu^*) \mapsto \lambda^*$, as a linear
functional on $\mathbb{R} \times F \times \mathbb{R}$. -/
def homCoord (F : Type*) [AddCommGroup F] [Module ℝ F] : ((ℝ × F) × ℝ) →ₗ[ℝ] ℝ :=
  (LinearMap.fst ℝ ℝ F).comp (LinearMap.fst ℝ (ℝ × F) ℝ)

/-- The homogenizing coordinate of $(\lambda^*, y, \mu^*)$ is $\lambda^*$. -/
@[simp] theorem homCoord_apply (q : (ℝ × F) × ℝ) : homCoord F q = q.1.1 := rfl

/-- The **reflection** $(\lambda^*, y, \mu^*) \mapsto (-\mu^*, y, -\lambda^*)$ of
$\mathbb{R} \times F \times \mathbb{R}$. It exchanges the homogenizing coordinate with the
epigraph coordinate and reverses the sign of both.

This linear involution is the change of variables that turns the polar of a homogenized epigraph
back into a homogenized epigraph. -/
def negSwapEnds (F : Type*) [AddCommGroup F] [Module ℝ F] :
    ((ℝ × F) × ℝ) →ₗ[ℝ] (ℝ × F) × ℝ where
  toFun q := ((-q.2, q.1.2), -q.1.1)
  map_add' p q := by simp [add_comm]
  map_smul' c q := by simp

/-- The reflection sends $(\lambda^*, y, \mu^*)$ to $(-\mu^*, y, -\lambda^*)$. -/
@[simp] theorem negSwapEnds_apply (q : (ℝ × F) × ℝ) :
    negSwapEnds F q = ((-q.2, q.1.2), -q.1.1) := rfl

/-- The reflection `ConvexAnalysis.negSwapEnds` is an involution. -/
@[simp] theorem negSwapEnds_negSwapEnds (q : (ℝ × F) × ℝ) :
    negSwapEnds F (negSwapEnds F q) = q := by simp

/-- If $F$ is a topological space, the reflection `ConvexAnalysis.negSwapEnds` is continuous for the
product topology on $\mathbb{R} \times F \times \mathbb{R}$. -/
theorem continuous_negSwapEnds (F : Type*) [AddCommGroup F] [Module ℝ F] [TopologicalSpace F] :
    Continuous (negSwapEnds F) :=
  ((continuous_snd.neg).prodMk continuous_fst.snd).prodMk continuous_fst.fst.neg

end Defs

/-! ### The conjugate on the epigraph -/

section Conj

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal}

/-- Let $f : E \to [-\infty, +\infty]$, $y \in F$ and $c \in \mathbb{R}$. Then $f^*(y) \le c$ if and
only if $$B(x, y) - \mu \le c \quad \text{for every } (x, \mu) \in \operatorname{epi} f.$$

No properness or convexity of $f$ is assumed. This is `ConvexAnalysis.convexConj_le_coe_iff`
with the affine minorant replaced by the epigraph that it lies below. -/
theorem convexConj_le_coe_iff_forall_mem_epi {y : F} {c : ℝ} :
    convexConj B f y ≤ (c : EReal) ↔ ∀ p ∈ epi f, B p.1 y - p.2 ≤ c := by
  rw [convexConj_le_coe_iff]
  constructor
  · intro h p hp
    have h₁ : affineFn B y c p.1 ≤ ((p.2 : ℝ) : EReal) := le_trans (h p.1) hp
    rw [affineFn_eq_coe, EReal.coe_le_coe_iff] at h₁
    linarith
  · intro h x
    by_contra hlt
    rw [not_le] at hlt
    obtain ⟨μ, hμ₁, hμ₂⟩ := EReal.lt_iff_exists_real_btwn.1 hlt
    have hmem : ((x, μ) : E × ℝ) ∈ epi f := le_of_lt hμ₁
    have hle := h (x, μ) hmem
    rw [affineFn_eq_coe, EReal.coe_lt_coe_iff] at hμ₂
    simp only at hle
    linarith

end Conj

/-! ### The polar of the homogenized epigraph -/

section Polar

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal}

/-- Membership in the polar of the generating set, unfolded. A vector $q = (\lambda^*, y, \mu^*)$
lies in the polar of the set of vectors $(1, x, \mu)$ with $\mu \ge f(x)$ if and only if
$$\lambda^* + B(x, y) + \mu \mu^* \le 0 \quad \text{for all } x \in E \text{ and } \mu \in
\mathbb{R} \text{ with } f(x) \le \mu.$$

The generating set is the epigraph of `ConvexAnalysis.levelOneLift f`. -/
theorem mem_polarCone_epi_levelOneLift {q : (ℝ × F) × ℝ} :
    q ∈ polarCone (homConePairing B) (epi (levelOneLift f)) ↔
      ∀ x : E, ∀ μ : ℝ, f x ≤ (μ : EReal) → q.1.1 + B x q.1.2 + μ * q.2 ≤ 0 := by
  rw [mem_polarCone]
  constructor
  · intro h x μ hμ
    have hmem : (((1, x), μ) : (ℝ × E) × ℝ) ∈ epi (levelOneLift f) :=
      mk_one_mem_epi_levelOneLift.2 hμ
    have hle := h _ hmem
    rw [homConePairing_apply] at hle
    simpa using hle
  · intro h p hp
    rw [mem_epi_levelOneLift] at hp
    rw [homConePairing_apply, hp.1, one_mul]
    exact h p.1.2 p.2 hp.2

/-- Polarity does not see the cone generation. Let $f : E \to [-\infty, +\infty]$ be convex. Then
the polar of the cone $K_f$ (`ConvexAnalysis.homCone f`) equals the polar of its generating set,
the set of vectors $(1, x, \mu)$ with $\mu \ge f(x)$: $$K_f^\circ = \{(1, x, \mu) \mid \mu \ge
f(x)\}^\circ.$$

The generating set is the epigraph of `ConvexAnalysis.levelOneLift f`. -/
theorem polarCone_homCone (hf : ConvexFn f) :
    polarCone (homConePairing B) (homCone f)
      = polarCone (homConePairing B) (epi (levelOneLift f)) := by
  rw [homCone_eq_coe_hull hf, polarCone_hull]

/-- **The cross-section.** Let $f : E \to [-\infty, +\infty]$ be convex, and let $q = (\lambda^*, y,
\mu^*) \in \mathbb{R} \times F \times \mathbb{R}$ with $\lambda^* > 0$. Then $$q \in K_{f^*}
\iff (-\mu^*, y, -\lambda^*) \in K_f^\circ,$$ where $K_g$ is the cone `ConvexAnalysis.homCone g`
and the polar is taken for `ConvexAnalysis.homConePairing B`.

At $\lambda^* = 1$ this is the computation "$(-\mu^*, y, -1) \in K_f^\circ$ if and only if
$\mu^* \ge f^*(y)$". -/
theorem mem_homCone_convexConj_iff_of_pos (hf : ConvexFn f) {q : (ℝ × F) × ℝ} (ha : 0 < q.1.1) :
    q ∈ homCone (convexConj B f) ↔ negSwapEnds F q ∈ polarCone (homConePairing B) (homCone f) := by
  have hzero : q ≠ 0 := fun h => by rw [h] at ha; exact lt_irrefl 0 ha
  rw [mem_homCone_iff, polarCone_homCone hf, mem_polarCone_epi_levelOneLift,
    convexConj_le_coe_iff_forall_mem_epi]
  have key : ∀ u v : ℝ,
      (q.1.1⁻¹ * u - v ≤ q.1.1⁻¹ * q.2 ↔ -q.2 + u + v * -q.1.1 ≤ 0) := by
    intro u v
    constructor
    · intro hle
      have h₂ := mul_le_mul_of_nonneg_left hle ha.le
      rw [mul_sub, mul_inv_cancel_left₀ ha.ne', mul_inv_cancel_left₀ ha.ne'] at h₂
      linarith
    · intro hle
      have h₂ : q.1.1⁻¹ * (u - q.1.1 * v) ≤ q.1.1⁻¹ * q.2 :=
        mul_le_mul_of_nonneg_left (by linarith) (inv_nonneg.2 ha.le)
      have h₃ : q.1.1⁻¹ * (u - q.1.1 * v) = q.1.1⁻¹ * u - v := by
        calc q.1.1⁻¹ * (u - q.1.1 * v) = q.1.1⁻¹ * u - q.1.1⁻¹ * q.1.1 * v := by ring
          _ = q.1.1⁻¹ * u - v := by rw [inv_mul_cancel₀ ha.ne']; ring
      rw [h₃] at h₂
      exact h₂
  constructor
  · rintro (h | ⟨-, h⟩)
    · exact absurd h hzero
    · intro x μ hμ
      have hle := h (x, μ) hμ
      simp only [map_smul, smul_eq_mul] at hle
      exact (key (B x q.1.2) μ).1 hle
  · intro h
    refine Or.inr ⟨ha, fun p hp => ?_⟩
    have hle := h p.1 p.2 hp
    simp only [map_smul, smul_eq_mul]
    exact (key (B p.1 q.1.2) p.2).2 hle

/-- Let $C, d \in \mathbb{R}$. If $C + t d \le 0$ for every $t \ge 0$, then $d \le 0$. -/
theorem nonpos_of_forall_add_mul_nonpos {C d : ℝ} (h : ∀ t : ℝ, 0 ≤ t → C + t * d ≤ 0) :
    d ≤ 0 := by
  by_contra hd
  rw [not_le] at hd
  have h₁ := h ((|C| + 1) / d) (div_nonneg (by positivity) hd.le)
  rw [div_mul_cancel₀ _ hd.ne'] at h₁
  have h₂ := neg_abs_le C
  linarith

/-- **The polar of the homogenized epigraph lies in the half-space $\lambda^* \ge 0$.** Let
$f : E \to [-\infty, +\infty]$ be convex with nonempty effective domain, and let
$q = (\lambda^*, y, \mu^*)$. If $(-\mu^*, y, -\lambda^*) \in K_f^\circ$, then $\lambda^* \ge 0$.

The vertical ray $(1, x_0, r + t)$, $t \ge 0$, above a point $x_0$ of $\operatorname{dom} f$
forces the sign. -/
theorem nonneg_homCoord_of_mem_polarCone (hf : ConvexFn f) (hdom : (convexDom f).Nonempty)
    {q : (ℝ × F) × ℝ} (hq : negSwapEnds F q ∈ polarCone (homConePairing B) (homCone f)) :
    0 ≤ homCoord F q := by
  obtain ⟨x₀, hx₀⟩ := hdom
  obtain ⟨r, hr, -⟩ := EReal.lt_iff_exists_real_btwn.1 hx₀
  rw [polarCone_homCone hf, mem_polarCone_epi_levelOneLift] at hq
  have hray : ∀ t : ℝ, 0 ≤ t →
      (-q.2 + B x₀ q.1.2 + r * -q.1.1) + t * -q.1.1 ≤ 0 := by
    intro t ht
    have hle := hq x₀ (r + t) (le_trans hr.le (by exact_mod_cast le_add_of_nonneg_right ht))
    simp only [negSwapEnds_apply] at hle
    nlinarith [hle]
  have hslope := nonpos_of_forall_add_mul_nonpos hray
  rw [homCoord_apply]
  linarith

end Polar

/-! ### The theorem -/

section Main

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal}

/-- Let $E$ and $F$ be real vector spaces paired by $B$, where $F$ is a topological vector space and
$y \mapsto B(x, y)$ is continuous on $F$ for every $x \in E$. Let $f : E \to [-\infty, +\infty]$
be convex, with nonempty effective domain $\operatorname{dom} f$ and with
$\operatorname{dom} f^*$ nonempty. Let $K_f$ be the cone generated by the vectors $(1, x, \mu)$
with $\mu \ge f(x)$. Then $$\operatorname{cl} K_{f^*} = \{(\lambda^*, y, \mu^*) \mid (-\mu^*, y,
-\lambda^*) \in K_f^\circ\}.$$ This is Theorem 14.4 of [rockafellar1970convex].

The continuity hypothesis is `ConvexAnalysis.IsContinuousPairing B.flip`, and the reflection is
`ConvexAnalysis.negSwapEnds`. The proof has three steps: the cross-section $\lambda^* > 0$
(`ConvexAnalysis.mem_homCone_convexConj_iff_of_pos`), the fact that the reflected polar lies in
$\lambda^* \ge 0$ (`ConvexAnalysis.nonneg_homCoord_of_mem_polarCone`), and
`Convex.closure_inter_setOf_pos`. -/
theorem closure_homCone_convexConj [IsContinuousPairing B.flip] (hf : ConvexFn f)
    (hdom : (convexDom f).Nonempty) (hdom' : (convexDom (convexConj B f)).Nonempty) :
    closure (homCone (convexConj B f))
      = negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f) := by
  have hflip : IsContinuousPairing (homConePairing B).flip := by
    rw [homConePairing_flip]; infer_instance
  have hPclosed : IsClosed (polarCone (homConePairing B) (homCone f)) := isClosed_polarCone
  have hLclosed : IsClosed (negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f)) :=
    hPclosed.preimage (continuous_negSwapEnds F)
  have hLconvex : Convex ℝ (negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f)) :=
    Convex.linear_preimage (convex_polarCone _ _) (negSwapEnds F)
  have hsub : homCone (convexConj B f) ⊆
      negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f) := by
    intro q hq
    rcases mem_homCone_iff.1 hq with rfl | ⟨hpos, -⟩
    · rw [Set.mem_preimage, map_zero]
      exact zero_mem_polarCone _ _
    · exact (mem_homCone_convexConj_iff_of_pos hf hpos).1 hq
  obtain ⟨y₀, hy₀⟩ := hdom'
  obtain ⟨c₀, hc₀, -⟩ := EReal.lt_iff_exists_real_btwn.1 hy₀
  have hq₀ : (((1, y₀), c₀) : (ℝ × F) × ℝ) ∈ homCone (convexConj B f) := by
    refine mem_homCone_iff.2 (Or.inr ⟨one_pos, ?_⟩)
    simpa using hc₀.le
  have hnn : ∀ q ∈ negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f),
      0 ≤ homCoord F q := fun _ hq => nonneg_homCoord_of_mem_polarCone hf hdom hq
  have hcross : (negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f)) ∩
      {q | 0 < homCoord F q} = homCone (convexConj B f) ∩ {q | 0 < homCoord F q} := by
    ext q
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_ofPred, homCoord_apply]
    exact and_congr_left fun hpos => (mem_homCone_convexConj_iff_of_pos hf hpos).symm
  refine subset_antisymm (closure_minimal hsub hLclosed) ?_
  calc negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f)
      ⊆ closure ((negSwapEnds F ⁻¹' polarCone (homConePairing B) (homCone f)) ∩
          {q | 0 < homCoord F q}) :=
        Convex.subset_closure_inter_setOf_pos hLconvex hnn (hsub hq₀) (by simp)
    _ = closure (homCone (convexConj B f) ∩ {q | 0 < homCoord F q}) := by rw [hcross]
    _ ⊆ closure (homCone (convexConj B f)) := closure_mono Set.inter_subset_left

end Main

end ConvexAnalysis
