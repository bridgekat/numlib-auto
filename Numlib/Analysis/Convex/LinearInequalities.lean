import Numlib.Analysis.Convex.Duality.Gauge
import Numlib.Analysis.Convex.Duality.Polar
import Numlib.Analysis.Convex.Helly
import Numlib.Analysis.Convex.Polyhedral.Cone

/-!
# Finite systems of linear inequalities

Let $E$ and $F$ be real vector spaces paired by a bilinear form $\langle x, y \rangle$, where $F$ or
$E$ is finite-dimensional. This module proves **Farkas' Lemma**, **Gale's theorem** of the
alternative for a finite system of weak linear inequalities $\langle x, a_i \rangle \le \alpha_i$,
**Motzkin's transposition theorem** for a mixed system of strict and weak inequalities, and the
description of the consequences $\langle x, a_0 \rangle \le \alpha_0$ of a consistent system. Each
theorem says that a system of inequalities has no solution if and only if there are nonnegative
multipliers $\lambda_i$ of a certain kind. The presentation follows [rockafellar1970convex], §22.

## Main results

* `ConvexAnalysis.mem_pointedCone_hull_range_iff`,
  `ConvexAnalysis.isClosed_coe_pointedCone_hull_range`: the cone generated by a finite family is the
  set of nonnegative combinations of the family, and it is closed.
* `ConvexAnalysis.farkas_of_pairing`, `ConvexAnalysis.farkas`: **Farkas' Lemma**. The inequality
  $\langle x, a_0 \rangle \le 0$ follows from $\langle x, a_i \rangle \le 0$ for all $i$ if and only
  if $a_0$ is a nonnegative combination of the $a_i$.
* `ConvexAnalysis.exists_multipliers_of_infeasible`, `ConvexAnalysis.alternative_linear_system`:
  **Gale's theorem**. The system $\langle x, a_i \rangle \le \alpha_i$ has a solution if and only if
  there are no $\lambda_i \ge 0$ with $\sum_i \lambda_i a_i = 0$ and
  $\sum_i \lambda_i \alpha_i < 0$.
* `ConvexAnalysis.alternative_linear_system_strict`: **Motzkin's transposition theorem**.
* `ConvexAnalysis.le_consequence_iff`: an inequality $\langle x, a_0 \rangle \le \alpha_0$ is a
  consequence of a consistent system $\langle x, a_i \rangle \le \alpha_i$ if and only if
  $a_0 = \sum_i \lambda_i a_i$ with $\lambda_i \ge 0$ and $\sum_i \lambda_i \alpha_i \le \alpha_0$.
* `ConvexAnalysis.eq_zero_of_forall_pairing_eq_zero`,
  `ConvexAnalysis.eq_zero_and_nonpos_of_forall_nonneg`: the pairing separates the points of $F$, so
  an affine function $x \mapsto \langle x, c \rangle - \gamma$ that is nonnegative on all of $E$ has
  $c = 0$ and $\gamma \le 0$.

## Proof outline

Farkas' Lemma is the bipolar identity $K^{\circ\circ} = K$ for the cone $K$ generated by the
coefficient vectors $a_i$. This cone is closed because it is finitely generated (Minkowski–Weyl).
Gale's theorem follows from Farkas' Lemma by homogenization: the system
$\langle x, a_i \rangle \le \alpha_i$ is inconsistent exactly when $(0, -1)$ lies in the cone of
$F \times \mathbb{R}$ generated by the $(a_i, \alpha_i)$ and $(0, 1)$, since a point of the polar
with a negative last coordinate rescales to a solution. Motzkin's theorem follows from the
alternative for a system of convex inequalities with affine side constraints. The step that turns
the multipliers of that alternative into the multipliers of Motzkin's theorem is
`ConvexAnalysis.eq_zero_and_nonpos_of_forall_nonneg`, and it needs the compatibility of the pairing
in the direction of $F$.

## Notation

* $\langle x, y \rangle$: the pairing `B x y` for $x \in E$ and $y \in F$.

## Implementation notes

* The pairing is a bilinear map `B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ`. The results assume
  `ConvexAnalysis.IsCompatiblePairing B.flip`: each map $y \mapsto \langle x, y \rangle$ is
  continuous on $F$, and every continuous linear functional on $F$ has this form for some $x \in E$.
  For finite-dimensional $F$, every linear functional on $F$ is continuous, so the condition says
  that every linear functional on $F$ is $\langle x, \cdot \rangle$ for some $x$.
* `ConvexAnalysis.farkas_of_pairing` puts the coefficient vectors in the first space of the pairing,
  the orientation in which instance search finds the instances at `ConvexAnalysis.epiPairing`.
  `ConvexAnalysis.farkas` is the flipped form, which the other results of the module use.
* "One and only one of the following holds" is stated as an equivalence between the first
  alternative and the negation of the second.
-/
open Set

namespace ConvexAnalysis

/-! ### Conical combinations of a finite family -/

section Hull

variable {F : Type*} [AddCommGroup F] [Module ℝ F] {ι : Type*}

/-- Let $(a_i)_{i \in \iota}$ be a finite family in a real vector space $F$. A point $x \in F$ lies
in the cone generated by the $a_i$ if and only if $x = \sum_i \lambda_i a_i$ for some
$\lambda_i \ge 0$.

The cone is `PointedCone.hull ℝ (Set.range a)`. -/
theorem mem_pointedCone_hull_range_iff [Fintype ι] {a : ι → F} {x : F} :
    x ∈ PointedCone.hull ℝ (Set.range a) ↔ ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ ∑ i, l i • a i = x := by
  rw [PointedCone.hull, Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨fun i => (c i : ℝ), fun i => (c i).2, rfl⟩
  · rintro ⟨l, hl, rfl⟩
    exact ⟨fun i => ⟨l i, hl i⟩, rfl⟩

/-- Let $F$ be a finite-dimensional real normed space and $(a_i)_{i \in \iota}$ a finite family in
$F$. Then the cone generated by the $a_i$ is closed.

The cone is finitely generated, hence polyhedral by Weyl's half of the Minkowski–Weyl theorem,
hence an intersection of finitely many closed half-spaces. -/
theorem isClosed_coe_pointedCone_hull_range {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    [FiniteDimensional ℝ F] {ι : Type*} [Finite ι] (a : ι → F) :
    IsClosed (PointedCone.hull ℝ (Set.range a) : Set F) := by
  classical
  have hfin : (Set.range a).Finite := Set.finite_range a
  refine FinitelyGeneratedCone.isClosed ⟨hfin.toFinset, ?_⟩
  rw [hfin.coe_toFinset]

end Hull

/-! ### Farkas' Lemma -/

section Farkas

variable {E F : Type*} [AddCommGroup E] [Module ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {ι : Type*} [Fintype ι]

/-- **Farkas' Lemma**, with the coefficient vectors in the first space of the pairing. Let $F$ be a
finite-dimensional real normed space, $E$ a real vector space, and
$A : F \times E \to \mathbb{R}$ a bilinear pairing such that every continuous linear functional
on $F$ is $A(\cdot, x)$ for some $x \in E$. Let $a_1, \dots, a_m, a_0 \in F$. Then
$$\big(\forall x \in E,\ (\forall i,\ A(a_i, x) \le 0) \Rightarrow A(a_0, x) \le 0\big) \iff
  \exists \lambda_1, \dots, \lambda_m \ge 0,\ \sum_i \lambda_i a_i = a_0.$$

This is the remark of [rockafellar1970convex] that Farkas' Lemma is the identity
$K^{\circ\circ} = K$ for the cone $K$ generated by the $a_i$. The condition on $A$ is
`ConvexAnalysis.IsCompatiblePairing A`. This orientation is the one in which instance search
finds the instances at `ConvexAnalysis.epiPairing`. -/
theorem farkas_of_pairing (A : F →ₗ[ℝ] E →ₗ[ℝ] ℝ) [IsCompatiblePairing A] (a : ι → F) (a₀ : F) :
    (∀ x : E, (∀ i, A (a i) x ≤ 0) → A a₀ x ≤ 0) ↔
      ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ ∑ i, l i • a i = a₀ := by
  have hpol := polarCone_setOf_forall_le_zero (B := A) a
  rw [(isClosed_coe_pointedCone_hull_range a).closure_eq] at hpol
  have hmem : a₀ ∈ polarCone A.flip {x : E | ∀ i, A (a i) x ≤ 0} ↔
      a₀ ∈ (PointedCone.hull ℝ (Set.range a) : Set F) := by rw [hpol]
  rw [← mem_pointedCone_hull_range_iff]
  refine Iff.trans ?_ hmem
  simp only [mem_polarCone, Set.mem_ofPred_eq, LinearMap.flip_apply]

end Farkas

/-! ### The alternative for a weak system -/

section Weak

variable {E F : Type*} [AddCommGroup E] [Module ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {ι : Type*} [Fintype ι]

/-- **Farkas' Lemma.** Let $E$ be a real vector space, $F$ a finite-dimensional real normed space,
and $\langle \cdot, \cdot \rangle : E \times F \to \mathbb{R}$ a pairing whose flip is
compatible. Let $a_1, \dots, a_m, a_0 \in F$. Then $\langle x, a_0 \rangle \le 0$ for every
$x \in E$ with $\langle x, a_i \rangle \le 0$ for all $i$ if and only if
$a_0 = \sum_i \lambda_i a_i$ for some $\lambda_1, \dots, \lambda_m \ge 0$.

This is `ConvexAnalysis.farkas_of_pairing` for the flipped pairing. The solution variable is in
$E$ and the coefficient vectors are in $F$, the orientation that the other results of the module
use. -/
theorem farkas [IsCompatiblePairing B.flip] (a : ι → F) (a₀ : F) :
    (∀ x : E, (∀ i, B x (a i) ≤ 0) → B x a₀ ≤ 0) ↔
      ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ ∑ i, l i • a i = a₀ :=
  farkas_of_pairing B.flip a a₀

/-- **Gale's theorem**, existence of multipliers. Let $E$ be a real vector space, $F$ a
finite-dimensional real normed space, and $\langle \cdot, \cdot \rangle : E \times F \to
\mathbb{R}$ a pairing whose flip is compatible. Let $a_1, \dots, a_m \in F$ and
$\alpha_1, \dots, \alpha_m \in \mathbb{R}$. If the system $\langle x, a_i \rangle \le \alpha_i$,
$i = 1, \dots, m$, has no solution $x \in E$, then there are $\lambda_1, \dots, \lambda_m \ge 0$
with
$$\sum_i \lambda_i a_i = 0, \qquad \sum_i \lambda_i \alpha_i < 0.$$

This is the substantial half of `ConvexAnalysis.alternative_linear_system`. The proof applies
Farkas' Lemma in $F \times \mathbb{R}$ to the vectors $(a_i, \alpha_i)$ together with the extra
vector $(0, 1)$. -/
theorem exists_multipliers_of_infeasible [IsCompatiblePairing B.flip] (a : ι → F) (α : ι → ℝ)
    (hno : ¬ ∃ x : E, ∀ i, B x (a i) ≤ α i) :
    ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ (∑ i, l i • a i = 0) ∧ ∑ i, l i * α i < 0 := by
  classical
  have hkey : ∀ p : E × ℝ,
      (∀ o : Option ι,
        epiPairing B.flip (o.elim ((0 : F), (1 : ℝ)) fun i => (a i, α i)) p ≤ 0) →
      epiPairing B.flip ((0 : F), (-1 : ℝ)) p ≤ 0 := by
    rintro ⟨x, t⟩ hp
    have ht : t ≤ 0 := by simpa using hp none
    have hi : ∀ i, B x (a i) + α i * t ≤ 0 := by
      intro i
      simpa using hp (some i)
    have ht0 : 0 ≤ t := by
      by_contra hcon
      push Not at hcon
      have hpos : 0 < -t := by linarith
      have htne : t ≠ 0 := ne_of_lt hcon
      refine hno ⟨(-t)⁻¹ • x, fun i => ?_⟩
      have hipos : 0 < (-t)⁻¹ := inv_pos.2 hpos
      have hstep : B x (a i) ≤ α i * (-t) := by linarith [hi i]
      have h2 := mul_le_mul_of_nonneg_left hstep hipos.le
      have h3 : (-t)⁻¹ * (α i * -t) = α i := by field_simp
      rw [map_smul, LinearMap.smul_apply, smul_eq_mul, ← h3]
      exact h2
    have htz : t = 0 := le_antisymm ht ht0
    simp [htz]
  obtain ⟨L, hL0, hLsum⟩ :=
    (farkas_of_pairing (epiPairing B.flip)
      (fun o : Option ι => o.elim ((0 : F), (1 : ℝ)) fun i => (a i, α i))
      ((0 : F), (-1 : ℝ))).1 hkey
  have hfst := congrArg Prod.fst hLsum
  have hsnd := congrArg Prod.snd hLsum
  rw [Prod.fst_sum, Fintype.sum_option] at hfst
  rw [Prod.snd_sum, Fintype.sum_option] at hsnd
  simp only [Option.elim_none, Option.elim_some, Prod.smul_fst, Prod.smul_snd, smul_zero,
    zero_add, smul_eq_mul, mul_one] at hfst hsnd
  refine ⟨fun i => L (some i), fun i => hL0 (some i), hfst, ?_⟩
  have hL0n : 0 ≤ L none := hL0 none
  linarith [hsnd]

/-- **Gale's theorem of the alternative.** Let $E$ be a real vector space, $F$ a finite-dimensional
real normed space with a pairing $\langle \cdot, \cdot \rangle : E \times F \to \mathbb{R}$
whose flip is compatible, $a_1, \dots, a_m \in F$ and
$\alpha_1, \dots, \alpha_m \in \mathbb{R}$. Then one and only one of the following holds: the
system $\langle x, a_i \rangle \le \alpha_i$, $i = 1, \dots, m$, has a solution $x \in E$; or
there are $\lambda_1, \dots, \lambda_m \ge 0$ with $\sum_i \lambda_i a_i = 0$ and
$\sum_i \lambda_i \alpha_i < 0$.

"One and only one" is stated as an equivalence of the first alternative with the negation of the
second. The forward direction is the elementary exclusivity, and the backward direction is
`ConvexAnalysis.exists_multipliers_of_infeasible`. -/
theorem alternative_linear_system [IsCompatiblePairing B.flip] (a : ι → F) (α : ι → ℝ) :
    (∃ x : E, ∀ i, B x (a i) ≤ α i) ↔
      ¬ ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ (∑ i, l i • a i = 0) ∧ ∑ i, l i * α i < 0 := by
  constructor
  · rintro ⟨x, hx⟩ ⟨l, hl0, hla, hlα⟩
    have h1 : ∑ i, l i * B x (a i) ≤ ∑ i, l i * α i :=
      Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hx i) (hl0 i)
    have h2 : ∑ i, l i * B x (a i) = 0 := by
      have h := congrArg (B x) hla
      rw [map_sum, map_zero] at h
      simpa using h
    linarith
  · intro hno
    by_contra hcon
    exact hno (exists_multipliers_of_infeasible a α hcon)

end Weak

/-! ### The alternative for a mixed system -/

section Affine

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]

/-- The affine function $x \mapsto \langle x, y \rangle - c$ of a pairing, as an affine map
$E \to \mathbb{R}$.

The alternative for a system of convex inequalities keeps its affine constraints as affine maps,
and this function presents a linear inequality in that form. `ConvexAnalysis.affineFn` is the
same function with values in `EReal`. -/
def affineMapOfPairing (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (y : F) (c : ℝ) : E →ᵃ[ℝ] ℝ :=
  AffineMap.mk' (fun x => B x y - c) (B.flip y) 0 fun _ => by simp [sub_eq_add_neg]

/-- The value of `ConvexAnalysis.affineMapOfPairing B y c` at $x$ is $\langle x, y \rangle - c$. -/
@[simp] theorem affineMapOfPairing_apply (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (y : F) (c : ℝ) (x : E) :
    affineMapOfPairing B y c x = B x y - c := rfl

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- A linear combination can be taken out of the pairing: $\langle x, \sum_i \lambda_i a_i \rangle =
\sum_i \lambda_i \langle x, a_i \rangle$. -/
theorem pairing_sum_smul (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (l : ι → ℝ) (a : ι → F) (x : E) :
    B x (∑ i, l i • a i) = ∑ i, l i * B x (a i) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [map_smul, smul_eq_mul]

/-- The weighted value of a mixed system at $x$ is one affine function of the pairing:
$$\sum_i \lambda_i (\langle x, a_i \rangle - \alpha_i) + \sum_j \mu_j (\langle x, b_j \rangle -
  \beta_j) = \Big\langle x, \sum_i \lambda_i a_i + \sum_j \mu_j b_j \Big\rangle - \Big(\sum_i
  \lambda_i \alpha_i + \sum_j \mu_j \beta_j\Big).$$
-/
theorem combined_value (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (l : ι → ℝ) (a : ι → F) (α : ι → ℝ)
    (μ : κ → ℝ) (b : κ → F) (β : κ → ℝ) (x : E) :
    ((∑ i, l i * (B x (a i) - α i)) + ∑ j, μ j * (B x (b j) - β j))
      = B x (∑ i, l i • a i + ∑ j, μ j • b j) - (∑ i, l i * α i + ∑ j, μ j * β j) := by
  rw [map_add, pairing_sum_smul, pairing_sum_smul]
  simp only [mul_sub, Finset.sum_sub_distrib]
  ring

end Affine

section Separating

variable {E F : Type*} [AddCommGroup E] [Module ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ}

/-- Let $F$ be a real normed space with a pairing $\langle \cdot, \cdot \rangle : E \times F \to
\mathbb{R}$ whose flip is compatible. If $c \in F$ satisfies $\langle x, c \rangle = 0$ for
every $x \in E$, then $c = 0$. So the pairing **separates** the points of $F$.

The proof is the Hahn–Banach theorem on $F$, together with the condition of compatibility that
every continuous linear functional on $F$ is $\langle x, \cdot \rangle$ for some $x$. -/
theorem eq_zero_of_forall_pairing_eq_zero [IsCompatiblePairing B.flip] {c : F}
    (h : ∀ x : E, B x c = 0) : c = 0 := by
  refine SeparatingDual.eq_zero_of_forall_dual_eq_zero (R := ℝ) fun g => ?_
  obtain ⟨x, hx⟩ := exists_pairing_eq B.flip g
  rw [hx c]
  exact h x

/-- Let $F$ be a real normed space with a pairing $\langle \cdot, \cdot \rangle : E \times F \to
\mathbb{R}$ whose flip is compatible, and let $c \in F$ and $\gamma \in \mathbb{R}$. If
$\langle x, c \rangle - \gamma \ge 0$ for every $x \in E$, then $c = 0$ and $\gamma \le 0$.

So an affine function of the pairing that is nonnegative on all of $E$ is a nonnegative
constant. This step turns the multipliers of the alternative for a system of convex inequalities
into the multipliers of Motzkin's theorem (`ConvexAnalysis.alternative_linear_system_strict`). -/
theorem eq_zero_and_nonpos_of_forall_nonneg [IsCompatiblePairing B.flip] {c : F} {γ : ℝ}
    (h : ∀ x : E, 0 ≤ B x c - γ) : c = 0 ∧ γ ≤ 0 := by
  have hγ : γ ≤ 0 := by simpa using h 0
  refine ⟨eq_zero_of_forall_pairing_eq_zero (B := B) fun x => ?_, hγ⟩
  by_contra hv
  have hs := h (((γ - 1) / B x c) • x)
  rw [map_smul, LinearMap.smul_apply, smul_eq_mul] at hs
  have hcancel : (γ - 1) / B x c * B x c = γ - 1 := div_mul_cancel₀ _ hv
  rw [hcancel] at hs
  linarith

end Separating

section Strict

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- **Motzkin's transposition theorem.** Let $E$ be a finite-dimensional real normed space, $F$ a
real normed space with a pairing $\langle \cdot, \cdot \rangle : E \times F \to \mathbb{R}$
whose flip is compatible, $a_i \in F$, $\alpha_i \in \mathbb{R}$ for $i \in \iota$, and
$b_j \in F$, $\beta_j \in \mathbb{R}$ for $j \in \kappa$, with $\iota$ and $\kappa$ finite.
Suppose that the weak system $\langle x, b_j \rangle \le \beta_j$ has a solution. Then one and
only one of the following holds: the mixed system
$$\langle x, a_i \rangle < \alpha_i \quad (i \in \iota), \qquad
  \langle x, b_j \rangle \le \beta_j \quad (j \in \kappa)$$
has a solution $x \in E$; or there are $\lambda_i \ge 0$ and $\mu_j \ge 0$, with at least one
$\lambda_i \neq 0$, such that
$$\sum_i \lambda_i a_i + \sum_j \mu_j b_j = 0, \qquad \sum_i \lambda_i \alpha_i + \sum_j \mu_j
  \beta_j \le 0.$$

"One and only one" is stated as an equivalence of the first alternative with the negation of the
second. -/
theorem alternative_linear_system_strict [IsCompatiblePairing B.flip]
    (a : ι → F) (α : ι → ℝ) (b : κ → F) (β : κ → ℝ)
    (hcons : ∃ x : E, ∀ j, B x (b j) ≤ β j) :
    (∃ x : E, (∀ i, B x (a i) < α i) ∧ ∀ j, B x (b j) ≤ β j) ↔
      ¬ ∃ (l : ι → ℝ) (μ : κ → ℝ), (∀ i, 0 ≤ l i) ∧ (∀ j, 0 ≤ μ j) ∧ (∃ i, l i ≠ 0) ∧
        (∑ i, l i • a i + ∑ j, μ j • b j = 0) ∧ ∑ i, l i * α i + ∑ j, μ j * β j ≤ 0 := by
  classical
  constructor
  · rintro ⟨x, hxs, hxw⟩ ⟨l, μ, hl0, hμ0, ⟨i₀, hi₀⟩, hc, hγ⟩
    have hlp : 0 < l i₀ := lt_of_le_of_ne (hl0 i₀) (Ne.symm hi₀)
    have hval := combined_value B l a α μ b β x
    rw [hc, map_zero] at hval
    have h1 : ∑ i, l i * (B x (a i) - α i) < ∑ _i : ι, (0 : ℝ) :=
      Finset.sum_lt_sum (fun i _ => by nlinarith [hl0 i, hxs i])
        ⟨i₀, Finset.mem_univ _, by nlinarith [hxs i₀]⟩
    rw [Finset.sum_const_zero] at h1
    have h2 : ∑ j, μ j * (B x (b j) - β j) ≤ 0 :=
      Finset.sum_nonpos fun j _ => by nlinarith [hμ0 j, hxw j]
    linarith
  · intro hno
    by_contra hcon
    refine hno ?_
    obtain ⟨x0, hx0⟩ := hcons
    have hfeas : ∃ x ∈ ri (Set.univ : Set E), ∀ j, affineMapOfPairing B (b j) (β j) x ≤ 0 := by
      refine ⟨x0, ?_, fun j => ?_⟩
      · rw [intrinsicInterior_univ]; trivial
      · rw [affineMapOfPairing_apply]; linarith [hx0 j]
    rcases alternative_of_convex_system_affine (C := (Set.univ : Set E))
        (f := fun i => affineFn B (a i) (α i))
        (a := fun j => affineMapOfPairing B (b j) (β j))
        convex_univ (fun i => convexFn_affineFn _ _) (fun i => properConvex_affineFn _ _)
        (fun _ _ _ => mem_convexDom.2 (lt_top_iff_ne_top.2 (affineFn_ne_top _ _ _)))
        hfeas with hgood | ⟨l, μ, hl0, hμ0, hlne, hineq⟩
    · exfalso
      obtain ⟨x, -, hs, hw⟩ := hgood
      refine hcon ⟨x, fun i => ?_, fun j => ?_⟩
      · have h : affineFn B (a i) (α i) x < 0 := hs i
        rw [affineFn_eq_coe] at h
        have hr : B x (a i) - α i < 0 := by exact_mod_cast h
        linarith
      · have h : B x (b j) - β j ≤ 0 := hw j
        linarith
    · have hineq' : ∀ x : E, (0 : EReal)
          ≤ (∑ i, (l i : EReal) * affineFn B (a i) (α i) x)
            + ((∑ j, μ j * (B x (b j) - β j) : ℝ) : EReal) :=
        fun x => hineq x (Set.mem_univ x)
      have hreal : ∀ x : E, 0 ≤ B x (∑ i, l i • a i + ∑ j, μ j • b j)
          - (∑ i, l i * α i + ∑ j, μ j * β j) := by
        intro x
        have h1 : (∑ i, (l i : EReal) * affineFn B (a i) (α i) x)
            = (((∑ i, l i * (B x (a i) - α i) : ℝ)) : EReal) := by
          rw [EReal.coe_sum]
          exact Finset.sum_congr rfl fun i _ => by
            rw [affineFn_eq_coe, ← EReal.coe_mul]
        have h := hineq' x
        rw [h1, ← EReal.coe_add] at h
        have hr : (0 : ℝ) ≤ (∑ i, l i * (B x (a i) - α i))
            + ∑ j, μ j * (B x (b j) - β j) := by exact_mod_cast h
        rwa [combined_value B l a α μ b β x] at hr
      obtain ⟨hc0, hγ0⟩ := eq_zero_and_nonpos_of_forall_nonneg hreal
      obtain ⟨i₀, hi₀⟩ := Function.ne_iff.1 hlne
      exact ⟨l, μ, hl0, hμ0, ⟨i₀, hi₀⟩, hc0, hγ0⟩

/-- **The consequences of a consistent system.** Let $E$ be a finite-dimensional real normed space
and $F$ a real normed space with a pairing $\langle \cdot, \cdot \rangle : E \times F \to
\mathbb{R}$ whose flip is compatible. Let $a_1, \dots, a_m, a_0 \in F$ and $\alpha_1, \dots,
\alpha_m, \alpha_0 \in \mathbb{R}$, and suppose that the system
$\langle x, a_i \rangle \le \alpha_i$ has a solution. Then $\langle x, a_0 \rangle \le \alpha_0$
holds for every solution $x$ of the system if and only if there are
$\lambda_1, \dots, \lambda_m \ge 0$ with
$$\sum_i \lambda_i a_i = a_0, \qquad \sum_i \lambda_i \alpha_i \le \alpha_0.$$

The inequality fails to be a consequence exactly when the mixed system
$\langle x, -a_0 \rangle < -\alpha_0$, $\langle x, a_i \rangle \le \alpha_i$ has a solution. So
Motzkin's theorem applies, and its multiplier on the strict inequality can be divided out. -/
theorem le_consequence_iff [IsCompatiblePairing B.flip] (a : ι → F) (α : ι → ℝ) (a₀ : F) (α₀ : ℝ)
    (hcons : ∃ x : E, ∀ i, B x (a i) ≤ α i) :
    (∀ x : E, (∀ i, B x (a i) ≤ α i) → B x a₀ ≤ α₀) ↔
      ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ (∑ i, l i • a i = a₀) ∧ ∑ i, l i * α i ≤ α₀ := by
  classical
  constructor
  · intro hconseq
    have hnot : ¬ ∃ x : E, (∀ _ : Unit, B x (-a₀) < -α₀) ∧ ∀ i, B x (a i) ≤ α i := by
      rintro ⟨x, hs, hw⟩
      have h := hs ()
      rw [map_neg] at h
      exact absurd (hconseq x hw) (by linarith)
    have hb := not_not.1 (fun hcon =>
      hnot ((alternative_linear_system_strict (ι := Unit) (κ := ι)
        (fun _ => -a₀) (fun _ => -α₀) a α hcons).2 hcon))
    obtain ⟨l', μ, hl'0, hμ0, ⟨u, hu⟩, hvec, hsca⟩ := hb
    rw [Finset.univ_unique, Finset.sum_singleton] at hvec hsca
    have hu' : (default : Unit) = u := Subsingleton.elim _ _
    rw [hu'] at hvec hsca
    rw [smul_neg, neg_add_eq_zero] at hvec
    -- `hvec : l' u • a₀ = ∑ i, μ i • a i`,  `hsca : l' u * -α₀ + ∑ i, μ i * α i ≤ 0`
    have hlampos : 0 < l' u := lt_of_le_of_ne (hl'0 u) (Ne.symm hu)
    have hlamne : l' u ≠ 0 := ne_of_gt hlampos
    refine ⟨fun i => μ i / l' u, fun i => div_nonneg (hμ0 i) hlampos.le, ?_, ?_⟩
    · have hsm : ∑ i, (μ i / l' u) • a i = (l' u)⁻¹ • ∑ i, μ i • a i := by
        rw [Finset.smul_sum]
        exact Finset.sum_congr rfl fun i _ => by rw [smul_smul, div_eq_inv_mul]
      rw [hsm, ← hvec, smul_smul, inv_mul_cancel₀ hlamne, one_smul]
    · have hsm : ∑ i, (μ i / l' u) * α i = (l' u)⁻¹ * ∑ i, μ i * α i := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by ring
      rw [hsm]
      have hle : ∑ i, μ i * α i ≤ l' u * α₀ := by linarith
      have hfin := mul_le_mul_of_nonneg_left hle (inv_nonneg.2 hlampos.le)
      rwa [← mul_assoc, inv_mul_cancel₀ hlamne, one_mul] at hfin
  · rintro ⟨l, hl0, hvec, hsca⟩ x hx
    have h1 : ∑ i, l i * B x (a i) ≤ ∑ i, l i * α i :=
      Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hx i) (hl0 i)
    have h2 : B x a₀ = ∑ i, l i * B x (a i) := by rw [← hvec, pairing_sum_smul]
    linarith

end Strict


end ConvexAnalysis
