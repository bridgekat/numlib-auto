import Numlib.Analysis.Convex.Duality.Level
import Numlib.Analysis.Convex.Subdifferential.Defs

/-!
# ε-subgradients

Let $B$ be a pairing $\langle \cdot, \cdot \rangle$ of real vector spaces $E$ and $F$, and let
$f : E \to [-\infty, +\infty]$. For $\varepsilon \in \mathbb{R}$, a vector $y \in F$ is an
**$\varepsilon$-subgradient** of $f$ at $x$ when the subgradient inequality holds up to the slack
$\varepsilon$:
$$f(z) \ge f(x) + \langle z - x, y \rangle - \varepsilon \quad \text{for every } z \in E.$$
When $f(x)$ is finite, the set $\partial_\varepsilon f(x)$ of these vectors is closed and convex,
and it decreases to $\partial f(x)$ as $\varepsilon \downarrow 0$. For a closed proper convex $f$ on
a finite-dimensional space, its support function decreases to the directional derivative
$f'(x; \cdot)$ itself, not only to the closure $\delta^*(\cdot \mid \partial f(x))$ of
$f'(x; \cdot)$. This is the exact dual of the difference between $f'(x; \cdot)$ and its closure. The
presentation follows [rockafellar1970convex], §23.

The proofs use the translate $h(w) = f(x + w) - f(x)$ of $f$, for $f(x)$ finite:
$\partial_\varepsilon f(x)$ is the set of $y$ with $\langle \cdot, y \rangle \le h + \varepsilon$,
and $f'(x; \cdot)$ is the positively homogeneous convex function generated by $h$.

## Main definitions

* `ConvexAnalysis.epsSubdifferential`: the $\varepsilon$-subdifferential
  $\partial_\varepsilon f(x) \subseteq F$.
* `ConvexAnalysis.shiftFn`: the translate $w \mapsto f(x + w) + c$ of $f$, with $x$ moved to the
  origin.

## Main results

* `ConvexAnalysis.epsSubdifferential_eq_setOf_convexConj_le`,
  `ConvexAnalysis.iInter_epsSubdifferential`: $\partial_\varepsilon f(x)$ is a level set of a
  conjugate, and $\bigcap_{\varepsilon > 0} \partial_\varepsilon f(x) = \partial f(x)$.
* `ConvexAnalysis.posHomGen_shiftFn`: the directional derivative $f'(x; \cdot)$ is the positively
  homogeneous convex function generated by $h$. This identity is the core of the module, and it
  needs no topology.
* `ConvexAnalysis.supportFn_epsSubdifferential_apply`: for $\varepsilon > 0$ and $v \neq 0$,
$$\delta^*(v \mid \partial_\varepsilon f(x)) = \inf_{\lambda > 0} \frac{f(x + \lambda v) - f(x) +
  \varepsilon}{\lambda}.$$
* `ConvexAnalysis.dirDeriv_eq_iInf_supportFn_epsSubdifferential`: $\inf_{\varepsilon > 0}
  \delta^*(\cdot \mid \partial_\varepsilon f(x)) = f'(x; \cdot)$; this is Theorem 23.6 of
  [rockafellar1970convex].

## Implementation notes

* The classical limit as $\varepsilon \downarrow 0$ is an infimum over $\varepsilon > 0$ here. The
  two agree because $\varepsilon \mapsto \partial_\varepsilon f(x)$ is monotone.
* Finite dimension is used once, to make the generated function closed and so remove the closure
  from the identity for the support function.
* `ConvexAnalysis.shiftFn` adds a real constant instead of subtracting $f(x)$, which avoids
  subtraction in `EReal`. Every lemma about $h$ assumes $f(x) = r$ for a real $r$, and $h$ is
  `ConvexAnalysis.shiftFn f x (-r)`.
-/

open Set

namespace ConvexAnalysis

/-!
### A lemma on `EReal`

For every $z \in [-\infty, +\infty]$, $\inf_{\varepsilon > 0} (z + \varepsilon) = z$, with no
hypothesis on $z$: the two infinite values are absorbing for $+ \varepsilon$. This makes
$\partial f(x)$ the intersection of the family $\partial_\varepsilon f(x)$, and it removes the
$\varepsilon$ at the end of the main proof.
-/

/-- For every $z \in [-\infty, +\infty]$,
$$\inf_{\varepsilon > 0} (z + \varepsilon) = z.$$
-/
theorem iInf_add_pos_coe (z : EReal) : ⨅ ε ∈ Ioi (0 : ℝ), (z + (ε : EReal)) = z := by
  refine le_antisymm ?_ (le_iInf₂ fun ε hε => ?_)
  · induction z with
    | bot =>
        refine le_of_le_of_eq (iInf₂_le (1 : ℝ) (mem_Ioi.2 one_pos)) ?_
        simp
    | top => exact le_top
    | coe c =>
        refine EReal.le_of_forall_lt_iff_le.1 fun q hq => le_of_lt ?_
        replace hq := EReal.coe_lt_coe_iff.1 hq
        refine lt_of_le_of_lt (iInf₂_le ((q - c) / 2) (mem_Ioi.2 (by linarith))) ?_
        rw [← EReal.coe_add]
        exact_mod_cast (by linarith : c + (q - c) / 2 < q)
  · have h0 : (0 : EReal) ≤ (ε : EReal) := by exact_mod_cast le_of_lt hε
    simpa using add_le_add (le_refl z) h0

/-- For $u, v \in [-\infty, +\infty]$, if $u \le v + \varepsilon$ for every real $\varepsilon > 0$,
then $u \le v$. -/
theorem le_of_forall_pos_le_add {u v : EReal} (h : ∀ ε : ℝ, 0 < ε → u ≤ v + (ε : EReal)) :
    u ≤ v := by
  rw [← iInf_add_pos_coe v]
  exact le_iInf₂ fun ε hε => h ε hε

/-- For reals $s, t$ and $u \in [-\infty, +\infty]$, $s \le u + t$ if and only if $s - t \le u$. -/
theorem coe_le_add_coe_iff {s t : ℝ} {u : EReal} :
    ((s : ℝ) : EReal) ≤ u + (t : EReal) ↔ ((s - t : ℝ) : EReal) ≤ u := by
  rw [EReal.coe_sub, EReal.sub_le_iff_le_add (.inl (EReal.coe_ne_bot t))
    (.inl (EReal.coe_ne_top t))]

/-- For reals $s, t, c$ and $u \in [-\infty, +\infty]$,
$$s + c \le u + t \iff c \le u + (t - s).$$
A real constant can be moved from one side of an inequality with slack to the other. This is
used for `ConvexAnalysis.epsSubdifferential_eq_supportSet`. -/
theorem coe_add_le_add_coe_iff {s t c : ℝ} {u : EReal} :
    (s : EReal) + (c : EReal) ≤ u + (t : EReal) ↔ (c : EReal) ≤ u + ((t - s : ℝ) : EReal) := by
  rw [← EReal.coe_add, coe_le_add_coe_iff, coe_le_add_coe_iff,
    show s + c - t = c - (t - s) from by ring]

/-- For $a \in \mathbb{R}$ and $z \in [-\infty, +\infty]$, $a z = z / a^{-1}$.

The statement holds for every real $a$; at $a = 0$ both sides are $0$. -/
theorem coe_mul_eq_div_coe_inv (a : ℝ) (z : EReal) :
    (a : EReal) * z = z / ((a⁻¹ : ℝ) : EReal) := by
  rw [div_eq_mul_inv, ← EReal.coe_inv, inv_inv]
  exact mul_comm _ _

/-- For $u \in [-\infty, +\infty]$ and $s \in \mathbb{R}$,
$$\inf_{\varepsilon > 0} \bigl(u + (\varepsilon - s)\bigr) = u + (-s).$$
-/
theorem iInf_add_sub_pos_coe (u : EReal) (s : ℝ) :
    ⨅ ε ∈ Ioi (0 : ℝ), (u + ((ε - s : ℝ) : EReal)) = u + ((-s : ℝ) : EReal) := by
  have hstep : ∀ ε : ℝ, u + ((ε - s : ℝ) : EReal) = (u + ((-s : ℝ) : EReal)) + (ε : EReal) :=
    fun ε => by
      rw [show (ε - s : ℝ) = -s + ε from by ring, EReal.coe_add, ← add_assoc]
  simp_rw [hstep]
  exact iInf_add_pos_coe _

/-! ### The ε-subdifferential -/

section Defs

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {y : F} {ε : ℝ}

/-- The **$\varepsilon$-subdifferential** of $f : E \to [-\infty, +\infty]$ at $x$ for the pairing
$B$ and a real $\varepsilon$: the set of $y \in F$ that satisfy the subgradient inequality up to
the slack $\varepsilon$,
$$\partial_\varepsilon f(x) = \{y \in F \mid f(x) + \langle z - x, y \rangle \le f(z) +
  \varepsilon \text{ for every } z \in E\}.$$

This is the inequality $f(z) \ge f(x) - \varepsilon + \langle z - x, y \rangle$ in a form that
keeps the shape of `ConvexAnalysis.subdifferential`, so that $\partial_0 f(x) = \partial f(x)$
is immediate. The value of $\varepsilon$ is not restricted to $\varepsilon > 0$. -/
def epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (ε : ℝ) (f : E → EReal) (x : E) : Set F :=
  {y | ∀ z, f x + ((B (z - x) y : ℝ) : EReal) ≤ f z + (ε : EReal)}

/-- $y \in \partial_\varepsilon f(x)$ if and only if $f(x) + \langle z - x, y \rangle \le f(z) +
\varepsilon$ for every $z$. -/
@[simp] theorem mem_epsSubdifferential :
    y ∈ epsSubdifferential B ε f x ↔
      ∀ z, f x + ((B (z - x) y : ℝ) : EReal) ≤ f z + (ε : EReal) := Iff.rfl

/-- At $\varepsilon = 0$ the $\varepsilon$-subdifferential is the subdifferential:
$\partial_0 f(x) = \partial f(x)$. -/
@[simp] theorem epsSubdifferential_zero (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) :
    epsSubdifferential B 0 f x = subdifferential B f x := by
  ext y
  simp only [mem_epsSubdifferential, mem_subdifferential, EReal.coe_zero, add_zero]

/-- The $\varepsilon$-subdifferentials increase with $\varepsilon$: if
$\varepsilon_1 \le \varepsilon_2$, then $\partial_{\varepsilon_1} f(x) \subseteq
\partial_{\varepsilon_2} f(x)$. -/
theorem epsSubdifferential_mono (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) {ε₁ ε₂ : ℝ}
    (h : ε₁ ≤ ε₂) : epsSubdifferential B ε₁ f x ⊆ epsSubdifferential B ε₂ f x :=
  fun _ hy z => (hy z).trans (add_le_add le_rfl (by exact_mod_cast h))

/-- For $\varepsilon \ge 0$, every subgradient is an $\varepsilon$-subgradient: $\partial f(x)
\subseteq \partial_\varepsilon f(x)$. -/
theorem subdifferential_subset_epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E)
    (hε : 0 ≤ ε) : subdifferential B f x ⊆ epsSubdifferential B ε f x := by
  rw [← epsSubdifferential_zero B f x]
  exact epsSubdifferential_mono B f x hε

/-- For every $f : E \to [-\infty, +\infty]$ and $x \in E$,
$$\bigcap_{\varepsilon > 0} \partial_\varepsilon f(x) = \partial f(x).$$

No hypothesis is needed, because $\inf_{\varepsilon > 0} (z + \varepsilon) = z$ holds in `EReal`
for every $z$ (`ConvexAnalysis.iInf_add_pos_coe`). -/
theorem iInter_epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) :
    ⋂ ε ∈ Ioi (0 : ℝ), epsSubdifferential B ε f x = subdifferential B f x := by
  refine subset_antisymm (fun y hy z => ?_) fun y hy =>
    mem_iInter₂.2 fun ε hε => subdifferential_subset_epsSubdifferential B f x (le_of_lt hε) hy
  exact le_of_forall_pos_le_add fun ε hε => (mem_iInter₂.1 hy ε (mem_Ioi.2 hε)) z

/-- The translate of $f : E \to [-\infty, +\infty]$ to the point $x$, raised by the real constant
$c$:
$$w \mapsto f(x + w) + c.$$
If $f(x) = r$ is finite, Rockafellar's function $h(w) = f(x + w) - f(x)$ is this function with
$c = -r$, and $h + \varepsilon$ is this function with $c = \varepsilon - r$. -/
noncomputable def shiftFn (f : E → EReal) (x : E) (c : ℝ) : E → EReal :=
  fun w => f (x + w) + (c : EReal)

omit [Module ℝ E] in
/-- The translate of $f$ to $x$ raised by $c$ takes at $w$ the value $f(x + w) + c$. -/
@[simp] theorem shiftFn_apply (f : E → EReal) (x : E) (c : ℝ) (w : E) :
    shiftFn f x c w = f (x + w) + (c : EReal) := rfl

omit [Module ℝ E] in
/-- If $f(x) = r$ is finite, the translate of $f$ to $x$ raised by $c$ takes the value $r + c$ at
the origin. -/
theorem shiftFn_zero {r c : ℝ} (hr : f x = (r : EReal)) :
    shiftFn f x c 0 = ((r + c : ℝ) : EReal) := by
  rw [shiftFn_apply, add_zero, hr, ← EReal.coe_add]

/-- The translate $w \mapsto f(x + w) + c$ of a convex function $f$ is convex. -/
theorem convexFn_shiftFn (hf : ConvexFn f) (x : E) (c : ℝ) : ConvexFn (shiftFn f x c) := by
  refine convexFn_of_epi_combo fun u v μ ν hu hv a b ha hb hab => ?_
  rw [shiftFn_apply, EReal.add_coe_le_coe_iff] at hu hv ⊢
  have hxs : a • x + b • x = x := by rw [← add_smul, hab, one_smul]
  have hx : a • (x + u) + b • (x + v) = x + (a • u + b • v) := by
    have hrearr : a • (x + u) + b • (x + v) = (a • x + b • x) + (a • u + b • v) := by
      rw [smul_add, smul_add]; abel
    rw [hrearr, hxs]
  have harith : a * (μ - c) + b * (ν - c) = a * μ + b * ν - c := by linear_combination (-c) * hab
  rw [← hx, ← harith]
  exact hf.epi_combo hu hv ha hb hab

omit [Module ℝ E] in
/-- The translate $w \mapsto f(x + w) + c$ of a proper convex function $f$ is proper. -/
theorem properConvex_shiftFn (hp : ProperConvex f) (x : E)
    (c : ℝ) : ProperConvex (shiftFn f x c) := by
  obtain ⟨z, hz⟩ := hp.convexDom_nonempty
  have hxz : x + (z - x) = z := by abel
  refine ⟨⟨z - x, ?_⟩, fun w => ?_⟩
  · rw [mem_convexDom, shiftFn_apply, hxz]
    exact EReal.add_lt_top (mem_convexDom.1 hz).ne (EReal.coe_ne_top c)
  · rw [shiftFn_apply, Ne, EReal.add_eq_bot_iff]
    push Not
    exact ⟨hp.ne_bot (x + w), EReal.coe_ne_bot c⟩

end Defs

/-! ### The level-set description of `∂_ε f x` -/

section Level

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {r : ℝ}

/-- If $f(x) = r$ is finite, then $\partial_\varepsilon f(x)$ is the set of $y$ such that the linear
function $\langle \cdot, y \rangle$ is a minorant of $h + \varepsilon$, where
$h(w) = f(x + w) - f(x)$:
$$\partial_\varepsilon f(x) = \{y \mid \langle w, y \rangle \le h(w) + \varepsilon \text{ for
  every } w\}.$$
-/
theorem epsSubdifferential_eq_supportSet (hr : f x = (r : EReal)) (ε : ℝ) :
    epsSubdifferential B ε f x = supportSet B (shiftFn f x (ε - r)) := by
  ext y
  simp only [mem_epsSubdifferential, mem_supportSet, shiftFn_apply, hr]
  constructor
  · intro h w
    have hw := h (x + w)
    rw [add_sub_cancel_left] at hw
    exact coe_add_le_add_coe_iff.1 hw
  · intro h z
    have hz := h (z - x)
    rw [show x + (z - x) = z from by abel] at hz
    exact coe_add_le_add_coe_iff.2 hz

/-- If $f(x) = r$ is finite, then $\partial_\varepsilon f(x)$ is a level set of the conjugate of
$h + \varepsilon$, where $h(w) = f(x + w) - f(x)$:
$$\partial_\varepsilon f(x) = \{y \mid (h + \varepsilon)^*(y) \le 0\}.$$
This is the level set $\{y \mid h^*(y) \le \varepsilon\}$, with $\varepsilon$ moved into the
function so that the level is $0$. -/
theorem epsSubdifferential_eq_setOf_convexConj_le (hr : f x = (r : EReal)) (ε : ℝ) :
    epsSubdifferential B ε f x = {y : F | convexConj B (shiftFn f x (ε - r)) y ≤ 0} := by
  rw [epsSubdifferential_eq_supportSet hr ε, supportSet_eq_setOf_convexConj_le]

/-- If $f(x)$ is finite, then $\partial_\varepsilon f(x)$ is convex, because it is a level set of
the convex function $(h + \varepsilon)^*$. -/
theorem convex_epsSubdifferential (hr : f x = (r : EReal)) (ε : ℝ) :
    Convex ℝ (epsSubdifferential B ε f x) := by
  rw [epsSubdifferential_eq_supportSet hr ε]
  exact convex_supportSet B _

end Level

section LevelClosed

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  [TopologicalSpace F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} [IsContinuousPairing B.flip] {f : E → EReal}
  {x : E} {r : ℝ}

/-- Let $F$ carry a topology for which every linear function $\langle x, \cdot \rangle$ on $F$ is
continuous. If $f(x)$ is finite, then $\partial_\varepsilon f(x)$ is closed, because it is a
level set of the lower semicontinuous function $(h + \varepsilon)^*$.

Continuity of the pairing is needed on the side of $F$ only, where $\partial_\varepsilon f(x)$
lies. -/
theorem isClosed_epsSubdifferential (hr : f x = (r : EReal)) (ε : ℝ) :
    IsClosed (epsSubdifferential B ε f x) := by
  rw [epsSubdifferential_eq_supportSet hr ε]
  exact isClosed_supportSet (B := B.flip) _

end LevelClosed

/-! ### The directional derivative as a generated positively homogeneous function -/

section PosHom

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {f g h : E → EReal} {x : E} {r : ℝ}

/-- For every $g : E \to [-\infty, +\infty]$ and $v \in E$, the positively homogeneous convex
function generated by $g$ satisfies
$$(\operatorname{posHomGen} g)(v) \le \inf_{a > 0} a \, g(a^{-1} v).$$
This half of the formula for `ConvexAnalysis.posHomGen` needs neither convexity of $g$ nor
$v \neq 0$. -/
theorem posHomGen_le_iInf_coe_mul (g : E → EReal) (v : E) :
    posHomGen g v ≤ ⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * g (a⁻¹ • v) := by
  refine le_iInf₂ fun a ha => ?_
  have ha' : (0 : ℝ) < a := ha
  have hhom := posHomogeneous_posHomGen g a ha' (a⁻¹ • v)
  rw [smul_smul, mul_inv_cancel₀ ha'.ne', one_smul] at hhom
  rw [hhom]
  exact (EReal.coe_mul_le_coe_mul_iff ha').2 (posHomGen_le g _)

/-- For every $g : E \to [-\infty, +\infty]$ and $v \in E$,
$$\inf_{a > 0} a \, g(a^{-1} v) = \inf_{b > 0} \frac{g(b v)}{b}.$$
This is the reindexing $b = a^{-1}$, which writes the infimum that defines
`ConvexAnalysis.posHomGen` as an infimum of difference quotients. -/
theorem iInf_coe_mul_eq_iInf_div (g : E → EReal) (v : E) :
    (⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * g (a⁻¹ • v))
      = ⨅ b ∈ Ioi (0 : ℝ), g (b • v) / (b : EReal) := by
  refine le_antisymm (le_iInf₂ fun b hb => ?_) (le_iInf₂ fun a ha => ?_)
  · have hb' : (0 : ℝ) < b := hb
    have key : ((b⁻¹ : ℝ) : EReal) * g ((b⁻¹)⁻¹ • v) = g (b • v) / (b : EReal) := by
      rw [inv_inv, coe_mul_eq_div_coe_inv, inv_inv]
    exact le_of_le_of_eq (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
      (c : EReal) * g (c⁻¹ • v)) b⁻¹ (mem_Ioi.2 (inv_pos.2 hb'))) key
  · have ha' : (0 : ℝ) < a := ha
    exact le_of_le_of_eq (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
      g (c • v) / (c : EReal)) a⁻¹ (mem_Ioi.2 (inv_pos.2 ha')))
      (coe_mul_eq_div_coe_inv a _).symm

/-- **The generated function as an infimum of difference quotients.** For a convex
$g : E \to [-\infty, +\infty]$ and $v \neq 0$,
$$(\operatorname{posHomGen} g)(v) = \inf_{\lambda > 0} \frac{g(\lambda v)}{\lambda}.$$
-/
theorem posHomGen_apply_eq_iInf_div (hg : ConvexFn g) {v : E} (hv : v ≠ 0) :
    posHomGen g v = ⨅ b ∈ Ioi (0 : ℝ), g (b • v) / (b : EReal) := by
  rw [← iInf_coe_mul_eq_iInf_div]
  exact posHomGen_apply_of_ne_zero hg hv

omit [Module ℝ E] in
/-- If $f(x) = r$ is finite, the translate of $f$ to $x$ raised by $-r$ is $h(w) = f(x + w) - f(x)$.
-/
theorem shiftFn_neg_apply (hr : f x = (r : EReal)) (w : E) :
    shiftFn f x (-r) w = f (x + w) - f x := by
  rw [shiftFn_apply, hr, EReal.coe_neg, ← sub_eq_add_neg]

/-- If $f(x) = r$ is finite and $h(w) = f(x + w) - f(x)$, then for every $v$
$$\inf_{a > 0} a \, h(a^{-1} v) = f'(x; v).$$
The rescaled values of $h$ are the difference quotients that define the directional derivative. -/
theorem iInf_coe_mul_shiftFn_neg (hr : f x = (r : EReal)) (v : E) :
    (⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * shiftFn f x (-r) (a⁻¹ • v)) = dirDeriv f x v := by
  rw [iInf_coe_mul_eq_iInf_div, dirDeriv_apply]
  exact iInf_congr fun b => iInf_congr fun _ => by rw [shiftFn_neg_apply hr]

/-- Let $f : E \to [-\infty, +\infty]$ be convex, and let $f(x) = r$ be finite. Then the directional
derivative $f'(x; \cdot)$ is the positively homogeneous convex function generated by
$h(w) = f(x + w) - f(x)$:
$$f'(x; \cdot) = \operatorname{posHomGen} h.$$

Both inequalities follow from the maximality of `ConvexAnalysis.posHomGen`. The statement needs
no topology and, unlike Rockafellar's formula for the generated function, no separate case at
$v = 0$. -/
theorem posHomGen_shiftFn (hf : ConvexFn f) (hr : f x = (r : EReal)) :
    posHomGen (shiftFn f x (-r)) = dirDeriv f x := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hle : dirDeriv f x ≤ shiftFn f x (-r) := by
    rw [Pi.le_def]
    intro w
    have hq := dirDeriv_le f x w one_pos
    rw [one_smul, EReal.coe_one, div_one] at hq
    rw [shiftFn_neg_apply hr]
    exact hq
  refine le_antisymm ?_ (le_posHomGen (posHomogeneous_dirDeriv f x) (convexFn_dirDeriv hf ht hb)
    (le_of_eq (dirDeriv_zero ht hb)) hle)
  rw [Pi.le_def]
  intro v
  exact (posHomGen_le_iInf_coe_mul _ v).trans (le_of_eq (iInf_coe_mul_shiftFn_neg hr v))

end PosHom

/-! ### The support functions of the ε-subdifferentials -/

section SupportFn

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {ε r : ℝ}

omit [NormedSpace ℝ E] [FiniteDimensional ℝ E] in
/-- Let $E$ be a normed additive group. If the epigraph of $f : E \to [-\infty, +\infty]$ is closed,
then the epigraph of the translate $w \mapsto f(x + w) + c$ is closed. It is the preimage of the
epigraph of $f$ under a homeomorphism of $E \times \mathbb{R}$. -/
theorem isClosed_epi_shiftFn (hc : IsClosed (epi f)) (x : E) (c : ℝ) :
    IsClosed (epi (shiftFn f x c)) := by
  have hpre : epi (shiftFn f x c) = (fun p : E × ℝ => (x + p.1, p.2 - c)) ⁻¹' epi f := by
    ext p
    simp only [Set.mem_preimage, mem_epi, shiftFn_apply]
    exact EReal.add_coe_le_coe_iff
  rw [hpre]
  exact hc.preimage ((continuous_const.add continuous_fst).prodMk
    (continuous_snd.sub continuous_const))

omit [NormedSpace ℝ E] [FiniteDimensional ℝ E] in
/-- If $f(x) = r$ is finite, then $(h + \varepsilon)(0) = \varepsilon$, where
$h(w) = f(x + w) - f(x)$. -/
theorem shiftFn_sub_apply_zero (hr : f x = (r : EReal)) (ε : ℝ) :
    shiftFn f x (ε - r) 0 = (ε : EReal) := by
  rw [shiftFn_zero hr, show r + (ε - r) = ε from by ring]

/-- Let $E$ be a finite-dimensional real normed space, let $f : E \to [-\infty, +\infty]$ be a
proper convex function with closed epigraph, let $f(x) = r$ be finite, and let
$\varepsilon > 0$. Then the positively homogeneous convex function generated by
$h + \varepsilon$, where $h(w) = f(x + w) - f(x)$, is closed.

The reason is that $h + \varepsilon$ is finite and positive at the origin. This removes the
closure from the identity for the support function of $\partial_\varepsilon f(x)$, and it is the
only use of finite dimension. -/
theorem closedConvex_posHomGen_shiftFn (hf : ConvexFn f) (hp : ProperConvex f)
    (hc : IsClosed (epi f))
    (hr : f x = (r : EReal)) (hε : 0 < ε) :
    ClosedConvex (posHomGen (shiftFn f x (ε - r))) := by
  have hgc : ConvexFn (shiftFn f x (ε - r)) := convexFn_shiftFn hf x _
  have hgp : ProperConvex (shiftFn f x (ε - r)) := properConvex_shiftFn hp x _
  have hge : IsClosed (epi (shiftFn f x (ε - r))) := isClosed_epi_shiftFn hc x _
  have hg0 := shiftFn_sub_apply_zero hr ε
  have h0 : 0 < shiftFn f x (ε - r) 0 := by
    rw [hg0]
    exact_mod_cast hε
  have hdom : shiftFn f x (ε - r) 0 ≠ ⊤ := by
    rw [hg0]
    exact EReal.coe_ne_top ε
  have hproper := properConvex_posHomGen hgc hgp hge h0
  have hlsc := lscHull_posHomGen_eq hgc hgp hge h0 hdom
  have hcl : convexCl (posHomGen (shiftFn f x (ε - r))) = posHomGen (shiftFn f x (ε - r)) := by
    rw [convexCl_of_forall_ne_bot fun y => by rw [hlsc]; exact hproper.ne_bot y, hlsc]
  exact hcl

/-- Let $E$ be a finite-dimensional real normed space with a compatible pairing $B$ with $F$, let
$f : E \to [-\infty, +\infty]$ be a proper convex function with closed epigraph, let $f(x) = r$
be finite, and let $\varepsilon > 0$. Then the support function of $\partial_\varepsilon f(x)$
is the positively homogeneous convex function generated by $h + \varepsilon$, where
$h(w) = f(x + w) - f(x)$:
$$\delta^*(\cdot \mid \partial_\varepsilon f(x)) = \operatorname{posHomGen}(h + \varepsilon).$$
No closure is needed, by `ConvexAnalysis.closedConvex_posHomGen_shiftFn`. -/
theorem supportFn_epsSubdifferential [IsCompatiblePairing B] (hf : ConvexFn f) (hp : ProperConvex f)
    (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (hε : 0 < ε) :
    supportFn B.flip (epsSubdifferential B ε f x) = posHomGen (shiftFn f x (ε - r)) := by
  rw [epsSubdifferential_eq_setOf_convexConj_le hr ε]
  exact supportFn_setOf_convexConj_le_zero (B := B.flip)
    (closedConvex_posHomGen_shiftFn hf hp hc hr hε)

/-- **The explicit formula.** Let $E$ be a finite-dimensional real normed space with a compatible
pairing $B$ with $F$, let $f : E \to [-\infty, +\infty]$ be a proper convex function with closed
epigraph, let $f(x)$ be finite, and let $\varepsilon > 0$. Then for every $v \neq 0$,
$$\delta^*(v \mid \partial_\varepsilon f(x)) = \inf_{\lambda > 0} \frac{f(x + \lambda v) -
  f(x) + \varepsilon}{\lambda}.$$
-/
theorem supportFn_epsSubdifferential_apply [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f)
    (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (hε : 0 < ε) {v : E} (hv : v ≠ 0) :
    supportFn B.flip (epsSubdifferential B ε f x) v
      = ⨅ b ∈ Ioi (0 : ℝ), (f (x + b • v) - f x + (ε : EReal)) / (b : EReal) := by
  rw [supportFn_epsSubdifferential hf hp hc hr hε,
    posHomGen_apply_eq_iInf_div (convexFn_shiftFn hf x _) hv]
  refine iInf_congr fun b => iInf_congr fun _ => ?_
  rw [shiftFn_apply, hr, show (ε - r : ℝ) = -r + ε from by ring, EReal.coe_add,
    EReal.coe_neg, ← add_assoc, ← sub_eq_add_neg]

/-- Let $E$ be a finite-dimensional real normed space with a compatible pairing $B$ with $F$, let
$f : E \to [-\infty, +\infty]$ be a proper convex function with closed epigraph, and let $f(x)$
be finite. Then for every $v \in E$,
$$\inf_{\varepsilon > 0} \delta^*(v \mid \partial_\varepsilon f(x)) = f'(x; v).$$
So the support functions of the $\varepsilon$-subdifferentials decrease, as
$\varepsilon \downarrow 0$, to the directional derivative itself, not only to its closure
$\delta^*(\cdot \mid \partial f(x))$. This is Theorem 23.6 of [rockafellar1970convex].

Both inequalities follow from `ConvexAnalysis.posHomGen`: letting $\varepsilon \downarrow 0$
inside the rescaling leaves the difference quotients that define $f'(x; \cdot)$. -/
theorem dirDeriv_eq_iInf_supportFn_epsSubdifferential [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f) (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (v : E) :
    ⨅ ε ∈ Ioi (0 : ℝ), supportFn B.flip (epsSubdifferential B ε f x) v = dirDeriv f x v := by
  have hval : ∀ δ ∈ Ioi (0 : ℝ), supportFn B.flip (epsSubdifferential B δ f x) v
      = posHomGen (shiftFn f x (δ - r)) v := fun δ hδ => by
    have hδ' : (0 : ℝ) < δ := hδ
    rw [supportFn_epsSubdifferential hf hp hc hr hδ']
  refine (iInf_congr fun δ => iInf_congr fun hδ => hval δ hδ).trans (le_antisymm ?_ ?_)
  · rw [← iInf_coe_mul_shiftFn_neg hr v]
    refine le_iInf₂ fun a ha => ?_
    have ha' : (0 : ℝ) < a := ha
    have hinner : shiftFn f x (-r) (a⁻¹ • v)
        = ⨅ δ ∈ Ioi (0 : ℝ), shiftFn f x (δ - r) (a⁻¹ • v) := by
      simp only [shiftFn_apply]
      exact (iInf_add_sub_pos_coe _ r).symm
    rw [hinner, EReal.coe_mul_iInf ha']
    refine le_iInf fun δ => ?_
    rw [EReal.coe_mul_iInf ha']
    refine le_iInf fun hδ => ?_
    exact le_trans (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
        posHomGen (shiftFn f x (c - r)) v) δ hδ)
      ((posHomGen_le_iInf_coe_mul (shiftFn f x (δ - r)) v).trans
        (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
          (c : EReal) * shiftFn f x (δ - r) (c⁻¹ • v)) a ha))
  · refine le_iInf₂ fun δ hδ => ?_
    have hδ' : (0 : ℝ) < δ := hδ
    have hmono : shiftFn f x (-r) ≤ shiftFn f x (δ - r) := by
      rw [Pi.le_def]
      intro w
      have hle : ((-r : ℝ) : EReal) ≤ ((δ - r : ℝ) : EReal) := by
        exact_mod_cast (by linarith : -r ≤ δ - r)
      exact add_le_add (le_refl (f (x + w))) hle
    have hstep := posHomGen_mono hmono v
    rwa [posHomGen_shiftFn hf hr] at hstep

end SupportFn

end ConvexAnalysis
