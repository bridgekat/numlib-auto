import Numlib.Analysis.Convex.Duality.Level
import Numlib.Analysis.Convex.Subdifferential.Defs

/-!
# ε-subgradients

A vector `y` is an *ε-subgradient* of `f` at `x` when the subgradient inequality holds up to a
slack `ε`: `f z ≥ (f x - ε) + ⟨z - x, y⟩` for every `z`. The set of them, `∂_ε f x`, is closed and
convex and decreases to `∂f x` as `ε ↓ 0`, and its support function decreases to the *directional
derivative* `f'(x; ·)`, not merely to the closure `δ*(· | ∂f x)`. That is the exact dual of the
discrepancy between `f'(x; ·)` and its own closure.

## Main definitions

* `epsSubdifferential B ε f x` — the ε-subdifferential `∂_ε f x ⊆ F`.
* `shiftFn f x c` — `w ↦ f (x + w) + c`, `f` translated so that `x` sits at the origin.

## Main results

* `epsSubdifferential_eq_setOf_convexConj_le`, `iInter_epsSubdifferential` — `∂_ε f x` is a level
  set of a conjugate, and `⋂_{ε > 0} ∂_ε f x = ∂f x`.
* `posHomGen_shiftFn` — the directional derivative *is* the positively homogeneous convex function
  generated by the shift. This is the identity everything turns on, and it needs no topology.
* `supportFn_epsSubdifferential_apply` —
  `δ*(y | ∂_ε f x) = inf_{λ > 0} (f (x + λ y) - f x + ε) / λ`.
* `dirDeriv_eq_iInf_supportFn_epsSubdifferential` — `⨅_{ε > 0} δ*(· | ∂_ε f x) = f'(x; ·)`
  ([rockafellar1970convex] Theorem 23.6).

## Implementation notes

The classical `lim_{ε ↓ 0}` is an infimum over `ε > 0` here, the same thing because `ε ↦ ∂_ε f x`
is monotone. Finite dimension is used once, to make the generated function closed and so remove
the closure from the support-function identity. `shiftFn` adds a real constant rather than
subtracting `f x`, which avoids `EReal` subtraction; every lemma below carries `f x = (r : ℝ)`.

## References

* [rockafellar1970convex] §23.
-/

open Set

namespace ConvexAnalysis

/-! ### An `EReal` service lemma

`⨅_{ε > 0} (z + ε) = z`, with no hypothesis on `z` — the two improper values are absorbing for
`+ ε`. This is what makes `∂f x` the intersection of the nest, and what removes the `ε` at the end
of the main proof. -/

theorem iInf_add_pos_coe (z : EReal) : ⨅ ε ∈ Ioi (0 : ℝ), (z + (ε : EReal)) = z := by
  refine le_antisymm ?_ (le_iInf₂ fun ε hε => ?_)
  · induction z with
    | bot =>
        refine le_of_le_of_eq (iInf₂_le (1 : ℝ) (mem_Ioi.2 one_pos)) ?_
        simp
    | top => exact le_top
    | coe c =>
        refine EReal.le_of_forall_lt_iff_le.1 fun q hq => le_of_lt ?_
        replace hq := EReal.coe_lt_coe_iff.1 hq
        refine lt_of_le_of_lt (iInf₂_le ((q - c) / 2) (mem_Ioi.2 (by linarith))) ?_
        rw [← EReal.coe_add]
        exact_mod_cast (by linarith : c + (q - c) / 2 < q)
  · have h0 : (0 : EReal) ≤ (ε : EReal) := by exact_mod_cast le_of_lt hε
    simpa using add_le_add (le_refl z) h0

/-- From `u ≤ v + ε` for every `ε > 0` follows `u ≤ v`. -/
theorem le_of_forall_pos_le_add {u v : EReal} (h : ∀ ε : ℝ, 0 < ε → u ≤ v + (ε : EReal)) :
    u ≤ v := by
  rw [← iInf_add_pos_coe v]
  exact le_iInf₂ fun ε hε => h ε hε

/-- Moving a real constant across `≤` against a real coercion, on the right. -/
theorem coe_le_add_coe_iff {s t : ℝ} {u : EReal} :
    ((s : ℝ) : EReal) ≤ u + (t : EReal) ↔ ((s - t : ℝ) : EReal) ≤ u := by
  rw [EReal.coe_sub, EReal.sub_le_iff_le_add (.inl (EReal.coe_ne_bot t))
    (.inl (EReal.coe_ne_top t))]

/-- Slack transfer: a real constant may be moved from one side of an inequality with slack to the
other. This is the bookkeeping behind `epsSubdifferential_eq_supportSet`. -/
theorem coe_add_le_add_coe_iff {s t c : ℝ} {u : EReal} :
    (s : EReal) + (c : EReal) ≤ u + (t : EReal) ↔ (c : EReal) ≤ u + ((t - s : ℝ) : EReal) := by
  rw [← EReal.coe_add, coe_le_add_coe_iff, coe_le_add_coe_iff,
    show s + c - t = c - (t - s) from by ring]

/-- Multiplying by a positive real is dividing by its reciprocal. -/
theorem coe_mul_eq_div_coe_inv (a : ℝ) (z : EReal) :
    (a : EReal) * z = z / ((a⁻¹ : ℝ) : EReal) := by
  rw [div_eq_mul_inv, ← EReal.coe_inv, inv_inv]
  exact mul_comm _ _

/-- Letting `ε ↓ 0` in `u + (ε - s)`. -/
theorem iInf_add_sub_pos_coe (u : EReal) (s : ℝ) :
    ⨅ ε ∈ Ioi (0 : ℝ), (u + ((ε - s : ℝ) : EReal)) = u + ((-s : ℝ) : EReal) := by
  have hstep : ∀ ε : ℝ, u + ((ε - s : ℝ) : EReal) = (u + ((-s : ℝ) : EReal)) + (ε : EReal) :=
    fun ε => by
      rw [show (ε - s : ℝ) = -s + ε from by ring, EReal.coe_add, ← add_assoc]
  simp_rw [hstep]
  exact iInf_add_pos_coe _

/-! ### The ε-subdifferential -/

section Defs

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {y : F} {ε : ℝ}

/-- The **ε-subdifferential** of `f` at `x`: the set of `y : F` satisfying the subgradient
inequality up to a slack of `ε`, `f z ≥ (f x - ε) + ⟨z - x, y⟩` for every `z`. It is written in the
equivalent form `f x + ⟨z - x, y⟩ ≤ f z + ε`, which keeps the shape of `subdifferential` and makes
`epsSubdifferential B 0 f x = subdifferential B f x` immediate. -/
def epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (ε : ℝ) (f : E → EReal) (x : E) : Set F :=
  {y | ∀ z, f x + ((B (z - x) y : ℝ) : EReal) ≤ f z + (ε : EReal)}

@[simp] theorem mem_epsSubdifferential :
    y ∈ epsSubdifferential B ε f x ↔
      ∀ z, f x + ((B (z - x) y : ℝ) : EReal) ≤ f z + (ε : EReal) := Iff.rfl

/-- At `ε = 0` the ε-subdifferential is the subdifferential. -/
@[simp] theorem epsSubdifferential_zero (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) :
    epsSubdifferential B 0 f x = subdifferential B f x := by
  ext y
  simp only [mem_epsSubdifferential, mem_subdifferential, EReal.coe_zero, add_zero]

/-- The ε-subdifferentials increase with `ε`. -/
theorem epsSubdifferential_mono (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) {ε₁ ε₂ : ℝ}
    (h : ε₁ ≤ ε₂) : epsSubdifferential B ε₁ f x ⊆ epsSubdifferential B ε₂ f x :=
  fun _ hy z => (hy z).trans (add_le_add le_rfl (by exact_mod_cast h))

/-- Every subgradient is an ε-subgradient. -/
theorem subdifferential_subset_epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E)
    (hε : 0 ≤ ε) : subdifferential B f x ⊆ epsSubdifferential B ε f x := by
  rw [← epsSubdifferential_zero B f x]
  exact epsSubdifferential_mono B f x hε

/-- The nest of ε-subdifferentials has intersection `∂f x`. No hypothesis is needed:
`⨅_{ε > 0} (z + ε) = z` holds in `EReal` outright. -/
theorem iInter_epsSubdifferential (B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ) (f : E → EReal) (x : E) :
    ⋂ ε ∈ Ioi (0 : ℝ), epsSubdifferential B ε f x = subdifferential B f x := by
  refine subset_antisymm (fun y hy z => ?_) fun y hy =>
    mem_iInter₂.2 fun ε hε => subdifferential_subset_epsSubdifferential B f x (le_of_lt hε) hy
  exact le_of_forall_pos_le_add fun ε hε => (mem_iInter₂.1 hy ε (mem_Ioi.2 hε)) z

/-- The book's `h`, with a constant added: `w ↦ f (x + w) + c`. Its `h y = f (x + y) - f x` is
`shiftFn f x (-f x)` and its `h + ε` is `shiftFn f x (ε - f x)`, both under the standing hypothesis
that `f x` is finite. -/
noncomputable def shiftFn (f : E → EReal) (x : E) (c : ℝ) : E → EReal :=
  fun w => f (x + w) + (c : EReal)

omit [Module ℝ E] in
@[simp] theorem shiftFn_apply (f : E → EReal) (x : E) (c : ℝ) (w : E) :
    shiftFn f x c w = f (x + w) + (c : EReal) := rfl

omit [Module ℝ E] in
/-- The value of `shiftFn` at the origin. -/
theorem shiftFn_zero {r c : ℝ} (hr : f x = (r : EReal)) :
    shiftFn f x c 0 = ((r + c : ℝ) : EReal) := by
  rw [shiftFn_apply, add_zero, hr, ← EReal.coe_add]

/-- A translate of a convex function, raised by a constant, is convex. -/
theorem convexFn_shiftFn (hf : ConvexFn f) (x : E) (c : ℝ) : ConvexFn (shiftFn f x c) := by
  refine convexFn_of_epi_combo fun u v μ ν hu hv a b ha hb hab => ?_
  rw [shiftFn_apply, EReal.add_coe_le_coe_iff] at hu hv ⊢
  have hxs : a • x + b • x = x := by rw [← add_smul, hab, one_smul]
  have hx : a • (x + u) + b • (x + v) = x + (a • u + b • v) := by
    have hrearr : a • (x + u) + b • (x + v) = (a • x + b • x) + (a • u + b • v) := by
      rw [smul_add, smul_add]; abel
    rw [hrearr, hxs]
  have harith : a * (μ - c) + b * (ν - c) = a * μ + b * ν - c := by linear_combination (-c) * hab
  rw [← hx, ← harith]
  exact hf.epi_combo hu hv ha hb hab

omit [Module ℝ E] in
/-- A translate of a proper function, raised by a constant, is proper. -/
theorem properConvex_shiftFn (hp : ProperConvex f) (x : E)
    (c : ℝ) : ProperConvex (shiftFn f x c) := by
  obtain ⟨z, hz⟩ := hp.convexDom_nonempty
  have hxz : x + (z - x) = z := by abel
  refine ⟨⟨z - x, ?_⟩, fun w => ?_⟩
  · rw [mem_convexDom, shiftFn_apply, hxz]
    exact EReal.add_lt_top (mem_convexDom.1 hz).ne (EReal.coe_ne_top c)
  · rw [shiftFn_apply, Ne, EReal.add_eq_bot_iff]
    push Not
    exact ⟨hp.ne_bot (x + w), EReal.coe_ne_bot c⟩

end Defs

/-! ### The level-set description of `∂_ε f x` -/

section Level

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {r : ℝ}

/-- `∂_ε f x` is the set of linear functions minorizing `h + ε`, for `h` the translate
`w ↦ f (x + w) - f x`. -/
theorem epsSubdifferential_eq_supportSet (hr : f x = (r : EReal)) (ε : ℝ) :
    epsSubdifferential B ε f x = supportSet B (shiftFn f x (ε - r)) := by
  ext y
  simp only [mem_epsSubdifferential, mem_supportSet, shiftFn_apply, hr]
  constructor
  · intro h w
    have hw := h (x + w)
    rw [add_sub_cancel_left] at hw
    exact coe_add_le_add_coe_iff.1 hw
  · intro h z
    have hz := h (z - x)
    rw [show x + (z - x) = z from by abel] at hz
    exact coe_add_le_add_coe_iff.2 hz

/-- `∂_ε f x` is the level set `{y | h* y ≤ ε}`, here with the `ε` folded into the function so that
the level is `0`. -/
theorem epsSubdifferential_eq_setOf_convexConj_le (hr : f x = (r : EReal)) (ε : ℝ) :
    epsSubdifferential B ε f x = {y : F | convexConj B (shiftFn f x (ε - r)) y ≤ 0} := by
  rw [epsSubdifferential_eq_supportSet hr ε, supportSet_eq_setOf_convexConj_le]

/-- **`∂_ε f x` is convex**: it is a level set of the convex
function `h*`. -/
theorem convex_epsSubdifferential (hr : f x = (r : EReal)) (ε : ℝ) :
    Convex ℝ (epsSubdifferential B ε f x) := by
  rw [epsSubdifferential_eq_supportSet hr ε]
  exact convex_supportSet B _

end Level

section LevelClosed

variable {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
  [TopologicalSpace F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} [IsContinuousPairing B.flip] {f : E → EReal}
  {x : E} {r : ℝ}

/-- **`∂_ε f x` is closed**: it is a sublevel set of the lower
semicontinuous function `h*`. Continuity of the pairing is needed on the `F` side only, which is
where `∂_ε f x` lives. -/
theorem isClosed_epsSubdifferential (hr : f x = (r : EReal)) (ε : ℝ) :
    IsClosed (epsSubdifferential B ε f x) := by
  rw [epsSubdifferential_eq_supportSet hr ε]
  exact isClosed_supportSet (B := B.flip) _

end LevelClosed

/-! ### The directional derivative as a generated positively homogeneous function -/

section PosHom

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {f g h : E → EReal} {x : E} {r : ℝ}

/-- The generated positively homogeneous function is bounded by every rescaled value of `g`: this
is the half of the formula for `posHomGen` that needs neither convexity of `g` nor `v ≠ 0`. -/
theorem posHomGen_le_iInf_coe_mul (g : E → EReal) (v : E) :
    posHomGen g v ≤ ⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * g (a⁻¹ • v) := by
  refine le_iInf₂ fun a ha => ?_
  have ha' : (0 : ℝ) < a := ha
  have hhom := posHomogeneous_posHomGen g a ha' (a⁻¹ • v)
  rw [smul_smul, mul_inv_cancel₀ ha'.ne', one_smul] at hhom
  rw [hhom]
  exact (EReal.coe_mul_le_coe_mul_iff ha').2 (posHomGen_le g _)

/-- The infimum defining `posHomGen`, reindexed by `a ↦ a⁻¹` as a family of difference
quotients. -/
theorem iInf_coe_mul_eq_iInf_div (g : E → EReal) (v : E) :
    (⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * g (a⁻¹ • v))
      = ⨅ b ∈ Ioi (0 : ℝ), g (b • v) / (b : EReal) := by
  refine le_antisymm (le_iInf₂ fun b hb => ?_) (le_iInf₂ fun a ha => ?_)
  · have hb' : (0 : ℝ) < b := hb
    have key : ((b⁻¹ : ℝ) : EReal) * g ((b⁻¹)⁻¹ • v) = g (b • v) / (b : EReal) := by
      rw [inv_inv, coe_mul_eq_div_coe_inv, inv_inv]
    exact le_of_le_of_eq (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
      (c : EReal) * g (c⁻¹ • v)) b⁻¹ (mem_Ioi.2 (inv_pos.2 hb'))) key
  · have ha' : (0 : ℝ) < a := ha
    exact le_of_le_of_eq (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
      g (c • v) / (c : EReal)) a⁻¹ (mem_Ioi.2 (inv_pos.2 ha')))
      (coe_mul_eq_div_coe_inv a _).symm

/-- **The generated function** in difference-quotient form: away from
the origin, `posHomGen g v = inf {g (λ v) / λ | λ > 0}`. -/
theorem posHomGen_apply_eq_iInf_div (hg : ConvexFn g) {v : E} (hv : v ≠ 0) :
    posHomGen g v = ⨅ b ∈ Ioi (0 : ℝ), g (b • v) / (b : EReal) := by
  rw [← iInf_coe_mul_eq_iInf_div]
  exact posHomGen_apply_of_ne_zero hg hv

omit [Module ℝ E] in
/-- The shift written out: `shiftFn f x (-f x) w = f (x + w) - f x`. -/
theorem shiftFn_neg_apply (hr : f x = (r : EReal)) (w : E) :
    shiftFn f x (-r) w = f (x + w) - f x := by
  rw [shiftFn_apply, hr, EReal.coe_neg, ← sub_eq_add_neg]

/-- The rescaled values of the shift are exactly the difference quotients defining
`f'(x; ·)`; their infimum is therefore the directional derivative. -/
theorem iInf_coe_mul_shiftFn_neg (hr : f x = (r : EReal)) (v : E) :
    (⨅ a ∈ Ioi (0 : ℝ), (a : EReal) * shiftFn f x (-r) (a⁻¹ • v)) = dirDeriv f x v := by
  rw [iInf_coe_mul_eq_iInf_div, dirDeriv_apply]
  exact iInf_congr fun b => iInf_congr fun _ => by rw [shiftFn_neg_apply hr]

/-- The directional derivative is the positively homogeneous convex function generated by `h`:
`f'(x; ·) = posHomGen (f (x + ·) - f x)`. Both inequalities are maximality arguments. No topology,
and — unlike the book's own formula for `posHomGen` — no case distinction at `v = 0`. -/
theorem posHomGen_shiftFn (hf : ConvexFn f) (hr : f x = (r : EReal)) :
    posHomGen (shiftFn f x (-r)) = dirDeriv f x := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hle : dirDeriv f x ≤ shiftFn f x (-r) := by
    rw [Pi.le_def]
    intro w
    have hq := dirDeriv_le f x w one_pos
    rw [one_smul, EReal.coe_one, div_one] at hq
    rw [shiftFn_neg_apply hr]
    exact hq
  refine le_antisymm ?_ (le_posHomGen (posHomogeneous_dirDeriv f x) (convexFn_dirDeriv hf ht hb)
    (le_of_eq (dirDeriv_zero ht hb)) hle)
  rw [Pi.le_def]
  intro v
  exact (posHomGen_le_iInf_coe_mul _ v).trans (le_of_eq (iInf_coe_mul_shiftFn_neg hr v))

end PosHom

/-! ### The support functions of the ε-subdifferentials -/

section SupportFn

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E} {ε r : ℝ}

omit [NormedSpace ℝ E] [FiniteDimensional ℝ E] in
/-- A translate of a function with closed epigraph, raised by a constant, has closed epigraph:
the epigraph is the preimage of `epi f` under a homeomorphism of `E × ℝ`. -/
theorem isClosed_epi_shiftFn (hc : IsClosed (epi f)) (x : E) (c : ℝ) :
    IsClosed (epi (shiftFn f x c)) := by
  have hpre : epi (shiftFn f x c) = (fun p : E × ℝ => (x + p.1, p.2 - c)) ⁻¹' epi f := by
    ext p
    simp only [Set.mem_preimage, mem_epi, shiftFn_apply]
    exact EReal.add_coe_le_coe_iff
  rw [hpre]
  exact hc.preimage ((continuous_const.add continuous_fst).prodMk
    (continuous_snd.sub continuous_const))

omit [NormedSpace ℝ E] [FiniteDimensional ℝ E] in
/-- The value of `h + ε` at the origin is `ε`. -/
theorem shiftFn_sub_apply_zero (hr : f x = (r : EReal)) (ε : ℝ) :
    shiftFn f x (ε - r) 0 = (ε : EReal) := by
  rw [shiftFn_zero hr, show r + (ε - r) = ε from by ring]

/-- For `ε > 0` the positively homogeneous convex function generated by `h + ε` is already closed,
because `h + ε` is finite and *positive* at the origin. This removes the closure from the
support-function identity below, and is the only place finite dimension is used. -/
theorem closedConvex_posHomGen_shiftFn (hf : ConvexFn f) (hp : ProperConvex f)
    (hc : IsClosed (epi f))
    (hr : f x = (r : EReal)) (hε : 0 < ε) :
    ClosedConvex (posHomGen (shiftFn f x (ε - r))) := by
  have hgc : ConvexFn (shiftFn f x (ε - r)) := convexFn_shiftFn hf x _
  have hgp : ProperConvex (shiftFn f x (ε - r)) := properConvex_shiftFn hp x _
  have hge : IsClosed (epi (shiftFn f x (ε - r))) := isClosed_epi_shiftFn hc x _
  have hg0 := shiftFn_sub_apply_zero hr ε
  have h0 : 0 < shiftFn f x (ε - r) 0 := by
    rw [hg0]
    exact_mod_cast hε
  have hdom : shiftFn f x (ε - r) 0 ≠ ⊤ := by
    rw [hg0]
    exact EReal.coe_ne_top ε
  have hproper := properConvex_posHomGen hgc hgp hge h0
  have hlsc := lscHull_posHomGen_eq hgc hgp hge h0 hdom
  have hcl : convexCl (posHomGen (shiftFn f x (ε - r))) = posHomGen (shiftFn f x (ε - r)) := by
    rw [convexCl_of_forall_ne_bot fun y => by rw [hlsc]; exact hproper.ne_bot y, hlsc]
  exact hcl

/-- For `ε > 0` the support function of `∂_ε f x` *is* the positively homogeneous convex function
generated by `h + ε`, with no closure operation, by the previous lemma. -/
theorem supportFn_epsSubdifferential [IsCompatiblePairing B] (hf : ConvexFn f) (hp : ProperConvex f)
    (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (hε : 0 < ε) :
    supportFn B.flip (epsSubdifferential B ε f x) = posHomGen (shiftFn f x (ε - r)) := by
  rw [epsSubdifferential_eq_setOf_convexConj_le hr ε]
  exact supportFn_setOf_convexConj_le_zero (B := B.flip)
    (closedConvex_posHomGen_shiftFn hf hp hc hr hε)

/-- **The explicit formula**:
`δ*(y | ∂_ε f x) = inf {(f (x + λ y) - f x + ε) / λ | λ > 0}`. -/
theorem supportFn_epsSubdifferential_apply [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f)
    (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (hε : 0 < ε) {v : E} (hv : v ≠ 0) :
    supportFn B.flip (epsSubdifferential B ε f x) v
      = ⨅ b ∈ Ioi (0 : ℝ), (f (x + b • v) - f x + (ε : EReal)) / (b : EReal) := by
  rw [supportFn_epsSubdifferential hf hp hc hr hε,
    posHomGen_apply_eq_iInf_div (convexFn_shiftFn hf x _) hv]
  refine iInf_congr fun b => iInf_congr fun _ => ?_
  rw [shiftFn_apply, hr, show (ε - r : ℝ) = -r + ε from by ring, EReal.coe_add,
    EReal.coe_neg, ← add_assoc, ← sub_eq_add_neg]

/-- The support functions of the ε-subdifferentials decrease, as `ε ↓ 0`, to the directional
derivative — *not* merely to its closure `δ*(· | ∂f x)`. Both inequalities are read off
`posHomGen`, letting `ε ↓ 0` inside the rescaling to leave the difference quotients that define
`f'(x; ·)`. -/
theorem dirDeriv_eq_iInf_supportFn_epsSubdifferential [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f) (hc : IsClosed (epi f)) (hr : f x = (r : EReal)) (v : E) :
    ⨅ ε ∈ Ioi (0 : ℝ), supportFn B.flip (epsSubdifferential B ε f x) v = dirDeriv f x v := by
  have hval : ∀ δ ∈ Ioi (0 : ℝ), supportFn B.flip (epsSubdifferential B δ f x) v
      = posHomGen (shiftFn f x (δ - r)) v := fun δ hδ => by
    have hδ' : (0 : ℝ) < δ := hδ
    rw [supportFn_epsSubdifferential hf hp hc hr hδ']
  refine (iInf_congr fun δ => iInf_congr fun hδ => hval δ hδ).trans (le_antisymm ?_ ?_)
  · rw [← iInf_coe_mul_shiftFn_neg hr v]
    refine le_iInf₂ fun a ha => ?_
    have ha' : (0 : ℝ) < a := ha
    have hinner : shiftFn f x (-r) (a⁻¹ • v)
        = ⨅ δ ∈ Ioi (0 : ℝ), shiftFn f x (δ - r) (a⁻¹ • v) := by
      simp only [shiftFn_apply]
      exact (iInf_add_sub_pos_coe _ r).symm
    rw [hinner, EReal.coe_mul_iInf ha']
    refine le_iInf fun δ => ?_
    rw [EReal.coe_mul_iInf ha']
    refine le_iInf fun hδ => ?_
    exact le_trans (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
        posHomGen (shiftFn f x (c - r)) v) δ hδ)
      ((posHomGen_le_iInf_coe_mul (shiftFn f x (δ - r)) v).trans
        (iInf₂_le (f := fun (c : ℝ) (_ : c ∈ Ioi (0 : ℝ)) =>
          (c : EReal) * shiftFn f x (δ - r) (c⁻¹ • v)) a ha))
  · refine le_iInf₂ fun δ hδ => ?_
    have hδ' : (0 : ℝ) < δ := hδ
    have hmono : shiftFn f x (-r) ≤ shiftFn f x (δ - r) := by
      rw [Pi.le_def]
      intro w
      have hle : ((-r : ℝ) : EReal) ≤ ((δ - r : ℝ) : EReal) := by
        exact_mod_cast (by linarith : -r ≤ δ - r)
      exact add_le_add (le_refl (f (x + w))) hle
    have hstep := posHomGen_mono hmono v
    rwa [posHomGen_shiftFn hf hr] at hstep

end SupportFn

end ConvexAnalysis
