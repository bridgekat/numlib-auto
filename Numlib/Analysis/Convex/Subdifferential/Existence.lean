import Numlib.Analysis.Convex.Duality.Polar
import Numlib.Analysis.Convex.Duality.SupportRelint
import Numlib.Analysis.Convex.Polyhedral.Conjugate
import Numlib.Analysis.Convex.Recession.ConeHull
import Numlib.Analysis.Convex.RelativeInterior
import Numlib.Analysis.Convex.Subdifferential.Defs

/-!
# Existence of subgradients

Let $E$ be a finite-dimensional real normed space paired with a real vector space $F$, and let
$f : E \to [-\infty, +\infty]$ be convex. A proper convex function has a subgradient at every point
of the relative interior $\operatorname{ri}(\operatorname{dom} f)$ of its effective domain, and a
polyhedral convex function has a subgradient at every point where it is finite. In both cases the
directional derivative $f'(x; \cdot)$ is equal to the support function of $\partial f(x)$, not only
its closure. The presentation follows [rockafellar1970convex], §23.

For every convex $f$ that is finite at $x$, $\operatorname{cl} f'(x; \cdot) = \delta^*(\cdot \mid
\partial f(x))$ (`ConvexAnalysis.convexCl_dirDeriv`). So both existence theorems reduce to one
question: is $f'(x; \cdot)$ closed? At a point of $\operatorname{ri}(\operatorname{dom} f)$, the
effective domain of $f'(x; \cdot)$ is the subspace parallel to the affine hull of
$\operatorname{dom} f$, and a proper convex function whose effective domain is an affine set is
closed. For polyhedral $f$, the epigraph of $f'(x; \cdot)$ is the convex cone generated by
$\operatorname{epi} f - (x, f(x))$, which is polyhedral and therefore closed. When $f'(x; \cdot)$ is
closed, $\partial f(x)$ is nonempty: the support function of the empty set is the constant
$-\infty$, but $f'(x; 0) = 0$. The module also proves that the normal cone to the level set
$\{z \mid f(z) \le f(x)\}$ is the closed convex cone generated by $\partial f(x)$, and that where
$f$ has no subgradient, $f'(x; \cdot)$ is $-\infty$ in every direction that points into
$\operatorname{ri}(\operatorname{dom} f)$.

## Main results

* `ConvexAnalysis.dirDeriv_eq_supportFn_of_mem_relint_convexDom`,
  `ConvexAnalysis.subdifferential_nonempty_of_mem_relint_convexDom`: at
  $x \in \operatorname{ri}(\operatorname{dom} f)$, $f'(x; \cdot) = \delta^*(\cdot \mid \partial
  f(x))$ and $\partial f(x) \ne \emptyset$. This is Theorem 23.4 of [rockafellar1970convex].
* `ConvexAnalysis.bddAbove_subdifferential_iff_mem_interior_convexDom`: at
  $x \in \operatorname{ri}(\operatorname{dom} f)$, $\partial f(x)$ is bounded exactly when
  $x \in \operatorname{int}(\operatorname{dom} f)$. This is the last assertion of Theorem 23.4 of
  [rockafellar1970convex].
* `ConvexAnalysis.dirDeriv_eq_supportFn_of_polyhedralFn`,
  `ConvexAnalysis.subdifferential_nonempty_of_polyhedralFn`,
  `ConvexAnalysis.polyhedral_subdifferential_of_polyhedralFn`: for polyhedral convex $f$ finite at
  $x$, $f'(x; \cdot) = \delta^*(\cdot \mid \partial f(x))$, and $\partial f(x)$ is a nonempty
  polyhedral convex set. This is Theorem 23.10 of [rockafellar1970convex].
* `ConvexAnalysis.normalCone_setOf_le_eq_closure_coe_hull_subdifferential`: if
  $\partial f(x) \ne \emptyset$ and $f(x) > \inf f$, the normal cone to $\{z \mid f(z) \le f(x)\}$
  at $x$ is the closure of the convex cone generated by $\partial f(x)$.
  `ConvexAnalysis.normalCone_setOf_le_eq_coe_hull_subdifferential` removes the closure when
  $\partial f(x)$ is bounded.
* `ConvexAnalysis.mem_interior_of_normalCone_eq_zero`: a convex set is a neighbourhood of every
  point of it at which its normal cone is $\{0\}$.
* `ConvexAnalysis.subdifferential_eq_empty_iff_exists_dirDeriv_eq_bot`: for convex $f$ finite at
  $x$, $\partial f(x) = \emptyset$ exactly when $f'(x; y) = -\infty$ for some $y$.

## Implementation notes

* The two existence theorems share their last two steps,
  `ConvexAnalysis.dirDeriv_eq_supportFn_of_closedConvex` and
  `ConvexAnalysis.subdifferential_nonempty_of_closedConvex_dirDeriv`. Both take closedness of
  $f'(x; \cdot)$ as a hypothesis, and only the proof of that hypothesis differs between the two
  theorems.
* Most results assume that the pairing is compatible with the topology of $E$
  (`ConvexAnalysis.IsCompatiblePairing`): every $\langle \cdot, y \rangle$ is continuous on $E$, and
  every continuous linear functional on $E$ has this form.
* The convex cone generated by a set $S$ is `PointedCone.hull ℝ S`, which contains the origin.
-/

open Set
open scoped Pointwise

namespace ConvexAnalysis

/-! ### The epigraph of the directional derivative as a cone -/

section EpiCone

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {f : E → EReal} {x : E} {r : ℝ}

/-- Let $f : E \to [-\infty, +\infty]$ be convex, and let $f(x) = r$ be real. Then the convex cone
generated by $\operatorname{epi} f - (x, r)$, with the origin, lies in
$\operatorname{epi} f'(x; \cdot)$.

The generators lie in it because $f'(x; z - x) \le f(z) - f(x)$, and the epigraph of a
positively homogeneous convex function is a cone. -/
theorem coe_hull_epi_sub_subset_epi_dirDeriv (hf : ConvexFn f) (hr : f x = (r : EReal)) :
    (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) ⊆ epi (dirDeriv f x) := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hisCone : ∀ a : ℝ, 0 < a → a • epi (dirDeriv f x) = epi (dirDeriv f x) :=
    (posHomogeneous_iff_isCone_epi (f := dirDeriv f x)).1 (posHomogeneous_dirDeriv f x)
  have hadd : ∀ p ∈ epi (dirDeriv f x), ∀ q ∈ epi (dirDeriv f x), p + q ∈ epi (dirDeriv f x) :=
    (convex_iff_add_mem_of_isCone (isCone_iff_smul_eq.2 hisCone)).1
      (convexFn_dirDeriv hf ht hb).convex_epi
  have hzero : (0 : E × ℝ) ∈ epi (dirDeriv f x) := by
    change dirDeriv f x (0 : E × ℝ).1 ≤ (((0 : E × ℝ).2 : ℝ) : EReal)
    simp [dirDeriv_zero ht hb]
  have hsmul : ∀ a : ℝ, 0 ≤ a → ∀ w ∈ epi (dirDeriv f x), a • w ∈ epi (dirDeriv f x) := by
    intro a ha w hw
    rcases eq_or_lt_of_le ha with h | h
    · rw [← h, zero_smul]; exact hzero
    · rw [← hisCone a h]; exact Set.smul_mem_smul_set hw
  intro w hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨p, hp, q, hq, hpq⟩ := hw
      rw [Set.mem_singleton_iff] at hq
      subst hq
      have hpq' : p - (x, r) = w := hpq
      have hfp : f p.1 ≤ ((p.2 : ℝ) : EReal) := hp
      have h1 : dirDeriv f x (p.1 - x)
          ≤ (f (x + (1 : ℝ) • (p.1 - x)) - f x) / ((1 : ℝ) : EReal) := dirDeriv_le f x _ one_pos
      have hx1 : x + (1 : ℝ) • (p.1 - x) = p.1 := by module
      rw [hx1, hr] at h1
      have h2 : (f p.1 - (r : EReal)) / ((1 : ℝ) : EReal) ≤ ((p.2 - r : ℝ) : EReal) := by
        rw [EReal.sub_div_le_coe_iff one_pos]
        have hc : (r + (p.2 - r) * 1 : ℝ) = p.2 := by ring
        rw [hc]
        exact hfp
      rw [← hpq']
      change dirDeriv f x (p - (x, r)).1 ≤ (((p - (x, r)).2 : ℝ) : EReal)
      simpa using h1.trans h2
  | zero => exact hzero
  | add w₁ w₂ _ _ ih₁ ih₂ => exact hadd w₁ ih₁ w₂ ih₂
  | smul c w _ ih => exact hsmul (c : ℝ) c.2 w ih

end EpiCone

section EpiConeClosed

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : E → EReal} {x : E} {r : ℝ}

/-- Let $E$ be a real normed space, let $f : E \to [-\infty, +\infty]$ be convex, and let $f(x) = r$
be real. If the convex cone $K$ generated by $\operatorname{epi} f - (x, r)$ is closed, then
$\operatorname{epi} f'(x; \cdot) \subseteq K$.

Only this inclusion needs closedness, and closedness cannot be dropped. For $f(y) = y^2$ at
$x = 0$, the cone $K$ is the open upper half-plane together with the origin, while
$\operatorname{epi} f'(0; \cdot)$ is the closed upper half-plane. For polyhedral $f$ the cone is
finitely generated, hence closed. -/
theorem epi_dirDeriv_subset_coe_hull (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hK : IsClosed (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))) :
    epi (dirDeriv f x) ⊆ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) := by
  intro w hw
  have hle : dirDeriv f x w.1 ≤ ((w.2 : ℝ) : EReal) := hw
  have hcont : Continuous fun t : ℝ => ((w.1, t) : E × ℝ) := by fun_prop
  have hsec : IsClosed {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} :=
    hK.preimage hcont
  have hsub : Set.Ioi w.2 ⊆ {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} := by
    intro t ht
    have hlt : dirDeriv f x w.1 < (t : EReal) :=
      lt_of_le_of_lt hle (by exact_mod_cast (ht : w.2 < t))
    obtain ⟨a, ha, hbound⟩ := exists_le_of_dirDeriv_lt hf hr hlt
    have hmem : ((x + a • w.1, r + t * a) : E × ℝ) ∈ epi f := hbound a ha le_rfl
    have hmem2 : ((a • w.1, t * a) : E × ℝ) ∈ epi f - {((x, r) : E × ℝ)} := by
      refine ⟨(x + a • w.1, r + t * a), hmem, (x, r), rfl, ?_⟩
      have h : ((x + a • w.1, r + t * a) : E × ℝ) - (x, r) = (a • w.1, t * a) := by
        rw [Prod.mk_sub_mk, add_sub_cancel_left, add_sub_cancel_left]
      exact h
    have hscal := Submodule.smul_mem (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}))
      (⟨a⁻¹, le_of_lt (inv_pos.2 ha)⟩ : {c : ℝ // 0 ≤ c}) (PointedCone.subset_hull hmem2)
    have heq : (a⁻¹ : ℝ) • ((a • w.1, t * a) : E × ℝ) = (w.1, t) := by
      rw [Prod.smul_mk, smul_smul, inv_mul_cancel₀ ha.ne', one_smul, smul_eq_mul]
      congr 1
      field_simp
    have hfin : (a⁻¹ : ℝ) • ((a • w.1, t * a) : E × ℝ)
        ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) := hscal
    rw [heq] at hfin
    exact hfin
  have hclos := hsec.closure_subset_iff.2 hsub
  rw [closure_Ioi] at hclos
  have hmem : w.2 ∈ {t : ℝ |
      ((w.1, t) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))} :=
    hclos (by simp)
  simpa using hmem

/-- Let $E$ be a real normed space, let $f$ be convex, and let $f(x) = r$ be real. If the convex
cone generated by $\operatorname{epi} f - (x, r)$ is closed, then it is equal to
$\operatorname{epi} f'(x; \cdot)$. -/
theorem epi_dirDeriv_eq_coe_hull (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hK : IsClosed (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ))) :
    epi (dirDeriv f x) = (PointedCone.hull ℝ (epi f - {((x, r) : E × ℝ)}) : Set (E × ℝ)) :=
  subset_antisymm (epi_dirDeriv_subset_coe_hull hf hr hK)
    (coe_hull_epi_sub_subset_epi_dirDeriv hf hr)

end EpiConeClosed

/-! ### The common last step: a closed directional derivative -/

section Closed

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- **Removal of the closure.** Let the pairing be compatible with the topology of the normed space
$E$, let $f$ be convex, and let $f(x)$ be finite. If $f'(x; \cdot)$ is closed, then it is the
support function of $\partial f(x)$:
$$f'(x; v) = \sup_{y \in \partial f(x)} \langle v, y \rangle \quad \text{for all } v \in E.$$
This is the last step of both existence theorems. -/
theorem dirDeriv_eq_supportFn_of_closedConvex [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hcl : ClosedConvex (dirDeriv f x)) :
    dirDeriv f x = supportFn B.flip (subdifferential B f x) :=
  hcl.symm.trans (convexCl_dirDeriv hf ht hb)

/-- **Subgradients from closedness.** Let the pairing be compatible with the topology of the normed
space $E$, let $f$ be convex, and let $f(x)$ be finite. If $f'(x; \cdot)$ is closed, then
$\partial f(x)$ is nonempty.

The support function of the empty set is the constant $-\infty$, but $f'(x; 0) = 0$. -/
theorem subdifferential_nonempty_of_closedConvex_dirDeriv [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hcl : ClosedConvex (dirDeriv f x)) :
    (subdifferential B f x).Nonempty := by
  rcases Set.eq_empty_or_nonempty (subdifferential B f x) with he | hne
  · exfalso
    have hEq := dirDeriv_eq_supportFn_of_closedConvex (B := B) hf ht hb hcl
    rw [he, supportFn_empty] at hEq
    have h0 := congrFun hEq 0
    rw [dirDeriv_zero ht hb] at h0
    exact absurd h0 (by simp)
  · exact hne

end Closed

/-! ### Subgradients on the relative interior -/

section Relint

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

omit [FiniteDimensional ℝ E] in
/-- Let $f$ be convex and $f(x)$ finite. Then the effective domain of $f'(x; \cdot)$ lies in the
linear subspace parallel to the affine hull of $\operatorname{dom} f$.

A direction along which some difference quotient is finite points from $x$ into
$\operatorname{dom} f$. Unlike the reverse inclusion, this needs nothing of $x$ except that
$f(x)$ is finite. -/
theorem convexDom_dirDeriv_subset_direction (hf : ConvexFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    convexDom (dirDeriv f x) ⊆ ((affineSpan ℝ (convexDom f)).direction : Set E) := by
  have hxdom : x ∈ convexDom f := mem_convexDom.2 (lt_top_iff_ne_top.2 ht)
  have hxaff : x ∈ affineSpan ℝ (convexDom f) := subset_affineSpan ℝ (convexDom f) hxdom
  obtain ⟨r, hr⟩ := EReal.exists_coe_of_ne_bot_of_lt_top hb (mem_convexDom.1 hxdom)
  intro y hy
  obtain ⟨m, hm, -⟩ := EReal.lt_iff_exists_real_btwn.1 (mem_convexDom.1 hy)
  obtain ⟨a, ha, hbound⟩ := exists_le_of_dirDeriv_lt hf hr hm
  have hmem : x + a • y ∈ convexDom f :=
    mem_convexDom.2 (lt_of_le_of_lt (hbound a ha le_rfl) (EReal.coe_lt_top _))
  have hvs : (x + a • y) - x ∈ (affineSpan ℝ (convexDom f)).direction :=
    AffineSubspace.vsub_mem_direction (subset_affineSpan ℝ (convexDom f) hmem) hxaff
  have hay : a • y ∈ (affineSpan ℝ (convexDom f)).direction := by
    have h : (x + a • y) - x = a • y := by abel
    rwa [h] at hvs
  have hfinal := Submodule.smul_mem _ (a⁻¹ : ℝ) hay
  rwa [smul_smul, inv_mul_cancel₀ ha.ne', one_smul] at hfinal

omit [FiniteDimensional ℝ E] in
/-- Let $f$ be proper and convex, and let $x \in \operatorname{ri}(\operatorname{dom} f)$. Then the
effective domain of $f'(x; \cdot)$ is the linear subspace parallel to the affine hull of
$\operatorname{dom} f$.

This is the first step of the proof of
`ConvexAnalysis.subdifferential_nonempty_of_mem_relint_convexDom`. Both inclusions are
elementary: a direction along which a difference quotient is finite points from $x$ into
$\operatorname{dom} f$, and a point of the relative interior can be moved a little in any
direction of the affine hull without leaving $\operatorname{dom} f$. -/
theorem convexDom_dirDeriv_of_mem_relint_convexDom (hf : ConvexFn f) (hp : ProperConvex f)
    (hx : x ∈ ri (convexDom f)) :
    convexDom (dirDeriv f x) = ((affineSpan ℝ (convexDom f)).direction : Set E) := by
  obtain ⟨hxaff, ε, hε, hball⟩ := mem_intrinsicInterior_iff.1 hx
  have hxdom : x ∈ convexDom f := intrinsicInterior_subset hx
  obtain ⟨r, hr⟩ :=
    EReal.exists_coe_of_ne_bot_of_lt_top (hp.ne_bot x) (mem_convexDom.1 hxdom)
  refine Set.Subset.antisymm
    (convexDom_dirDeriv_subset_direction hf (mem_convexDom.1 hxdom).ne (hp.ne_bot x)) fun y hy => ?_
  · have hyd : y ∈ (affineSpan ℝ (convexDom f)).direction := hy
    set a : ℝ := ε / (‖y‖ + 1) with hadef
    have hpos : 0 < a := by positivity
    have hnorm : ‖a • y‖ < ε := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hpos, hadef, div_mul_eq_mul_div]
      rw [div_lt_iff₀ (by positivity)]
      nlinarith [norm_nonneg y, hε]
    have haff : x + a • y ∈ affineSpan ℝ (convexDom f) := by
      have h := AffineSubspace.vadd_mem_of_mem_direction
        (Submodule.smul_mem _ a hyd) hxaff
      have he : (a • y) +ᵥ x = x + a • y := by
        rw [vadd_eq_add]; abel
      rwa [he] at h
    have hdist : dist (x + a • y) x < ε := by
      rw [dist_eq_norm]
      have h : (x + a • y) - x = a • y := by abel
      rwa [h]
    have hmem : x + a • y ∈ convexDom f := hball _ haff hdist
    obtain ⟨c, hc, -⟩ := EReal.lt_iff_exists_real_btwn.1 (mem_convexDom.1 hmem)
    refine mem_convexDom.2 (lt_of_le_of_lt (dirDeriv_le f x y hpos) ?_)
    rw [hr]
    have hbound : (f (x + a • y) - (r : EReal)) / ((a : ℝ) : EReal)
        ≤ (((c - r) / a : ℝ) : EReal) := by
      rw [EReal.sub_div_le_coe_iff hpos]
      have hcc : (r + (c - r) / a * a : ℝ) = c := by
        rw [div_mul_cancel₀ _ hpos.ne']; ring
      rw [hcc]
      exact hc.le
    exact lt_of_le_of_lt hbound (EReal.coe_lt_top _)

omit [FiniteDimensional ℝ E] in
/-- Let $f$ be proper and convex, and let $x \in \operatorname{ri}(\operatorname{dom} f)$. Then
$f'(x; \cdot)$ is proper.

This is the second step. The effective domain of $f'(x; \cdot)$ is a subspace, hence relatively
open, so a value $-\infty$ anywhere would spread over all of it, also to the origin, where
$f'(x; 0) = 0$. The relative interior is essential: for $f(y) = -\sqrt{y}$ on $[0, \infty)$ and
$+\infty$ elsewhere, $f'(0; y) = -\infty$ for every $y > 0$, while $f'(0; 0) = 0$. -/
theorem properConvex_dirDeriv_of_mem_relint_convexDom (hf : ConvexFn f) (hp : ProperConvex f)
    (hx : x ∈ ri (convexDom f)) : ProperConvex (dirDeriv f x) := by
  have hxdom : x ∈ convexDom f := intrinsicInterior_subset hx
  have ht : f x ≠ ⊤ := (mem_convexDom.1 hxdom).ne
  have hb : f x ≠ ⊥ := hp.ne_bot x
  have hdom := convexDom_dirDeriv_of_mem_relint_convexDom hf hp hx
  have h0 : (0 : E) ∈ convexDom (dirDeriv f x) := by
    rw [mem_convexDom, dirDeriv_zero ht hb]; exact EReal.zero_lt_top
  by_contra hcon
  have hopen : ri (convexDom (dirDeriv f x)) = convexDom (dirDeriv f x) := by
    have h := AffineSubspace.intrinsicInterior_coe
      (((affineSpan ℝ (convexDom f)).direction : Submodule ℝ E).toAffineSubspace)
    rw [hdom]
    exact h
  have hbot := (convexFn_dirDeriv hf ht hb).eq_bot_of_mem_relint_convexDom hcon
    (by rw [hopen]; exact h0)
  rw [dirDeriv_zero ht hb] at hbot
  exact absurd hbot (by simp)

/-- Let $E$ be finite-dimensional, let $f$ be proper and convex, and let
$x \in \operatorname{ri}(\operatorname{dom} f)$. Then $f'(x; \cdot)$ is closed.

This is the third step: a proper convex function whose effective domain is an affine set is
closed. -/
theorem closedConvex_dirDeriv_of_mem_relint_convexDom (hf : ConvexFn f) (hp : ProperConvex f)
    (hx : x ∈ ri (convexDom f)) : ClosedConvex (dirDeriv f x) := by
  have hxdom : x ∈ convexDom f := intrinsicInterior_subset hx
  refine (convexFn_dirDeriv
      hf (mem_convexDom.1 hxdom).ne (hp.ne_bot x)).closedConvex_of_convexDom_eq_coe
    (properConvex_dirDeriv_of_mem_relint_convexDom hf hp hx)
    (M := ((affineSpan ℝ (convexDom f)).direction : Submodule ℝ E).toAffineSubspace) ?_
  rw [convexDom_dirDeriv_of_mem_relint_convexDom hf hp hx]
  rfl

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, let $f : E \to [-\infty, +\infty]$ be proper and convex, and let
$x \in \operatorname{ri}(\operatorname{dom} f)$. Then the directional derivative is the support
function of the subdifferential:
$$f'(x; v) = \sup_{y \in \partial f(x)} \langle v, y \rangle \quad \text{for all } v \in E.$$

This is part of Theorem 23.4 of [rockafellar1970convex]. The support function is
`ConvexAnalysis.supportFn` for the flipped pairing `B.flip`. Compatibility is
`ConvexAnalysis.IsCompatiblePairing`. -/
theorem dirDeriv_eq_supportFn_of_mem_relint_convexDom [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f) (hx : x ∈ ri (convexDom f)) :
    dirDeriv f x = supportFn B.flip (subdifferential B f x) := by
  have hxdom : x ∈ convexDom f := intrinsicInterior_subset hx
  exact dirDeriv_eq_supportFn_of_closedConvex hf (mem_convexDom.1 hxdom).ne (hp.ne_bot x)
    (closedConvex_dirDeriv_of_mem_relint_convexDom hf hp hx)

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, and let $f : E \to [-\infty, +\infty]$ be proper and convex. Then $f$ has a
subgradient at every point of $\operatorname{ri}(\operatorname{dom} f)$:
$\partial f(x) \ne \emptyset$.

This is part of Theorem 23.4 of [rockafellar1970convex]. Compatibility is
`ConvexAnalysis.IsCompatiblePairing`. -/
theorem subdifferential_nonempty_of_mem_relint_convexDom [IsCompatiblePairing B] (hf : ConvexFn f)
    (hp : ProperConvex f) (hx : x ∈ ri (convexDom f)) : (subdifferential B f x).Nonempty := by
  have hxdom : x ∈ convexDom f := intrinsicInterior_subset hx
  exact subdifferential_nonempty_of_closedConvex_dirDeriv
      hf (mem_convexDom.1 hxdom).ne (hp.ne_bot x)
    (closedConvex_dirDeriv_of_mem_relint_convexDom hf hp hx)

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, and let $g : E \to [-\infty, +\infty]$ be proper and concave. Then $g$ has a
supergradient at every point $x$ of the relative interior of $\{z \mid g(z) > -\infty\}$: the
superdifferential of $g$ at $x$ is nonempty.

This is the concave counterpart of
`ConvexAnalysis.subdifferential_nonempty_of_mem_relint_convexDom`. The effective domain of a
concave function is `ConvexAnalysis.concaveDom`. -/
theorem superdifferential_nonempty_of_mem_relint_concaveDom [IsCompatiblePairing B]
    {g : E → EReal} (hg : ConcaveFn g) (hp : ProperConcave g) (hx : x ∈ ri (concaveDom g)) :
    (superdifferential B g x).Nonempty := by
  rw [concaveDom_eq_convexDom_neg] at hx
  obtain ⟨y, hy⟩ := subdifferential_nonempty_of_mem_relint_convexDom (B := B) hg.convexFn_neg
    hp.properConvex_neg hx
  exact ⟨-y, neg_mem_superdifferential_iff.2 hy⟩

/-- Let $E$ be finite-dimensional, let $f$ be proper and convex, and let
$x \in \operatorname{ri}(\operatorname{dom} f)$. Then $f'(x; \cdot)$ is finite everywhere, that
is, its effective domain is $E$, if and only if
$x \in \operatorname{int}(\operatorname{dom} f)$. -/
theorem convexDom_dirDeriv_eq_univ_iff_mem_interior_convexDom (hf : ConvexFn f)
    (hp : ProperConvex f)
    (hx : x ∈ ri (convexDom f)) : convexDom (dirDeriv f x) = univ ↔ x ∈ interior (convexDom f) := by
  have hxaff : x ∈ affineSpan ℝ (convexDom f) :=
      subset_affineSpan ℝ (convexDom f) (intrinsicInterior_subset hx)
  have hdom := convexDom_dirDeriv_of_mem_relint_convexDom hf hp hx
  constructor
  · intro huniv
    have hdir : ((affineSpan ℝ (convexDom f)).direction : Set E) = univ := by rw [← hdom, huniv]
    have htop : affineSpan ℝ (convexDom f) = ⊤ := by
      refine eq_top_iff.2 fun z _ => ?_
      have hz : z - x ∈ (affineSpan ℝ (convexDom f)).direction := by
        rw [← SetLike.mem_coe, hdir]; trivial
      have h := AffineSubspace.vadd_mem_of_mem_direction hz hxaff
      have he : (z - x) +ᵥ x = z := by rw [vadd_eq_add]; abel
      rwa [he] at h
    rw [← intrinsicInterior_eq_interior htop]
    exact hx
  · intro hint
    have htop : affineSpan ℝ (convexDom f) = ⊤ :=
      (Convex.interior_nonempty_iff_affineSpan_eq_top hf.convex_convexDom).1 ⟨x, hint⟩
    rw [hdom, htop, AffineSubspace.direction_top]
    exact Submodule.top_coe

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, let $f : E \to [-\infty, +\infty]$ be proper and convex, and let
$x \in \operatorname{ri}(\operatorname{dom} f)$. Then $\partial f(x)$ is bounded in the sense of
the pairing, that is, for every $v \in E$ there is $c$ with $\langle v, y \rangle \le c$ for all
$y \in \partial f(x)$, if and only if $x \in \operatorname{int}(\operatorname{dom} f)$.

This is the last assertion of Theorem 23.4 of [rockafellar1970convex]. Boundedness in the sense
of the norm, when $F$ is a finite-dimensional normed space, is
`ConvexAnalysis.isBounded_subdifferential_iff_mem_interior_convexDom`. -/
theorem bddAbove_subdifferential_iff_mem_interior_convexDom [IsCompatiblePairing B]
    (hf : ConvexFn f)
    (hp : ProperConvex f) (hx : x ∈ ri (convexDom f)) :
    (∀ v : E, ∃ c : ℝ, ∀ y ∈ subdifferential B f x, B v y ≤ c) ↔ x ∈ interior (convexDom f) := by
  rw [← convexDom_dirDeriv_eq_univ_iff_mem_interior_convexDom hf hp hx,
    dirDeriv_eq_supportFn_of_mem_relint_convexDom (B := B) hf hp hx]
  constructor
  · intro h
    refine eq_univ_of_forall fun v => ?_
    exact mem_convexDom.2 (supportFn_lt_top_iff.2 (h v))
  · intro h v
    exact supportFn_lt_top_iff.1 (mem_convexDom.1 (h ▸ Set.mem_univ v))

/-! ### Points without a subgradient -/

omit [FiniteDimensional ℝ E] in
/-- If $f(x) \ne -\infty$ and $z \in \operatorname{dom} f$, then $z - x$ lies in the effective
domain of $f'(x; \cdot)$. The difference quotient with step $1$ is $f(z) - f(x) < +\infty$. -/
theorem sub_mem_convexDom_dirDeriv (hb : f x ≠ ⊥) {z : E} (hz : z ∈ convexDom f) :
    z - x ∈ convexDom (dirDeriv f x) := by
  refine mem_convexDom.2 (dirDeriv_lt_iff.2 ⟨1, one_pos, ?_⟩)
  rw [one_smul, show x + (z - x) = z from by abel, EReal.coe_one, div_one, sub_eq_add_neg]
  exact EReal.add_lt_top (mem_convexDom.1 hz).ne
    (by rw [Ne, EReal.neg_eq_top_iff]; exact hb)

/-- Let $f$ be convex and $f(x)$ finite. If $z \in \operatorname{ri}(\operatorname{dom} f)$, then
$z - x$ lies in the relative interior of the effective domain of $f'(x; \cdot)$.

This is the geometric core of `ConvexAnalysis.dirDeriv_eq_bot_of_subdifferential_eq_empty`. The
proof uses the prolongation criterion for relative interiors. -/
theorem sub_mem_relint_convexDom_dirDeriv (hf : ConvexFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) {z : E}
    (hz : z ∈ ri (convexDom f)) : z - x ∈ ri (convexDom (dirDeriv f x)) := by
  have hconv : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  have h0 : (0 : E) ∈ convexDom (dirDeriv f x) :=
    mem_convexDom.2 (by rw [dirDeriv_zero ht hb]; exact EReal.zero_lt_top)
  have hxaff : x ∈ affineSpan ℝ (convexDom f) :=
    subset_affineSpan ℝ (convexDom f) (mem_convexDom.2 (lt_top_iff_ne_top.2 ht))
  refine (Convex.mem_relint_iff_prolong hconv.convex_convexDom ⟨0, h0⟩).2 fun w hw => ?_
  have hxw : x + w ∈ affineSpan ℝ (convexDom f) := by
    have h := AffineSubspace.vadd_mem_of_mem_direction
      (convexDom_dirDeriv_subset_direction hf ht hb hw) hxaff
    rwa [show w +ᵥ x = x + w from by rw [vadd_eq_add]; abel] at h
  obtain ⟨μ, hμ, hmem⟩ := exists_one_lt_smul_mem_of_mem_relint hz hxw
  refine ⟨μ, hμ, ?_⟩
  rw [show (1 - μ) • w + μ • (z - x) = ((1 - μ) • (x + w) + μ • z) - x from by module]
  exact sub_mem_convexDom_dirDeriv hb hmem

/-- Let the pairing be compatible with the topology of $E$, let $f$ be convex, let $f(x)$ be finite,
and let $\partial f(x) = \emptyset$. Then $f'(x; z - x) = -\infty$ for every
$z \in \operatorname{ri}(\operatorname{dom} f)$. No properness of $f$ is needed, because the
proof works only with $f'(x; \cdot)$.

The classical proof concludes, in its last sentence, that $f'(x; \cdot)$ is $-\infty$ on all of
$\operatorname{dom} f - x$. That conclusion is false: for $f(y) = -\sqrt{y}$ on $[0, \infty)$
and $+\infty$ elsewhere, at $x = 0$ one has $\partial f(0) = \emptyset$ and $f'(0; y) = -\infty$
for every $y > 0$, but $f'(0; 0) = 0$ and $0 \in \operatorname{dom} f - 0$. -/
theorem dirDeriv_eq_bot_of_subdifferential_eq_empty [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hsub : subdifferential B f x = ∅) {z : E}
    (hz : z ∈ ri (convexDom f)) : dirDeriv f x (z - x) = ⊥ := by
  have hconv : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  refine hconv.eq_bot_of_mem_relint_convexDom (fun hpd => ?_)
      (sub_mem_relint_convexDom_dirDeriv hf ht hb hz)
  have hcl : convexCl (dirDeriv f x) = fun _ => (⊥ : EReal) := by
    rw [convexCl_dirDeriv (B := B) hf ht hb, hsub, supportFn_empty]
  exact (hconv.properConvex_convexCl hpd).ne_bot 0 (congrFun hcl 0)

/-- Let the pairing be compatible with the topology of $E$, let $f$ be convex, let $f(x)$ be finite,
and let $\partial f(x) = \emptyset$. Then there is a direction $y$ with $f'(x; y) = -\infty$ and
$f'(x; -y) = +\infty$, an infinite two-sided directional derivative. -/
theorem exists_dirDeriv_eq_bot_and_dirDeriv_neg_eq_top [IsCompatiblePairing B] (hf : ConvexFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) (hsub : subdifferential B f x = ∅) :
    ∃ y : E, dirDeriv f x y = ⊥ ∧ dirDeriv f x (-y) = ⊤ := by
  obtain ⟨z, hz⟩ :=
      Convex.relint_nonempty hf.convex_convexDom ⟨x, mem_convexDom.2 (lt_top_iff_ne_top.2 ht)⟩
  refine ⟨z - x, dirDeriv_eq_bot_of_subdifferential_eq_empty (B := B) hf ht hb hsub hz, ?_⟩
  have h := neg_dirDeriv_neg_le hf ht hb (z - x)
  rwa [dirDeriv_eq_bot_of_subdifferential_eq_empty (B := B) hf ht hb hsub hz, le_bot_iff,
    EReal.neg_eq_bot_iff] at h

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, let $f : E \to [-\infty, +\infty]$ be convex, and let $f(x)$ be finite. Then
$$\partial f(x) = \emptyset \iff f'(x; y) = -\infty \text{ for some } y \in E.$$

Only the forward implication needs the work above. The reverse implication needs no convexity: a
subgradient $y$ gives $f'(x; v) \ge \langle v, y \rangle > -\infty$. -/
theorem subdifferential_eq_empty_iff_exists_dirDeriv_eq_bot [IsCompatiblePairing B]
    (hf : ConvexFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    subdifferential B f x = ∅ ↔ ∃ y : E, dirDeriv f x y = ⊥ := by
  constructor
  · intro hsub
    obtain ⟨y, hy, -⟩ := exists_dirDeriv_eq_bot_and_dirDeriv_neg_eq_top (B := B) hf ht hb hsub
    exact ⟨y, hy⟩
  · rintro ⟨y, hy⟩
    refine Set.eq_empty_of_forall_notMem fun v hv => ?_
    have h := (mem_subdifferential_iff_le_dirDeriv ht hb).1 hv y
    rw [hy, le_bot_iff] at h
    exact EReal.coe_ne_bot _ h

end Relint

/-! ### Polyhedral functions -/

section Polyhedral

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- Let $E$ be finite-dimensional, let $f$ be a polyhedral convex function, and let $f(x)$ be
finite. Then $f'(x; \cdot)$ is polyhedral.

This is the first step of the polyhedral case. The convex cone generated by
$\operatorname{epi} f - (x, f(x))$ is finitely generated, hence closed, and a closed cone of
this kind is $\operatorname{epi} f'(x; \cdot)$. -/
theorem polyhedralFn_dirDeriv (hf : PolyhedralFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    PolyhedralFn (dirDeriv f x) := by
  obtain ⟨r, hr⟩ := EReal.exists_coe_of_ne_bot_of_lt_top hb (lt_top_iff_ne_top.2 ht)
  have hsub : Polyhedral (epi f - {((x, r) : E × ℝ)}) :=
    Polyhedral.sub hf (polyhedral_singleton _)
  have h0 : (0 : E × ℝ) ∈ epi f - {((x, r) : E × ℝ)} :=
    ⟨(x, r), (mk_mem_epi.2 hr.le : ((x, r) : E × ℝ) ∈ epi f), (x, r), rfl, sub_self _⟩
  have hfg := finitelyGeneratedCone_hull_of_zero_mem hsub h0
  change Polyhedral (epi (dirDeriv f x))
  rw [epi_dirDeriv_eq_coe_hull hf.convexFn hr hfg.isClosed]
  exact hfg.polyhedralCone.polyhedral

/-- Let $E$ be finite-dimensional, let $f$ be a polyhedral convex function, and let $f(x)$ be
finite. Then $f'(x; \cdot)$ is proper.

This is the second step. A lower semicontinuous convex function that takes the value $-\infty$
somewhere is $-\infty$ on the whole closure of its effective domain, but $f'(x; 0) = 0$. -/
theorem properConvex_dirDeriv_of_polyhedralFn (hf : PolyhedralFn f) (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    ProperConvex (dirDeriv f x) := by
  have hpoly := polyhedralFn_dirDeriv hf ht hb
  have h0 : (0 : E) ∈ convexDom (dirDeriv f x) := by
    rw [mem_convexDom, dirDeriv_zero ht hb]; exact EReal.zero_lt_top
  by_contra hcon
  have hbot := hpoly.convexFn.eq_bot_of_mem_closure_convexDom hpoly.lowerSemicontinuous hcon
    (subset_closure h0)
  rw [dirDeriv_zero ht hb] at hbot
  exact absurd hbot (by simp)

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, let $f : E \to [-\infty, +\infty]$ be a polyhedral convex function, and let $f(x)$ be
finite. Then the directional derivative is the support function of the subdifferential:
$$f'(x; v) = \sup_{y \in \partial f(x)} \langle v, y \rangle \quad \text{for all } v \in E.$$

This is part of Theorem 23.10 of [rockafellar1970convex]. A polyhedral convex function is
`ConvexAnalysis.PolyhedralFn`: its epigraph is a polyhedral convex set. -/
theorem dirDeriv_eq_supportFn_of_polyhedralFn [IsCompatiblePairing B] (hf : PolyhedralFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) :
    dirDeriv f x = supportFn B.flip (subdifferential B f x) :=
  dirDeriv_eq_supportFn_of_closedConvex hf.convexFn ht hb
    ((polyhedralFn_dirDeriv hf ht hb).closedConvex
        (properConvex_dirDeriv_of_polyhedralFn hf ht hb).ne_bot)

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology, and let $f : E \to [-\infty, +\infty]$ be a polyhedral convex function. Then $f$ has a
subgradient at every point $x$ where $f(x)$ is finite.

This is part of Theorem 23.10 of [rockafellar1970convex]. -/
theorem subdifferential_nonempty_of_polyhedralFn [IsCompatiblePairing B] (hf : PolyhedralFn f)
    (ht : f x ≠ ⊤) (hb : f x ≠ ⊥) : (subdifferential B f x).Nonempty :=
  subdifferential_nonempty_of_closedConvex_dirDeriv hf.convexFn ht hb
    ((polyhedralFn_dirDeriv hf ht hb).closedConvex
        (properConvex_dirDeriv_of_polyhedralFn hf ht hb).ne_bot)

end Polyhedral

section PolyhedralSubdifferential

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal} {x : E}

/-- Let $E$ and $F$ be finite-dimensional real normed spaces with any pairing, let
$f : E \to [-\infty, +\infty]$ be a polyhedral convex function, and let $f(x)$ be finite. Then
$\partial f(x)$ is a polyhedral convex set.

This is part of Theorem 23.10 of [rockafellar1970convex]. The set $\partial f(x)$ is the
effective domain of $(f'(x; \cdot))^*$, which is the indicator function of $\partial f(x)$, and
the conjugate of a polyhedral convex function is polyhedral. -/
theorem polyhedral_subdifferential_of_polyhedralFn (hf : PolyhedralFn f) (ht : f x ≠ ⊤)
    (hb : f x ≠ ⊥) : Polyhedral (subdifferential B f x) := by
  have hconj : PolyhedralFn (convexConj B (dirDeriv f x)) :=
    PolyhedralFn.convexConj (polyhedralFn_dirDeriv hf ht hb)
  rw [convexConj_dirDeriv ht hb] at hconj
  have h := hconj.polyhedral_convexDom
  rwa [convexDom_indicatorFn] at h

end PolyhedralSubdifferential

/-!
### The normal cone to a level set

The proof reads the bipolar theorem backwards. The closure of the convex cone generated by
$\partial f(x)$ is the bipolar $(\partial f(x))^{\circ\circ}$, its polar is the level set $\{v \mid
(\operatorname{cl} f'(x; \cdot))(v) \le 0\}$, and that set is the closure of
$\{v \mid f'(x; v) < 0\}$.
-/

section NormalCone

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] [TopologicalSpace F] [IsTopologicalAddGroup F]
  [ContinuousSMul ℝ F] [LocallyConvexSpace ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {f : E → EReal}
  {x : E} {r : ℝ}

omit [FiniteDimensional ℝ E] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- Let every $\langle z, \cdot \rangle$ be continuous on $F$. Then the normal cone $N_C(x)$ is
closed in $F$, for every set $C$ and every point $x$. It is an intersection of closed
half-spaces, one for each point of $C$. -/
theorem isClosed_normalCone [IsContinuousPairing B.flip] (C : Set E) (x : E) :
    IsClosed (normalCone B C x) := by
  rw [show normalCone B C x = ⋂ z ∈ C, {y : F | B (z - x) y ≤ 0} from
    Set.ext fun y => by simp]
  exact isClosed_biInter fun z _ =>
    isClosed_le (continuous_pairing B.flip (z - x)) continuous_const

omit [FiniteDimensional ℝ E] [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- Let $f(x) = r$ be real. Then every subgradient of $f$ at $x$ is normal at $x$ to the level set
$\{z \mid f(z) \le r\}$:
$$\partial f(x) \subseteq N_{\{z \mid f(z) \le r\}}(x).$$
This is the subgradient inequality at the points of the level set. -/
theorem subdifferential_subset_normalCone_setOf_le (hr : f x = (r : EReal)) :
    subdifferential B f x ⊆ normalCone B {z | f z ≤ (r : EReal)} x := by
  intro y hy z hz
  have h0 := hy z
  rw [hr] at h0
  have h1 : (r : EReal) + ((B (z - x) y : ℝ) : EReal) ≤ (r : EReal) := h0.trans hz
  rw [← EReal.coe_add, EReal.coe_le_coe_iff] at h1
  linarith

omit [FiniteDimensional ℝ E] [TopologicalSpace F] [IsTopologicalAddGroup F] [ContinuousSMul ℝ F]
  [LocallyConvexSpace ℝ F] in
/-- Let the pairing be compatible with the topology of $E$, let $f$ be convex, and let $f(x)$ be
finite. Then the polar cone of $\partial f(x)$ is a level set of the closure of the directional
derivative:
$$(\partial f(x))^\circ = \{v \in E \mid (\operatorname{cl} f'(x; \cdot))(v) \le 0\}.$$
The polar cone is `ConvexAnalysis.polarCone` for the flipped pairing `B.flip`. -/
theorem polarCone_subdifferential [IsCompatiblePairing B] (hf : ConvexFn f) (ht : f x ≠ ⊤)
    (hb : f x ≠ ⊥) :
    polarCone B.flip (subdifferential B f x) = {v : E | convexCl (dirDeriv f x) v ≤ 0} := by
  rw [convexCl_dirDeriv (B := B) hf ht hb]
  ext v
  simp only [mem_polarCone, Set.mem_ofPred_eq, supportFn_apply, LinearMap.flip_apply,
    iSup₂_le_iff]
  exact ⟨fun h y hy => by exact_mod_cast h y hy, fun h y hy => by exact_mod_cast h y hy⟩

/-- Let $E$ be a finite-dimensional real normed space, let $F$ be a locally convex topological
vector space, and let the pairing be compatible with the topologies of $E$ and of $F$. Let
$f : E \to [-\infty, +\infty]$ be convex, let $f(x) = r$ be real, let $\inf_z f(z) < r$, and let
$\partial f(x)$ be nonempty. Then the normal cone to the level set $\{z \mid f(z) \le r\}$ at
$x$ is the closure of the convex cone generated by $\partial f(x)$:
$$N_{\{z \mid f(z) \le f(x)\}}(x) = \operatorname{cl} \Big(\bigcup_{\lambda \ge 0} \lambda \,
  \partial f(x)\Big).$$

Neither of the last two hypotheses can be dropped. For $f(y) = -\sqrt{y}$ on $[0, \infty)$ and
$+\infty$ elsewhere, at $x = 0$ the level set is $[0, \infty)$ with normal cone $(-\infty, 0]$,
while $\partial f(0) = \emptyset$ generates only $\{0\}$. If $x$ minimizes $f$, the level set is
the set of minimizers, which can be all of $\operatorname{dom} f$ near $x$. Properness of $f$
follows from $\partial f(x) \ne \emptyset$, so it is not assumed.

The cone is `PointedCone.hull ℝ (subdifferential B f x)`. Compatibility of both $B$ and `B.flip`
is `ConvexAnalysis.IsCompatiblePairing`. -/
theorem normalCone_setOf_le_eq_closure_coe_hull_subdifferential [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hne : (subdifferential B f x).Nonempty) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = closure ((PointedCone.hull ℝ (subdifferential B f x) : Set F)) := by
  have ht : f x ≠ ⊤ := by rw [hr]; exact EReal.coe_ne_top r
  have hb : f x ≠ ⊥ := by rw [hr]; exact EReal.coe_ne_bot r
  have hk : ConvexFn (dirDeriv f x) := convexFn_dirDeriv hf ht hb
  have hkp : ProperConvex (dirDeriv f x) := by
    obtain ⟨y₀, hy₀⟩ := hne
    refine ⟨⟨0, ?_⟩, fun v => ?_⟩
    · rw [mem_convexDom, dirDeriv_zero ht hb]
      simp
    · exact ne_bot_of_le_ne_bot (EReal.coe_ne_bot _)
        ((mem_subdifferential_iff_le_dirDeriv ht hb).1 hy₀ v)
  have hneg : (⨅ v, dirDeriv f x v) < ((0 : ℝ) : EReal) := by
    obtain ⟨z, hz⟩ := iInf_lt_iff.1 hinf
    obtain ⟨μ, hzμ, hμr⟩ := EReal.lt_iff_exists_real_btwn.1 hz
    have hμr2 : μ < r := by exact_mod_cast hμr
    have hquot : dirDeriv f x (z - x) ≤ ((μ - r : ℝ) : EReal) := by
      have h1 := dirDeriv_le f x (z - x) one_pos
      rw [one_smul, show x + (z - x) = z from by abel, hr] at h1
      refine h1.trans ?_
      rw [EReal.sub_div_le_coe_iff one_pos, show r + (μ - r) * 1 = μ from by ring]
      exact hzμ.le
    refine lt_of_le_of_lt ((iInf_le _ (z - x)).trans hquot) ?_
    exact_mod_cast (by linarith : μ - r < 0)
  have hpol : polarCone B.flip (subdifferential B f x) = closure {v : E | dirDeriv f x v < 0} := by
    have h76 := hk.closure_setOf_lt hneg
    rw [EReal.coe_zero] at h76
    rw [polarCone_subdifferential hf ht hb, h76, hk.convexCl_eq_lscHull hkp]
  have hbip : closure ((PointedCone.hull ℝ (subdifferential B f x) : Set F))
      = polarCone B (polarCone B.flip (subdifferential B f x)) := by
    have h := polarCone_polarCone (B := B.flip)
      (K := (PointedCone.hull ℝ (subdifferential B f x) : Set F))
      ((PointedCone.hull ℝ (subdifferential B f x) : ConvexCone ℝ F).convex)
      (isCone_coe_pointedCone _) ⟨0, Submodule.zero_mem _⟩
    rw [polarCone_hull, LinearMap.flip_flip] at h
    exact h.symm
  refine subset_antisymm ?_ ?_
  · rw [hbip]
    intro y hy v hv
    rw [hpol] at hv
    refine closure_minimal (fun w hw => ?_)
      (isClosed_le (continuous_pairing B y) continuous_const) hv
    obtain ⟨a, ha, hlt⟩ := dirDeriv_lt_iff.1 hw
    have hmem : x + a • w ∈ {z : E | f z ≤ (r : EReal)} := by
      have h2 : (f (x + a • w) - f x) / (a : EReal) ≤ ((0 : ℝ) : EReal) := by
        rw [EReal.coe_zero]
        exact hlt.le
      rw [hr, EReal.sub_div_le_coe_iff ha, show r + 0 * a = r from by ring] at h2
      exact h2
    have h3 := hy _ hmem
    rw [add_sub_cancel_left, map_smul, LinearMap.smul_apply, smul_eq_mul] at h3
    exact nonpos_of_mul_nonpos_right h3 ha
  · refine closure_minimal ?_ (isClosed_normalCone _ x)
    have hle : PointedCone.hull ℝ (subdifferential B f x)
        ≤ normalPointedCone B {z | f z ≤ (r : EReal)} x :=
      Submodule.span_le.2 (subdifferential_subset_normalCone_setOf_le hr)
    exact hle

end NormalCone

section NormalConeBounded

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ}
  {f : E → EReal} {x : E} {r : ℝ}

/-- Let $E$ and $F$ be finite-dimensional real normed spaces whose pairing is compatible with both
topologies, let $f$ be proper and convex, and let
$x \in \operatorname{ri}(\operatorname{dom} f)$. Then $\partial f(x)$ is bounded in norm if and
only if $x \in \operatorname{int}(\operatorname{dom} f)$.

This upgrades `ConvexAnalysis.bddAbove_subdifferential_iff_mem_interior_convexDom`, which uses
boundedness in the sense of the pairing, the only sense that a general pair of spaces supports.
The upgrade needs $F$ finite-dimensional. -/
theorem isBounded_subdifferential_iff_mem_interior_convexDom [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hp : ProperConvex f)
        (hx : x ∈ ri (convexDom f)) :
    Bornology.IsBounded (subdifferential B f x) ↔ x ∈ interior (convexDom f) := by
  rw [← bddAbove_subdifferential_iff_mem_interior_convexDom (B := B) hf hp hx,
    isBounded_iff_forall_bddAbove (B := B.flip)]
  simp

/-- Let $E$ and $F$ be finite-dimensional real normed spaces whose pairing is compatible with both
topologies. Let $f : E \to [-\infty, +\infty]$ be convex, let $f(x) = r$ be real with
$\inf_z f(z) < r$, and let $\partial f(x)$ be nonempty and bounded. Then the normal cone to the
level set $\{z \mid f(z) \le r\}$ at $x$ is the convex cone generated by $\partial f(x)$:
$$N_{\{z \mid f(z) \le f(x)\}}(x) = \bigcup_{\lambda \ge 0} \lambda \, \partial f(x).$$

The closure in `ConvexAnalysis.normalCone_setOf_le_eq_closure_coe_hull_subdifferential` can be
removed because the cone generated by a nonempty bounded closed convex set that does not contain
the origin is closed. The condition $0 \notin \partial f(x)$ is not an extra hypothesis: it is
equivalent to $f(x) > \inf f$. By
`ConvexAnalysis.isBounded_subdifferential_iff_mem_interior_convexDom`, boundedness holds when
$x \in \operatorname{int}(\operatorname{dom} f)$. -/
theorem normalCone_setOf_le_eq_coe_hull_subdifferential [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hne : (subdifferential B f x).Nonempty)
    (hbdd : Bornology.IsBounded (subdifferential B f x)) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = (PointedCone.hull ℝ (subdifferential B f x) : Set F) := by
  have h0 : (0 : F) ∉ subdifferential B f x := by
    intro hmem
    refine absurd (le_iInf fun z => ?_) (not_le_of_gt hinf)
    have h1 := hmem z
    rwa [map_zero, EReal.coe_zero, add_zero, hr] at h1
  have hcl := isClosed_coe_hull_of_isBounded (convex_subdifferential B f x)
    (isClosed_subdifferential (B := B) f x) hne h0 hbdd
  rw [normalCone_setOf_le_eq_closure_coe_hull_subdifferential hf hr hinf hne, hcl.closure_eq]

/-- Let $E$ and $F$ be finite-dimensional real normed spaces whose pairing is compatible with both
topologies. Let $f$ be proper and convex, let $f(x) = r$ be real with $\inf_z f(z) < r$, and let
$x \in \operatorname{int}(\operatorname{dom} f)$. Then the normal cone to
$\{z \mid f(z) \le r\}$ at $x$ is the convex cone generated by $\partial f(x)$.

The hypothesis $x \in \operatorname{int}(\operatorname{dom} f)$ makes $\partial f(x)$ nonempty
and bounded. Properness is assumed, not derived from $\partial f(x) \ne \emptyset$, because the
existence theorem on the relative interior needs it first. -/
theorem normalCone_setOf_le_eq_coe_hull_subdifferential_of_mem_interior_convexDom
    [IsCompatiblePairing B]
    [IsCompatiblePairing B.flip] (hf : ConvexFn f) (hp : ProperConvex f) (hr : f x = (r : EReal))
    (hinf : ⨅ z, f z < (r : EReal)) (hx : x ∈ interior (convexDom f)) :
    normalCone B {z | f z ≤ (r : EReal)} x
      = (PointedCone.hull ℝ (subdifferential B f x) : Set F) := by
  have hri : x ∈ ri (convexDom f) := interior_subset_intrinsicInterior hx
  exact normalCone_setOf_le_eq_coe_hull_subdifferential hf hr hinf
    (subdifferential_nonempty_of_mem_relint_convexDom (B := B) hf hp hri)
    ((isBounded_subdifferential_iff_mem_interior_convexDom (B := B) hf hp hri).2 hx)

end NormalConeBounded

/-! ### A trivial normal cone means an interior point -/

section NormalConeInterior

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [AddCommGroup F] [Module ℝ F] {B : E →ₗ[ℝ] F →ₗ[ℝ] ℝ} {C : Set E} {x : E}

/-- Let $E$ be a finite-dimensional real normed space whose pairing with $F$ is compatible with the
topology. Let $C \subseteq E$ be convex and $x \in C$. If $N_C(x) = \{0\}$, then $x$ is an
interior point of $C$.

This is the converse of the evident implication that $x \in \operatorname{int} C$ gives
$N_C(x) = \{0\}$. It is the supporting hyperplane theorem in another form, since a boundary
point of a convex set has a nonzero supporting functional. Finite dimension is needed. In an
infinite-dimensional space a convex set can have empty interior and be dense, such as the linear
span of an orthonormal basis of a Hilbert space. Then no nonzero continuous functional supports
it anywhere, so the normal cone is $\{0\}$ at every point although the interior is empty. In
finite dimension a convex set with empty interior lies in a proper affine subspace, and a
functional that vanishes on that subspace is normal at every point. -/
theorem mem_interior_of_normalCone_eq_zero [IsCompatiblePairing B] (hC : Convex ℝ C)
    (hx : x ∈ C) (h : normalCone B C x = {0}) : x ∈ interior C := by
  by_contra hnot
  obtain ⟨g, hg0, hgmax⟩ :=
    exists_ne_zero_isMaxOn_of_mem_frontier hC hx ⟨subset_closure hx, hnot⟩
  obtain ⟨y, hy⟩ := exists_pairing_eq B g
  have hmem : y ∈ normalCone B C x := by
    intro z hz
    have hle : g z ≤ g x := hgmax z hz
    rw [hy z, hy x] at hle
    simpa using sub_nonpos.2 hle
  rw [h, Set.mem_singleton_iff] at hmem
  exact hg0 (ContinuousLinearMap.ext fun z => by simp [hy z, hmem])

end NormalConeInterior

end ConvexAnalysis
