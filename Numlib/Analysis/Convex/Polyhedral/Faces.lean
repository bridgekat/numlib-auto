import Numlib.Analysis.Convex.Polyhedral.Ops
import Numlib.Analysis.Convex.Representation

/-!
# Finite generation and a finite set of faces

A face of a convex set $C$ is a convex subset $C' \subseteq C$ such that every closed line segment
in $C$ with a relative interior point in $C'$ has both endpoints in $C'$. In a finite-dimensional
space, a closed convex set has only finitely many faces exactly when it is finitely generated
([rockafellar1970convex], §18 and §19). This is a third description of a polyhedral convex set:
`Numlib.Analysis.Convex.Polyhedral.Defs` identifies polyhedral sets with finitely generated sets,
and this module adds the closed convex sets with finitely many faces.

A face of $C = \operatorname{conv} P + \operatorname{cone} D$ is the set generated by the points of
$P$ that it contains and the directions of $D$ in which it recedes. So each face is finitely
generated, and the faces are indexed by pairs of subsets of $P$ and $D$. Conversely, a closed convex
set that contains no line is generated by its extreme points and extreme directions, and finitely
many faces bound both. The general case reduces to this one by splitting off the lineality space.

## Main results

* `ConvexAnalysis.FinitelyGenerated.finite_setOf_isFace`,
  `ConvexAnalysis.FinitelyGenerated.of_isFace`: a finitely generated set has finitely many faces,
  and each of them is finitely generated.
* `ConvexAnalysis.Polyhedral.finite_setOf_isFace`, `ConvexAnalysis.Polyhedral.of_isFace`: the same
  for polyhedral sets.
* `ConvexAnalysis.finitelyGenerated_of_finite_setOf_isFace_of_containsNoLine`: a closed convex set
  that contains no line and has finitely many faces is finitely generated.
* `ConvexAnalysis.polyhedral_of_finite_setOf_isFace`,
  `ConvexAnalysis.finitelyGenerated_of_finite_setOf_isFace`: a closed convex set with finitely many
  faces is polyhedral and finitely generated.
* `ConvexAnalysis.polyhedral_iff_isClosed_finite_setOf_isFace`,
  `ConvexAnalysis.finitelyGenerated_iff_isClosed_finite_setOf_isFace`: a convex set is polyhedral,
  or finitely generated, if and only if it is closed and has finitely many faces.

## Implementation notes

* Extreme directions are counted as rays, not as vectors. The set
  `ConvexAnalysis.extremeDirections C` is closed under multiplication by positive scalars, so it is
  never finite when it is nonempty. A finite set of faces bounds the number of faces that are
  half-lines, and `ConvexAnalysis.exists_finite_generating_extremeDirections` turns this bound into
  a finite generating set by the choice of one direction vector for each half-line face.
-/

open Set

open scoped Pointwise

namespace ConvexAnalysis

/-! ### Counting extreme points and extreme directions -/

section Counting

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {C : Set E}

/-- **A set with finitely many faces has finitely many extreme points.** The extreme points of $C$
are exactly the singleton faces of $C$ (`ConvexAnalysis.isFace_singleton`). -/
theorem finite_extremePoints_of_finite_setOf_isFace
    (hfin : {C' : Set E | IsFace C C'}.Finite) : (C.extremePoints ℝ).Finite := by
  refine Set.Finite.of_finite_image (hfin.subset ?_) Set.singleton_injective.injOn
  rintro _ ⟨x, hx, rfl⟩
  exact isFace_singleton.2 hx

/-- **A set with finitely many faces has finitely many extreme rays.** If $C$ has only finitely many
faces, then there is a finite set $D$ of extreme direction vectors of $C$ such that every
extreme direction vector of $C$ is in the convex cone generated by $D$.

Every extreme direction is the direction of a half-line face, and every generator of such a face
lies in the recession cone of the face. -/
theorem exists_finite_generating_extremeDirections
    (hfin : {C' : Set E | IsFace C C'}.Finite) :
    ∃ D : Set E, D.Finite ∧ D ⊆ extremeDirections C ∧
      extremeDirections C ⊆ (PointedCone.hull ℝ D : Set E) := by
  classical
  have hchoice : ∀ C' : Set E, ∃ y : E,
      (∃ x : E, y ≠ 0 ∧ C' = halfLine x y) ∨ ∀ x z : E, z ≠ 0 → C' ≠ halfLine x z := by
    intro C'
    by_cases h : ∃ x z : E, z ≠ 0 ∧ C' = halfLine x z
    · obtain ⟨x, z, hz, he⟩ := h
      exact ⟨z, Or.inl ⟨x, hz, he⟩⟩
    · exact ⟨0, Or.inr fun x z hz he => h ⟨x, z, hz, he⟩⟩
  choose g hg using hchoice
  refine ⟨g '' {C' : Set E | IsFace C C'} ∩ extremeDirections C,
    (hfin.image g).subset Set.inter_subset_left, Set.inter_subset_right, ?_⟩
  rintro y ⟨hy, x, hface⟩
  rcases hg (halfLine x y) with ⟨x', hg0, hx'⟩ | hno
  · have hgmem : g (halfLine x y) ∈
        g '' {C' : Set E | IsFace C C'} ∩ extremeDirections C := by
      refine ⟨⟨halfLine x y, hface, rfl⟩, hg0, x', ?_⟩
      rw [← hx']
      exact hface
    have hrec : y ∈ recessionCone (halfLine x' (g (halfLine x y))) := by
      rw [← hx']
      exact mem_recessionCone_halfLine x y
    rw [recessionCone_halfLine] at hrec
    obtain ⟨a, ha, hya⟩ := hrec
    have hone : y ∈ (PointedCone.hull ℝ ({g (halfLine x y)} : Set E) : Set E) := by
      rw [coe_coneHull_singleton]
      exact ⟨a, ha, hya⟩
    exact Submodule.span_mono (Set.singleton_subset_iff.2 hgmem) hone
  · exact absurd rfl (hno x y hy)

/-- **A finitely generated set has only finitely many extreme points.** If $C = \operatorname{conv}
P + \operatorname{cone} D$ with $P$ and $D$ finite, then every extreme point of $C$ is in $P$
(`ConvexAnalysis.extremePoints_convexHullPD_subset`). This needs neither finite dimension nor a
norm. -/
theorem FinitelyGenerated.finite_extremePoints (hC : FinitelyGenerated C) :
    (C.extremePoints ℝ).Finite := by
  obtain ⟨P, D, hPD⟩ := hC
  have hPD' : C = convexHullPD (P : Set E) (D : Set E) := hPD
  rw [hPD']
  exact finite_extremePoints_convexHullPD P D

end Counting

/-! ### The faces of a finitely generated set -/

section Generated

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {C C' : Set E}

/-- **A face of a finitely generated set is finitely generated.** Let $E$ be a finite-dimensional
real normed space. If $C \subseteq E$ is finitely generated and $C'$ is a face of $C$, then $C'$
is finitely generated.

If $C = \operatorname{conv} P + \operatorname{cone} D$, then $C'$ is generated by the points of
$P$ that are in $C'$ and the directions of $D$ in which $C'$ recedes. Both are subsets of the
original generators. -/
theorem FinitelyGenerated.of_isFace (hC : FinitelyGenerated C) (hface : IsFace C C') :
    FinitelyGenerated C' := by
  classical
  obtain ⟨P, D, hPD⟩ := hC
  have hPD' : C = convexHullPD (P : Set E) (D : Set E) := hPD
  rw [hPD'] at hface
  refine ⟨P.filter (· ∈ C'), D.filter (· ∈ recessionCone C'), ?_⟩
  have hp : ((P.filter (· ∈ C') : Finset E) : Set E) = (P : Set E) ∩ C' := by
    ext z; simp
  have hd : ((D.filter (· ∈ recessionCone C') : Finset E) : Set E)
      = {y ∈ (D : Set E) | y ∈ recessionCone C'} := by
    ext z; simp
  rw [← convexHullPD_def, hp, hd]
  exact hface.eq_convexHullPD

/-- **A finitely generated set has only finitely many faces.** Let $E$ be a finite-dimensional real
normed space. If $C \subseteq E$ is finitely generated, then the set of faces of $C$ is finite.

By the description in `ConvexAnalysis.FinitelyGenerated.of_isFace`, the map from faces to
generators factors through the pairs of subsets of the two finite generating sets. -/
theorem FinitelyGenerated.finite_setOf_isFace (hC : FinitelyGenerated C) :
    {C' : Set E | IsFace C C'}.Finite := by
  classical
  obtain ⟨P, D, hPD⟩ := hC
  have hPD' : C = convexHullPD (P : Set E) (D : Set E) := hPD
  refine Set.Finite.subset (Set.Finite.image
    (fun q : Finset E × Finset E => convexHullPD (q.1 : Set E) (q.2 : Set E))
    (P.powerset ×ˢ D.powerset).finite_toSet) ?_
  rintro C' hC'
  have hface : IsFace (convexHullPD (P : Set E) (D : Set E)) C' := hPD' ▸ hC'
  have hp : ((P.filter (· ∈ C') : Finset E) : Set E) = (P : Set E) ∩ C' := by
    ext z; simp
  have hd : ((D.filter (· ∈ recessionCone C') : Finset E) : Set E)
      = {y ∈ (D : Set E) | y ∈ recessionCone C'} := by
    ext z; simp
  refine ⟨(P.filter (· ∈ C'), D.filter (· ∈ recessionCone C')), ?_, ?_⟩
  · exact Finset.mem_coe.2 (Finset.mem_product.2
      ⟨Finset.mem_powerset.2 (Finset.filter_subset _ _),
        Finset.mem_powerset.2 (Finset.filter_subset _ _)⟩)
  · change convexHullPD ((P.filter (· ∈ C') : Finset E) : Set E)
      ((D.filter (· ∈ recessionCone C') : Finset E) : Set E) = C'
    rw [hp, hd]
    exact hface.eq_convexHullPD.symm

/-- Let $E$ be a finite-dimensional real normed space. If $C \subseteq E$ is polyhedral and $C'$ is
a face of $C$, then $C'$ is polyhedral.

This is `ConvexAnalysis.FinitelyGenerated.of_isFace` combined with
`ConvexAnalysis.polyhedral_iff_finitelyGenerated`. -/
theorem Polyhedral.of_isFace (hC : Polyhedral C) (hface : IsFace C C') : Polyhedral C' :=
  (hC.finitelyGenerated.of_isFace hface).polyhedral

/-- Let $E$ be a finite-dimensional real normed space. If $C \subseteq E$ is polyhedral, then $C$
has only finitely many faces.

This is `ConvexAnalysis.FinitelyGenerated.finite_setOf_isFace` combined with
`ConvexAnalysis.polyhedral_iff_finitelyGenerated`. -/
theorem Polyhedral.finite_setOf_isFace (hC : Polyhedral C) :
    {C' : Set E | IsFace C C'}.Finite :=
  hC.finitelyGenerated.finite_setOf_isFace

end Generated

/-! ### Finitely many faces forces finite generation -/

section FiniteFaces

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {C : Set E}

/-- **A closed convex set that contains no line and has only finitely many faces is finitely
generated.** Let $E$ be a finite-dimensional real normed space and let $C \subseteq E$ be closed
and convex. If $C$ contains no line and has only finitely many faces, then $C$ is finitely
generated.

The set $C$ is the convex hull of its extreme points and extreme directions. A finite set of
faces bounds both, and the replacement of the extreme directions by a finite generating set does
not change the hull. -/
theorem finitelyGenerated_of_finite_setOf_isFace_of_containsNoLine (hC : Convex ℝ C)
    (hCcl : IsClosed C) (hnl : ContainsNoLine C)
    (hfin : {C' : Set E | IsFace C C'}.Finite) : FinitelyGenerated C := by
  classical
  obtain ⟨D, hDfin, hDsub, hDcov⟩ := exists_finite_generating_extremeDirections hfin
  have hPfin := finite_extremePoints_of_finite_setOf_isFace hfin
  have hrepr := convexHullPD_extremePoints_extremeDirections hC hCcl hnl
  refine ⟨hPfin.toFinset, hDfin.toFinset, ?_⟩
  rw [hPfin.coe_toFinset, hDfin.coe_toFinset, ← convexHullPD_def]
  refine Set.Subset.antisymm (Set.Subset.trans hrepr.ge ?_)
    (Set.Subset.trans (convexHullPD_mono_right _ hDsub) hrepr.subset)
  exact Set.Subset.trans (convexHullPD_mono_right _ hDcov)
    (convexHullPD_coneHull _ _).subset

/-- **A closed convex set with only finitely many faces is polyhedral.** Let $E$ be a
finite-dimensional real normed space and let $C \subseteq E$ be closed and convex. If $C$ has
only finitely many faces, then $C$ is polyhedral.

The proof is the reduction of [rockafellar1970convex] to lineality zero. Let $N$ be the
lineality space of $C$ and let $M$ be a complement of $N$. Then $C = N + (C \cap M)$, and the
faces of $C \cap M$ correspond to the faces of $C$. The set $C \cap M$ contains no line, because
the direction of such a line would be in $N \cap M = \{0\}$. So $C \cap M$ is finitely
generated, and $C$ is a sum of two polyhedral sets. -/
theorem polyhedral_of_finite_setOf_isFace (hC : Convex ℝ C) (hCcl : IsClosed C)
    (hfin : {C' : Set E | IsFace C C'}.Finite) : Polyhedral C := by
  classical
  obtain ⟨M, hcompl⟩ := (linealitySubmodule C).exists_isCompl
  have hN : ((linealitySubmodule C : Submodule ℝ E) : Set E) ⊆ linealitySpace C :=
    (coe_linealitySubmodule C).subset
  have hdec : C = ((linealitySubmodule C : Submodule ℝ E) : Set E) + (C ∩ (M : Set E)) :=
    eq_add_inter_of_isCompl_of_le hN hcompl
  have hC₀nl : ContainsNoLine (C ∩ (M : Set E)) := by
    intro x y hy
    by_contra hall
    push Not at hall
    have hyL : y ∈ linealitySpace C :=
      mem_linealitySpace_of_forall_add_smul_mem hC hCcl fun t => (hall t).1
    have h0 : x + (0 : ℝ) • y ∈ M := (hall 0).2
    have h1 : x + (1 : ℝ) • y ∈ M := (hall 1).2
    have hsub : (x + (1 : ℝ) • y) - (x + (0 : ℝ) • y) ∈ M := M.sub_mem h1 h0
    have heq : (x + (1 : ℝ) • y) - (x + (0 : ℝ) • y) = y := by module
    rw [heq] at hsub
    exact hy ((Submodule.disjoint_def.1 hcompl.disjoint) y
      (mem_linealitySubmodule.2 hyL) hsub)
  have hfin₀ : {C₀ : Set E | IsFace (C ∩ (M : Set E)) C₀}.Finite := by
    have h1 : Finite {C' : Set E // IsFace C C'} := hfin.to_subtype
    have h2 : Finite {C₀ : Set E // IsFace (C ∩ (M : Set E)) C₀} :=
      Finite.of_equiv _ (isFaceEquivInter hN hcompl)
    have h3 : Finite ↥{C₀ : Set E | IsFace (C ∩ (M : Set E)) C₀} := h2
    exact Set.toFinite _
  have hC₀ : FinitelyGenerated (C ∩ (M : Set E)) :=
    finitelyGenerated_of_finite_setOf_isFace_of_containsNoLine (hC.inter M.convex)
      (hCcl.inter M.closed_of_finiteDimensional) hC₀nl hfin₀
  have hsum : Polyhedral (((linealitySubmodule C : Submodule ℝ E) : Set E)
      + (C ∩ (M : Set E))) :=
    (polyhedral_coe_submodule _).add hC₀.polyhedral
  rwa [← hdec] at hsum

/-- **A closed convex set with only finitely many faces is finitely generated.** Let $E$ be a
finite-dimensional real normed space and let $C \subseteq E$ be closed and convex. If $C$ has
only finitely many faces, then $C$ is finitely generated. -/
theorem finitelyGenerated_of_finite_setOf_isFace (hC : Convex ℝ C) (hCcl : IsClosed C)
    (hfin : {C' : Set E | IsFace C C'}.Finite) : FinitelyGenerated C :=
  (polyhedral_of_finite_setOf_isFace hC hCcl hfin).finitelyGenerated

/-- **A convex set is polyhedral exactly when it is closed and has only finitely many faces.** Let
$E$ be a finite-dimensional real normed space and let $C \subseteq E$ be convex. Then $C$ is
polyhedral if and only if $C$ is closed and has only finitely many faces.

Together with `ConvexAnalysis.polyhedral_iff_finitelyGenerated`, this gives the equivalence of
the three descriptions. -/
theorem polyhedral_iff_isClosed_finite_setOf_isFace (hC : Convex ℝ C) :
    Polyhedral C ↔ IsClosed C ∧ {C' : Set E | IsFace C C'}.Finite :=
  ⟨fun h => ⟨h.isClosed, h.finite_setOf_isFace⟩,
    fun h => polyhedral_of_finite_setOf_isFace hC h.1 h.2⟩

/-- **A convex set is finitely generated exactly when it is closed and has only finitely many
faces.** Let $E$ be a finite-dimensional real normed space and let $C \subseteq E$ be convex.
Then $C$ is finitely generated if and only if $C$ is closed and has only finitely many faces.

This is `ConvexAnalysis.polyhedral_iff_isClosed_finite_setOf_isFace` for finitely generated
sets. -/
theorem finitelyGenerated_iff_isClosed_finite_setOf_isFace (hC : Convex ℝ C) :
    FinitelyGenerated C ↔ IsClosed C ∧ {C' : Set E | IsFace C C'}.Finite := by
  rw [← polyhedral_iff_finitelyGenerated]
  exact polyhedral_iff_isClosed_finite_setOf_isFace hC

end FiniteFaces

end ConvexAnalysis
