import Numlib.Analysis.Convex.Duality.Polar

/-!
# Polyhedral convex cones and the Minkowski–Weyl theorem

A convex cone $K$ in a real vector space $E$ has two finite descriptions. From outside, $K$ is a
**polyhedral convex cone** if it is the solution set of finitely many homogeneous linear
inequalities $\varphi_1(x) \le 0, \dots, \varphi_k(x) \le 0$. From inside, $K$ is a **finitely
generated convex cone** if it is the set of nonnegative combinations of finitely many vectors
$v_1, \dots, v_m$. The **Minkowski–Weyl theorem** for cones says that in finite dimensions the two
descriptions are equivalent ([rockafellar1970convex], Theorem 19.1). The rest of the polyhedral
theory rests on this theorem.

Weyl's half, that a finitely generated cone is polyhedral, is proved by Fourier–Motzkin elimination
and uses no topology. Closedness of polyhedral and finitely generated cones follows. Minkowski's
half, that a polyhedral cone is finitely generated, is proved by separation in the dual space.

## Main definitions

* `ConvexAnalysis.PolyhedralCone`: $K$ is the solution set of finitely many inequalities
  $\varphi(x) \le 0$ with $\varphi$ linear.
* `ConvexAnalysis.FinitelyGeneratedCone`: $K$ is the set of nonnegative combinations of a finite set
  of vectors.

## Main results

* `ConvexAnalysis.FinitelyGeneratedCone.polyhedralCone`: Weyl's half. In a finite-dimensional space,
  a finitely generated cone is polyhedral.
* `ConvexAnalysis.PolyhedralCone.isClosed`, `ConvexAnalysis.FinitelyGeneratedCone.isClosed`: in a
  finite-dimensional normed space, polyhedral cones and finitely generated cones are closed.
* `ConvexAnalysis.PolyhedralCone.finitelyGeneratedCone`: Minkowski's half. In a finite-dimensional
  normed space, a polyhedral cone is finitely generated.
* `ConvexAnalysis.polyhedralCone_iff_finitelyGeneratedCone`: the Minkowski–Weyl theorem for cones.

## Proof outline

Weyl's half is an induction on the generators. The origin is a polyhedral cone, and adding one ray
to a polyhedral cone gives a polyhedral cone, by Fourier–Motzkin elimination of the coefficient of
the ray. Closedness of a finitely generated cone is then a corollary, and Carathéodory's theorem is
not needed. For Minkowski's half, the cone generated by the constraint functionals is finitely
generated, hence polyhedral by Weyl's half. Its constraints are evaluations at points of $E$, and
these points generate $K$.

## Implementation notes

* Mathlib has the two predicates for pointed cones (`PointedCone.DualFG` and `PointedCone.FG`) but
  not their equivalence.
* Minkowski's half pairs $E$ with `Module.Dual ℝ E` directly and uses only
  `geometric_hahn_banach_closed_point`. The statement therefore needs no pairing parameter.
* `ConvexAnalysis.PolyhedralCone.add_ray` states the new cone as
  $\{x \mid \exists t \ge 0,\ x - tv \in K\}$ rather than as the equal set
  $K + \{tv \mid t \ge 0\}$, because the elimination proof works with the first form.
-/

open Set

namespace ConvexAnalysis

/-! ### Homogeneous half-spaces cut out by linear functionals -/

section HalfSpace

variable {M : Type*} [AddCommGroup M] [Module ℝ M]

/-- The homogeneous half-space $\{m \mid \theta(m) \le 0\}$ of a linear functional $\theta$ on $M$,
as a pointed cone.

`ConvexAnalysis.halfSpaceCone` is the same construction for a continuous linear functional. This
algebraic version is the one that Weyl's half of the Minkowski–Weyl theorem needs, because that
half uses no topology. -/
def halfSpaceConeₗ (θ : M →ₗ[ℝ] ℝ) : PointedCone ℝ M where
  carrier := {m | θ m ≤ 0}
  add_mem' {m m'} hm hm' := by
    have hm₁ : θ m ≤ 0 := hm
    have hm₂ : θ m' ≤ 0 := hm'
    change θ (m + m') ≤ 0
    rw [map_add]
    linarith
  zero_mem' := by
    change θ 0 ≤ 0
    simp
  smul_mem' a {m} hm := by
    have hm' : θ m ≤ 0 := hm
    have ha : (0 : ℝ) ≤ (a : ℝ) := a.2
    change θ ((a : ℝ) • m) ≤ 0
    rw [map_smul, smul_eq_mul]
    nlinarith

/-- A point $m$ is in the half-space cone of $\theta$ if and only if $\theta(m) \le 0$. -/
@[simp]
theorem mem_halfSpaceConeₗ {θ : M →ₗ[ℝ] ℝ} {m : M} : m ∈ halfSpaceConeₗ θ ↔ θ m ≤ 0 := Iff.rfl

/-- Let $\theta$ be a linear functional on $M$ and let $S \subseteq M$. If $\theta(m) \le 0$ for
every $m \in S$, then $\theta(m) \le 0$ for every $m$ in the convex cone generated by $S$.

Both halves of the Minkowski–Weyl theorem use this lemma, once in $E$ and once in the dual space
of $E$. For this reason it is stated for an arbitrary module. -/
theorem forall_nonpos_of_mem_hull {θ : M →ₗ[ℝ] ℝ} {S : Set M} (h : ∀ m ∈ S, θ m ≤ 0) {m : M}
    (hm : m ∈ PointedCone.hull ℝ S) : θ m ≤ 0 := by
  have hsub : S ⊆ (halfSpaceConeₗ θ : Set M) := fun m' hm' => h m' hm'
  have hle : PointedCone.hull ℝ S ≤ halfSpaceConeₗ θ := Submodule.span_le.2 hsub
  exact hle hm

end HalfSpace

/-! ### The two descriptions of a cone -/

section Defs

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- A set $K \subseteq E$ is a **polyhedral convex cone** if there are finitely many linear
functionals $\varphi_1, \dots, \varphi_k$ on $E$ such that $$K = \{ x \in E \mid \varphi_i(x)
\le 0 \text{ for } i = 1, \dots, k \}.$$

This is the polyhedral convex cone of [rockafellar1970convex], and the H-cone of the literature
on linear programming. -/
def PolyhedralCone (K : Set E) : Prop :=
  ∃ s : Finset (E →ₗ[ℝ] ℝ), K = {x | ∀ φ ∈ s, φ x ≤ 0}

/-- A set $K \subseteq E$ is a **finitely generated convex cone** if there is a finite set
$s \subseteq E$ such that $K$ is the set of nonnegative linear combinations of elements of $s$,
that is, the convex cone generated by $s$.

This is the V-cone of the literature on linear programming. The case $s = \emptyset$ gives
$K = \{0\}$. -/
def FinitelyGeneratedCone (K : Set E) : Prop :=
  ∃ s : Finset E, K = (PointedCone.hull ℝ (s : Set E) : Set E)

/-- A polyhedral cone is convex. -/
theorem PolyhedralCone.convex {K : Set E} (hK : PolyhedralCone K) : Convex ℝ K := by
  obtain ⟨s, rfl⟩ := hK
  simpa only [Set.ofPred_forall] using
    convex_iInter₂ fun φ (_ : φ ∈ s) => convex_halfSpace_le φ.isLinear 0

/-- A polyhedral cone contains the origin. -/
theorem PolyhedralCone.zero_mem {K : Set E} (hK : PolyhedralCone K) : (0 : E) ∈ K := by
  obtain ⟨s, rfl⟩ := hK
  intro φ _
  simp

/-- A polyhedral cone is closed under multiplication by nonnegative scalars. -/
theorem PolyhedralCone.smul_mem {K : Set E} (hK : PolyhedralCone K) {a : ℝ} (ha : 0 ≤ a) {x : E}
    (hx : x ∈ K) : a • x ∈ K := by
  obtain ⟨s, rfl⟩ := hK
  intro φ hφ
  have h : φ x ≤ 0 := hx φ hφ
  rw [map_smul, smul_eq_mul]
  nlinarith

/-- A finitely generated cone is convex. -/
theorem FinitelyGeneratedCone.convex {K : Set E} (hK : FinitelyGeneratedCone K) : Convex ℝ K := by
  obtain ⟨s, rfl⟩ := hK
  exact ((PointedCone.hull ℝ (s : Set E) : ConvexCone ℝ E)).convex

/-- A finitely generated cone contains the origin. -/
theorem FinitelyGeneratedCone.zero_mem {K : Set E} (hK : FinitelyGeneratedCone K) :
    (0 : E) ∈ K := by
  obtain ⟨s, rfl⟩ := hK
  exact (PointedCone.hull ℝ (s : Set E)).zero_mem

/-- A finitely generated cone is closed under multiplication by nonnegative scalars. -/
theorem FinitelyGeneratedCone.smul_mem {K : Set E} (hK : FinitelyGeneratedCone K) {a : ℝ}
    (ha : 0 ≤ a) {x : E} (hx : x ∈ K) : a • x ∈ K := by
  obtain ⟨s, rfl⟩ := hK
  have h := Submodule.smul_mem (PointedCone.hull ℝ (s : Set E)) (⟨a, ha⟩ : {c : ℝ // 0 ≤ c}) hx
  exact h

end Defs

/-! ### Weyl's half: a finitely generated cone is polyhedral -/

section Weyl

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- Adding a generator $v$ to a set $S$ adds a ray to the convex cone generated by $S$: the cone
generated by $S \cup \{v\}$ is $\{ x \mid \exists t \ge 0,\ x - tv \in \operatorname{cone} S
\}$. -/
theorem coe_hull_insert (v : E) (S : Set E) :
    (PointedCone.hull ℝ (insert v S) : Set E)
      = {x | ∃ t : ℝ, 0 ≤ t ∧ x - t • v ∈ (PointedCone.hull ℝ S : Set E)} := by
  rw [PointedCone.hull, Submodule.span_insert, Submodule.coe_sup]
  ext x
  constructor
  · rintro ⟨y, hy, z, hz, rfl⟩
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hy
    exact ⟨(a : ℝ), a.2, by simpa using hz⟩
  · rintro ⟨t, ht, hmem⟩
    refine ⟨t • v, Submodule.mem_span_singleton.2 ⟨⟨t, ht⟩, rfl⟩, x - t • v, hmem, by simp⟩

/-- **Fourier–Motzkin elimination.** If $K \subseteq E$ is a polyhedral cone and $v \in E$, then
$$\{ x \in E \mid \exists t \ge 0,\ x - tv \in K \},$$ which is $K$ with the ray through $v$
added, is a polyhedral cone.

The inequalities of the new cone are the old inequalities $\varphi$ with $\varphi(v) \le 0$,
unchanged, together with one combination $\psi(v)\,\chi - \chi(v)\,\psi$ for each pair of old
inequalities with $\psi(v) > 0$ and $\chi(v) < 0$. These are exactly the consequences of the old
system that do not contain the eliminated variable $t$. -/
theorem PolyhedralCone.add_ray {K : Set E} (hK : PolyhedralCone K) (v : E) :
    PolyhedralCone {x | ∃ t : ℝ, 0 ≤ t ∧ x - t • v ∈ K} := by
  classical
  obtain ⟨s, rfl⟩ := hK
  refine ⟨s.filter (fun φ => φ v ≤ 0) ∪
    Finset.image₂ (fun ψ χ => ψ v • χ - χ v • ψ) (s.filter (fun φ => 0 < φ v))
      (s.filter (fun φ => φ v < 0)), ?_⟩
  ext x
  simp only [Set.mem_ofPred_eq, Finset.mem_union, Finset.mem_filter, Finset.mem_image₂]
  constructor
  · rintro ⟨t, ht0, hmem⟩ χ hχ
    rcases hχ with ⟨hχs, hχv⟩ | ⟨ψ, ⟨hψs, hψv⟩, χ', ⟨hχ's, hχ'v⟩, rfl⟩
    · have h := hmem χ hχs
      rw [map_sub, map_smul, smul_eq_mul] at h
      nlinarith
    · have h₁ := hmem ψ hψs
      have h₂ := hmem χ' hχ's
      rw [map_sub, map_smul, smul_eq_mul] at h₁ h₂
      simp only [LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]
      nlinarith
  · intro h
    have hZ : ∀ φ ∈ s, φ v ≤ 0 → φ x ≤ 0 := fun φ hφ hφv => h φ (Or.inl ⟨hφ, hφv⟩)
    have hPN : ∀ ψ ∈ s, 0 < ψ v → ∀ χ ∈ s, χ v < 0 → ψ v * χ x - χ v * ψ x ≤ 0 := by
      intro ψ hψ hψv χ hχ hχv
      have hcomb := h _ (Or.inr ⟨ψ, ⟨hψ, hψv⟩, χ, ⟨hχ, hχv⟩, rfl⟩)
      simpa only [LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul] using hcomb
    set T : Finset ℝ :=
      insert 0 ((s.filter (fun φ => 0 < φ v)).image (fun φ => φ x / φ v)) with hT
    have hTne : T.Nonempty := ⟨0, Finset.mem_insert_self _ _⟩
    -- the witness is the largest of `0` and the lower bounds forced by the `φ v > 0` rows; being
    -- a `max'` it is one of them, which is what the `φ v < 0` rows are checked against
    have hmaxcase : T.max' hTne = 0 ∨
        ∃ ψ ∈ s, 0 < ψ v ∧ ψ x / ψ v = T.max' hTne := by
      rcases Finset.mem_insert.1 (T.max'_mem hTne) with hzero | hmem
      · exact Or.inl hzero
      · obtain ⟨ψ, hψ, hψeq⟩ := Finset.mem_image.1 hmem
        obtain ⟨hψs, hψv⟩ := Finset.mem_filter.1 hψ
        exact Or.inr ⟨ψ, hψs, hψv, hψeq⟩
    refine ⟨T.max' hTne, Finset.le_max' _ _ (Finset.mem_insert_self _ _), ?_⟩
    intro φ hφ
    rw [map_sub, map_smul, smul_eq_mul]
    rcases lt_trichotomy (φ v) 0 with hφv | hφv | hφv
    · have hφx : φ x ≤ 0 := hZ φ hφ hφv.le
      rcases hmaxcase with hzero | ⟨ψ, hψs, hψv, hψeq⟩
      · rw [hzero]
        linarith
      · have key := hPN ψ hψs hψv φ hφ hφv
        rw [← hψeq, div_mul_eq_mul_div, sub_nonpos, le_div_iff₀ hψv]
        linarith
    · rw [hφv]
      have := hZ φ hφ hφv.le
      linarith
    · have hmem : φ x / φ v ∈ T :=
        Finset.mem_insert_of_mem (Finset.mem_image.2 ⟨φ, Finset.mem_filter.2 ⟨hφ, hφv⟩, rfl⟩)
      have hle := Finset.le_max' T _ hmem
      rw [div_le_iff₀ hφv] at hle
      linarith

/-- In a finite-dimensional space $E$, the set $\{0\}$ is a polyhedral cone. It is cut out by the
$2n$ inequalities $\pm b_i^*(x) \le 0$, where $b_1^*, \dots, b_n^*$ are the coordinate
functionals of a basis.

This is the base of the induction in Weyl's half, and the only place where finite dimension
enters it. -/
theorem polyhedralCone_zero [FiniteDimensional ℝ E] : PolyhedralCone ({0} : Set E) := by
  classical
  set b := Module.finBasis ℝ E with hb
  refine ⟨Finset.univ.image b.coord ∪ Finset.univ.image (fun i => -b.coord i), ?_⟩
  ext x
  simp only [Set.mem_singleton_iff, Set.mem_ofPred_eq, Finset.mem_union, Finset.mem_image,
    Finset.mem_univ, true_and]
  constructor
  · rintro rfl φ _
    simp
  · intro h
    refine b.forall_coord_eq_zero_iff.1 fun i => le_antisymm (h _ (Or.inl ⟨i, rfl⟩)) ?_
    have := h _ (Or.inr ⟨i, rfl⟩)
    simpa using this

/-- **Weyl's half of the Minkowski–Weyl theorem.** Let $E$ be a finite-dimensional real vector
space. Every finitely generated convex cone in $E$ is a polyhedral convex cone.

The proof is an induction on the generators: $\{0\}$ is polyhedral
(`ConvexAnalysis.polyhedralCone_zero`), and `ConvexAnalysis.PolyhedralCone.add_ray` adds one
generator at a time. No topology is involved. -/
theorem FinitelyGeneratedCone.polyhedralCone [FiniteDimensional ℝ E] {K : Set E}
    (hK : FinitelyGeneratedCone K) : PolyhedralCone K := by
  classical
  obtain ⟨s, rfl⟩ := hK
  induction s using Finset.induction_on with
  | empty =>
    have : (PointedCone.hull ℝ ((∅ : Finset E) : Set E) : Set E) = {0} := by
      rw [Finset.coe_empty, PointedCone.hull, Submodule.span_empty]
      rfl
    rw [this]
    exact polyhedralCone_zero
  | insert v s _ ih =>
    rw [Finset.coe_insert, coe_hull_insert]
    exact ih.add_ray v

end Weyl

/-! ### Closedness -/

section Closed

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- Let $E$ be a finite-dimensional real normed space. Every polyhedral convex cone in $E$ is
closed.

It is a finite intersection of closed half-spaces, because in finite dimensions every linear
functional is continuous. -/
theorem PolyhedralCone.isClosed {K : Set E} (hK : PolyhedralCone K) : IsClosed K := by
  obtain ⟨s, rfl⟩ := hK
  simpa only [Set.ofPred_forall] using isClosed_iInter fun φ => isClosed_iInter fun (_ : φ ∈ s) =>
    isClosed_le (LinearMap.continuous_of_finiteDimensional φ) continuous_const

/-- Let $E$ be a finite-dimensional real normed space. Every finitely generated convex cone in $E$
is closed.

The classical proof uses Carathéodory's theorem, before the Minkowski–Weyl theorem. Here the
result is a corollary of Weyl's half and `ConvexAnalysis.PolyhedralCone.isClosed`. -/
theorem FinitelyGeneratedCone.isClosed {K : Set E} (hK : FinitelyGeneratedCone K) : IsClosed K :=
  hK.polyhedralCone.isClosed

end Closed

/-! ### Minkowski's half, and the equivalence of the two descriptions -/

section Minkowski

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **Minkowski's half of the Minkowski–Weyl theorem.** Let $E$ be a finite-dimensional real normed
space. Every polyhedral convex cone in $E$ is finitely generated.

The generators are found in the dual space. The cone $C$ generated by the constraint functionals
of $K$ is finitely generated, hence polyhedral by Weyl's half. Because a finite-dimensional
space is reflexive, the functionals that cut out $C$ are evaluations at points $v_1, \dots, v_m$
of $E$, and these points generate $K$. One inclusion is immediate. For the other, a point of $K$
outside the cone generated by the $v_j$ is separated from this cone, which is closed by Weyl's
half, and the separating functional is in $C$. -/
theorem PolyhedralCone.finitelyGeneratedCone {K : Set E} (hK : PolyhedralCone K) :
    FinitelyGeneratedCone K := by
  classical
  obtain ⟨s, rfl⟩ := hK
  obtain ⟨t, ht⟩ :
      PolyhedralCone (PointedCone.hull ℝ (s : Set (E →ₗ[ℝ] ℝ)) : Set (E →ₗ[ℝ] ℝ)) :=
    FinitelyGeneratedCone.polyhedralCone ⟨s, rfl⟩
  set D : Finset E := t.image fun Φ => (Module.evalEquiv ℝ E).symm Φ with hD
  have hEval : ∀ (Φ : (E →ₗ[ℝ] ℝ) →ₗ[ℝ] ℝ) (ψ : E →ₗ[ℝ] ℝ),
      Φ ψ = ψ ((Module.evalEquiv ℝ E).symm Φ) := by
    intro Φ ψ
    conv_lhs => rw [← (Module.evalEquiv ℝ E).apply_symm_apply Φ]
    rfl
  have hmemD : ∀ w ∈ D, ∃ Φ ∈ t, (Module.evalEquiv ℝ E).symm Φ = w := by
    intro w hw
    obtain ⟨Φ, hΦ, rfl⟩ := Finset.mem_image.1 hw
    exact ⟨Φ, hΦ, rfl⟩
  refine ⟨D, subset_antisymm ?_ ?_⟩
  · -- the hard inclusion, by separation
    intro x hx
    by_contra hcon
    have hGclosed : IsClosed (PointedCone.hull ℝ (D : Set E) : Set E) :=
      FinitelyGeneratedCone.isClosed ⟨D, rfl⟩
    obtain ⟨f, u, hfG, hfx⟩ :=
      geometric_hahn_banach_closed_point
        ((PointedCone.hull ℝ (D : Set E) : ConvexCone ℝ E)).convex hGclosed hcon
    have hcone : ∀ ⦃a : ℝ⦄, 0 < a → ∀ ⦃y⦄, y ∈ (PointedCone.hull ℝ (D : Set E) : Set E) →
        a • y ∈ (PointedCone.hull ℝ (D : Set E) : Set E) :=
      fun a ha y hy =>
        Submodule.smul_mem (PointedCone.hull ℝ (D : Set E)) (⟨a, ha.le⟩ : {c : ℝ // 0 ≤ c}) hy
    have hle : ∀ y ∈ (PointedCone.hull ℝ (D : Set E) : Set E), f y ≤ 0 := fun y hy =>
      le_zero_of_isCone_of_forall_le hcone (fun z hz => (hfG z hz).le) hy
    have hu : 0 < u := by
      have h0 := hfG 0 (PointedCone.hull ℝ (D : Set E)).zero_mem
      simpa using h0
    -- the separating functional satisfies the constraints defining `t`, so it lies in the cone
    -- generated by `s`
    have hfC : (f : E →ₗ[ℝ] ℝ) ∈
        (PointedCone.hull ℝ (s : Set (E →ₗ[ℝ] ℝ)) : Set (E →ₗ[ℝ] ℝ)) := by
      rw [ht]
      intro Φ hΦ
      rw [hEval]
      exact hle _ (PointedCone.subset_hull (Finset.mem_coe.2
        (Finset.mem_image.2 ⟨Φ, hΦ, rfl⟩)))
    -- but then it is nonpositive at `x`
    have hfx0 : f x ≤ 0 :=
      forall_nonpos_of_mem_hull (θ := Module.Dual.eval ℝ E x)
        (fun ψ hψ => hx ψ (Finset.mem_coe.1 hψ)) hfC
    linarith
  · -- the easy inclusion
    intro x hx φ hφ
    refine forall_nonpos_of_mem_hull (θ := φ) (fun w hw => ?_) hx
    obtain ⟨Φ, hΦ, rfl⟩ := hmemD w (Finset.mem_coe.1 hw)
    rw [← hEval]
    have : φ ∈ (PointedCone.hull ℝ (s : Set (E →ₗ[ℝ] ℝ)) : Set (E →ₗ[ℝ] ℝ)) :=
      PointedCone.subset_hull (Finset.mem_coe.2 hφ)
    rw [ht] at this
    exact this Φ hΦ

/-- **The Minkowski–Weyl theorem for cones.** Let $E$ be a finite-dimensional real normed space and
let $K \subseteq E$. Then $K$ is the solution set of finitely many homogeneous linear
inequalities if and only if $K$ is the convex cone generated by finitely many vectors.

This is the cone case of Theorem 19.1 of [rockafellar1970convex]. -/
theorem polyhedralCone_iff_finitelyGeneratedCone {K : Set E} :
    PolyhedralCone K ↔ FinitelyGeneratedCone K :=
  ⟨PolyhedralCone.finitelyGeneratedCone, FinitelyGeneratedCone.polyhedralCone⟩

end Minkowski

end ConvexAnalysis
