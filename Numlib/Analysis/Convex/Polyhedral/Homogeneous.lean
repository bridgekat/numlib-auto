import Numlib.Analysis.Convex.Operations.Hull
import Numlib.Analysis.Convex.Polyhedral.Function
import Numlib.Analysis.Convex.Recession.ConeHull

/-!
# The positively homogeneous convex function generated by finitely many points

A convex set generated by finitely many points and directions is polyhedral. This module proves the
function-level form the Helly-type theorems on systems of inequalities consume: the positively
homogeneous convex function generated by finitely many points is polyhedral.

That function is `posHomGen f`, whose epigraph is *not* the convex cone generated by `epi f`,
because that cone is not upward closed at the origin: for `posHomGen (δ(· | {a}) + α)` the
epigraph must also contain the vertical ray above the origin. This is why the generator list for
`epi k₀` carries the extra point `(0, 1)`.

## Main results

* `epi_posHomGen_of_epi_eq` — if `epi f` is `conv P` plus the vertical ray, for a finite `P`, then
  `epi (posHomGen f)` is the convex cone generated by `P` together with `(0, 1)`;
  `polyhedralFn_posHomGen_of_epi_eq` is that this function is polyhedral.
* `epi_convFn_of_epi_eq`, `polyhedralFn_posHomGen_convFn` — the same for the function those
  theorems build, generated by the convex hull of finitely many functions whose epigraphs are
  single translated vertical rays.

## Implementation notes

The hypothesis is `epi f = conv P + cone {(0,1)}`, not "`f` is polyhedral". For a general
direction set `D`, `epi (posHomGen f) = cone (P ∪ D ∪ {(0,1)})` is **false**: for `f x = |x| + 1`
on `ℝ` the point `(1, 1)` lies in `epi (posHomGen f) = epi |·|` but in no finite nonnegative
combination of `epi f ∪ {(0,1)}`. A closure is needed unless the direction set is exactly the
vertical ray — which is the case used there, the conjugate of an affine function being a point
indicator.

## References

* [rockafellar1970convex] §19.
-/

open Set Pointwise

namespace ConvexAnalysis

section VerticalRay

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- The **vertical ray** `{0} × [0, ∞)` of `E × ℝ`, as a pointed cone: the cone generated by
`(0, 1)`. Adding it to a set is what makes the set upward closed. -/
noncomputable def verticalRay (E : Type*) [AddCommGroup E] [Module ℝ E] :
    PointedCone ℝ (E × ℝ) :=
  PointedCone.hull ℝ ({((0 : E), (1 : ℝ))} : Set (E × ℝ))

theorem mem_verticalRay_iff {p : E × ℝ} :
    p ∈ verticalRay E ↔ ∃ c : ℝ, 0 ≤ c ∧ p = ((0 : E), c) := by
  rw [verticalRay, PointedCone.hull, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨c, rfl⟩
    refine ⟨(c : ℝ), c.2, ?_⟩
    have hval : (c : ℝ) • (((0 : E), (1 : ℝ)) : E × ℝ) = ((0 : E), (c : ℝ)) := by
      rw [Prod.smul_mk, smul_zero, smul_eq_mul, mul_one]
    exact hval
  · rintro ⟨c, hc, rfl⟩
    refine ⟨⟨c, hc⟩, ?_⟩
    have hval : c • (((0 : E), (1 : ℝ)) : E × ℝ) = ((0 : E), c) := by
      rw [Prod.smul_mk, smul_zero, smul_eq_mul, mul_one]
    exact hval

end VerticalRay

section Homogeneous

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **The epigraph of the positively homogeneous convex function generated by finitely many
points.** If `epi f` is the convex hull of a finite set `P` plus the vertical ray, then
`epi (posHomGen f)` is the convex cone generated by `P` together with `(0, 1)`. The extra generator
is not decoration: the cone generated by `epi f` alone meets the vertical axis in `{0}` only. -/
theorem epi_posHomGen_of_epi_eq {f : E → EReal} {P : Finset (E × ℝ)}
    (hepi : epi f = convexHull ℝ (P : Set (E × ℝ)) + (verticalRay E : Set (E × ℝ))) :
    epi (posHomGen f)
      = (PointedCone.hull ℝ (insert ((0 : E), (1 : ℝ)) (P : Set (E × ℝ))) : Set (E × ℝ)) := by
  classical
  set Kc : PointedCone ℝ (E × ℝ) :=
    PointedCone.hull ℝ (insert ((0 : E), (1 : ℝ)) (P : Set (E × ℝ))) with hKc
  have hvert : ((0 : E), (1 : ℝ)) ∈ Kc := PointedCone.subset_hull (Set.mem_insert _ _)
  have hPsub : (P : Set (E × ℝ)) ⊆ (Kc : Set (E × ℝ)) := fun p hp =>
    PointedCone.subset_hull (Set.mem_insert_of_mem _ hp)
  -- `Kc` is closed and upward closed, hence an epigraph.
  have hKcl : IsClosed (Kc : Set (E × ℝ)) :=
    FinitelyGeneratedCone.isClosed ⟨insert ((0 : E), (1 : ℝ)) P, by rw [hKc, Finset.coe_insert]⟩
  have hKmono : ∀ (x : E) (μ ν : ℝ), (x, μ) ∈ (Kc : Set (E × ℝ)) → μ ≤ ν →
      (x, ν) ∈ (Kc : Set (E × ℝ)) := by
    intro x μ ν hmem hle
    have hsmul : (((0 : E), ν - μ) : E × ℝ) ∈ Kc := by
      have h := Submodule.smul_mem Kc (⟨ν - μ, by linarith⟩ : {c : ℝ // 0 ≤ c}) hvert
      simpa using h
    have heq : ((x, μ) : E × ℝ) + ((0 : E), ν - μ) = (x, ν) := by simp
    rw [← heq]
    exact Submodule.add_mem Kc hmem hsmul
  have hKepi : IsEpiLike (Kc : Set (E × ℝ)) := IsEpiLike.of_isClosed hKmono hKcl
  -- `epi f` sits inside `Kc`, hence so does the cone it generates.
  have hepiK : epi f ⊆ (Kc : Set (E × ℝ)) := by
    rw [hepi]
    rintro _ ⟨u, hu, v, hv, rfl⟩
    refine Submodule.add_mem Kc ?_ ?_
    · exact convexHull_min hPsub ((Kc : ConvexCone ℝ (E × ℝ))).convex hu
    · obtain ⟨c, hc, rfl⟩ := mem_verticalRay_iff.1 hv
      have h := Submodule.smul_mem Kc (⟨c, hc⟩ : {d : ℝ // 0 ≤ d}) hvert
      simpa using h
  refine Set.Subset.antisymm
    (epi_ofEpi_subset_of_isEpiLike (Submodule.span_le.2 hepiK) hKepi) fun p hp => ?_
  -- Conversely every generator of `Kc` lies in `epi (posHomGen f)`, which is a cone plus verticals.
  rw [hKc, ← Set.singleton_union, coe_hull_union] at hp
  obtain ⟨v, hv, u, hu, rfl⟩ := hp
  obtain ⟨c, hc, rfl⟩ := mem_verticalRay_iff.1 hv
  have hPepi : (P : Set (E × ℝ)) ⊆ epi f := by
    intro p hp
    rw [hepi]
    exact ⟨p, subset_convexHull ℝ _ hp, 0, (verticalRay E).zero_mem, add_zero p⟩
  have huepi : u ∈ epi (posHomGen f) :=
    coe_hull_epi_subset_epi_posHomGen f (Submodule.span_mono hPepi hu)
  rw [mem_epi] at huepi ⊢
  have hfst : ((((0 : E), c) : E × ℝ) + u).1 = u.1 := by simp
  have hsnd : ((((0 : E), c) : E × ℝ) + u).2 = c + u.2 := by simp
  rw [hfst, hsnd]
  refine le_trans huepi ?_
  exact_mod_cast le_add_of_nonneg_left hc

/-- The positively homogeneous convex function generated by finitely many points is polyhedral. -/
theorem polyhedralFn_posHomGen_of_epi_eq {f : E → EReal} {P : Finset (E × ℝ)}
    (hepi : epi f = convexHull ℝ (P : Set (E × ℝ)) + (verticalRay E : Set (E × ℝ))) :
    PolyhedralFn (posHomGen f) := by
  classical
  have hfg : FinitelyGenerated (epi (posHomGen f)) := by
    refine ⟨{0}, insert ((0 : E), (1 : ℝ)) P, ?_⟩
    rw [epi_posHomGen_of_epi_eq hepi, Finset.coe_insert, Finset.coe_singleton,
      convexHull_singleton]
    ext q
    constructor
    · exact fun hq => ⟨0, rfl, q, hq, zero_add q⟩
    · rintro ⟨a, ha, b, hb, rfl⟩
      rw [Set.mem_singleton_iff] at ha
      subst ha
      simpa using hb
  exact hfg.polyhedral

/-- **The convex hull of finitely many translated vertical rays.** If each `g i` has for epigraph
the vertical ray above a single point `p i` — what the conjugate of an affine function looks like —
then `convFn g` has for epigraph the convex hull of the `p i` plus the vertical ray. `IsEpiLike` is
not automatic for a convex hull of a union; here it is paid for by finite generation, the
right-hand side being `conv P + cone {(0,1)}`, hence closed and absorbing the vertical ray. -/
theorem epi_convFn_of_epi_eq {ι : Type*} [Finite ι] {g : ι → E → EReal} {p : ι → E × ℝ}
    (hg : ∀ i, epi (g i) = {p i} + (verticalRay E : Set (E × ℝ))) :
    epi (convFn g) = convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ)) := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  have hunion : (⋃ i, epi (g i)) = Set.range p + (verticalRay E : Set (E × ℝ)) := by
    ext q
    simp only [Set.mem_iUnion, hg]
    constructor
    · rintro ⟨i, u, hu, v, hv, rfl⟩
      rw [Set.mem_singleton_iff] at hu
      exact ⟨p i, ⟨i, rfl⟩, v, hv, by rw [hu]⟩
    · rintro ⟨u, ⟨i, rfl⟩, v, hv, rfl⟩
      exact ⟨i, p i, rfl, v, hv, rfl⟩
  have hVconv : Convex ℝ ((verticalRay E : Set (E × ℝ))) :=
    ((verticalRay E : ConvexCone ℝ (E × ℝ))).convex
  have hhull : convexHull ℝ (⋃ i, epi (g i))
      = convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ)) := by
    rw [hunion, convexHull_add, hVconv.convexHull_eq]
  have hrange : (Set.range p) = ((Finset.image p Finset.univ : Finset (E × ℝ)) : Set (E × ℝ)) := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hfg : FinitelyGenerated (convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ))) :=
    ⟨Finset.image p Finset.univ, {((0 : E), (1 : ℝ))},
      by rw [hrange, verticalRay, Finset.coe_singleton]⟩
  have hmono : ∀ (x : E) (μ ν : ℝ),
      (x, μ) ∈ convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ)) → μ ≤ ν →
      (x, ν) ∈ convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ)) := by
    rintro x μ ν ⟨u, hu, v, hv, huv⟩ hle
    obtain ⟨c, hc, rfl⟩ := mem_verticalRay_iff.1 hv
    refine ⟨u, hu, ((0 : E), c + (ν - μ)),
      mem_verticalRay_iff.2 ⟨c + (ν - μ), by linarith, rfl⟩, ?_⟩
    have h1 : (u + ((0 : E), c)).1 = x := congrArg Prod.fst huv
    have h2 : (u + ((0 : E), c)).2 = μ := congrArg Prod.snd huv
    simp only [Prod.fst_add, Prod.snd_add, add_zero] at h1 h2
    refine Prod.ext ?_ ?_
    · simpa using h1
    · simp only [Prod.snd_add]
      rw [← add_assoc, h2]
      ring
  have hepilike : IsEpiLike (convexHull ℝ (Set.range p) + (verticalRay E : Set (E × ℝ))) :=
    IsEpiLike.of_isClosed hmono hfg.isClosed
  rw [epi_convFn (by rw [hhull]; exact hepilike), hhull]

/-- The same, in the form the systems-of-inequalities theorems ask for: the positively homogeneous
convex function generated by the convex hull of finitely many point indicators is polyhedral — the
`k₀` there, once the conjugates of the affine `fᵢ` are identified as point indicators. -/
theorem polyhedralFn_posHomGen_convFn {ι : Type*} [Finite ι] {g : ι → E → EReal} {p : ι → E × ℝ}
    (hg : ∀ i, epi (g i) = {p i} + (verticalRay E : Set (E × ℝ))) :
    PolyhedralFn (posHomGen (convFn g)) := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  refine polyhedralFn_posHomGen_of_epi_eq (P := Finset.image p Finset.univ) ?_
  rw [epi_convFn_of_epi_eq hg, Finset.coe_image, Finset.coe_univ, Set.image_univ]

end Homogeneous

end ConvexAnalysis
