import Mathlib.RingTheory.Coprime.Lemmas
import Numlib.LinearAlgebra.MinpolyOn

/-!
# Sums of cyclic vectors with coprime minimal polynomials

If vector minimal polynomials are pairwise coprime, then the sum of the vectors
generates the sum of their cyclic subspaces. Its minimal polynomial is the product
of the individual minimal polynomials.

## Main results

* `Krylov.minpolyVec_fullSubspace_add_of_isCoprime`: two generators with coprime
  vector minimal polynomials give the direct sum of their cyclic subspaces.
* `Krylov.minpolyVec_fullSubspace_finsetSum_of_pairwise_isCoprime`: the finite family version.
-/

open Polynomial

namespace Krylov

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
variable (A : Module.End K V)

/-- The vector $p(A)v$ belongs to the cyclic subspace generated by $v$. -/
theorem aeval_mem_fullSubspace (v : V) (p : K[X]) :
    aeval A p v ∈ fullSubspace A v := by
  apply subspace_le_fullSubspace A v (p.natDegree + 1)
  apply aeval_apply_mem_subspace A v
  exact degree_le_natDegree.trans_lt (WithBot.coe_lt_coe.mpr (Nat.lt_succ_self _))

variable [FiniteDimensional K V]

/-- A polynomial annihilates the cyclic subspace of $v$ if and only if it is a
multiple of the minimal polynomial of $v$. -/
theorem fullSubspace_le_ker_aeval_iff (v : V) (p : K[X]) :
    fullSubspace A v ≤ LinearMap.ker (aeval A p) ↔ minpolyVec A v ∣ p := by
  let hW := (Module.End.mem_invtSubmodule_iff_mapsTo A).1
    (fullSubspace_mem_invtSubmodule A v)
  rw [← LinearMap.minpolyOn_fullKrylovSubspace A v hW, LinearMap.minpolyOn_dvd_iff A hW]
  rfl

/-- The vector minimal polynomial of the zero vector is $1$. -/
@[simp]
theorem minpolyVec_zero : minpolyVec A (0 : V) = 1 := by
  have hm := minpolyVec_monic A (0 : V) (minpolyVec_ne_zero A (0 : V))
  have hd : minpolyVec A (0 : V) ∣ 1 := (minpolyVec_dvd_iff A 0).2 (by simp)
  exact eq_of_dvd_of_natDegree_le_of_leadingCoeff hd (by simp) (by simp [hm])

/-- If $v$ and $w$ have coprime minimal polynomials, then the minimal polynomial of $v+w$
is their product and its grade is the sum of their grades. The cyclic subspace of the sum
is the internal direct sum of the cyclic subspaces of $v$ and $w$. -/
theorem minpolyVec_fullSubspace_add_of_isCoprime (v w : V)
    (hcop : IsCoprime (minpolyVec A v) (minpolyVec A w)) :
    minpolyVec A (v + w) =
        minpolyVec A v * minpolyVec A w ∧
      grade A (v + w) = grade A v + grade A w ∧
      Krylov.fullSubspace A (v + w) = Krylov.fullSubspace A v ⊔ Krylov.fullSubspace A w ∧
      Disjoint (Krylov.fullSubspace A v) (Krylov.fullSubspace A w) := by
  let p := minpolyVec A v
  let q := minpolyVec A w
  obtain ⟨a, b, hab⟩ := hcop
  change a * p + b * q = 1 at hab
  have hmul (r s : K[X]) (x : V) :
      aeval A (r * s) x = aeval A r (aeval A s x) := by
    rw [map_mul, Module.End.mul_apply]
  have hv := Krylov.aeval_minpolyVec A v
  have hw := Krylov.aeval_minpolyVec A w
  change aeval A p v = 0 at hv
  change aeval A q w = 0 at hw
  have hone (x : V) : aeval A (a * p) x + aeval A (b * q) x = x := by
    rw [← LinearMap.add_apply, ← map_add, hab, map_one]
    rfl
  have hvp : aeval A (b * q) (v + w) = v := by
    rw [map_add, hmul b q w, hw, map_zero, add_zero]
    simpa only [hmul a p v, hv, map_zero, zero_add] using hone v
  have hwp : aeval A (a * p) (v + w) = w := by
    rw [map_add, hmul a p v, hv, map_zero, zero_add]
    simpa only [hmul b q w, hw, map_zero, add_zero] using hone w
  have hkill : aeval A (p * q) (v + w) = 0 := by
    rw [map_add, hmul p q w, hw, map_zero, add_zero, mul_comm, hmul q p v, hv, map_zero]
  have hdiv := (Krylov.minpolyVec_dvd_iff A (v + w)).2 hkill
  let r := minpolyVec A (v + w)
  have hkill' := Krylov.aeval_minpolyVec A (v + w)
  change aeval A r (v + w) = 0 at hkill'
  have hdiv' : p * q ∣ r := by
    apply IsCoprime.mul_dvd ⟨a, b, hab⟩
    · apply (Krylov.minpolyVec_dvd_iff A v).2
      rw [← hvp, ← hmul, mul_comm, hmul, hkill', map_zero]
    · apply (Krylov.minpolyVec_dvd_iff A w).2
      rw [← hwp, ← hmul, mul_comm, hmul, hkill', map_zero]
  have hp : p.Monic := Krylov.minpolyVec_monic A v (Krylov.minpolyVec_ne_zero A v)
  have hq : q.Monic := Krylov.minpolyVec_monic A w (Krylov.minpolyVec_ne_zero A w)
  have hr : r.Monic := Krylov.minpolyVec_monic A (v + w)
    (Krylov.minpolyVec_ne_zero A (v + w))
  have heq : r = p * q := eq_of_dvd_of_natDegree_le_of_leadingCoeff hdiv
    (natDegree_le_of_dvd hdiv' hr.ne_zero) (hr.leadingCoeff.trans (hp.mul hq).leadingCoeff.symm)
  have hfull (x : V) : x ∈ Krylov.fullSubspace A x :=
    Krylov.subspace_le_fullSubspace A x 1 <| Krylov.self_mem_subspace A x (by decide)
  refine ⟨heq, ?_, ?_, ?_⟩
  · simp only [← Krylov.natDegree_minpolyVec]
    change r.natDegree = p.natDegree + q.natDegree
    rw [heq, natDegree_mul hp.ne_zero hq.ne_zero]
  · have hV := Krylov.fullSubspace_mem_invtSubmodule A v
    have hW := Krylov.fullSubspace_mem_invtSubmodule A w
    have hSum := Krylov.fullSubspace_mem_invtSubmodule A (v + w)
    apply le_antisymm
    · exact Krylov.fullSubspace_le_of_mem_invtSubmodule A _ (A.invtSubmodule.sup_mem hV hW)
        (Submodule.add_mem _ (Submodule.mem_sup_left (hfull v))
          (Submodule.mem_sup_right (hfull w)))
    · have hvm := aeval_mem_fullSubspace A (v + w) (b * q)
      have hwm := aeval_mem_fullSubspace A (v + w) (a * p)
      rw [hvp] at hvm
      rw [hwp] at hwm
      exact sup_le (Krylov.fullSubspace_le_of_mem_invtSubmodule A v hSum hvm)
        (Krylov.fullSubspace_le_of_mem_invtSubmodule A w hSum hwm)
  · refine Submodule.disjoint_def.2 fun x hx hy => ?_
    have hp0 : aeval A p x = 0 := ((fullSubspace_le_ker_aeval_iff A v p).2 dvd_rfl) hx
    have hq0 : aeval A q x = 0 := ((fullSubspace_le_ker_aeval_iff A w q).2 dvd_rfl) hy
    simpa only [hmul, hp0, hq0, map_zero, add_zero] using (hone x).symm

/-- For a finite family of vectors with pairwise coprime minimal polynomials, the minimal
polynomial of their sum is the product of the individual minimal polynomials. Their cyclic
subspaces span the cyclic subspace of the sum. -/
theorem minpolyVec_fullSubspace_finsetSum_of_pairwise_isCoprime {ι : Type*} (v : ι → V)
    (hcop : Pairwise fun i j => IsCoprime (minpolyVec A (v i)) (minpolyVec A (v j)))
    (s : Finset ι) :
    minpolyVec A (∑ i ∈ s, v i) = ∏ i ∈ s, minpolyVec A (v i) ∧
      fullSubspace A (∑ i ∈ s, v i) = s.sup (fun i => fullSubspace A (v i)) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      have hc : IsCoprime (minpolyVec A (v i)) (minpolyVec A (∑ j ∈ s, v j)) := by
        rw [ih.1]
        exact IsCoprime.prod_right fun j hj => hcop (fun h => hi (h ▸ hj))
      obtain ⟨h₁, -, h₂, -⟩ := minpolyVec_fullSubspace_add_of_isCoprime A (v i)
        (∑ j ∈ s, v j) hc
      simp only [Finset.sum_insert hi, Finset.prod_insert hi, Finset.sup_insert, h₁, h₂,
        ih.1, ih.2, and_self]

end Krylov
